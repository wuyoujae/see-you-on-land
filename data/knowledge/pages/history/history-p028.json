nt"},{"id":"history-p028-n0022","text":"，南宋爱国词人；与苏轼并称","bbox":[694.216,275.672,190.523,15.257],"color":"#141414","fontSize":14.656,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"history-p028-n0023","text":"“","bbox":[884.738,270.186,6.243,14.656],"color":"#141414","fontSize":14.656,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"history-p028-n0024","text":"苏辛","bbox":[890.986,275.672,29.311,14.656],"color":"#141414","fontSize":14.656,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"history-p028-n0025","text":"”","bbox":[920.297,270.186,6.243,14.656],"color":"#141414","fontSize":14.656,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"history-p028-n0026","text":"，与李清照并称","bbox":[926.544,275.672,102.589,14.656],"color":"#141414","fontSize":14.656,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"history-p028-n0027","text":"“","bbox":[1029.133,270.186,6.243,14.656],"color":"#141414","fontSize":14.656,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"history-p028-n0028","text":"济南二安","bbox":[1035.38,275.672,58.622,14.656],"color":"#141414","fontSize":14.656,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"history-p028-n0029","text":"”","bbox":[1094.003,270.186,6.243,14.656],"color":"#141414","fontSize":14.656,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"history-p028-n0030","text":"在文学史上","bbox":[520.509,317.807,73.278,14.656],"color":"#141414","fontSize":14.656,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"history-p028-n0031","text":"第一次把金戈铁马的铿锵之声带入词","bbox":[593.788,317.807,234.489,14.656],"color":"#8e24aa","fontSize":14.656,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"history-p028-n0032","text":"代表作是《鹧鸪天》《水龙吟》《青玉案","bbox":[520.509,359.942,249.145,14.656],"color":"#141414","fontSize":14.656,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"history-p028-n0033","text":"·","bbox":[769.655,354.527,2.96,14.656],"color":"#141414","fontS