bbox":[620.125,434.569,5.297,15.308],"color":"#141414","fontSize":15.308,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0058","text":"十一世纪中国最伟大的改革家","bbox":[625.432,440.224,199.002,15.308],"color":"#141414","fontSize":15.308,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0059","text":"”","bbox":[824.435,434.569,5.297,15.308],"color":"#141414","fontSize":15.308,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0060","text":"【知识延伸】","bbox":[461.306,616.265,91.847,15.308],"color":"#141414","fontSize":15.308,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0061","text":"古文运动","bbox":[589.51,538.769,61.232,15.308],"color":"#141414","fontSize":15.308,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0062","text":"是唐宋时期提倡古文、反对骈文的文体改革运动","bbox":[687.097,494.759,321.465,15.308],"color":"#141414","fontSize":15.308,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0063","text":"其核心是反对六朝以来形式僵化、内容空洞的骈文","bbox":[687.097,538.769,336.773,15.308],"color":"#141414","fontSize":15.308,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0064","text":"提倡恢复先秦两汉时期质朴自由、言之有物的散文","bbox":[687.097,582.779,336.773,15.308],"color":"#141414","fontSize":15.308,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0065","text":"传统，以复兴儒学，挽救时局","bbox":[687.097,605.741,199.002,15.308],"color":"#141414","fontSize":15.308,"block":22,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0066","text":"经典名句","bbox":[589.51,693.761,61.232,15.308],"color":"#141414","fontSize":15.308,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0067","text":"《师说》：闻道有先后，术业有专攻，如是而已","bbox":[687.097,649.751,313.811,15.308],"color":"#141414","fontSize":15.308,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0068","text":"《醉翁亭记》：醉翁之意不在酒，在乎山水之间也","bbox":[687.097,693.761,329.119,15.308],"color":"#141414","fontSize":15.308,"block":25,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0069","text":"《游褒禅山记》：世之奇伟、瑰怪，非常之观，常在","bbox":[687.097,737.771,344.427,15.308],"color":"#141414","fontSize":15.308,"block":26,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0070","text":"于险远，而人之所罕至焉，故非有志者不能至也","bbox":[687.097,760.733,321.465,15.308],"color":"#141414","fontSize":15.308,"block":27,"line":0,"emphasis":false,"role":"content"},{"id":"history-p024-n0071","text":"24","bbox":[587.275,810.711,16.0,21.344],"color":"#000000","fontSize":16.0,"block":28,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"history-p024-b0001","text":"第二章文学常识三、唐宋八大家","bbox":[93.12,364.872,289.415,17.221],"nodeIds":["history-p024-n0001","history-p024-n0002","history-p024-n0003"]},{"id":"history-p024-b0002","text":"唐宋八大家","bbox":[461.306,61.355,76.539,15.308],"nodeIds":["history-p024-n0004"]},{"id":"history-p024-b0003","text":"主持唐宋古文运动","bbox":[578.507,38.393,122.463,15.308],"nodeIds":["history-p024-n0005"]},{"id":"history-p024-b0004","text":"的中心人物","bbox":[601.469,61.355,76.539,15.308],"nodeIds":["history-p024-n0006"]},{"id":"history-p024-b0005","text":"唐二家（韩愈、柳宗元）","bbox":[741.631,39.35,168.387,15.308],"nodeIds":["history-p024-n0007","history-p024-n0008","history-p024-n0009"]},{"id":"history-p024-b0006","text":"宋六家（苏轼、苏洵、苏辙、欧阳修、曾巩、王安石）","bbox":[741.631,83.36,367.389,15.308],"nodeIds":["history-p024-n0010","history-p024-n0011","history-p024-n0012"]},{"id":"history-p024-b0007","text":"韩愈","bbox":[461.306,171.38,30.616,15.308],"nodeIds":["history-p024-n0013"]},{"id":"history-p024-b0008","text":"世称韩昌黎、昌黎先生，苏轼称韩愈“文起八代之衰”。与柳宗元并称“韩柳”","bbox":[528.278,121.64,500.641,21.038],"nodeIds":["history-p024-n0014","history-p024-n0015","history-p024-n0016","history-p024-n0017","history-p024-n0018","history-p024-n0019","history-p024-n0020","history-p024-n0021","history-p024-n0022","history-p024-n0023","history-p024-n0024"]},{"id":"h