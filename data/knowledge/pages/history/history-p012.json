.46,95.236,67.587,13.517],"color":"#141414","fontSize":13.517,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0011","text":"秦国","bbox":[558.151,95.236,27.035,13.517],"color":"#141414","fontSize":13.517,"block":3,"line":1,"emphasis":false,"role":"content"},{"id":"history-p012-n0012","text":"李冰","bbox":[585.186,95.236,27.035,13.517],"color":"#15831c","fontSize":13.517,"block":3,"line":1,"emphasis":true,"role":"content"},{"id":"history-p012-n0013","text":"主持修建的","bbox":[612.221,95.236,67.587,13.517],"color":"#141414","fontSize":13.517,"block":3,"line":1,"emphasis":false,"role":"content"},{"id":"history-p012-n0014","text":"都江堰","bbox":[679.808,95.236,40.552,13.517],"color":"#15831c","fontSize":13.517,"block":3,"line":1,"emphasis":true,"role":"content"},{"id":"history-p012-n0015","text":"、韩国水工郑国修建的","bbox":[720.36,95.236,135.174,13.517],"color":"#141414","fontSize":13.517,"block":3,"line":1,"emphasis":false,"role":"content"},{"id":"history-p012-n0016","text":"郑国渠","bbox":[855.534,95.236,40.552,13.517],"color":"#15831c","fontSize":13.517,"block":3,"line":1,"emphasis":true,"role":"content"},{"id":"history-p012-n0017","text":"③秦朝时期","bbox":[458.46,138.323,67.587,13.517],"color":"#141414","fontSize":13.517,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0018","text":"修建","bbox":[558.151,138.323,27.035,13.517],"color":"#141414","fontSize":13.517,"block":4,"line":1,"emphasis":false,"role":"content"},{"id":"history-p012-n0019","text":"灵渠","bbox":[585.186,138.323,27.035,13.517],"color":"#15831c","fontSize":13.517,"block":4,"line":1,"emphasis":true,"role":"content"},{"id":"history-p012-n0020","text":"，联接","bbox":[612.221,138.323,40.552,13.517],"color":"#141414","fontSize":13.517,"block":4,"line":1,"emphasis":false,"role":"content"},{"id":"history-p012-n0021","text":"长江、珠江","bbox":[652.773,138.323,67.587,13.517],"color":"#15831c","fontSize":13.517,"block":4,"line":1,"emphasis":true,"role":"content"},{"id":"history-p012-n0022","text":"两大水系，促使秦始皇统一岭南","bbox":[720.36,138.323,189.244,13.517],"color":"#141414","fontSize":13.517,"block":4,"line":1,"emphasis":false,"role":"content"},{"id":"history-p012-n0023","text":"④隋唐时期","bbox":[458.46,240.549,67.587,13.517],"color":"#141414","fontSize":13.517,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0024","text":"春秋时期，吴王夫差开凿了连接长江与淮河的邗沟，","bbox":[558.151,181.41,310.9,13.517],"color":"#141414","fontSize":13.517,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0025","text":"这是有确切纪年的中国大运河最早的河段","bbox":[558.151,201.686,243.313,13.517],"color":"#141414","fontSize":13.517,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0026","text":"隋朝时期，为加强都城洛阳与南方的联系，隋炀帝下令大规模开凿运河","bbox":[558.151,240.549,419.04,13.517],"color":"#141414","fontSize":13.517,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0027","text":"京杭大运河始凿于春秋时期吴王夫差开挖的","bbox":[558.151,279.411,256.831,13.517],"color":"#141414","fontSize":13.517,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0028","text":"邗沟，贯通于隋唐，取直于元朝","bbox":[814.982,279.411,189.244,13.761],"color":"#15831c","fontSize":13.517,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"history-p012-n0029","text":"⑤元朝时期","bbox":[458.46,337.705,67.587,13.517],"color":"#141414","fontSize":13.517,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0030","text":"为缩短航程，对运河进行了","bbox":[558.151,318.274,162.209,13.517],"color":"#141414","fontSize":13.517,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0031","text":"“","bbox":[720.36,313.279,4.677,13.517],"color":"#141414","fontSize":13.517,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0032","text":"裁弯取直","bbox":[725.046,318.274,54.07,13.517],"color":"#141414","fontSize":13.517,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0033","text":"”","bbox":[779.116,313.279,4.677,13.517],"color":"#141414","fontSize":13.517,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0034","text":"先后开凿了济州河、会通河、通惠河等新河道，使运河不再绕道洛阳","bbox":[558.151,357.136,405.522,13.517],"color":"#141414","fontSize":13.517,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0035","text":"【知识延伸】","bbox":[387.775,636.778,81.104,13.517],"color":"#e32c2d","fontSize":13.517,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"history-p012-n0036","text":"都江堰","bbox":[408.051,657.054,40.552,13.517],"color":"#e32c2d","fontSize":13.517,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"history-p012-n0037","text":"1.","bbox":[500.983,559.127,7.556,13.517],"color":"#141414","fontSize":13.517,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0038","text":"三大主体工程","bbox":[508.528,564.121,81.104,13.517],"color":"#141414","fontSize":13.517,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0039","text":"鱼嘴分水堤","bbox":[621.795,445.844,67.587,13.517],"color":"#141414","fontSize":13.517,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0040","text":"形如鱼头的堤坝将岷江一分为二，形成内江和外江","bbox":[721.486,395.999,297.383,13.517],"color":"#141414","fontSize":13.517,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0041","text":"它利用地形和水势，实现了","bbox":[721.486,416.275,162.209,13.517],"color":"#141414","fontSize":13.517,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0042","text":"“","bbox":[883.695,411.215,5.758,13.517],"color":"#141414","fontSize":13.517,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0043","text":"四六分水","bbox":[889.457,416.275,54.07,13.517],"color":"#141414","fontSize":13.517,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0044","text":"”","bbox":[943.527,411.215,5.758,13.517],"color":"#141414","fontSize":13.517,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0045","text":"的动态平衡","bbox":[949.289,416.275,67.587,13.517],"color":"#141414","fontSize":13.517,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0046","text":"枯水期，约六成江水流入内江，保证灌溉","bbox":[721.486,455.137,243.313,13.517],"color":"#141414","fontSize":13.517,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0047","text":"洪水期，约六成江水排入外江，实现泄洪","bbox":[721.486,475.413,243.313,13.517],"color":"#141414","fontSize":13.517,"block":19,"line":1,"emphasis":false,"role":"content"},{"id":"history-p012-n0048","text":"飞沙堰溢洪道","bbox":[621.795,564.121,81.104,13.517],"color":"#141414","fontSize":13.517,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0049","text":"作为内江的","bbox":[735.004,514.276,67.587,13.517],"color":"#141414","fontSize":13.517,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0050","text":"“","bbox":[802.591,509.282,4.677,13.517],"color":"#141414","fontSize":13.517,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0051","text":"安全阀","bbox":[807.27,514.276,40.552,13.517],"color":"#141414","fontSize":13.517,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0052","text":"”","bbox":[847.823,509.282,4.677,13.517],"color":"#141414","fontSize":13.517,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0053","text":"，当水量过大时，多余","bbox":[852.502,514.276,135.174,13.517],"color":"#141414","fontSize":13.517,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0054","text":"的水会漫过这道低矮的堰坝，排入外江","bbox":[735.004,534.552,229.796,13.517],"color":"#141414","fontSize":13.517,"block":22,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0055","text":"利用水流在弯道产生的离心力，形成漩涡，能将内江","bbox":[735.004,573.415,310.9,13.517],"color":"#141414","fontSize":13.517,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0056","text":"80%","bbox":[735.004,588.696,26.859,13.517],"color":"#141414","fontSize":13.517,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0057","text":"以上的泥沙和卵石","bbox":[761.86,593.691,108.139,13.517],"color":"#141414","fontSize":13.517,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0058","text":"“","bbox":[870.0,588.696,4.677,13.517],"color":"#141414","fontSize":13.517,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0059","text":"甩","bbox":[874.679,593.691,13.517,13.517],"color":"#141414","fontSize":13.517,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0060","text":"”","bbox":[888.196,588.696,4.677,13.517],"color":"#141414","fontSize":13.517,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0061","text":"出，有效防止了渠道淤积","bbox":[892.876,593.691,148.692,13.517],"color":"#141414","fontSize":13.517,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0062","text":"宝瓶口引水口","bbox":[621.795,672.261,81.104,13.517],"color":"#141414","fontSize":13.517,"block":25,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0063","text":"人工在玉垒山凿开的一个形似瓶口的狭","bbox":[735.004,632.553,229.796,13.517],"color":"#141414","fontSize":13.517,"block":26,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0064","text":"窄通道，是内江水进入成都平原的咽喉","bbox":[735.004,652.829,229.796,13.517],"color":"#141414","fontSize":13.517,"block":27,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0065","text":"像一道天然闸门，精确控制进入灌区的水量，确保平原地区用水平稳","bbox":[735.004,691.692,405.522,13.517],"color":"#141414","fontSize":13.517,"block":28,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0066","text":"2.","bbox":[500.983,744.991,9.935,13.517],"color":"#141414","fontSize":13.517,"block":29,"line":0,"emphasis":false,"role":"content"},{"id":"history-p012-n0067","text":"历史地位","bbox":[510.917,749.986,54.07,13.517],"color"