":"#141414","fontSize":14.751,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0046","text":"年","bbox":[620.893,287.381,14.751,14.751],"color":"#141414","fontSize":14.751,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0047","text":"1","bbox":[635.644,281.93,13.482,14.751],"color":"#141414","fontSize":14.751,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0048","text":"月，中国人民解放军同国民党军队进行的战略决战","bbox":[649.113,287.381,324.529,14.751],"color":"#141414","fontSize":14.751,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0049","text":"包括","bbox":[488.876,329.79,29.502,14.751],"color":"#141414","fontSize":14.751,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0050","text":"辽沈战役、淮海战役、平津战役","bbox":[518.378,329.79,206.514,14.751],"color":"#8e24aa","fontSize":14.751,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"history-p021-n0051","text":"三场战略性战役","bbox":[724.892,329.79,103.257,14.751],"color":"#141414","fontSize":14.751,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0052","text":"5.","bbox":[382.853,441.354,11.403,14.751],"color":"#ff6f00","fontSize":14.751,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"history-p021-n0053","text":"七届二中全会","bbox":[394.255,446.875,88.506,14.751],"color":"#ff6f00","fontSize":14.751,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"history-p021-n0054","text":"1949","bbox":[518.378,366.748,34.244,14.751],"color":"#141414","fontSize":14.751,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0055","text":"年","bbox":[552.605,372.199,14.751,14.751],"color":"#141414","fontSize":14.751,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0056","text":"3","bbox":[567.356,366.748,15.592,14.751],"color":"#141414","fontSize":14.751,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0057","text":"月，在河北省","bbox":[582.935,372.199,88.506,14.751],"color":"#141414","fontSize":14.751,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0058","text":"西柏坡","bbox":[671.448,372.199,44.253,14.751],"color":"#ff6f00","fontSize":14.751,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"history-p021-n0059","text":"召开","bbox":[715.701,372.199,29.502,14.751],"color":"#141414","fontSize":14.751,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0060","text":"会议讨论和决定的主要问题","bbox":[518.378,521.552,177.012,14.751],"color":"#141414","fontSize":14.751,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0061","text":"一是确定了彻底推翻国民党统治，夺取全国的方针","bbox":[733.189,414.608,324.522,14.751],"color":"#141414","fontSize":14.751,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0062","text":"二是指出工作重心应从农村转向城市，并以生产建设为中心","bbox":[733.189,457.017,383.526,14.751],"color":"#141414","fontSize":14.751,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0063","text":"三是阐述了在全国胜利后仍会存在两种基本矛盾，一种是无产","bbox":[733.189,499.426,398.276,14.751],"color":"#141414","fontSize":14.751,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0064","text":"阶级同资产阶级的矛盾，一种是中国人民和帝国主义的矛盾","bbox":[733.189,521.552,383.526,14.751],"color":"#141414","fontSize":14.751,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0065","text":"同时告诫全党在革命胜利后要警惕资产阶级","bbox":[733.189,563.961,280.268,14.751],"color":"#141414","fontSize":14.751,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0066","text":"“","bbox":[1013.458,558.44,6.284,14.751],"color":"#ff6f00","fontSize":14.751,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"history-p021-n0067","text":"糖衣炮弹","bbox":[1019.746,563.961,59.004,14.751],"color":"#ff6f00","fontSize":14.751,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"history-p021-n0068","text":"”","bbox":[1078.75,558.44,6.284,14.751],"color":"#ff6f00","fontSize":14.751,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"history-p021-n0069","text":"的袭击","bbox":[1085.037,563.961,44.253,14.751],"color":"#141414","fontSize":14.751,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0070","text":"务必继续地保持","bbox":[733.189,606.37,103.257,14.751],"color":"#141414","fontSize":14.751,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0071","text":"谦虚、谨慎、不骄、不躁","bbox":[836.446,606.37,162.261,14.751],"color":"#ff6f00","fontSize":14.751,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"history-p021-n0072","text":"和","bbox":[998.707,606.37,14.751,14.751],"color":"#141414","fontSize":14.751,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0073","text":"艰苦奋斗","bbox":[1013.458,606.37,59.004,14.751],"color":"#ff6f00","fontSize":14.751,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"history-p021-n0074","text":"的作风","bbox":[1072.462,606.37,44.253,14.751],"color":"#141414","fontSize":14.751,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0075","text":"6.","bbox":[382.853,664.462,11.609,14.751],"color":"#19a719","fontSize":14.751,"block":22,"line":0,"emphasis":true,"role":"content"},{"id":"history-p021-n0076","text":"渡江战役","bbox":[394.464,669.984,59.004,14.751],"color":"#19a719","fontSize":14.751,"block":22,"line":0,"emphasis":true,"role":"content"},{"id":"history-p021-n0077","text":"1949","bbox":[488.876,643.329,34.244,14.751],"color":"#141414","fontSize":14.751,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0078","text":"年","bbox":[523.103,648.779,14.751,14.751],"color":"#141414","fontSize":14.751,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"history-p021-n0079","text":"4","bbox":[537.854,643.329,16.536,14.751],"color":"#141414","fontSize":14.751,"block":23,"line":0,"emphasis":false,"role":"cont