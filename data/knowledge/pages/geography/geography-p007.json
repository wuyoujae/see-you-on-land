ize":14.507,"block":28,"line":0,"emphasis":false,"role":"content"},{"id":"geography-p007-n0102","text":"100","bbox":[826.686,766.158,29.537,14.507],"color":"#141414","fontSize":14.507,"block":28,"line":0,"emphasis":false,"role":"content"},{"id":"geography-p007-n0103","text":"毫米以上且降雨可能持续","bbox":[856.211,771.518,159.581,14.507],"color":"#141414","fontSize":14.507,"block":28,"line":0,"emphasis":false,"role":"content"},{"id":"geography-p007-n0104","text":"7","bbox":[591.275,810.711,8.0,21.344],"color":"#000000","fontSize":16.0,"block":29,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"geography-p007-b0001","text":"四、降水的类型","bbox":[80.918,344.506,114.245,16.321],"nodeIds":["geography-p007-n0001"]},{"id":"geography-p007-b0002","text":"对流雨","bbox":[285.683,85.14,43.522,14.507],"nodeIds":["geography-p007-n0002"]},{"id":"geography-p007-b0003","text":"对流雨，也叫热雷雨，是近地面空气局部受热或高层空气强烈降温，导致上下层空气发生对流，使低层空气上升，水汽在高空冷却、凝结而形成的雨","bbox":[363.66,31.644,478.742,36.268],"nodeIds":["geography-p007-n0003","geography-p007-n0004"]},{"id":"geography-p007-b0004","text":"强烈的对流雨常伴有强风、雷电、冰雹或龙卷，但雨时较短，雨区范围也较小，","bbox":[363.66,95.113,507.756,14.507],"nodeIds":["geography-p007-n0005","geography-p007-n0006","geography-p007-n0007","geography-p007-n0008","geography-p007-n0009","geography-p007-n0010","geography-p007-n0011"]},{"id":"geography-p007-b0005","text":"或呈不连续的条块分布。多发生在夏季酷热的午后。赤道地带全年以对流雨为主","bbox":[363.66,116.875,507.757,14.507],"nodeIds":["geography-p007-n0012","geography-p007-n0013","geography-p007-n0014","geography-p007-n0015"]},{"id":"geography-p007-b0006","text":"地形雨","bbox":[285.683,178.531,43.522,14.507],"nodeIds":["geography-p007-n0016"]},{"id":"geography-p007-b0007","text":"当潮湿的气团前进时，遇到高山阻挡，气流被迫缓慢上升，引起绝热降温，发生凝结而形成的降水。地形雨多降在迎风面的山坡（迎风坡）上，背风坡面则因空气下沉引起绝热增温，反使云量消减，降雨减少","bbox":[363.66,156.77,681.845,36.268],"nodeIds":["geography-p007-n0017","geography-p007-n0018","geography-p007-n0019","geography-p007-n0020"]},{"id":"geography-p007-b0008","text":"锋面雨","bbox":[285.683,264.668,43.522,14.507],"nodeIds":["geography-p007-n0021"]},{"id":"geography-p007-b0009","text":"冷、暖两种性质不同的气团相遇时，暖湿空气被抬升，在高空冷却凝结而形成的降水","bbox":[363.66,222.959,536.772,14.507],"nodeIds":["geography-p007-n0022"]},{"id":"geography-p007-b0010","text":"雨势通常比较和缓。降水区域呈带状分布，水平范围很大","bbox":[363.66,264.668,362.683,14.507],"nodeIds":["geography-p007-n0023","geography-p007-n0024","geography-p007-n0025","geography-p007-n0026"]},{"id":"geography-p007-b0011","text":"降雨持续时间较长，短则几天，长则半个月以上。常见的有梅雨、春雨等","bbox":[363.66,306.377,464.234,14.507],"nodeIds":["geography-p007-n0027","geography-p007-n0028","geography-p007-n0029","geography-p007-n0030","geography-p007-n0031"]},{"id":"geography-p007-b0012","text":"台风雨","bbox":[285.683,367.126,43.522,14.507],"nodeIds":["geography-p007-n0032"]},{"id":"geography-p007-b0013","text":"是由热带气旋(台风或飓风)带来的降水，降水主要集中在台风眼周围的“云墙区”，这里上升气流最强，降雨最猛烈","bbox":[363.66,340.912,715.677,19.867],"nodeIds":["geography-p007-n0033","geography-p007-n0034","geography-p007-n0035","geography-p007-n0036","geography-p007-n0037","geography-p007-n0038","geography-p007-n0039","geography-p007-n0040","geography-p007-n0041","geography-p007-n0042"]},{"id":"geography-p007-b0014","text":"而台风眼内部气流下沉，通常是晴朗无风的，主要影响热带、亚热带沿海地区，多发生在夏秋季节","bbox":[363.66,387.98,623.816,14.507],"nodeIds":["geography-p007-n0043","geography-p007-n0044","geography-p007-n0045","geography-p007-n0046","geography-p007-n0047"]},{"id":"geography-p007-b0015","text":"【知识延伸】","bbox":[257.273,570.796,87.044,14.507],"nodeIds":["geography-p007-n0048"]},{"id":"geography-p007-b0016","text":"梅雨","bbox":[378.772,479.558,29.015,14.507],"nodeIds":["geography-p007-n0049"]},{"id":"geography-p007-b0017","text":"是在每年6、7月份的东南季风带来的太平洋暖湿气流","bbox":[442.241,432.419,342.92,19.937],"nodeIds":["geography-p007-n0050","geography-p007-n0051","geography-p007-n0052","geography-p007-n0053","geography-p007-n0054","geography-p007-n0055","geography-p007-n0056"]},{"id":"geography-p007-b0018","text":"经过中国长江中下游地区、中国台湾地区、日本中南部以及韩国南部等地出现的持续天阴有雨的气候现象","bbox":[442.241,479.558,667.337,14.507],"nodeIds":["geography-p007-n0057","geography-p007-n0058","geography-p007-n0059"]},{"id":"geography-p007-b0019","text":"由于正是江南梅子的成熟期，故称其为“梅雨”","bbox":[442.241,515.906,285.682,19.868],"nodeIds":["geography-p007-n0060","geography-p007-n0061","geography-p007-n0062","geography-p007-n0063"]},{"id":"geography-p007-b0020","text":"暴雨","bbox":[378.772,662.033,29.015,14.507],"nodeIds":["geography-p007-n0064"]},{"id":"geography-p007-b0021","text":"1.等级划分","bbox":[442.241,599.324,66.126,19.867],"nodeIds":["geography-p007-n0065","geography-p007-n0066"]},{"id":"geography-p007-b0022","text":"暴雨：24小时降水量为50-99.9毫米","bbox":[542.886,557.615,223.412,19.867],"nodeIds":["geography-p007-n0067","geography-p007-n0068","geography-p007-n0069","geography-p007-n0070","geography-p007-n0071"]},{"id":"geography-p007-b0023","text":"大暴雨：24小时降水量为100-249.9毫米","bbox":[542.886,599.324,252.937,19.867],"nodeIds":["geography-p007-n0072","geography-p007-n0073","geography-p007-n0074","geography-p007-n0075","geography-p007-n0076"]},{"id":"geography-p007-b0024","text":"特大暴雨：24小时降水量为250毫米以上","bbox":[542.886,641.032,262.329,19.867],"nodeIds":["geography-p007-n0077","geography-p007-n0078","geography-p007-n0079","geography-p007-n0080","geography-p007-n0081"]},{"id":"geography-p007-b0025","text":"2.预警信号","bbox":[442.241,714.022,68.69,19.867],"nodeIds":["geography-p007-n0082","geography-p007-n0083"]},{"id":"geography-p007-b0026","text":"暴雨预警信号分为蓝色、黄色、橙色、红色四级","bbox":[545.606,688.101,304.654,14.507],"nodeIds":["geography-p007-n0084","geography-p007-n0085","geography-p007-n0086","geography-p007-n0087","geography-p007-n0088","geography-p007-n0089","geography-p007-n0090","geography-p007-n0091","geography-p007-n0092"]},{"id":"geography-p007-b0027","text":"红色暴雨预警信号为最高级","bbox":[545.606,750.664,174.088,14.507],"nodeIds":["geography-p007-n0093","geography-p007-n0094","geography-p007-n0095"]},{"id":"geography-p007-b0028","text":"表示3小时内降雨量达到100毫米以上","bbox":[754.149,724.449,247.949,19.867],"nodeIds":["geography-p007-n0096","geography-p007-n0097","geography-p007-n0098","geography-p007-n0099","geography-p007-n0100"]},{"id":"geography-p007-b0029","text":"或者已达到100毫米以上且降雨可能持续","bbox":[754.149,766.158,261.643,19.867],"nodeIds":["geography-p007-n0101","geography-p007-n0102","geography-p007-n0103"]},{"id":"geography-p007-b0030","text":"7","bbox":[591.275,810.711,8.0,21.344],"nodeIds":["geography-p007-n0104"]}],"questions":[{"id":"geography-p007-q001","number":1,"type":"fill-in","answer":"对流雨","bbox":[285.683,85.14,43.522,14.507],"fontSize":14.507,"color":"#e32c2d","segments":[{"text":"对流雨","bbox":[285.683,85.14,43.522,14.507],"color":"#e32c2d"}],"nodeIds":["geography-p007-n0002"],"aliases":[],"context":"____"},{"id":"geography-p007-q002","number":2,"type":"fill-in","answer":"强风、雷电、冰雹或龙卷","bbox":[494.226,95.113,159.581,14.507],"fontSize":14.507,"color":"#e32c2d","segments":[{"text":"强风、雷电、冰雹或龙卷","bbox":[494.226,95.113,159.581,14.507],"color":"#e32c2d"}],"nodeIds":["geography-p007-n0006"],"aliases":[],"context":"强烈的对流雨常伴有____，但____，雨区____，"},{"id":"geography-p007-q003","number":3,"type":"fill-in","answer":"雨时较短","bbox":[682.821,95.113,58.029,14.507],"fontSize":14.507,"color":"#e53935","segments":[{"text":"雨时较短","bbox":[682.821,95.113,58.029,14.507],"color":"#e53935"}],"nodeIds":["geography-p007-n0008"],"aliases":[],"context":"强烈的对流雨常伴有____，但____，雨区____，"},{"id":"geography-p007-q004","number":4,"type":"fill-in","answer":"范围也较小","bbox":[784.373,95.113,72.537,14.507],"fontSize":14.507,"color":"#e53935","segments":[{"text":"范围也较小","bbox":[784.373,95.113,72.537,14.507],"color":"#e53935"}],"nodeIds":["geography-p007-n0010"],"aliases":[],"context":"强烈的对流雨常伴有____，但____，雨区____，"},{"id":"geography-p007-q005","number":5,"type":"fill-in","answer":"夏季","bbox":[581.27,116.875,29.015,14.507],"fontSize":14.507,"color":"#e32c2d","segments":[{"text":"夏季","bbox":[581.27,116.875,29.015,14.507],"color":"#e32c2d"}],"nodeIds":["geography-p007-n0013"],"aliases":[],"context":"或呈不连续的条块分布。多发生在____酷热的午后。__