itics-2-p019-n0048"]},{"id":"politics-2-p019-b0015","text":"9.要完善公共安全体系，推动公共安全治理模式向事前预防转型","bbox":[451.028,667.633,446.998,22.159],"nodeIds":["politics-2-p019-n0049","politics-2-p019-n0050","politics-2-p019-n0051","politics-2-p019-n0052"]},{"id":"politics-2-p019-b0016","text":"10.每年4月15日是全民国家安全教育日","bbox":[451.028,714.073,288.133,22.237],"nodeIds":["politics-2-p019-n0053","politics-2-p019-n0054","politics-2-p019-n0055","politics-2-p019-n0056","politics-2-p019-n0057","politics-2-p019-n0058","politics-2-p019-n0059","politics-2-p019-n0060"]},{"id":"politics-2-p019-b0017","text":"19","bbox":[589.275,810.923,12.0,16.008],"nodeIds":["politics-2-p019-n0061"]}],"questions":[{"id":"politics-2-p019-q001","number":1,"type":"fill-in","answer":"总体国家安全观","bbox":[460.066,89.096,113.262,16.18],"fontSize":16.18,"color":"#e32c2d","segments":[{"text":"总体国家安全观","bbox":[460.066,89.096,113.262,16.18],"color":"#e32c2d"}],"nodeIds":["politics-2-p019-n0006"],"aliases":[],"context":"1.____是建国以来首个被确立为国家安全工作指导思想的战略思想"},{"id":"politics-2-p019-q002","number":2,"type":"fill-in","answer":"国家利益","bbox":[874.751,135.615,64.721,16.18],"fontSize":16.18,"color":"#8e24aa","segments":[{"text":"国家利益","bbox":[874.751,135.615,64.721,16.18],"color":"#8e24aa"}],"nodeIds":["politics-2-p019-n0011"],"aliases":[],"context":"以____为准则，以____为根本"},{"id":"politics-2-p019-q003","number":3,"type":"fill-in","answer":"政治安全","bbox":[1020.374,135.615,64.722,16.18],"fontSize":16.18,"color":"#8e24aa","segments":[{"text":"政治安全","bbox":[1020.374,135.615,64.722,16.18],"color":"#8e24aa"}],"nodeIds":["politics-2-p019-n0013"],"aliases":[],"context":"以____为准则，以____为根本"},{"id":"politics-2-p019-q004","number":4,"type":"fill-in","answer":"经济安全","bbox":[874.751,182.133,64.721,16.18],"fontSize":16.18,"color":"#8e24aa","segments":[{"text":"经济安全","bbox":[874.751,182.133,64.721,16.18],"color":"#8e24aa"}],"nodeIds":["politics-2-p019-n0016"],"aliases":[],"context":"以____为基础，以____为宗旨"},{"id":"politics-2-p019-q005","number":5,"type":"fill-in","