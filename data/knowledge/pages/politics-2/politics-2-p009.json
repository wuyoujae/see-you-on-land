ontent"},{"id":"politics-2-p009-n0010","text":"就业","bbox":[522.38,94.892,26.245,13.122],"color":"#000000","fontSize":13.122,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0011","text":"是民生之本，","bbox":[548.631,94.892,78.735,13.122],"color":"#141414","fontSize":13.122,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0012","text":"最基本的民生","bbox":[627.366,94.892,78.735,13.122],"color":"#8e24aa","fontSize":13.122,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0013","text":"，是","bbox":[706.1,94.892,26.245,13.122],"color":"#141414","fontSize":13.122,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0014","text":"最大的","bbox":[732.345,94.892,39.367,13.122],"color":"#8e24aa","fontSize":13.122,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0015","text":"民生工程、民心工程、根基工程","bbox":[771.713,94.892,183.714,13.122],"color":"#141414","fontSize":13.122,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0016","text":"2.","bbox":[515.056,127.77,9.645,13.122],"color":"#141414","fontSize":13.122,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0017","text":"促进高质量充分就业，是新时代新征程就业工作的新定位、新使命","bbox":[524.699,132.619,380.557,13.122],"color":"#141414","fontSize":13.122,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0018","text":"3.","bbox":[515.056,165.497,9.212,13.122],"color":"#141414","fontSize":13.122,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0019","text":"促进高质量充分就业以","bbox":[524.257,170.346,131.224,13.122],"color":"#141414","fontSize":13.122,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0020","text":"破解结构性就业矛盾","bbox":[655.482,170.346,118.102,13.122],"color":"#8e24aa","fontSize":13.122,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0021","text":"为着力点","bbox":[773.583,170.346,52.49,13.122],"color":"#141414","fontSize":13.122,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0022","text":"4.","bbox":[515.056,203.225,10.052,13.122],"color":"#141414","fontSize":13.122,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0023","text":"全面贯彻劳动者自主就业、市场调节就业、政府促进就业和鼓励创业的方针，","bbox":[525.096,208.073,446.169,13.122],"color":"#141414","fontSize":13.122,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0024","text":"以推动高质量发展为基础，以实施就业优先战略为引领，以强化就业优先政策为抓","bbox":[515.056,227.757,472.408,13.122],"color":"#141414","fontSize":13.122,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0025","text":"手，以深化就业体制机制改革为动力，持续促进就业质的有效提升和量的合理增长","bbox":[515.056,247.44,472.408,13.122],"color":"#141414","fontSize":13.122,"block":6,"line":2,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0026","text":"二、完善分配制度","bbox":[352.666,398.348,104.979,13.122],"color":"#141414","fontSize":13.122,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0027","text":"收入分配","bbox":[514.509,285.167,52.49,13.122],"color":"#ff6f00","fontSize":13.122,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0028","text":"是","bbox":[566.999,285.167,13.122,13.122],"color":"#141414","fontSize":13.122,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0029","text":"民生之源。分配制度","bbox":[580.121,285.167,118.102,13.122],"color":"#ff6f00","fontSize":13.122,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0030","text":"是促进","bbox":[698.223,285.167,39.367,13.122],"color":"#141414","fontSize":13.122,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0031","text":"共同富裕","bbox":[737.591,285.167,52.49,13.122],"color":"#ff6f00","fontSize":13.122,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0032","text":"的","bbox":[790.081,285.167,13.122,13.122],"color":"#141414","fontSize":13.122,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0033","text":"基础性制度","bbox":[803.203,285.167,65.612,13.122],"color":"#ff6f00","fontSize":13.122,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0034","text":"构建","bbox":[514.509,341.758,26.245,13.122],"color":"#141414","fontSize":13.122,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0035","text":"初次分配、再分配、第三次分配","bbox":[540.754,341.758,183.714,13.122],"color":"#ff6f00","fontSize":13.122,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0036","text":"协调配套的制度体系","bbox":[724.468,341.758,118.102,13.122],"color":"#141414","fontSize":13.122,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0037","text":"提高居民收入在国民收入分配中的比重","bbox":[876.743,322.894,223.082,13.122],"color":"#141414","fontSize":13.122,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0038","text":"提高劳动报酬在初次分配中的比重","bbox":[876.743,360.621,196.837,13.122],"color":"#141414","fontSize":13.122,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0039","text":"健全各类要素由市场评价贡献、按贡献决定报酬的初次分配机制，促进多劳者多得、技高者多得、创新者多得","bbox":[514.509,398.348,629.878,13.122],"color":"#141414","fontSize":13.122,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0040","text":"加强税收、社会保障、转移支付等再分配调节，优化收入分配格局","bbox":[514.509,436.075,380.551,13.122],"color":"#141414","fontSize":13.122,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0041","text":"多渠道增加城乡居民财产性收入，形成有效增加低收入群体收入、","bbox":[514.509,473.802,380.551,13.122],"color":"#141414","fontSize":13.122,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0042","text":"稳步扩大中等收入群体规模、合理调节过高收入的制度体系","bbox":[514.509,493.486,341.184,13.122],"color":"#141414","fontSize":13.122,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0043","text":"三、健全社会保障体系","bbox":[352.666,578.372,131.224,13.122],"color":"#141414","fontSize":13.122,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0044","text":"社会保障体系","bbox":[540.754,531.213,78.735,13.122],"color":"#1e88e5","fontSize":13.122,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0045","text":"是人民生活的","bbox":[619.489,531.213,78.734,13.122],"color":"#141414","fontSize":13.122,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0046","text":"安全网","bbox":[698.223,531.213,39.367,13.122],"color":"#1e88e5","fontSize":13.122,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0047","text":"和社会运行的","bbox":[737.591,531.213,78.735,13.122],"color":"#141414","fontSize":13.122,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0048","text":"稳定器","bbox":[816.325,531.213,39.367,13.122],"color":"#1e88e5","fontSize":13.122,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0049","text":"社会保障制度包括：","bbox":[542.258,586.163,118.102,13.122],"color":"#141414","fontSize":13.122,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0050","text":"社会","bbox":[660.359,586.163,26.245,13.122],"color":"#1e88e5","fontSize":13.122,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0051","text":"保险、社会福利、社会救","bbox":[542.258,605.847,144.347,13.122],"color":"#1e88e5","fontSize":13.122,"block":18,"line":1,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0052","text":"济、社会优抚与安置","bbox":[555.38,625.531,118.102,13.122],"color":"#1e88e5","fontSize":13.122,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0053","text":"①","bbox":[719.274,568.94,13.122,13.122],"color":"#141414","fontSize":13.122,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0054","text":"社会保险","bbox":[732.396,568.94,52.49,13.122],"color":"#19a719","fontSize":13.122,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0055","text":"是社会保障制度的","bbox":[784.886,568.94,104.979,13.122],"color":"#141414","fontSize":13.122,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0056","text":"核心内容","bbox":[889.866,568.94,52.49,13.122],"color":"#19a719","fontSize":13.122,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0057","text":"，是社会保障体系中的基本纲领","bbox":[942.355,568.94,183.714,13.122],"color":"#141414","fontSize":13.122,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0058","text":"②","bbox":[719.274,606.667,13.122,13.122],"color":"#141414","fontSize":13.122,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0059","text":"社会福利","bbox":[732.396,606.667,52.49,13.122],"color":"#e32c2d","fontSize":13.122,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0060","text":"属于","bbox":[784.886,606.667,26.245,13.122],"color":"#141414","fontSize":13.122,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0061","text":"最高层次","bbox":[811.131,606.667,52.49,13.122],"color":"#e32c2d","fontSize":13.122,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0062","text":"的社会保障措施","bbox":[863.621,606.667,91.857,13.122],"color":"#141414","fontSize":13.122,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0063","text":"③","bbox":[719.274,644.394,13.122,13.122],"color":"#141414","fontSize":13.122,"block":22,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0064","text":"社会救济","bbox":[732.396,644.394,52.49,13.122],"color":"#ce4289","fontSize":13.122,"block":22,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0065","text":"属于","bbox":[784.886,644.394,26.245,13.122],"color":"#141414","fontSize":13.122,"block":22,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0066","text":"最低层次","bbox":[811.131,644.394,52.49,13.122],"color":"#ce4289","fontSize":13.122,"block":22,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0067","text":"的社会保障措施","bbox":[863.621,644.394,91.857,13.122],"color":"#141414","fontSize":13.122,"block":22,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0068","text":"④社会优抚是国家和社会对法定的对象给予抚恤和优待的保障制度","bbox":[719.274,682.121,380.551,13.122],"color":"#141414","fontSize":13.122,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0069","text":"四、推进健康中国建设","bbox":[352.666,738.712,131.224,13.122],"color":"#141414","fontSize":13.122,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0070","text":"人民健康","bbox":[540.754,719.848,52.49,13.122],"color":"#e32c2d","fontSize":13.122,"block":25,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0071","text":"是社会文明进步的基础，是民族昌盛和国家富强的","bbox":[593.244,719.848,288.694,13.122],"color":"#141414","fontSize":13.122,"block":25,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0072","text":"重要标志","bbox":[881.938,719.848,52.49,13.122],"color":"#e32c2d","fontSize":13.122,"block":25,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0073","text":"坚持","bbox":[540.754,757.575,26.245,13.122],"color":"#141414","fontSize":13.122,"block":26,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0074","text":"预防为主","bbox":[566.999,757.575,52.49,13.122],"color":"#e32c2d","fontSize":13.122,"block":26,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p009-n0075","text":"的方针，深入实施健康中国行动","bbox":[619.489,757.575,183.714,13.122],"color":"#141414","fontSize":13.122,"block":26,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p009-n0076","text":"9","bbox":[592.275,810.923,6.0,16.008],"color":"#000000","fontSize":12.0,"block":27,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"politics-2-p009-b0001","text":"第二章分论第六节保障和改善民生","bbox":[57.821,413.308,261.302,14.763],"nodeIds":["politics-2-p009-n0001","politics-2-p009-n0002","politics-2-p009-n0003","politics-2-p009-n0004"]},{"id":"politics-2-p009-b0002","text":"为民造福是立D为公、执政为民的本质要求，要把增进民生福祉作为发展的根本目的","bbox":[352.666,52.316,481.275,17.971],"nodeIds":["politics-2-p009-n0005","politics-2-p009-n0006","politics-2-p009-n0007"]},{"id":"politics-2-p009-b0003","text":"一、实施就业优先战略","bbox":[352.666,170.346,131.224,13.122],"nodeIds":["politics-2-p009-n0008"]},{"id":"politics-2-p009-b0004","text":"1.就业是民生之本，最基本的民生，是最大的民生工程、民心工程、根基工程","bbox":[515.056,90.043,440.371,17.971],"nodeIds":["politics-2-p009-n0009","politics-2-p009-n0010","politics-2-p009-n0011","politics-2-p009-n0012","politics-2-p009-n0013","politics-2-p009-n0014","politics-2-p009-n0015"]},{"id":"politics-2-p009-b0005","text":"2.促进高质量充分就业，是新时代新征程就业工作的新定位、新使命","bbox":[515.056,127.77,390.2,17.971],"nodeIds":["politics-2-p009-n0016","politics-2-p009-n0017"]},{"id":"politics-2-p009-b0006","text":"3.促进高质量充分就业以破解结构性就业矛盾为着力点","bbox":[515.056,165.497,311.017,17.971],"nodeIds":["politics-2-p009-n0018","politics-2-p009-n0019","politics-2-p009-n0020","politics-2-p009-n0021"]},{"id":"politics-2-p009-b0007","text":"4.全面贯彻劳动者自主就业、市场调节就业、政府促进就业和鼓励创业的方针，以推动高质量发展为基础，以实施就业优先战略为引领，以强化就业优先政策为抓手，以深化就业体制机制改革为动力，持续促进就业质的有效提升和量的合理增长","bbox":[515.056,203.225,472.408,57.337],"nodeIds":["politics-2-p009-n0022","politics-2-p009-n0023","politics-2-p009-n0024","politics-2-p009-n0025"]},{"id":"politics-2-p009-b0008","text":"二、完善分配制度","bbox":[352.666,398.348,104.979,13.122],"nodeIds":["politics-2-p009-n0026"]},{"id":"politics-2-p009-b0009","text":"收入分配是民生之源。分配制度是促进共同富裕的基础性制度","bbox":[514.509,285.167,354.306,13.122],"nodeIds":["politics-2-p009-n0027","politics-2-p009-n0028","politics-2-p009-n0029","politics-2-p009-n0030","politics-2-p009-n0031","politics-2-p009-n0032","politics-2-p009-n0033"]},{"id":"politics-2-p009-b0010","text":"构建初次分配、再分配、第三次分配协调配套的制度体系","bbox":[514.509,341.758,328.061,13.122],"nodeIds":["politics-2-p009-n0034","politics-2-p009-n0035","politics-2-p009-n0036"]},{"id":"politics-2-p009-b0011","text":"提高居民收入在国民收入分配中的比重","bbox":[876.743,322.894,223.082,13.122],"nodeIds":["politics-2-p009-n0037"]},{"id":"politics-2-p009-b0012","text":"提高劳动报酬在初次分配中的比重","bbox":[876.743,360.621,196.837,13.122],"nodeIds":["politics-2-p009-n0038"]},{"id":"politics-2-p009-b0013","text":"健全各类要素由市场评价贡献、按贡献决定报酬的初次分配机制，促进多劳者多得、技高者多得、创新者多得","bbox":[514.509,398.348,629.878,13.122],"nodeIds":["politics-2-p009-n0039"]},{"id":"politics-2-p009-b0014","text":"加强税收、社会保障、转移支付等再分配调节，优化收入分配格局","bbox":[514.509,436.075,380.551,13.122],"nodeIds":["politics-2-p009-n0040"]},{"id":"politics-2-p009-b0015","text":"多渠道增加城乡居民财产性收入，形成有效增加低收入群体收入、","bbox":[514.509,473.802,380.551,13.122],"nodeIds":["politics-2-p009-n0041"]},{"id":"politics-2-p009-b0016","text":"稳步扩大中等收入群体规模、合理调节过高收入的制度体系","bbox":[514.509,493.486,341.184,13.122],"nodeIds":["politics-2-p009-n0042"]},{"id":"politics-2-p009-b0017","text":"三、健全社会保障体系","bbox":[352.666,578.372,131.224,13.122],"nodeIds":["politics-2-p009-n0043"]},{"id":"politics-2-p009-b0018","text":"社会保障体系是人民生活的安全网和社会运行的稳定器","bbox":[540.754,531.213,314.938,13.122],"nodeIds":["politics-2-p009-n0044","politics-2-p009-n0045","politics-2-p009-n0046","politics-2-p009-n0047","politics-2-p009-n0048"]},{"id":"politics-2-p009-b0019","text":"社会保障制度包括：社会保险、社会福利、社会救","bbox":[542.258,586.163,144.347,32.806],"nodeIds":["politics-2-p009-n0049","politics-2-p009-n0050","politics-2-p009-n0051"]},{"id":"politics-2-p009-b0020","text":"济、社会优抚与安置","bbox":[555.38,625.531,118.102,13.122],"nodeIds":["politics-2-p009-n0052"]},{"id":"politics-2-p009-b0021","text":"①社会保险是社会保障制度的核心内容，是社会保障体系中的基本纲领","bbox":[719.274,568.94,406.795,13.122],"nodeIds":["politics-2-p009-n0053","politics-2-p009-n0054","politics-2-p009-n0055","politics-2-p009-n0056","politics-2-p009-n0057"]},{"id":"politics-2-p009-b0022","text":"②社会福利属于最高层次的社会保障措施","bbox":[719.274,606.667,236.204,13.122],"nodeIds":