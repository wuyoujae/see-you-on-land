p002-n0056","text":"全体人民","bbox":[625.589,448.969,52.43,13.107],"color":"#e53935","fontSize":13.107,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0057","text":"共同富裕，是人民","bbox":[678.019,448.969,104.859,13.107],"color":"#000000","fontSize":13.107,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0058","text":"群众物质生活和精神生活","bbox":[782.878,448.969,144.182,13.107],"color":"#e53935","fontSize":13.107,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0059","text":"都富裕，不是少数人的富裕，","bbox":[927.059,448.969,170.397,13.107],"color":"#000000","fontSize":13.107,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0060","text":"也不是整齐划一的平均主义，不是所有人都同时富裕，也不是所有地区同时达到一个富裕水准","bbox":[560.052,468.63,537.404,13.107],"color":"#e53935","fontSize":13.107,"block":14,"line":1,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0061","text":"全体人民共同富裕是一个","bbox":[560.052,506.313,144.182,13.107],"color":"#141414","fontSize":13.107,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0062","text":"总体概念","bbox":[704.233,506.313,52.43,13.107],"color":"#ce4289","fontSize":13.107,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0063","text":"，是对全社会而言的，","bbox":[756.663,506.313,131.074,13.343],"color":"#141414","fontSize":13.107,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0064","text":"不要各提各的指标","bbox":[887.737,506.313,104.859,13.107],"color":"#ce4289","fontSize":13.107,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0065","text":"2035","bbox":[560.052,539.091,31.012,13.107],"color":"#e32c2d","fontSize":13.107,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0066","text":"年，共同富裕","bbox":[594.414,543.997,78.644,13.343],"color":"#141414","fontSize":13.107,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0067","text":"取得明显的实质性进展","bbox":[673.065,543.997,131.074,13.107],"color":"#ce4289","fontSize":13.107,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0068","text":"。","bbox":[804.139,543.997,13.107,13.107],"color":"#141414","fontSize":13.107,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0069","text":"本世纪中叶","bbox":[817.246,543.997,65.537,13.107],"color":"#e32c2d","fontSize":13.107,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0070","text":"，","bbox":[882.784,543.997,13.107,13.343],"color":"#141414","fontSize":13.107,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0071","text":"基本实现共同富裕","bbox":[895.891,543.997,104.859,13.107],"color":"#ce4289","fontSize":13.107,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0072","text":"实现共同富裕，首先要把","bbox":[560.052,581.681,144.182,13.343],"color":"#141414","fontSize":13.107,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0073","text":"“","bbox":[704.233,576.775,5.584,13.107],"color":"#ce4289","fontSize":13.107,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0074","text":"蛋糕","bbox":[709.821,581.681,26.215,13.107],"color":"#ce4289","fontSize":13.107,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0075","text":"”","bbox":[736.036,576.775,5.584,13.107],"color":"#ce4289","fontSize":13.107,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0076","text":"做大做好","bbox":[741.623,581.681,52.43,13.107],"color":"#ce4289","fontSize":13.107,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0077","text":"，然后","bbox":[794.052,581.681,39.322,13.343],"color":"#141414","fontSize":13.107,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0078","text":"把","bbox":[833.375,581.681,13.107,13.107],"color":"#ce4289","fontSize":13.107,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0079","text":"“","bbox":[846.482,576.775,5.584,13.107],"color":"#ce4289","fontSize":13.107,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0080","text":"蛋糕","bbox":[852.069,581.681,26.215,13.107],"color":"#ce4289","fontSize":13.107,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0081","text":"”","bbox":[878.284,576.775,5.584,13.107],"color":"#ce4289","fontSize":13.107,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0082","text":"切好分好","bbox":[883.871,581.681,52.43,13.107],"color":"#ce4289","fontSize":13.107,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-2-p002-n0083","text":"正确处理效率和公平的关系，构建初次分配、再分配、三次分配协调配套的基础性制度安排，加","bbox":[560.052,619.365,550.512,13.107],"color":"#000000","fontSize":13.107,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0084","text":"大税收、社保、转移支付等调节力度并提高精准性，扩大中等收入群体比重，增加低收入群体收","bbox":[560.052,639.026,550.512,13.107],"color":"#000000","fontSize":13.107,"block":18,"line":1,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0085","text":"入，合理调节高收入，取缔非法收入，形成中间大、两头小的橄榄型分配结构","bbox":[560.052,658.687,445.652,13.343],"color":"#000000","fontSize":13.107,"block":18,"line":2,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0086","text":"【知识延伸】","bbox":[397.848,723.405,78.644,13.107],"color":"#141414","fontSize":13.107,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0087","text":"收入分配政策","bbox":[397.848,743.066,78.644,13.107],"color":"#141414","fontSize":13.107,"block":19,"line":1,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0088","text":"初次分配：收入分配体系的基础，核心是发挥市场的决定性作用。如职工薪酬、最低工资保障等","bbox":[507.622,705.382,550.511,13.107],"color":"#141414","fontSize":13.107,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0089","text":"再分配：在初次分配的基础上，由政府主导进行的调节性分配。如个人所得税、社会保障、转移支付等","bbox":[507.622,743.066,589.834,13.107],"color":"#141414","fontSize":13.107,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0090","text":"第三次分配：社会力量自愿参与，通过慈善、公益、捐赠、志愿服务等方式，对社会资源和财富进行分配","bbox":[507.622,780.75,602.941,13.107],"color":"#141414","fontSize":13.107,"block":22,"line":0,"emphasis":false,"role":"content"},{"id":"politics-2-p002-n0091","text":"2","bbox":[592.275,810.923,6.0,16.008],"color":"#000000","fontSize":12.0,"block":23,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"politics-2-p002-b0001","text":"第二章分论第二节以人民为中心","bbox":[81.768,467.598,247.896,14.746],"nodeIds":["politics-2-p002-n0001","politics-2-p002-n0002","politics-2-p002-n0003","politics-2-p002-n0004"]},{"id":"politics-2-p002-b0002","text":"一、坚持以人民为中心","bbox":[372.179,162.244,131.074,13.107],"nodeIds":["politics-2-p002-n0005"]},{"id":"politics-2-p002-b0003","text":"人民性是马克思主义的本质属性和鲜明品格","bbox":[560.052,30.35,249.041,13.107],"nodeIds":["politics-2-p002-n0006","politics-2-p002-n0007","politics-2-p002-n0008","politics-2-p002-n0009"]},{"id":"politics-2-p002-b0004","text":"人民立场是中国共产D的根本政治立场，是我们D区别于其他政D的显著标志","bbox":[560.052,63.128,434.055,18.249],"nodeIds":["politics-2-p002-n0010","politics-2-p002-n0011","politics-2-p002-n0012","politics-2-p002-n0013","politics-2-p002-n0014","politics-2-p002-n0015","politics-2-p002-n0016","politics-2-p002-n0017"]},{"id":"politics-2-p002-b0005","text":"D的最大政治优势是密切联系群众，D执政后的最大危险是脱离群众","bbox":[560.052,100.812,385.491,18.249],"nodeIds":["politics-2-p002-n0018","politics-2-p002-n0019","politics-2-p002-n0020","politics-2-p002-n0021","politics-2-p002-n0022","politics-2-p002-n0023"]},{"id":"politics-2-p002-b0006","text":"坚持人民至上，是新时代D治国理政的根本价值取向","bbox":[560.052,138.495,297.604,18.25],"nodeIds":["politics-2-p002-n0024","politics-2-p002-n0025","politics-2-p002-n0026","politics-2-p002-n0027","politics-2-p002-n0028","politics-2-p002-n0029"]},{"id":"politics-2-p002-b0007","text":"让群众满意是我们D做好一切工作的价值取向和根本标准","bbox":[560.052,176.179,323.82,18.014],"nodeIds":["politics-2-p002-n0030","politics-2-p002-n0031","politics-2-p002-n0032","politics-2-p002-n0033","politics-2-p002-n0034"]},{"id":"politics-2-p002-b0008","text":"要把增进民生福祉作为发展的根本目的","bbox":[560.052,218.77,222.826,13.107],"nodeIds":["politics-2-p002-n0035","politics-2-p002-n0036"]},{"id":"politics-2-p002-b0009","text":"全心全意为人民服务是中国共产D的宗旨","bbox":[560.052,251.547,232.068,18.013],"nodeIds":["politics-2-p002-n0037","politics-2-p002-n0038","politics-2-p002-n0039","politics-2-p002-n0040"]},{"id":"politics-2-p002-b0010","text":"⑧群众路线是我们D的生命线和根本工作路线","bbox":[534.383,289.231,268.369,18.013],"nodeIds":["politics-2-p002-n0041","politics-2-p002-n0042","politics-2-p002-n0043","politics-2-p002-n0044","politics-2-p002-n0045","politics-2-p002-n0046"]},{"id":"politics-2-p002-b0011","text":"【知识延伸】","bbox":[397.848,340.832,78.644,13.107],"nodeIds":["politics-2-p002-n0047"]},{"id":"politics-2-p002-b0012","text":"群众路线一切为了群众，一切依靠群众，从群众中来，到群众中去，把D的正确主张变为群众的自觉行动","bbox":[410.955,355.651,642.929,18.186],"nodeIds":["politics-2-p002-n0048","politics-2-p002-n0049","politics-2-p002-n0050","politics-2-p002-n0051"]},{"id":"politics-2-p002-b0013","text":"二、扎实推进共同富裕","bbox":[372.179,543.997,131.074,13.107],"nodeIds":["politics-2-p002-n0052"]},{"id":"politics-2-p002-b0014","text":"社会主义最大的优越性是共同富裕","bbox":[560.052,411.285,196.611,13.107],"nodeIds":["politics-2-p002-n0053","politics-2-p002-n0054"]},{"id":"politics-2-p002-b0015","text":"共同富裕是全体人民共同富裕，是人民群众物质生活和精神生活都富裕，不是少数人的富裕，也不是整齐划一的平均主义，不是所有人都同时富裕，也不是所有地区同时达到一个富裕水准","bbox":[560.052,448.969,537.404,32.768],"nodeIds":["politics-2-p002-n0055","politics-2-p002-n0056","politics-2-p002-n0057","politics-2-p002-n0058","politics-2-p002-n0059","politics-2-p002-n0060"]},{"id":"politics-2-p002-b0016","text":"全体人民共同富裕是一个总体概念，是对全社会而言的，不要各提各的指标","bbox":[560.052,506.313,432.544,13.343],"nodeIds":["politics-2-p002-n0061","politics-2-p002-n0062","politics-2-p002-n0063","politics-2-p002-n0064"]},{"id":"politics-2-p002-b0017","text":"2035年，共同富裕取得明显的实质性进展。本世纪中叶，基本实现共同富裕","bbox":[560.052,539.091,440.698,18.249],"nodeIds":["politics-2-p002-n0065","politics-2-p002-n0066","politics-2-p002-n0067","politics-2-p002-n0068","politics-2-p002-n0069","politics-2-p002-n0070","politics-2-p002-n0071"]},{"id":"politics-2-p002-b0018","text":"实现共同富裕，首先要把“蛋糕”做大做好，然后把“蛋糕”切好分好","bbox":[560.052,576.775,376.249,18.249],"nodeIds":["politics-2-p002-n0072","politics-2-p002-n0073","politics-2-p002-n0074","politics-2-p002-n0075","politics-2-p002-n0076","politics-2-p002-n0077","politics-2-p002-n0078","politics-2-p002-n0079","politics-2-p002-n0080","politics-2-p002-n0081","politics-2-p002-n0082"]},{"id":"politics-2-p002-b0019","text":"正确处理效率和公平的关系，构建初次分配、再分配、三次分配协调配套的基础性制度安排，加大税收、社保、转移支付等调节力度并提高精准性，扩大中等收入群体比重，增加低收入群体收入，合理调节高收入，取缔非法收入，形成中间大、两头小的橄榄型分配结构","bbox":[560.052,619.365,550.512,52.665],"nodeIds":["politics-2-p002-n0083","politics-2-p002-n0084","politics-2-p002-n0085"]},{"id":"politics-2-p002-b0020","text":"【知识延伸】收入分配政策","bbox":[397.848,723.405,78.644,32.768],"nodeIds":["politics-2-p002-n0086","politics-2-p002-n0087"]},{"id":"politics-2-p002-b0021","text":"初次分配：收入分配体系的基础，核心是发挥市场的决定性作用。如职工薪酬、最低工资保障等","bbox":[507.622,705.382,550.511,13.107],"nodeIds":["politics-2-p002-n0088"]},{"id":"politics-2-p002-b0022","text":"再分配：在初次分配的基础上，由政府主导进行的调节性分配。如个人所得税、社会保障、转移支付等","bbox":[507.622,743.066,589.834,13.107],"nodeIds":["politics-2-p002-n0089"]},{"id":"politics-2-p002-b0023","text":"第三次分配：社会力量自愿参与，通过慈善、公益、捐赠、志愿服务等方式，对社会资源和财富进行分配","bbox":[507.622,780.75,602.941,13.107],"nodeIds":["politics-2-p002-n0090"]},{"id":"politics-2-p002-b0024","text":"2","bbox":[592.275,810.923,6.0,16.008],"nodeIds":["politics-2-p002-n0091"]}],"questions":[{"id":"politics-2-p002-q001","number":1,"type":"fill-in","answer":"人民性","bbox":[560.052,30.35,39.322,13.107],"fontSize":13.107,"color":"#19a719","segments":[{"text":"人民性","bbox":[560.052,30.35,39.322,13.107],"color":"#19a719"}],"nodeIds":["politics-2-p002-n0006"],"aliases":[],"context":"____是马克思主义的____和鲜明品格"},{