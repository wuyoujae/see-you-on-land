"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0032","text":"新时代是","bbox":[602.397,360.211,41.534,10.383],"color":"#141414","fontSize":10.383,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0033","text":"决胜全面建成小康社会、进而全面建设社会主义现代化强国","bbox":[643.931,360.211,269.969,10.383],"color":"#15831c","fontSize":10.383,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"politics-1-p001-n0034","text":"的时代","bbox":[913.9,360.211,31.15,10.383],"color":"#141414","fontSize":10.383,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0035","text":"新时代是全国各族人民不断创造美好生活、逐步实现全体人民","bbox":[602.397,390.063,280.353,10.383],"color":"#141414","fontSize":10.383,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0036","text":"共同富裕","bbox":[882.75,390.063,41.534,10.383],"color":"#15831c","fontSize":10.383,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"politics-1-p001-n0037","text":"的时代","bbox":[924.284,390.063,31.15,10.383],"color":"#141414","fontSize":10.383,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0038","text":"新时代是全体中华儿女勠力同心、奋力实现中华民族伟大复兴中国梦的时代","bbox":[602.397,419.916,342.654,10.383],"color":"#141414","fontSize":10.383,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0039","text":"新时代是我国不断为人类作出更大贡献的时代","bbox":[602.397,449.768,207.669,10.383],"color":"#141414","fontSize":10.383,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0040","text":"中国特色社会主义进入新时代的依据","bbox":[411.601,607.467,166.135,10.383],"color":"#141414","fontSize":10.383,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0041","text":"①中国特色社会主义进入","bbox":[602.397,523.75,114.218,10.383],"color":"#141414","fontSize":10.383,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0042","text":"新时代，是我国社会主要","bbox":[602.397,539.325,114.218,10.57],"color":"#141414","fontSize":10.383,"block":22,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0043","text":"矛盾发生新变化的反映","bbox":[602.397,554.901,103.834,10.383],"color":"#141414","fontSize":10.383,"block":22,"line":1,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0044","text":"社会主要矛盾的变化是我们","bbox":[743.871,479.621,124.601,10.383],"color":"#141414","fontSize":10.383,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0045","text":"D","bbox":[868.473,475.784,7.019,10.383],"color":"#141414","fontSize":10.383,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0046","text":"作出中特社会主义进入新时代重大判断的基本依据","bbox":[875.49,479.621,228.436,10.383],"color":"#141414","fontSize":10.383,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0047","text":"十九大报告指出，我国社会主要矛盾已经转化为","bbox":[743.871,509.473,218.052,10.383],"color":"#141414","fontSize":10.383,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0048","text":"人民日益","bbox":[961.924,509.473,41.534,10.383],"color":"#ff6f00","fontSize":10.383,"block":24,"line":0,"emphasis":true,"role":"content"},{"id":"politics-1-p001-n0049","text":"增长的美好生活需要和不平衡不充分的发展","bbox":[743.871,525.048,197.286,10.383],"color":"#ff6f00","fontSize":10.383,"block":25,"line":0,"emphasis":true,"role":"content"},{"id":"politics-1-p001-n0050","text":"之间的矛盾","bbox":[941.157,525.048,51.917,10.383],"color":"#141414","fontSize":10.383,"block":25,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0051","text":"新时代我国社会主要矛盾的变化，","bbox":[743.871,554.901,155.752,10.383],"color":"#141414","fontSize":10.383,"block":26,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0052","text":"没有改变对我国社会主义所处历史阶段的判断","bbox":[899.623,554.901,207.669,10.383],"color":"#ff6f00","fontSize":10.383,"block":26,"line":0,"emphasis":true,"role":"content"},{"id":"politics-1-p001-n0053","text":"我国仍处于并将长期处于","bbox":[743.871,584.753,114.218,10.383],"color":"#141414","fontSize":10.383,"block":27,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0054","text":"社会主义初级阶段的基本国情","bbox":[858.089,584.753,134.985,10.383],"color":"#ff6f00","fontSize":10.383,"block":27,"line":0,"emphasis":true,"role":"content"},{"id":"politics-1-p001-n0055","text":"没有变","bbox":[993.074,584.753,31.15,10.383],"color":"#141414","fontSize":10.383,"block":27,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0056","text":"我国是","bbox":[743.871,614.605,31.15,10.383],"color":"#141414","fontSize":10.383,"block":28,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0057","text":"世界最大发展中国家的国际地位","bbox":[775.022,614.605,145.368,10.383],"color":"#ff6f00","fontSize":10.383,"block":28,"line":0,"emphasis":true,"role":"content"},{"id":"politics-1-p001-n0058","text":"没有变","bbox":[920.39,614.605,31.15,10.383],"color":"#141414","fontSize":10.383,"block":28,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0059","text":"②中国特色社会主义进入新时代，","bbox":[602.397,644.458,155.752,10.57],"color":"#141414","fontSize":10.383,"block":29,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0060","text":"是","bbox":[602.397,660.033,10.383,10.383],"color":"#141414","fontSize":10.383,"block":30,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0061","text":"D","bbox":[612.78,656.146,7.32,10.383],"color":"#141414","fontSize":10.383,"block":30,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0062","text":"的主要任务发生新变化的反映","bbox":[620.101,660.033,134.985,10.383],"color":"#141414","fontSize":10.383,"block":30,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0063","text":"D","bbox":[782.809,641.27,7.019,10.383],"color":"#141414","fontSize":10.383,"block":31,"line":0,"emphasis":false,"role":"content"},{"id":"politics-1-p001-n0064","text":"的十八大后，","bbox":[789.826,645.107,62.301,10.383],"color":"#141414","fontSize":10.383,"block":31,"line":0,"emphasis":false,"role":"c