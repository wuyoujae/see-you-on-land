text":"业","bbox":[910.123,501.13,14.272,14.272],"color":"#19a719","fontSize":14.272,"block":18,"line":1,"emphasis":true,"role":"content"},{"id":"law-p034-n0071","text":"；其他较重的行政处罚等情形","bbox":[924.394,501.13,185.533,14.857],"color":"#141414","fontSize":14.272,"block":18,"line":1,"emphasis":false,"role":"content"},{"id":"law-p034-n0072","text":"②程序","bbox":[519.433,588.545,42.815,14.272],"color":"#141414","fontSize":14.272,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0073","text":"时间","bbox":[596.144,546.621,28.544,14.272],"color":"#ce4289","fontSize":14.272,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0074","text":"：当事人要求听证的，应在行政机关告知后","bbox":[624.687,546.621,271.164,14.857],"color":"#141414","fontSize":14.272,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0075","text":"5","bbox":[899.516,541.279,11.888,14.272],"color":"#ce4289","fontSize":14.272,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0076","text":"日内提出","bbox":[911.405,546.621,57.087,14.272],"color":"#ce4289","fontSize":14.272,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0077","text":"；","bbox":[968.492,546.621,14.272,14.857],"color":"#141414","fontSize":14.272,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0078","text":"行政机关应在听证的","bbox":[640.464,568.029,128.446,14.272],"color":"#141414","fontSize":14.272,"block":20,"line":1,"emphasis":false,"role":"content"},{"id":"law-p034-n0079","text":"7","bbox":[772.604,562.687,11.275,14.272],"color":"#ce4289","fontSize":14.272,"block":20,"line":1,"emphasis":true,"role":"content"},{"id":"law-p034-n0080","text":"日前，通知","bbox":[783.879,568.029,71.359,14.529],"color":"#ce4289","fontSize":14.272,"block":20,"line":1,"emphasis":true,"role":"content"},{"id":"law-p034-n0081","text":"当事人举行听证的时间、地点","bbox":[855.238,568.029,185.533,14.272],"color":"#141414","fontSize":14.272,"block":20,"line":1,"emphasis":false,"role":"content"},