{"id":"law-p034","bookId":"law","number":34,"title":"第三章行政法二、行政处罚","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p034.svg","dataUrl":"data/knowledge/pages/law/law-p034.json","questionCount":34,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":34},"nodes":[{"id":"law-p034-n0001","text":"第三章","bbox":[62.885,533.344,48.167,16.056],"color":"#141414","fontSize":16.056,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0002","text":"行政法","bbox":[115.168,533.344,48.167,16.056],"color":"#141414","fontSize":16.056,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0003","text":"二、行政处罚","bbox":[216.753,534.022,85.631,14.272],"color":"#141414","fontSize":14.272,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p034-n0004","text":"行政处罚","bbox":[366.011,310.022,57.087,14.272],"color":"#141414","fontSize":14.272,"block":1,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0005","text":"的程序","bbox":[373.147,331.43,42.815,14.272],"color":"#141414","fontSize":14.272,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0006","text":"一般","bbox":[456.994,96.615,28.544,14.272],"color":"#141414","fontSize":14.272,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0007","text":"规定","bbox":[456.994,118.022,28.544,14.272],"color":"#141414","fontSize":14.272,"block":3,"line":1,"emphasis":false,"role":"content"},{"id":"law-p034-n0008","text":"行政处罚应当由","bbox":[519.433,84.573,99.902,14.272],"color":"#141414","fontSize":14.272,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0009","text":"具有行政执法资格的执法人员","bbox":[619.335,84.573,185.533,14.272],"color":"#8e24aa","fontSize":14.272,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0010","text":"实施","bbox":[804.868,84.573,28.544,14.272],"color":"#141414","fontSize":14.272,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0011","text":"执法人员不得少于","bbox":[867.307,84.573,114.174,14.272],"color":"#8e24aa","fontSize":14.272,"block":4,"line":1,"emphasis":true,"role":"content"},{"id":"law-p034-n0012","text":"2","bbox":[981.482,79.23,15.97,14.272],"color":"#8e24aa","fontSize":14.272,"block":4,"line":1,"emphasis":true,"role":"content"},{"id":"law-p034-n0013","text":"人","bbox":[997.468,84.573,14.272,14.272],"color":"#8e24aa","fontSize":14.272,"block":4,"line":1,"emphasis":true,"role":"content"},{"id":"law-p034-n0014","text":"作出行政处罚","bbox":[519.433,130.064,85.631,14.272],"color":"#000000","fontSize":14.272,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0015","text":"决定之前","bbox":[605.064,130.064,57.087,14.272],"color":"#8e24aa","fontSize":14.272,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0016","text":"应当","bbox":[662.151,130.064,28.544,14.272],"color":"#000000","fontSize":14.272,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0017","text":"告知","bbox":[690.694,130.064,28.544,14.272],"color":"#8e24aa","fontSize":14.272,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0018","text":"当事人拟作出的行政处罚内容及事实、理由、依据，以及依法","bbox":[719.238,130.064,385.338,14.272],"color":"#000000","fontSize":14.272,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0019","text":"享有的陈述、申辩、要求听证等权利，行政机关","bbox":[519.433,151.472,299.707,14.272],"color":"#000000","fontSize":14.272,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0020","text":"不得因当事人陈述、申辩","bbox":[819.14,151.472,156.99,14.272],"color":"#8e24aa","fontSize":14.272,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0021","text":"而给予","bbox":[976.13,151.472,42.815,14.272],"color":"#000000","fontSize":14.272,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0022","text":"更重","bbox":[1018.945,151.472,28.544,14.272],"color":"#8e24aa","fontSize":14.272,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0023","text":"的处罚","bbox":[1047.489,151.472,42.815,14.272],"color":"#000000","fontSize":14.272,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0024","text":"一般","bbox":[456.994,232.642,28.544,14.272],"color":"#141414","fontSize":14.272,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0025","text":"程序","bbox":[456.994,254.05,28.544,14.272],"color":"#141414","fontSize":14.272,"block":7,"line":1,"emphasis":false,"role":"content"},{"id":"law-p034-n0026","text":"①立案；②","bbox":[519.433,192.503,71.359,14.857],"color":"#141414","fontSize":14.272,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0027","text":"调查取证","bbox":[590.792,192.503,57.087,14.272],"color":"#1e88e5","fontSize":14.272,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0028","text":"：执法人员","bbox":[647.879,192.503,71.359,14.857],"color":"#141414","fontSize":14.272,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0029","text":"不少于两人","bbox":[719.238,192.503,71.359,14.272],"color":"#1e88e5","fontSize":14.272,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0030","text":"，并应当向当事人或者有关人员","bbox":[790.597,192.503,199.805,14.272],"color":"#141414","fontSize":14.272,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0031","text":"出示证件","bbox":[990.401,192.503,57.087,14.272],"color":"#1e88e5","fontSize":14.272,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0032","text":"③告知处罚的事实、理由、依据和有关权利","bbox":[519.433,233.534,271.164,14.272],"color":"#141414","fontSize":14.272,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0033","text":"④","bbox":[519.433,274.566,14.272,14.272],"color":"#141414","fontSize":14.272,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0034","text":"听取陈述、申辩","bbox":[533.705,274.566,99.902,14.272],"color":"#1e88e5","fontSize":14.272,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0035","text":"或者举行听证，行政机关不得因当事人申辩而加重处罚","bbox":[633.607,274.566,342.523,14.272],"color":"#141414","fontSize":14.272,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0036","text":"⑤决定处罚：行政机关","bbox":[519.433,315.597,142.718,14.857],"color":"#141414","fontSize":14.272,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0037","text":"负责人（集体）","bbox":[662.151,315.597,99.902,14.272],"color":"#1e88e5","fontSize":14.272,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0038","text":"做出处罚决定；⑥当事人不在场，","bbox":[762.053,315.597,214.077,14.857],"color":"#141414","fontSize":14.272,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0039","text":"7","bbox":[976.13,310.255,11.275,14.272],"color":"#1e88e5","fontSize":14.272,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0040","text":"日内送达","bbox":[987.405,315.597,57.087,14.272],"color":"#1e88e5","fontSize":14.272,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0041","text":"简易","bbox":[456.994,376.252,28.544,14.272],"color":"#141414","fontSize":14.272,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0042","text":"程序","bbox":[456.994,397.66,28.544,14.272],"color":"#141414","fontSize":14.272,"block":12,"line":1,"emphasis":false,"role":"content"},{"id":"law-p034-n0043","text":"①特点：","bbox":[519.433,356.628,57.087,14.857],"color":"#141414","fontSize":14.272,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0044","text":"一人执法、当场决定、当场送达","bbox":[576.52,356.628,199.805,14.272],"color":"#ff6f00","fontSize":14.272,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0045","text":"②条件：","bbox":[519.433,397.66,57.087,14.857],"color":"#141414","fontSize":14.272,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0046","text":"警告","bbox":[576.52,397.66,28.544,14.272],"color":"#ff6f00","fontSize":14.272,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0047","text":"；对","bbox":[605.064,397.66,28.544,14.857],"color":"#141414","fontSize":14.272,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0048","text":"公民","bbox":[633.607,397.66,28.544,14.272],"color":"#ff6f00","fontSize":14.272,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0049","text":"罚款","bbox":[662.151,397.66,28.544,14.272],"color":"#141414","fontSize":14.272,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0050","text":"200","bbox":[694.388,392.317,29.5,14.272],"color":"#ff6f00","fontSize":14.272,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0051","text":"元以下","bbox":[723.886,397.66,42.815,14.272],"color":"#ff6f00","fontSize":14.272,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0052","text":"，对","bbox":[766.708,397.66,28.544,14.272],"color":"#141414","fontSize":14.272,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0053","text":"法人","bbox":[795.252,397.66,28.544,14.272],"color":"#ff6f00","fontSize":14.272,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0054","text":"、其他组织罚款","bbox":[823.795,397.66,99.902,14.272],"color":"#141414","fontSize":14.272,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0055","text":"3000","bbox":[927.391,392.317,37.706,14.272],"color":"#ff6f00","fontSize":14.272,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0056","text":"元以下","bbox":[965.077,397.66,42.815,14.272],"color":"#ff6f00","fontSize":14.272,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p034-n0057","text":"。另有规定从其规定","bbox":[1007.893,397.66,128.446,14.272],"color":"#141414","fontSize":14.272,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p034-n0058","text":"③程序：当场决定，当场交付处罚决定书","bbox":[5