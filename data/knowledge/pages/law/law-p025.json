{"id":"law-p025","bookId":"law","number":25,"title":"第二章刑法七、刑罚","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p025.svg","dataUrl":"data/knowledge/pages/law/law-p025.json","questionCount":22,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":25},"nodes":[{"id":"law-p025-n0001","text":"第二章","bbox":[64.7,381.585,49.557,16.519],"color":"#141414","fontSize":16.519,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0002","text":"刑法","bbox":[118.492,381.585,33.038,16.519],"color":"#141414","fontSize":16.519,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0003","text":"七、刑罚","bbox":[206.489,382.283,58.735,14.684],"color":"#141414","fontSize":14.684,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p025-n0004","text":"附加刑","bbox":[330.688,364.846,44.051,14.684],"color":"#19a719","fontSize":14.684,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0005","text":"是补充主刑适用的刑罚方法。附加刑的特点是既可以附加适用，也可以独立适用","bbox":[409.613,77.138,513.928,14.684],"color":"#141414","fontSize":14.684,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0006","text":"附加刑有四种：","bbox":[409.613,99.164,102.786,15.286],"color":"#141414","fontSize":14.684,"block":2,"line":1,"emphasis":false,"role":"content"},{"id":"law-p025-n0007","text":"罚金、剥夺政治权利、没收财产、驱逐出境","bbox":[512.399,99.164,278.99,14.684],"color":"#19a719","fontSize":14.684,"block":2,"line":1,"emphasis":true,"role":"content"},{"id":"law-p025-n0008","text":"剥夺政治权利","bbox":[409.613,323.089,88.102,14.684],"color":"#00897b","fontSize":14.684,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0009","text":"剥夺犯罪分子参加国家管理和政治活动权利的刑罚","bbox":[532.589,141.379,323.041,14.684],"color":"#141414","fontSize":14.684,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0010","text":"主要","bbox":[532.589,183.595,29.367,14.684],"color":"#141414","fontSize":14.684,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0011","text":"内容","bbox":[532.589,205.62,29.367,14.684],"color":"#141414","fontSize":14.684,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0012","text":"选举权和被选举权；言论、出版、集会、结社、游行、示威自由","bbox":[596.83,184.512,411.143,15.506],"color":"#8e24aa","fontSize":14.684,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0013","text":"的权利","bbox":[1007.972,184.512,44.051,14.684],"color":"#141414","fontSize":14.684,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0014","text":"担任","bbox":[596.83,226.728,29.367,14.684],"color":"#141414","fontSize":14.684,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0015","text":"国家机关职务","bbox":[626.197,226.728,88.102,14.684],"color":"#8e24aa","fontSize":14.684,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0016","text":"的权利；担任国有公司","bbox":[714.299,226.728,146.837,15.286],"color":"#141414","fontSize":14.684,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0017","text":"/","bbox":[861.135,221.303,5.139,14.684],"color":"#141414","fontSize":14.684,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0018","text":"企业","bbox":[866.276,226.728,29.367,14.684],"color":"#141414","fontSize":14.684,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0019","text":"/","bbox":[895.643,221.303,5.139,14.684],"color":"#141414","fontSize":14.684,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0020","text":"事业单位和人民团体","bbox":[900.784,226.728,132.153,14.684],"color":"#141414","fontSize":14.684,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0021","text":"领导职务","bbox":[1032.937,226.728,58.735,14.684],"color":"#8e24aa","fontSize":14.684,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0022","text":"的权利","bbox":[1091.672,226.728,44.051,14.684],"color":"#141414","fontSize":14.684,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0023","text":"适用","bbox":[532.589,301.064,29.367,14.684],"color":"#141414","fontSize":14.684,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0024","text":"对象","bbox":[532.589,323.089,29.367,14.684],"color":"#141414","fontSize":14.684,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0025","text":"应当附加剥夺","bbox":[596.83,268.943,88.102,14.684],"color":"#1e88e5","fontSize":14.684,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0026","text":"政治权利：对于","bbox":[684.932,268.943,102.786,15.286],"color":"#141414","fontSize":14.684,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0027","text":"危害国家安全","bbox":[787.717,268.943,88.102,14.684],"color":"#1e88e5","fontSize":14.684,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0028","text":"的犯罪分子，以及对","bbox":[875.819,268.943,132.153,14.684],"color":"#141414","fontSize":14.684,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0029","text":"于被","bbox":[596.83,290.969,29.367,14.684],"color":"#141414","fontSize":14.684,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0030","text":"判处死刑、无期徒刑","bbox":[626.197,290.969,132.153,14.684],"color":"#1e88e5","fontSize":14.684,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0031","text":"的犯罪分子，应当附加剥夺政治权利","bbox":[758.35,290.969,234.939,14.684],"color":"#141414","fontSize":14.684,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0032","text":"可以附加剥夺","bbox":[596.83,333.184,88.102,14.684],"color":"#1e88e5","fontSize":14.684,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0033","text":"政治权利：对于故意杀人、强奸、放火、爆炸、投","bbox":[684.932,333.184,323.041,15.286],"color":"#141414","fontSize":14.684,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0034","text":"毒、抢劫等严重破坏社会秩序的犯罪分子，可以附加剥夺政治权利","bbox":[596.83,355.21,425.826,14.684],"color":"#141414","fontSize":14.684,"block":13,"line":1,"emphasis":false,"role":"content"},{"id":"law-p025-n0035","text":"剥夺","bbox":[532.589,417.615,29.367,14.684],"color":"#141414","fontSize":14.684,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0036","text":"期限","bbox":[532.589,439.641,29.367,14.684],"color":"#141414","fontSize":14.684,"block":14,"line":1,"emphasis":false,"role":"content"},{"id":"law-p025-n0037","text":"对于被判处","bbox":[596.83,397.425,73.418,14.684],"color":"#141414","fontSize":14.684,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0038","text":"死刑、无期徒刑","bbox":[670.248,397.425,102.786,14.684],"color":"#ff6f00","fontSize":14.684,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0039","text":"的犯罪分子，应当剥夺政治权利","bbox":[773.034,397.425,205.571,14.684],"color":"#141414","fontSize":14.684,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0040","text":"终身","bbox":[978.605,397.425,29.367,14.684],"color":"#ff6f00","fontSize":14.684,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0041","text":"附加剥夺政治权利的","bbox":[596.83,439.641,132.153,14.684],"color":"#141414","fontSize":14.684,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0042","text":"刑期","bbox":[728.983,439.641,29.367,14.684],"color":"#ff6f00","fontSize":14.684,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0043","text":"，从","bbox":[758.35,439.641,29.367,14.684],"color":"#141414","fontSize":14.684,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0044","text":"徒刑、拘役执行完毕之日","bbox":[787.717,439.641,161.52,14.684],"color":"#ff6f00","fontSize":14.684,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0045","text":"或者从","bbox":[949.237,439.641,44.051,14.684],"color":"#141414","fontSize":14.684,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0046","text":"假释之日起计算","bbox":[993.288,439.641,102.786,14.684],"color":"#ff6f00","fontSize":14.684,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0047","text":"剥夺政治权利的效力当然","bbox":[596.83,481.856,161.52,14.684],"color":"#141414","fontSize":14.684,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0048","text":"施用于主刑执行期间","bbox":[758.35,481.856,132.153,14.684],"color":"#ff6f00","fontSize":14.684,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0049","text":"剥夺政治权利的执行机关剥夺政治权利由","bbox":[532.589,524.072,264.306,14.684],"color":"#141414","fontSize":14.684,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0050","text":"公安机关","bbox":[796.895,524.072,58.735,14.684],"color":"#00897b","fontSize":14.684,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0051","text":"执行","bbox":[855.629,524.072,29.367,14.684],"color":"#141414","fontSize":14.684,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0052","text":"没收财产","bbox":[409.613,630.529,58.735,14.684],"color":"#e53935","fontSize":14.684,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0053","text":"将犯罪分子个人所有财产的部分或者全部强制","bbox":[503.221,566.287,293.673,14.684],"color":"#141414","fontSize":14.684,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0054","text":"无偿","bbox":[796.895,566.287,29.367,14.684],"color":"#e53935","fontSize":14.684,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0055","text":"地收归国有的刑罚方法","bbox":[826.262,566.287,146.837,14.684],"color":"#141414","fontSize":14.684,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0056","text":"没收","bbox":[503.221,608.503,29.367,14.684],"color":"#141414","fontSize":14.684,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0057","text":"范围","bbox":[503.221,630.529,29.367,14.684],"color":"#141414","fontSize":14.684,"block":22,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0058","text":"必须是","bbox":[567.462,609.421,44.051,14.684],"color":"#141414","fontSize":14.684,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0059","text":"犯罪分子所有的合法财产","bbox":[611.513,609.421,161.52,14.684],"color":"#e53935","fontSize":14.684,"block":23,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0060","text":"；不得没收属于犯罪分子家属所有或者应有的财产","bbox":[773.034,609.421,323.041,15.286],"color":"#141414","fontSize":14.684,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0061","text":"没收全部财产时，应当给犯罪分子","bbox":[567.462,651.636,220.255,14.684],"color":"#141414","fontSize":14.684,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0062","text":"个人及其扶养的家属保留必要的生活费用","bbox":[787.717,651.636,264.306,14.684],"color":"#e53935","fontSize":14.684,"block":24,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0063","text":"执行","bbox":[503.221,693.852,29.367,14.684],"color":"#141414","fontSize":14.684,"block":25,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0064","text":"机关","bbox":[503.221,715.877,29.367,14.684],"color":"#141414","fontSize":14.684,"block":25,"line":1,"emphasis":false,"role":"content"},{"id":"law-p025-n0065","text":"没收财产的判决，无论附加适用或者独立适用，都由人民","bbox":[567.462,694.77,367.092,14.684],"color":"#141414","fontSize":14.684,"block":26,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0066","text":"法院","bbox":[934.554,694.77,29.367,14.684],"color":"#e53935","fontSize":14.684,"block":26,"line":0,"emphasis":true,"role":"content"},{"id":"law-p025-n0067","text":"执行","bbox":[963.921,694.77,29.367,14.684],"color":"#141414","fontSize":14.684,"block":26,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0068","text":"在必要时，可以会同公安机关执行","bbox":[567.462,736.985,220.255,14.684],"color":"#141414","fontSize":14.684,"block":27,"line":0,"emphasis":false,"role":"content"},{"id":"law-p025-n0069","text":"25","bbox":[587.275,810.711,16.0,21.344],"color":"#000000","fontSize":16.0,"block":28,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"law-p025-b0001","text":"第二章刑法七、刑罚","bbox":[64.7,381.585,200.524,16.519],"nodeIds":["law-p025-n0001","law-p025-n0002","law-p025-n0003"]},{"id":"law-p025-b0002","text":"附加刑","bbox":[330.688,364.846,44.051,14.684],"nodeIds":["law-p025-n0004"]},{"id":"law-p025-b0003","text":"是补充主刑适用的刑罚方法。附加刑的特点是既可以附加适用，也可以独立适用附加刑有四种：罚金、剥夺政治权利、没收财产、驱逐出境","bbox":[409.613,77.138,513.928,37.312],"nodeIds":["law-p025-n0005","law-p025-n0006","law-p025-n0007"]},{"id":"law-p025-b0004","text":"剥夺政治权利","bbox":[409.613,323.089,88.102,14.684],"nodeIds":["law-p025-n0008"]},{"id":"law-p025-b0005","text":"剥夺犯罪分子参加国家管理和政治活动权利的刑罚","bbox":[532.589,141.379,323.041,14.684],"nodeIds":["law-p025-n0009"]},{"id":"law-p025-b0006","text":"主要","bbox":[532.589,183.595,29.367,14.684],"nodeIds":["law-p025-n0010"]},{"id":"law-p025-b0007","text":"内容","bbox":[532.589,205.62,29.367,14.684],"nodeIds":["law-p025-n0011"]},{"id":"law-p025-b0008","text":"选举权和被选举权；言论、出版、集会、结社、游行、示威自由的权利","bbox":[596.83,184.512,455.193,15.506],"nodeIds":["law-p025-n0012","law-p025-n0013"]},{"id":"law-p025-b0009","text":"担任国家机关职务的权利；担任国有公司/企业/事业单位和人民团体领导职务的权利","bbox":[596.83,221.303,538.893,20.711],"nodeIds":["law-p025-n0014","law-p025-n0015","law-p025-n0016","law-p025-n0017","law-p025-n0018","law-p025-n0019","law-p025-n0020","law-p025-n0021","law-p025-n0022"]},{"id":"law-p025-b0010","text":"适用","bbox":[532.589,301.064,29.367,14.684],"nodeIds":["law-p025-n0023"]},{"id":"law-p025-b0011","text":"对象","bbox":[532.589,323.089,29.367,14.684],"nodeIds":["law-p025-n0024"]},{"id":"law-p025-b0012","text":"应当附加剥夺政治权利：对于危害国家安全的犯罪分子，以及对","bbox":[596.83,268.943,411.142,15.286],"nodeIds":["law-p025-n0025","law-p025-n0026","law-p025-n0027","law-p025-n0028"]},{"id":"law-p025-b0013","text":"于被判处死刑、无期徒刑的犯罪分子，应当附加剥夺政治权利","bbox":[596.83,290.969,396.459,14.684],"nodeIds":["law-p025-n0029","law-p025-n0030","law-p025-n0031"]},{"id":"law-p025-b0014","text":"可以附加剥夺政治权利：对于故意杀人、强奸、放火、爆炸、投毒、抢劫等严重破坏社会秩序的犯罪分子，可以附加剥夺政治权利","bbox":[596.83,333.184,425.826,36.71],"nodeIds":["law-p025-n0032","law-p025-n0033","law-p025-n0034"]},{"id":"law-p025-b0015","text":"剥夺期限","bbox":[532.589,417.615,29.367,36.71],"nodeIds":["law-p025-n0035","law-p025-n0036"]},{"id":"law-p025-b0016","text":"对于被判处死刑、无期徒刑的犯罪分子，应当剥夺政治权利终身","bbox":[596.83,397.425,411.142,14.684],"nodeIds":["law-p025-n0037","law-p025-n0038","law-p025-n0039","law-p025-n0040"]},{"id":"law-p025-b0017","text":"附加剥夺政治权利的刑期，从徒刑、拘役执行完毕之日或者从假释之日起计算","bbox":[596.83,439.641,499.244,14.684],"nodeIds":["law-p025-n0041","law-p025-n0042","law-p025-n0043","law-p025-n0044","law-p025-n0045","law-p025-n0046"]},{"id":"law-p025-b0018","text":"剥夺政治权利的效力当然施用于主刑执行期间","bbox":[596.83,481.856,293.673,14.684],"nodeIds":["law-p025-n0047","law-p025-n0048"]},{"id":"law-p025-b0019","text":"剥夺政治权利的执行机关剥夺政治权利由公安机关执行","bbox":[532.589,524.072,352.407,14.684],"nodeIds":["law-p025-n0049","law-p025-n0050","law-p025-n0051"]},{"id":"law-p025-b0020","text":"没收财产","bbox":[409.613,630.529,58.735,14.684],"nodeIds":["law-p025-n0052"]},{"id":"law-p025-b0021","text":"将犯罪分子个人所有财产的部分或者全部强制无偿地收归国有的刑罚方法","bbox":[503.221,566.287,469.878,14.684],"nodeIds":["law-p025-n0053","law-p025-n0054","law-p025-n0055"]},{"id":"law-p025-b0022","text":"没收","bbox":[503.221,608.503,29.367,14.684],"nodeIds":["law-p025-n0056"]},{"id":"law-p025-b0023","text":"范围","bbox":[503.221,630.529,29.367,14.684],"nodeIds":["law-p025-n0057"]},{"id":"law-p025-b0024","text":"必须是犯罪分子所有的合法财产；不得没收属于犯罪分子家属所有或者应有的财产","bbox":[567.462,609.421,528.613,15.286],"nodeIds":["law-p025-n0058","law-p025-n0059","law-p025-n0060"]},{"id":"law-p025-b0025","text":"没收全部财产时，应当给犯罪分子个人及其扶养的家属保留必要的生活费用","bbox":[567.462,651.636,484.561,14.684],"nodeIds":["law-p025-n0061","law-p025-n0062"]},{"id":"law-p025-b0026","text":"执行机关","bbox":[503.221,693.852,29.367,36.709],"nodeIds":["law-p025-n0063","law-p025-n0064"]},{"id":"law-p025-b0027","text":"没收财产的判决，无论附加适用或者独立适用，都由人民法院执行","bbox":[567.462,694.77,425.826,14.684],"nodeIds":["law-p025-n0065","law-p025-n0066","law-p025-n0067"]},{"id":"law-p025-b0028","text":"在必要时，可以会同公安机关执行","bbox":[567.462,736.985,220.255,14.684],"nodeIds":["law-p025-n0068"]},{"id":"law-p025-b0029","text":"25","bbox":[587.275,810.711,16.0,21.344],"nodeIds":["law-p025-n0069"]}],"questions":[{"id":"law-p025-q001","number":1,"type":"fill-in","answer":"罚金、剥夺政治权利、没收财产、驱逐出境","bbox":[512.399,99.164,278.99,14.684],"fontSize":14.684,"color":"#19a719","segments":[{"text":"罚金、剥夺政治权利、没收财产、驱逐出境","bbox":[512.399,99.164,278.99,14.684],"color":"#19a719"}],"nodeIds":["law-p025-n0007"],"aliases":[],"context":"附加刑有四种：____"},{"id":"law-p025-q002","number":2,"type":"fill-in","answer":"选举权和被选举权；言论、出版、集会、结社、游行、示威自由","bbox":[596.83,184.512,411.143,15.506],"fontSize":14.684,"color":"#8e24aa","segments":[{"text":"选举权和被选举权；言论、出版、集会、结社、游行、示威自由","bbox":[596.83,184.512,411.143,15.506],"color":"#8e24aa"}],"nodeIds":["law-p025-n0012"],"aliases":[],"context":"主要____的权利"},{"id":"law-p025-q003","number":3,"type":"fill-in","answer":"国家机关职务","bbox":[626.197,226.728,88.102,14.684],"fontSize":14.684,"color":"#8e24aa","segments":[{"text":"国家机关职务","bbox":[626.197,226.728,88.102,14.684],"color":"#8e24aa"}],"nodeIds":["law-p025-n0015"],"aliases":[],"context":"担任____的权利；担任国有公司/企业/事业单位和人民团体____的权利"},{"id":"law-p025-q004","number":4,"type":"fill-in","answer":"领导职务","bbox":[1032.937,226.728,58.735,14.684],"fontSize":14.684,"color":"#8e24aa","segments":[{"text":"领导职务","bbox":[1032.937,226.728,58.735,14.684],"color":"#8e24aa"}],"nodeIds":["law-p025-n0021"],"aliases":[],"context":"担任____的权利；担任国有公司/企业/事业单位和人民团体____的权利"},{"id":"law-p025-q005","number":5,"type":"fill-in","answer":"应当附加剥夺","bbox":[596.83,268.943,88.102,14.684],"fontSize":14.684,"color":"#1e88e5","segments":[{"text":"应当附加剥夺","bbox":[596.83,268.943,88.102,14.684],"color":"#1e88e5"}],"nodeIds":["law-p025-n0025"],"aliases":[],"context":"____政治权利：对于____的犯罪分子，以及对"},{"id":"law-p02