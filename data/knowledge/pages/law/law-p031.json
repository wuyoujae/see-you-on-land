{"id":"law-p031","bookId":"law","number":31,"title":"第二章刑法十一、贪污贿赂罪","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p031.svg","dataUrl":"data/knowledge/pages/law/law-p031.json","questionCount":25,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":31},"nodes":[{"id":"law-p031-n0001","text":"第二章","bbox":[64.892,407.688,49.704,16.568],"color":"#141414","fontSize":16.568,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0002","text":"刑法","bbox":[118.844,407.688,33.136,16.568],"color":"#141414","fontSize":16.568,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0003","text":"十一、贪污贿赂罪","bbox":[207.102,408.387,117.818,14.727],"color":"#141414","fontSize":14.727,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p031-n0004","text":"受贿罪","bbox":[390.579,268.478,44.182,14.727],"color":"#ce4289","fontSize":14.727,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0005","text":"含义","bbox":[469.738,204.507,29.454,14.727],"color":"#141414","fontSize":14.727,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0006","text":"指国家工作人员，利用职务上的便利，索取他人财物","bbox":[534.17,183.336,338.727,14.727],"color":"#ce4289","fontSize":14.727,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0007","text":"或非法收受他人财物并为他人谋取利益的行为","bbox":[534.17,225.677,294.545,14.727],"color":"#ce4289","fontSize":14.727,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0008","text":"认定","bbox":[469.738,332.45,29.454,14.727],"color":"#141414","fontSize":14.727,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0009","text":"①","bbox":[534.17,268.018,14.727,14.727],"color":"#141414","fontSize":14.727,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0010","text":"“","bbox":[548.897,262.576,5.096,14.727],"color":"#1e88e5","fontSize":14.727,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0011","text":"为他人谋取利益","bbox":[554.003,268.018,103.091,14.727],"color":"#1e88e5","fontSize":14.727,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0012","text":"”","bbox":[657.094,262.576,5.096,14.727],"color":"#1e88e5","fontSize":14.727,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0013","text":"既包括","bbox":[662.199,268.018,44.182,14.727],"color":"#141414","fontSize":14.727,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0014","text":"正当","bbox":[706.381,268.018,29.454,14.727],"color":"#1e88e5","fontSize":14.727,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0015","text":"利益，也包括","bbox":[735.835,268.018,88.363,14.727],"color":"#141414","fontSize":14.727,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0016","text":"不正当","bbox":[824.199,268.018,44.182,14.727],"color":"#1e88e5","fontSize":14.727,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0017","text":"利益","bbox":[868.381,268.018,29.454,14.727],"color":"#141414","fontSize":14.727,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0018","text":"②国家工作人员在经济往来中，违反国家规定，","bbox":[534.17,310.359,309.272,14.727],"color":"#141414","fontSize":14.727,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0019","text":"收受各种","bbox":[843.442,310.359,58.909,14.727],"color":"#1e88e5","fontSize":14.727,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0020","text":"名义的回扣、手续费，归个人所有","bbox":[534.17,332.45,220.909,14.992],"color":"#1e88e5","fontSize":14.727,"block":7,"line":1,"emphasis":true,"role":"content"},{"id":"law-p031-n0021","text":"的，以受贿论处","bbox":[755.079,332.45,103.091,14.727],"color":"#141414","fontSize":14.727,"block":7,"line":1,"emphasis":false,"role":"content"},{"id":"law-p031-n0022","text":"③","bbox":[534.17,374.79,14.727,14.727],"color":"#141414","fontSize":14.727,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0023","text":"斡旋受贿","bbox":[548.897,374.79,58.909,14.727],"color":"#ff6f00","fontSize":14.727,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0024","text":"：国家工作人员","bbox":[607.806,374.79,103.091,14.727],"color":"#141414","fontSize":14.727,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0025","text":"利用本人职权","bbox":[710.897,374.79,88.364,14.727],"color":"#ff6f00","fontSize":14.727,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0026","text":"或者地位形成的便利条件，通过","bbox":[799.26,374.79,206.182,14.727],"color":"#141414","fontSize":14.727,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0027","text":"其他国家工作人员职","bbox":[1005.442,374.79,132.545,14.727],"color":"#ff6f00","fontSize":14.727,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0028","text":"务上","bbox":[534.17,396.881,29.455,14.727],"color":"#ff6f00","fontSize":14.727,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0029","text":"的行为，为请托人谋取","bbox":[563.624,396.881,147.272,14.727],"color":"#141414","fontSize":14.727,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0030","text":"不正当利益","bbox":[710.897,396.881,73.636,14.727],"color":"#ff6f00","fontSize":14.727,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0031","text":"，索取请托人财物或者收受请托人财物的，以受贿论处","bbox":[784.533,396.881,353.454,14.727],"color":"#141414","fontSize":14.727,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0032","text":"行贿罪","bbox":[390.579,513.319,44.182,14.727],"color":"#19a719","fontSize":14.727,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0033","text":"含义","bbox":[469.738,460.393,29.454,14.727],"color":"#141414","fontSize":14.727,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0034","text":"指为谋取不正当利益，给予国家工作人员以财物的行为","bbox":[534.17,439.222,353.454,14.727],"color":"#19a719","fontSize":14.727,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0035","text":"“","bbox":[534.17,476.122,5.096,14.727],"color":"#19a719","fontSize":14.727,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0036","text":"不正当利益","bbox":[539.268,481.563,73.636,14.727],"color":"#19a719","fontSize":14.727,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0037","text":"”","bbox":[612.905,476.122,5.096,14.727],"color":"#19a719","fontSize":14.727,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0038","text":"不限于非法利益，获取不公平的竞争优势也属于不正当利益","bbox":[618.003,481.563,382.909,14.727],"color":"#19a719","fontSize":14.727,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0039","text":"认定","bbox":[469.738,566.245,29.454,14.727],"color":"#141414","fontSize":14.727,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0040","text":"①因","bbox":[534.17,523.904,29.455,14.727],"color":"#141414","fontSize":14.727,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0041","text":"被勒索","bbox":[563.624,523.904,44.182,14.727],"color":"#e53935","fontSize":14.727,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0042","text":"给予财物，","bbox":[607.806,523.904,73.636,14.727],"color":"#141414","fontSize":14.727,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0043","text":"没有获得","bbox":[681.442,523.904,58.909,14.727],"color":"#e53935","fontSize":14.727,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0044","text":"不正当利益的，","bbox":[740.351,523.904,103.091,14.727],"color":"#141414","fontSize":14.727,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0045","text":"不是","bbox":[843.442,523.904,29.454,14.727],"color":"#e53935","fontSize":14.727,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0046","text":"行贿","bbox":[872.897,523.904,29.454,14.727],"color":"#141414","fontSize":14.727,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0047","text":"②为了","bbox":[534.17,566.245,44.182,14.727],"color":"#141414","fontSize":14.727,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0048","text":"谋取正当利益","bbox":[578.352,566.245,88.364,14.727],"color":"#e53935","fontSize":14.727,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0049","text":"而给予国家工作人员财物的，","bbox":[666.715,566.245,191.454,14.727],"color":"#141414","fontSize":14.727,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0050","text":"不是","bbox":[858.169,566.245,29.455,14.727],"color":"#e53935","fontSize":14.727,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0051","text":"行贿","bbox":[887.624,566.245,29.454,14.727],"color":"#141414","fontSize":14.727,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0052","text":"③在","bbox":[534.17,608.586,29.455,14.727],"color":"#141414","fontSize":14.727,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0053","text":"经济往来","bbox":[563.624,608.586,58.909,14.727],"color":"#e53935","fontSize":14.727,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0054","text":"中，违反国家规定，给予国家工作人员以财物，","bbox":[622.533,608.586,309.272,14.727],"color":"#141414","fontSize":14.727,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0055","text":"数额较大","bbox":[931.806,608.586,58.909,14.727],"color":"#e53935","fontSize":14.727,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0056","text":"的，或者","bbox":[990.715,608.586,58.909,14.727],"color":"#141414","fontSize":14.727,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0057","text":"违反国家规定，给予国家工作人员以各种名义的","bbox":[534.17,630.677,309.272,14.727],"color":"#141414","fontSize":14.727,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0058","text":"回扣、手续费","bbox":[843.442,630.677,88.364,14.727],"color":"#e53935","fontSize":14.727,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0059","text":"的，以","bbox":[931.806,630.677,44.182,14.727],"color":"#141414","fontSize":14.727,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0060","text":"行贿","bbox":[975.987,630.677,29.454,14.727],"color":"#e53935","fontSize":14.727,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p031-n0061","text":"论处","bbox":[1005.442,630.677,29.454,14.727],"color":"#141414","fontSize":14.727,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p031-n0062","text":"31","bbox":[587.275,810.711,16.0,21.344],"color":"#000000","fontSize":16.0,"block":19,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"law-p031-b0001","text":"第二章刑法十一、贪污贿赂罪","bbox":[64.892,407.688,260.028,16.568],"nodeIds":["law-p031-n0001","law-p031-n0002","law-p031-n0003"]},{"id":"law-p031-b0002","text":"受贿罪","bbox":[390.579,268.478,44.182,14.727],"nodeIds":["law-p031-n0004"]},{"id":"law-p031-b0003","text":"含义","bbox":[469.738,204.507,29.454,14.727],"nodeIds":["law-p031-n0005"]},{"id":"law-p031-b0004","text":"指国家工作人员，利用职务上的便利，索取他人财物","bbox":[534.17,183.336,338.727,14.727],"nodeIds":["law-p031-n0006"]},{"id":"law-p031-b0005","text":"或非法收受他人财物并为他人谋取利益的行为","bbox":[534.17,225.677,294.545,14.727],"nodeIds":["law-p031-n0007"]},{"id":"law-p031-b0006","text":"认定","bbox":[469.738,332.45,29.454,14.727],"nodeIds":["law-p031-n0008"]},{"id":"law-p031-b0007","text":"①“为他人谋取利益”既包括正当利益，也包括不正当利益","bbox":[534.17,262.576,363.665,20.169],"nodeIds":["law-p031-n0009","law-p031-n0010","law-p031-n0011","law-p031-n0012","law-p031-n0013","law-p031-n0014","law-p031-n0015","law-p031-n0016","law-p031-n0017"]},{"id":"law-p031-b0008","text":"②国家工作人员在经济往来中，违反国家规定，收受各种名义的回扣、手续费，归个人所有的，以受贿论处","bbox":[534.17,310.359,368.181,37.083],"nodeIds":["law-p031-n0018","law-p031-n0019","law-p031-n0020","law-