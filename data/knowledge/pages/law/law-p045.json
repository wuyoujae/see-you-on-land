aw-p045-n0034","text":"中央军事委员会其他组成人员的人选；根据国家监察委员会主任的提请，任免国家监","bbox":[656.529,303.923,455.792,12.824],"color":"#141414","fontSize":12.319,"block":14,"line":2,"emphasis":false,"role":"content"},{"id":"law-p045-n0035","text":"察委员会副主任、委员；据最高人民法院院长的提请，任免最高人民法院副院长、审","bbox":[656.529,321.521,455.792,12.824],"color":"#141414","fontSize":12.319,"block":14,"line":3,"emphasis":false,"role":"content"},{"id":"law-p045-n0036","text":"判员、审判委员会委员和军事法院院长；根据最高人民检察院检察长的提请，任免最","bbox":[656.529,339.119,455.792,12.824],"color":"#141414","fontSize":12.319,"block":14,"line":4,"emphasis":false,"role":"content"},{"id":"law-p045-n0037","text":"高人民检察院副检察长、检察员、检察委员会委员和军事检察院检察长，并且批准","bbox":[656.529,356.718,443.473,12.319],"color":"#141414","fontSize":12.319,"block":14,"line":5,"emphasis":false,"role":"content"},{"id":"law-p045-n0038","text":"省、自治区、直辖市的人民检察院检察长的任免","bbox":[656.529,374.316,258.693,12.319],"color":"#141414","fontSize":12.319,"block":14,"line":6,"emphasis":false,"role":"content"},{"id":"law-p045-n0039","text":"④","bbox":[522.783,436.12,14.078,14.079],"color":"#141414","fontSize":14.079,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p045-n0040","text":"重大事务","bbox":[536.861,436.12,56.314,14.079],"color":"#1e88e5","fontSize":14.079,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p045-n0041","text":"决定权","bbox":[536.861,457.238,42.236,14.079],"color":"#141414","fontSize":14.079,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p045-n0042","text":"决定特赦","bbox":[626.612,412.363,56.314,14.079],"color":"#1e88e5","fontSize":14.079,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p045-n0043","text":"决定全国总动员或者局部动员","bbox":[716.362,412.363,183.021,14.079],"color":"#1e88e5","fontSize":14.079,"block":17,"line":1,"emphasis":true,"role":"content"},{"id":"law-p045-n0044","text":"决定全国或者个别省","bbox":[626.612,457.238,126.707,14.079],"color":"#1e88e5","fontSize":14.079,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p045-n0045","text":"、自治区、直辖市进入","bbox":[753.319,457.238,140.785,14.079],"color":"#141414","fontSize":14.079,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p045-n0046","text":"紧急状态","bbox":[894.104,457.238,56.314,14.079],"color":"#1e88e5","fontSize":14.079,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p045-n0047","text":"在全国人民代表大会闭会期间，如果遇到国家遭受武装侵犯或者","bbox":[626.612,497.714,394.198,14.079],"color":"#141414","fontSize":14.079,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p045-n0048","text":"必须履行国际间共同防止侵略的条约的情况，","bbox":[626.612,518.832,281.57,14.078],"color":"#141414","fontSize":14.079,"block":19,"line":1,"emphasis":false,"role":"content"},{"id":"law-p045-n0049","text":"决定战争状态","bbox":[908.182,518.832,84.471,14.078],"color":"#1e88e5","fontSize":14.079,"block":19,"line":1,"emphasis":true,"role":"content"},{"id":"law-p045-n0050","text":"的宣布","bbox":[992.653,518.832,42.236,14.078],"color":"#141414","fontSize":14.079,"block":19,"line":1,"emphasis":false,"role":"content"},{"id":"law-p045-n0051","text":"中华人民","bbox":[378.478,633.219,56.314,14.078],"color":"#e53935","fontSize":14.079,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p045-n0052","text":"共和国主席","bbox":[371.439,654.337,70.393,14.078],"color":"#e53935","fontSize":14.079,"block":20,"line":1,"emphasis":true,"role":"content"},{"id":"law-p045-n0053","text":"性质","bbox":[475.268,579.545,28.157,14.078],"color":"#e53935","fontSize":14.079,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"law-p045-n0054","text":"是一个","bbox":[536.861,559.307,42.236,14.078],"color":"#141414","fontSize":14.079,"block":22,"line":0,"emphasis":false,"role":"content"},{"id":"law-p045-n0055","text":"独立的国家机关","bbox":[579.097,559.307,98.549,14.078],"color":"#e53935","fontSize":14.079,"block":22,"line":0,"emphasis":true,"role":"content"},{"id":"law-p045-n0056","text":"，对内、对外代表国家；是我国的国家元首","bbox":[677.647,559.307,267.492,14.656],"color":"#141414","fontSize":14.079,"bl