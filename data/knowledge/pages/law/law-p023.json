{"id":"law-p023","bookId":"law","number":23,"title":"第二章刑法七、刑罚","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p023.svg","dataUrl":"data/knowledge/pages/law/law-p023.json","questionCount":33,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":23},"nodes":[{"id":"law-p023-n0001","text":"第二章","bbox":[68.312,400.866,52.324,17.441],"color":"#141414","fontSize":17.441,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0002","text":"刑法","bbox":[125.107,400.866,34.883,17.441],"color":"#141414","fontSize":17.441,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0003","text":"七、刑罚","bbox":[218.016,401.602,62.014,15.503],"color":"#141414","fontSize":15.503,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p023-n0004","text":"主刑","bbox":[349.149,383.192,31.007,15.503],"color":"#8e24aa","fontSize":15.503,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0005","text":"管制","bbox":[416.976,160.331,31.007,15.503],"color":"#1e88e5","fontSize":15.503,"block":2,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0006","text":"对犯罪分子","bbox":[484.803,71.187,77.517,15.503],"color":"#141414","fontSize":15.503,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0007","text":"不实行关押","bbox":[562.32,71.187,77.517,15.503],"color":"#1e88e5","fontSize":15.503,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0008","text":"，依法实行","bbox":[639.837,71.187,77.517,15.503],"color":"#141414","fontSize":15.503,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0009","text":"社区矫正","bbox":[717.354,71.187,62.013,15.503],"color":"#1e88e5","fontSize":15.503,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0010","text":"，限制其一定自由","bbox":[779.367,71.187,124.027,15.503],"color":"#141414","fontSize":15.503,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0011","text":"①管制的期限为","bbox":[484.803,115.759,108.524,15.503],"color":"#141414","fontSize":15.503,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0012","text":"3","bbox":[597.339,109.956,12.961,15.503],"color":"#1e88e5","fontSize":15.503,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0013","text":"个月以上","bbox":[610.299,115.759,62.013,15.503],"color":"#1e88e5","fontSize":15.503,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0014","text":"2","bbox":[672.312,109.956,17.348,15.503],"color":"#1e88e5","fontSize":15.503,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0015","text":"年以下","bbox":[689.678,115.759,46.51,15.503],"color":"#1e88e5","fontSize":15.503,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0016","text":"，数罪并罚时不得超过","bbox":[736.188,115.759,155.034,15.503],"color":"#141414","fontSize":15.503,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0017","text":"3","bbox":[895.204,109.956,12.961,15.503],"color":"#1e88e5","fontSize":15.503,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0018","text":"年","bbox":[908.164,115.759,15.503,15.503],"color":"#1e88e5","fontSize":15.503,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0019","text":"②管制的刑期，从","bbox":[484.803,160.331,124.027,15.503],"color":"#141414","fontSize":15.503,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0020","text":"判决执行之日","bbox":[608.83,160.331,93.02,15.503],"color":"#1e88e5","fontSize":15.503,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0021","text":"起计算；判决执行以前先行羁押的，","bbox":[701.851,160.331,248.054,16.139],"color":"#141414","fontSize":15.503,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0022","text":"羁押一日折抵刑期二日","bbox":[949.905,160.331,155.034,15.503],"color":"#1e88e5","fontSize":15.503,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0023","text":"③对于被判处管制的犯罪分子，在劳动中应当","bbox":[484.803,204.904,310.068,15.503],"color":"#141414","fontSize":15.503,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0024","text":"同工同酬","bbox":[794.871,204.904,62.013,15.503],"color":"#1e88e5","fontSize":15.503,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0025","text":"④对被判处管制的犯罪分子依法实行社区矫正","bbox":[484.803,249.476,310.068,15.503],"color":"#141414","fontSize":15.503,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0026","text":"拘役","bbox":[416.976,383.192,31.007,15.503],"color":"#19a719","fontSize":15.503,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0027","text":"剥夺犯罪分子短期人身自由，就近实行","bbox":[484.803,294.048,263.557,15.503],"color":"#141414","fontSize":15.503,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0028","text":"强制劳动改造","bbox":[748.361,294.048,93.02,15.503],"color":"#19a719","fontSize":15.503,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0029","text":"的刑罚方法","bbox":[841.381,294.048,77.517,15.503],"color":"#141414","fontSize":15.503,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0030","text":"①拘役的期限为","bbox":[484.803,338.62,108.524,15.503],"color":"#141414","fontSize":15.503,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0031","text":"1","bbox":[597.339,332.817,10.976,15.503],"color":"#19a719","fontSize":15.503,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0032","text":"个月以上","bbox":[608.316,338.62,62.013,15.503],"color":"#19a719","fontSize":15.503,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0033","text":"6","bbox":[670.329,332.817,17.1,15.503],"color":"#19a719","fontSize":15.503,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0034","text":"个月以下","bbox":[687.437,338.62,62.013,15.503],"color":"#19a719","fontSize":15.503,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0035","text":"，数罪并罚时不超过","bbox":[749.451,338.62,139.53,15.503],"color":"#141414","fontSize":15.503,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0036","text":"1","bbox":[892.963,332.817,10.976,15.503],"color":"#19a719","fontSize":15.503,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0037","text":"年","bbox":[903.94,338.62,15.503,15.503],"color":"#19a719","fontSize":15.503,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0038","text":"②拘役的刑期，从","bbox":[484.803,383.192,124.027,15.503],"color":"#141414","fontSize":15.503,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0039","text":"判决执行之日","bbox":[608.83,383.192,93.02,15.503],"color":"#19a719","fontSize":15.503,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0040","text":"起计算；判决执行以前先行羁押的，","bbox":[701.851,383.192,248.054,16.139],"color":"#141414","fontSize":15.503,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0041","text":"羁押一日折抵刑期一日","bbox":[949.905,383.192,155.034,15.503],"color":"#19a719","fontSize":15.503,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0042","text":"③由","bbox":[484.803,427.764,31.007,15.503],"color":"#141414","fontSize":15.503,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0043","text":"公安机关","bbox":[515.81,427.764,62.013,15.503],"color":"#19a719","fontSize":15.503,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0044","text":"就近执行","bbox":[577.824,427.764,62.013,15.503],"color":"#141414","fontSize":15.503,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0045","text":"④被判处拘役的犯罪分子","bbox":[484.803,472.337,170.537,15.503],"color":"#141414","fontSize":15.503,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0046","text":"每月可以回家一至两天","bbox":[655.34,472.337,155.034,15.503],"color":"#19a719","fontSize":15.503,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0047","text":"；参加劳动的，可以","bbox":[810.374,472.337,139.53,16.139],"color":"#141414","fontSize":15.503,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0048","text":"酌量发","bbox":[949.905,472.337,46.51,15.503],"color":"#19a719","fontSize":15.503,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0049","text":"给报酬","bbox":[996.415,472.337,46.51,15.503],"color":"#141414","fontSize":15.503,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0050","text":"有期","bbox":[416.976,606.053,31.007,15.503],"color":"#ff6f00","fontSize":15.503,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0051","text":"徒刑","bbox":[416.976,629.308,31.007,15.503],"color":"#ff6f00","fontSize":15.503,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0052","text":"剥夺犯罪分子一定期限的人身自由，实行","bbox":[484.803,516.909,279.061,15.503],"color":"#141414","fontSize":15.503,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0053","text":"强制劳动","bbox":[763.864,516.909,62.013,15.503],"color":"#ff6f00","fontSize":15.503,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0054","text":"改造","bbox":[825.878,516.909,31.007,15.503],"color":"#141414","fontSize":15.503,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0055","text":"①有期徒刑的期限为","bbox":[484.803,561.481,139.53,15.503],"color":"#141414","fontSize":15.503,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0056","text":"6","bbox":[628.316,555.678,13.131,15.503],"color":"#ff6f00","fontSize":15.503,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0057","text":"个月以上","bbox":[641.449,561.481,62.014,15.503],"color":"#ff6f00","fontSize":15.503,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0058","text":"15","bbox":[703.463,555.678,23.891,15.503],"color":"#ff6f00","fontSize":15.503,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0059","text":"年以下","bbox":[727.354,561.481,46.51,15.503],"color":"#ff6f00","fontSize":15.503,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0060","text":"。","bbox":[773.872,561.481,15.503,15.503],"color":"#141414","fontSize":15.503,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0061","text":"数罪","bbox":[789.375,561.481,31.007,15.503],"color":"#ff6f00","fontSize":15.503,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0062","text":"并罚时，有期徒刑","bbox":[820.382,561.481,124.027,15.503],"color":"#141414","fontSize":15.503,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0063","text":"总和不满","bbox":[944.409,561.481,62.013,15.503],"color":"#ff6f00","fontSize":15.503,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0064","text":"35","bbox":[484.803,578.933,21.906,15.503],"color":"#ff6f00","fontSize":15.503,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0065","text":"年","bbox":[506.703,584.736,15.503,15.503],"color":"#ff6f00","fontSize":15.503,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0066","text":"，最高不能超过","bbox":[522.214,584.736,108.524,15.503],"color":"#141414","fontSize":15.503,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p023-n0067","text":"20","bbox":[634.75,578.933,22.712,15.503],"color":"#ff6f00","fontSize":15.503,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0068","text":"年，总和刑期在","bbox":[657.468,584.736,108.531,15.503],"color":"#ff6f00","fontSize":15.503,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0069","text":"35","bbox":[765.999,578.933,25.875,15.503],"color":"#ff6f00","fontSize":15.503,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p023-n0070","text":"年以上","bbox":[791.873,584.736,46.51