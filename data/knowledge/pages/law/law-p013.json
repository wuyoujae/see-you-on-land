{"id":"law-p013","bookId":"law","number":13,"title":"第一章民法八、侵权责任","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p013.svg","dataUrl":"data/knowledge/pages/law/law-p013.json","questionCount":24,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":13},"nodes":[{"id":"law-p013-n0001","text":"第一章","bbox":[66.234,367.906,51.617,17.206],"color":"#141414","fontSize":17.206,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0002","text":"民法","bbox":[122.261,367.906,34.411,17.206],"color":"#141414","fontSize":17.206,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0003","text":"八、侵权责任","bbox":[213.916,368.633,91.764,15.294],"color":"#141414","fontSize":15.294,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p013-n0004","text":"饲养动物","bbox":[373.866,183.193,61.176,15.294],"color":"#1e88e5","fontSize":15.294,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0005","text":"损害责任","bbox":[373.866,206.134,61.176,15.294],"color":"#1e88e5","fontSize":15.294,"block":2,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0006","text":"对于","bbox":[471.365,139.223,30.588,15.294],"color":"#000000","fontSize":15.294,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0007","text":"一般主体","bbox":[501.953,139.223,61.176,15.294],"color":"#1e88e5","fontSize":15.294,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0008","text":"饲养的动物致人损害，由动物饲养人或管理人承担","bbox":[563.128,139.223,336.468,15.294],"color":"#000000","fontSize":15.294,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0009","text":"无过错","bbox":[899.596,139.223,45.882,15.294],"color":"#1e88e5","fontSize":15.294,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0010","text":"责任","bbox":[945.478,139.223,30.588,15.294],"color":"#000000","fontSize":15.294,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0011","text":"对于","bbox":[471.365,183.193,30.588,15.294],"color":"#000000","fontSize":15.294,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0012","text":"动物园","bbox":[501.953,183.193,45.882,15.294],"color":"#1e88e5","fontSize":15.294,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0013","text":"饲养的动物致人损害，则适用","bbox":[547.835,183.193,198.822,15.294],"color":"#000000","fontSize":15.294,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0014","text":"过错推定","bbox":[746.656,183.193,61.176,15.294],"color":"#1e88e5","fontSize":15.294,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0015","text":"责任。动物园","bbox":[807.832,183.193,91.764,15.294],"color":"#000000","fontSize":15.294,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0016","text":"应当承担侵权责任，但能够证明","bbox":[471.365,206.134,214.116,15.294],"color":"#000000","fontSize":15.294,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0017","text":"尽到管理职责的，不承担","bbox":[685.48,206.134,168.234,15.569],"color":"#1e88e5","fontSize":15.294,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0018","text":"责任","bbox":[853.714,206.134,30.588,15.294],"color":"#000000","fontSize":15.294,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0019","text":"因","bbox":[471.365,250.105,15.294,15.294],"color":"#000000","fontSize":15.294,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0020","text":"第三人的过错","bbox":[486.659,250.105,91.764,15.294],"color":"#1e88e5","fontSize":15.294,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0021","text":"致使动物造成他人损害的，被侵权人可以向动物","bbox":[578.422,250.105,321.174,15.294],"color":"#000000","fontSize":15.294,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0022","text":"饲养人或者管理人","bbox":[899.596,250.105,122.352,15.294],"color":"#1e88e5","fontSize":15.294,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0023","text":"请求","bbox":[1021.948,250.105,30.588,15.294],"color":"#000000","fontSize":15.294,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0024","text":"赔偿，也可以向","bbox":[471.365,273.045,107.058,15.294],"color":"#000000","fontSize":15.294,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"law-p013-n0025","text":"第三人","bbox":[578.422,273.045,45.882,15.294],"color":"#1e88e5","fontSize":15.294,"block":6,"line":1,"emphasis":true,"role":"content"},{"id":"law-p013-n0026","text":"请求赔偿。动物饲养人或者管理人赔偿后，有权向第三人","bbox":[624.304,273.045,382.349,15.294],"color":"#000000","fontSize":15.294,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"law-p013-n0027","text":"追偿","bbox":[1006.654,273.045,30.588,15.294],"color":"#1e88e5","fontSize":15.294,"block":6,"line":1,"emphasis":true,"role":"content"},{"id":"law-p013-n0028","text":"教育机构","bbox":[373.866,471.867,61.176,15.294],"color":"#e53935","fontSize":15.294,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0029","text":"的责任","bbox":[381.513,494.808,45.882,15.294],"color":"#e53935","fontSize":15.294,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0030","text":"无民事行为能力人","bbox":[471.365,373.412,122.352,15.294],"color":"#19a719","fontSize":15.294,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0031","text":"在幼儿园、学校或者其他教育机构学习、生活期间受到人","bbox":[630.04,317.016,382.349,15.294],"color":"#000000","fontSize":15.294,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0032","text":"身损害的，","bbox":[630.04,339.957,76.47,15.294],"color":"#000000","fontSize":15.294,"block":10,"line":1,"emphasis":false,"role":"content"},{"id":"law-p013-n0033","text":"幼儿园、学校或者其他教育机构","bbox":[706.509,339.957,214.116,15.294],"color":"#19a719","fontSize":15.294,"block":10,"line":1,"emphasis":true,"role":"content"},{"id":"law-p013-n0034","text":"应当承担责任","bbox":[920.625,339.957,91.764,15.294],"color":"#000000","fontSize":15.294,"block":10,"line":1,"emphasis":false,"role":"content"},{"id":"law-p013-n0035","text":"但能够证明尽到教育、管理职责的，不承担责任","bbox":[630.04,383.927,321.174,15.294],"color":"#000000","fontSize":15.294,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0036","text":"此时教育机构承担","bbox":[630.04,406.868,122.352,15.294],"color":"#000000","fontSize":15.294,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0037","text":"过错推定","bbox":[752.391,406.868,61.176,15.294],"color":"#19a719","fontSize":15.294,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0038","text":"责任","bbox":[813.567,406.868,30.588,15.294],"color":"#000000","fontSize":15.294,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0039","text":"限制民事行为能力人","bbox":[471.365,494.808,137.646,15.294],"color":"#ff6f00","fontSize":15.294,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0040","text":"在学校或者其他教育机构学习、生活期间受到人身损害","bbox":[645.334,450.838,367.055,15.294],"color":"#000000","fontSize":15.294,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0041","text":"学校或者其他教育机构","bbox":[645.334,494.808,152.94,15.294],"color":"#000000","fontSize":15.294,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0042","text":"未尽到教育、管理职责","bbox":[798.273,494.808,152.94,15.294],"color":"#ff6f00","fontSize":15.294,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0043","text":"的，应当","bbox":[951.213,494.808,61.176,15.294],"color":"#000000","fontSize":15.294,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0044","text":"承担","bbox":[1012.389,494.808,30.588,15.294],"color":"#ff6f00","fontSize":15.294,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0045","text":"责任","bbox":[1042.977,494.808,30.588,15.294],"color":"#000000","fontSize":15.294,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0046","text":"此时教育机构适用过错责任原则","bbox":[645.334,538.778,214.116,15.294],"color":"#000000","fontSize":15.294,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0047","text":"无民事行为能力人或","bbox":[471.365,616.204,137.646,15.294],"color":"#8e24aa","fontSize":15.294,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0048","text":"限制民事行为能力人","bbox":[471.365,639.145,137.646,15.294],"color":"#8e24aa","fontSize":15.294,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0049","text":"在幼儿园、学校或者其他教育机构学习、生活期间，受到幼儿园、学校","bbox":[645.334,582.749,474.113,15.294],"color":"#000000","fontSize":15.294,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0050","text":"或者其他教育机构","bbox":[645.334,605.69,122.352,15.294],"color":"#000000","fontSize":15.294,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0051","text":"以外的人员","bbox":[767.685,605.69,76.47,15.294],"color":"#8e24aa","fontSize":15.294,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0052","text":"人身损害的，由","bbox":[844.155,605.69,107.058,15.294],"color":"#000000","fontSize":15.294,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0053","text":"侵权人承担","bbox":[951.213,605.69,76.47,15.294],"color":"#8e24aa","fontSize":15.294,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0054","text":"侵权责任","bbox":[1027.683,605.69,61.176,15.294],"color":"#000000","fontSize":15.294,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0055","text":"幼儿园、学校或者其他教育机构未尽到管理职责的，承担相应的补充责任","bbox":[645.334,649.66,489.407,15.294],"color":"#000000","fontSize":15.294,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0056","text":"幼儿园、学校或者其他教育机构承担补充责任后，可以向","bbox":[645.334,672.601,382.349,15.294],"color":"#000000","fontSize":15.294,"block":22,"line":0,"emphasis":false,"role":"content"},{"id":"law-p013-n0057","text":"第三人追偿","bbox":[1027.683,672.601,76.47,15.294],"color":"#8e24aa","fontSize":15.294,"block":22,"line":0,"emphasis":true,"role":"content"},{"id":"law-p013-n0058","text":"13","bbox":[587.275,810.711,16.0,21.344],"color":"#000000","fontSize":16.0,"block":23,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"law-p013-b0001","text":"第一章民法八、侵权责任","bbox":[66.234,367.906,239.446,17.206],"nodeIds":["law-p013-n0001","law-p013-n0002","law-p013-n0003"]},{"id":"law-p013-b0002","text":"饲养动物","bbox":[373.866,183.193,61.176,15.294],"nodeIds":["law-p013-n0004"]},{"id":"law-p013-b0003","text":"损害责任","bbox":[373.866,206.134,61.176,15.294],"nodeIds":["law-p013-n0005"]},{"id":"law-p013-b0004","text":"对于一般主体饲养的动物致人损害，由动物饲养人或管理人承担无过错责任","bbox":[471.365,139.223,504.701,15.294],"nodeIds":["law-p013-n0006","law-p013-n0007","law-p013-n0008","law-p013-n0009","law-p013-n0010"]},{"id":"law-p013-b0005","text":"对于动物园饲养的动物致人损害，则适用过错推定责任。动物园","bbox":[471.365,183.193,428.231,15.294],"nodeIds":["law-p013-n0011","law-p013-n0012","law-p013-n0013","law-p013-n0014","law-p013-n0015"]},{"id":"law-p013-b0006","text":"应当承担侵权责任，但能够证明尽到管理职责的，不承担责任","bbox":[471.365,206.134,412.937,15.569],"nodeIds":["law-p013-n0016","law-p013-n0017","law-p013-n0018"]},{"id":"law-p013-b0007","text":"因第三人的过错致使动物造成他人损害的，被侵权人可以向动物饲养人或者管理人请求赔偿，也可以向第三人请求赔偿。动物饲养人或者管理人赔偿后，有权向第三人追偿","bbox":[471.365,250.105,581.171,38.234],"nodeIds":["law-p013-n0019","law-p013-n0020","law-p013-n0021","law-p013-n0022","law-p013-n0023","law-p013-n0024","law-p013-n0025","law-p013-n0026","law-p013-n0027"]},{"id":"law-p013-b0008","text":"教育机构","bbox":[373.866,471.867,61.176,15.294],"nodeIds":["law-p013-n0028"]},{"id":"law-p013-b0009","text":"的责任","bbox":[381.513,494.808,45.882,15.294],"nodeIds":["law-p013-n0029"]},{"id":"law-p013-b0010","text":"无民事行为能力人","bbox":[471.365,373.412,122.352,15.294],"nodeIds":["law-p013-n0030"]},{"id":"law-p013-b0011","text":"在幼儿园、学校或者其他教育机构学习、生活期间受到人身损害的，幼儿园、学校或者其他教育机构应当承担责任","bbox":[630.04,317.016,382.349,38.235],"node