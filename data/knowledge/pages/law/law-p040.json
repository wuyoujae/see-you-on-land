{"id":"law-p040","bookId":"law","number":40,"title":"第三章行政法七、行政诉讼","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p040.svg","dataUrl":"data/knowledge/pages/law/law-p040.json","questionCount":15,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":40},"nodes":[{"id":"law-p040-n0001","text":"第三章","bbox":[59.305,351.417,45.877,15.292],"color":"#141414","fontSize":15.292,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0002","text":"行政法","bbox":[109.103,351.417,45.877,15.292],"color":"#141414","fontSize":15.292,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0003","text":"七、行政诉讼","bbox":[205.858,352.063,81.56,13.593],"color":"#141414","fontSize":13.593,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p040-n0004","text":"原则","bbox":[348.021,129.824,27.187,13.593],"color":"#8e24aa","fontSize":13.593,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0005","text":"①行政机关负责人出庭应诉原则","bbox":[407.492,87.77,190.306,13.593],"color":"#141414","fontSize":13.593,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0006","text":"（告官要见官）","bbox":[455.068,108.16,95.153,13.593],"color":"#141414","fontSize":13.593,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0007","text":"行政机关及其工作人员不得干预、阻碍人民法院受理","bbox":[630.082,67.38,312.646,13.593],"color":"#141414","fontSize":13.593,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0008","text":"行政案件；","bbox":[630.082,87.77,67.966,14.151],"color":"#141414","fontSize":13.593,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0009","text":"被诉行政机关负责人应当出庭应诉","bbox":[698.048,87.77,203.899,13.593],"color":"#8e24aa","fontSize":13.593,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0010","text":"；不能","bbox":[901.947,87.77,40.78,14.151],"color":"#141414","fontSize":13.593,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0011","text":"出庭的，应当","bbox":[630.082,108.16,81.56,13.593],"color":"#141414","fontSize":13.593,"block":5,"line":1,"emphasis":false,"role":"content"},{"id":"law-p040-n0012","text":"委托行政机关相应的工作人员","bbox":[711.641,108.16,176.713,13.593],"color":"#8e24aa","fontSize":13.593,"block":5,"line":1,"emphasis":true,"role":"content"},{"id":"law-p040-n0013","text":"出庭","bbox":[888.354,108.16,27.187,13.593],"color":"#141414","fontSize":13.593,"block":5,"line":1,"emphasis":false,"role":"content"},{"id":"law-p040-n0014","text":"②行政行为的合法性审查原则","bbox":[407.492,151.488,176.713,13.593],"color":"#141414","fontSize":13.593,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0015","text":"人民法院审理行政案件，对行政行为","bbox":[616.488,151.488,217.493,13.593],"color":"#141414","fontSize":13.593,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"law-p040-n0016","text":"是否合法","bbox":[833.981,151.488,54.373,13.593],"color":"#8e24aa","fontSize":13.593,"block":6,"line":1,"emphasis":true,"role":"content"},{"id":"law-p040-n0017","text":"进行审查","bbox":[888.354,151.488,54.373,13.593],"color":"#141414","fontSize":13.593,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"law-p040-n0018","text":"管辖","bbox":[348.021,273.403,27.187,13.593],"color":"#141414","fontSize":13.593,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0019","text":"中级人民法院","bbox":[407.492,214.357,81.56,13.593],"color":"#ff6f00","fontSize":13.593,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0020","text":"管辖","bbox":[489.051,214.357,27.187,13.593],"color":"#141414","fontSize":13.593,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0021","text":"对","bbox":[548.522,194.817,13.593,13.593],"color":"#141414","fontSize":13.593,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0022","text":"国务院部门或者县级以上地方人民政府","bbox":[562.115,194.817,231.086,13.593],"color":"#ff6f00","fontSize":13.593,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0023","text":"所作的行政行为提起诉讼的案件","bbox":[793.201,194.817,190.306,13.593],"color":"#141414","fontSize":13.593,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0024","text":"海关处理","bbox":[548.522,233.898,54.373,13.593],"color":"#ff6f00","fontSize":13.593,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0025","text":"的案件；","bbox":[602.895,233.898,54.373,14.151],"color":"#141414","fontSize":13.593,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0026","text":"本辖区内重大、复杂","bbox":[657.268,233.898,122.34,13.593],"color":"#ff6f00","fontSize":13.593,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0027","text":"的案件；其他法律规定由中级人民法院管辖的案件","bbox":[779.608,233.898,299.052,14.151],"color":"#141414","fontSize":13.593,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0028","text":"地域","bbox":[407.492,332.449,27.187,13.593],"color":"#1e88e5","fontSize":13.593,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0029","text":"管辖","bbox":[434.678,332.449,27.187,13.593],"color":"#141414","fontSize":13.593,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0030","text":"①一般地域管辖：","bbox":[494.149,272.978,108.746,14.151],"color":"#141414","fontSize":13.593,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0031","text":"原告就被告","bbox":[602.895,272.978,67.966,13.593],"color":"#1e88e5","fontSize":13.593,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0032","text":"②特殊地域管辖","bbox":[494.149,391.92,95.153,13.593],"color":"#141414","fontSize":13.593,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0033","text":"经复议的案件，可以由最初作出行政行为的机关所在","bbox":[621.586,312.059,312.646,13.593],"color":"#141414","fontSize":13.593,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0034","text":"地法院管辖，也可以由复议机关所在地人民法院管辖","bbox":[621.586,332.449,312.646,13.593],"color":"#141414","fontSize":13.593,"block":14,"line":1,"emphasis":false,"role":"content"},{"id":"law-p040-n0035","text":"对","bbox":[621.586,371.53,13.593,13.593],"color":"#141414","fontSize":13.593,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0036","text":"限制人身自由的行政强制措施","bbox":[635.179,371.53,176.713,13.593],"color":"#1e88e5","fontSize":13.593,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0037","text":"不服提起诉讼由","bbox":[811.892,371.53,95.153,13.593],"color":"#141414","fontSize":13.593,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0038","text":"被告所在地或原告所在","bbox":[907.045,371.53,135.933,13.593],"color":"#1e88e5","fontSize":13.593,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0039","text":"地","bbox":[621.586,391.92,13.593,13.593],"color":"#1e88e5","fontSize":13.593,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0040","text":"（包括原告户籍地、经常居住地和被限制人身自由地）人民法院管辖","bbox":[635.179,391.92,407.799,13.593],"color":"#141414","fontSize":13.593,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0041","text":"因不动产提起诉讼的由","bbox":[621.586,431.0,135.933,13.593],"color":"#141414","fontSize":13.593,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0042","text":"不动产所在地","bbox":[757.519,431.0,81.56,13.593],"color":"#1e88e5","fontSize":13.593,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0043","text":"人民法院管辖","bbox":[839.078,431.0,81.56,13.593],"color":"#141414","fontSize":13.593,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0044","text":"参加人","bbox":[348.021,542.017,40.78,13.593],"color":"#141414","fontSize":13.593,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0045","text":"行政诉讼原告：","bbox":[421.085,470.081,95.153,14.151],"color":"#141414","fontSize":13.593,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0046","text":"行政行为的相对人","bbox":[516.238,470.081,108.746,13.593],"color":"#19a719","fontSize":13.593,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"law-p040-n0047","text":"以及认为行政行为侵犯其合法权益，而依法向法院提起诉讼的公民、法人或者其他组织","bbox":[624.984,470.081,516.545,13.593],"color":"#141414","fontSize":13.593,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0048","text":"行政诉讼被告","bbox":[421.085,613.953,81.56,13.593],"color":"#141414","fontSize":13.593,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p040-n0049","text":"40","bbox":[587.275,810.711,16.0,21.344],"color":"#000000","fontSize":16.0,"block":21,"line":0,"emphasis":false,"role":"page-number"},{"id":"law-p040-r01-n001","text":"情形","bbox":[665.656,513.894,30.855,17.23],"color":"#141414","fontSize":17.23,"block":10019,"line":0,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.998879},{"id":"law-p040-r01-n002","text":"被告","bbox":[934.532,513.894,31.255,17.23],"color":"#141414","fontSize":17.23,"block":10019,"line":1,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.999943},{"id":"law-p040-r01-n003","text":"复议改变(只包括改变处理结果)","bbox":[609.958,539.138,199.954,12.422],"color":"#141414","fontSize":12.422,"block":10019,"line":2,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.991437},{"id":"law-p040-r01-n004","text":"复议机关","bbox":[921.709,537.536,57.301,15.628],"color":"#141414","fontSize":15.628,"block":10019,"line":3,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.999959},{"id":"law-p040-r01-n005","text":"复议维持","bbox":[680.883,560.777,58.503,16.028],"color":"#141414","fontSize":16.028,"block":10019,"line":4,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.999537},{"id":"law-p040-r01-n006","text":"原机关和复议机关","bbox":[894.461,561.979,112.599,12.823],"color":"#141414","fontSize":12.823,"block":10019,"line":5,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.999393},{"id":"law-p040-r01-n007","text":"复议后","bbox":[549.451,568.39,44.078,15.628],"color":"#141414","fontSize":15.628,"block":10019,"line":6,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.999981},{"id":"law-p040-r01-n008","text":"再起诉","bbox":[549.451,586.422,44.879,17.23],"color":"#141414","fontSize":17.23,"block":10019,"line":7,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.999741},{"id":"law-p040-r01-n009","text":"对复议机关不服，以复议机关为被告；","bbox":[828.745,583.617,235.216,12.823],"color":"#141414","fontSize":12.823,"block":10019,"line":8,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.984608},{"id":"law-p040-r01-n010","text":"复议机关不作为","bbox":[660.046,601.248,100.578,15.227],"color":"#141414","fontSize":15.227,"block":10019,"line":9,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.999943},{"id":"law-p040-r01-n011","text":"对原具体行政行为不服，以原机关为被","bbox":[828.344,602.05,244.432,13.624],"color":"#141414","fontSize":13.624,"block":10019,"line":10,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.999551},{"id":"law-p040-r01-n012","text":"告","bbox":[942.947,619.681,14.826,16.429],"color":"#141414","fontSize":16.429,"block":10019,"line":11,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.999992},{"id":"law-p040-r01-n013","text":"行政机关委托的组织所作出的行政行为","bbox":[558.667,642.521,244.032,13.624],"color":"#141414","fontSize":13.624,"block":10019,"line":12,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p040-r01","confidence":0.999939},{"id":"l