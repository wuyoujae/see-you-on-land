lor":"#1e88e5","fontSize":15.908,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0011","text":"在","bbox":[528.088,253.197,15.908,15.908],"color":"#141414","fontSize":15.908,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0012","text":"5","bbox":[548.081,247.242,13.251,15.908],"color":"#1e88e5","fontSize":15.908,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0013","text":"年内","bbox":[561.332,253.197,31.815,15.908],"color":"#1e88e5","fontSize":15.908,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0014","text":"再犯应当判处","bbox":[593.147,253.197,95.445,15.908],"color":"#141414","fontSize":15.908,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0015","text":"有期徒刑以上","bbox":[688.592,253.197,95.445,15.908],"color":"#1e88e5","fontSize":15.908,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0016","text":"刑罚之罪的犯罪分子","bbox":[784.037,253.197,143.168,15.908],"color":"#141414","fontSize":15.908,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0017","text":"特别累犯","bbox":[426.678,321.798,63.63,15.908],"color":"#19a719","fontSize":15.908,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0018","text":"危害国家安全犯罪、恐怖活动犯罪、黑社会性质的组织犯罪的犯罪分子","bbox":[528.088,298.931,493.133,15.908],"color":"#19a719","fontSize":15.908,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0019","text":"在刑罚","bbox":[528.088,344.665,47.723,15.908],"color":"#141414","fontSize":15.908,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0020","text":"执行完毕或者赦免","bbox":[575.81,344.665,127.26,15.908],"color":"#19a719","fontSize":15.908,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0021","text":"以后，","bbox":[703.071,344.665,47.723,15.908],"color":"#141414","fontSize":15.908,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0022","text":"在任何时候","bbox":[750.793,344.665,79.538,15.908],"color":"#19a719","fontSize":15.908,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0023","text":"再犯","bbox":[830.331,344.665,31.815,15.908],"color":"#141414","fontSize":15.908,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0024","text":"上述任一类","bbox":[862.146,344.665,79.538,15.908],"color":"#19a719","fontSize":15.908,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0025","text":"罪的情形","bbox":[941.683,344.665,63.63,15.908],"color":"#141414","fontSize":15.908,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0026","text":"累犯的处罚","bbox":[426.678,390.399,79.538,15.908],"color":"#ce4289","fontSize":15.908,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0027","text":"对累犯","bbox":[543.996,390.399,47.722,15.908],"color":"#141414","fontSize":15.908,"block":9,"line":1,"emphasis":false,"role":"content"},{"id":"law-p026-n0028","text":"应当从重","bbox":[591.718,390.399,63.63,15.908],"color":"#ce4289","fontSize":15.908,"block":9,"line":1,"emphasis":true,"role":"content"},{"id":"law-p026-n0029","text":"处罚，对累犯","bbox":[655.348,390.399,95.445,15.908],"color":"#141414","fontSize":15.908,"block":9,"line":1,"emphasis":false,"role":"content"},{"id":"law-p026-n0030","text":"不适用缓刑和假释","bbox":[750.793,390.399,127.26,15.908],"color":"#ce4289","fontSize":15.908,"block":9,"line":1,"emphasis":true,"role":"content"},{"id":"law-p026-n0031","text":"自首","bbox":[357.082,487.832,31.815,15.908],"color":"#8e24aa","fontSize":15.908,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0032","text":"是指犯罪以后","bbox":[426.678,441.104,95.445,15.908],"color":"#141414","fontSize":15.908,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0033","text":"自动投案，如实供述","bbox":[522.123,441.104,143.168,16.194],"color":"#8e24aa","fontSize":15.908,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0034","text":"自己罪行的行为，或被采取强制措施的犯罪嫌疑人","bbox":[665.29,441.104,349.965,15.908],"color":"#141414","fontSize":15.908,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0035","text":"被告人和正在服刑的罪犯，如实供述司法机关还未掌握的本人","bbox":[426.678,464.965,429.503,15.908],"color":"#141414","fontSize":15.908,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0036","text":"其他罪行","bbox":[856.18,464.965,63.63,15.908],"color":"#8e24aa","fontSize":15.908,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0037","text":"的行为","bbox":[919.81,464.965,47.723,15.908],"color":"#141414","fontSize":15.908,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0038","text":"对于自首的犯罪分子，","bbox":[426.678,510.7,159.075,15.907],"color":"#141414","fontSize":15.908,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0039","text":"可以从轻或者减轻处罚","bbox":[585.753,510.7,159.075,15.907],"color":"#8e24aa","fontSize":15.908,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0040","text":"。其中，犯罪较轻的，","bbox":[744.828,510.7,159.075,15.907],"color":"#141414","fontSize":15.908,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0041","text":"可以免除处罚","bbox":[903.903,510.7,95.445,15.907],"color":"#8e24aa","fontSize":15.908,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0042","text":"立功","bbox":[357.082,613.601,31.815,15.907],"color":"#ff6f00","fontSize":15.908,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0043","text":"是指犯罪分子","bbox":[426.678,579.301,95.445,15.907],"color":"#141414","fontSize":15.908,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0044","text":"揭发他人","bbox":[522.123,579.301,63.63,15.907],"color":"#ff6f00","fontSize":15.908,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0045","text":"的犯罪行为，查证属实的","bbox":[585.753,579.301,174.983,15.907],"color":"#141414","fontSize":15.908,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0046","text":"或者提供重要线索从而得以侦破其他案件的行为","bbox":[800.504,556.434,334.058,15.907],"color":"#141414","fontSize":15.908,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0047","text":"或者协助司法机关抓获其他嫌疑人的","bbox":[800.504,602.168,254.52,15.907],"color":"#141414","fontSize":15.908,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0048","text":"犯罪人有立功表现的，","bbox":[426.678,647.902,159.075,15.907],"color":"#141414","fontSize":15.908,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0049","text":"可以从轻或者减轻处罚","bbox":[585.753,647.902,159.075,15.907],"color":"#ff6f00","fontSize":15.908,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0050","text":"；有","bbox":[744.828,647.902,31.815,16.56],"color":"#141414","fontSize":15.908,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0051","text":"重大","bbox":[776.643,647.902,31.815,15.907],"color":"#ff6f00","fontSize":15.908,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0052","text":"立功表现的，","bbox":[808.458,647.902,95.445,15.907],"color":"#141414","fontSize":15.908,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p026-n0053","text":"可以减轻或者免除处罚","bbox":[903.903,647.902,159.075,15.907],"color":"#ff6f00","fontSize":15.908,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p026-n0054","text":"26","bbox":[587.275,810.711,16.0,21.344],"color":"#000000","fontSize":16.0,"block":19,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"law-p026-b0001","text":"第二章刑法八、量刑","bbox":[68.924,462.967,217.237,17.896],"nodeIds":["law-p026-n0001","law-p026-n0002","law-p026-n0003"]},{"id":"law-p026-b0002","text":"累犯","bbox":[357.082,276.064,31.815,15.908],"nodeIds":["law-p026-n0004"]},{"id":"law-p026-b0003","text":"是指因犯罪而受过一定的刑罚处罚，在刑罚执行完毕或者赦免以后，在法定期限内犯一定之罪的罪犯","bbox":[426.678,161.729,699.93,15.908],"nodeIds":["law-p026-n0005"]},{"id":"law-p026-b0004","text":"一般累犯","bbox":[426.678,230.33,63.63,15.908],"nodeIds":["law-p026-n0006"]},{"id":"law-p026-b0005","text":"被判处有期徒刑以上刑罚的犯罪分子，刑罚执行完毕或者赦免以后","bbox":[528.088,207.463,461.318,15.908],"nodeIds":["law-p026-n0007","law-p026-n0008","law-p026-n0009","law-p026-n0010"]},{"id":"law-p026-b0006","text":"在5年内再犯应当判处有期徒刑以上刑罚之罪的犯罪分子","bbox":[528.088,247.242,399.117,21.863],"nodeIds":["law-p026-n0011","law-p026-n0012","law-p026-n0013","law-p026-n0014","law-p026-n0015","law-p026-n0016"]},{"id":"law-p026-b0007","text":"特别累犯","bbox":[426.678,321.798,63.63,15.908],"nodeIds":["law-p026-n0017"]},{"id":"law-p026-b0008","text":"危害国家安全犯罪、恐怖活动犯罪、黑社会性质的组织犯罪的犯罪分子","bbox":[528.088,298.931,493.133,15.908],"nodeIds":["law-p026-n0018"]},{"id":"law-p026-b0009","text":"在刑罚执行完毕或者赦免以后，在任何时候再犯上述任一类罪的情形","bbox":[528.088,344.665,477.225,15.908],"nodeIds":["law-p026-n0019","law-p026-n0020","law-p026-n0021","law-p026-n0022","law-p026-n0023","law-p026-n0024","law-p026-n0025"]},{"id":"law-p026-b0010","text":"累犯的处罚对累犯应当从重处罚，对累犯不适用缓刑和假释","bbox":[426.678,390.399,451.375,15.908],"nodeIds":["law-p026-n0026","law-p026-n0027","law-p026-n0028","law-p026-n0029","law-p026-n0030"]},{"id":"law-p026-b0011","text":"自首","bbox":[357.082,487.832,31.815,15.908],"nodeIds":["law-p026-n0031"]},{"id":"law-p026-b0012","text":"是指犯罪以后自动投案，如实供述自己罪行的行为，或被采取强制措施的犯罪嫌疑人","bbox":[426.678,441.104,588.577,16.194],"nodeIds":["law-p026-n0032","law-p026-n0033","law-p026-n0034"]},{"id":"law-p026-b0013","text":"被告人和正在服刑的罪犯，如实供述司法机关还未掌握的本人其他罪行的行为","bbox":[426.678,464.965,540.855,15.908],"nodeIds":["law-p026-n0035","law-p026-n0036","law-p026-n0037"]},{"id":"law-p026-b0014","text":"对于自首的犯罪分子，可以从轻或者减轻处罚。其中，犯罪较轻的，可以免除处罚","bbox":[426.678,510.7,572.67,15.907],"nodeIds":["law-p026-n0038","law-p026-n0039","law-p026-n0040","law-p026-n0041"]},{"id":"law-p026-b0015","text":"立功","bbox":[357.082,613.601,31.815,15.907],"nodeIds":["law-p026-n0042"]},{"id":"law-p026-b0016","text":"是指犯罪分子揭发他人的犯罪行为，查证属实的","bbox":[426.678,579.301,334.058,15.907],"nodeIds":["law-p026-n0043","law-p026-n0044","law-