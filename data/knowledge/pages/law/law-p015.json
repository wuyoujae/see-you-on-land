33,15.109],"color":"#141414","fontSize":15.109,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0011","text":"罪刑相适应原则","bbox":[453.554,211.274,105.766,15.109],"color":"#8e24aa","fontSize":15.109,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p015-n0012","text":"刑罚的轻重，应当与犯罪分子所犯罪行和承担的刑事责任相适应","bbox":[595.205,211.274,423.065,15.109],"color":"#141414","fontSize":15.109,"block":8,"line":1,"emphasis":false,"role":"content"},{"id":"law-p015-n0013","text":"二、刑法的效力范围","bbox":[250.206,639.297,135.985,15.109],"color":"#141414","fontSize":15.109,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0014","text":"空间效力","bbox":[453.554,485.606,60.438,15.109],"color":"#000000","fontSize":15.109,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0015","text":"属地管辖","bbox":[549.877,300.987,60.438,15.109],"color":"#ff6f00","fontSize":15.109,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p015-n0016","text":"凡是在我国领域内犯罪，除法律有特别规定之外，一律适用我国刑法","bbox":[646.2,257.547,453.284,15.109],"color":"#141414","fontSize":15.109,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0017","text":"①","bbox":[646.2,300.987,15.109,15.109],"color":"#141414","fontSize":15.109,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0018","text":"“","bbox":[661.309,295.404,5.228,15.109],"color":"#141414","fontSize":15.109,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0019","text":"领域内","bbox":[666.54,300.987,45.328,15.109],"color":"#141414","fontSize":15.109,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0020","text":"”","bbox":[711.868,295.404,5.228,15.109],"color":"#141414","fontSize":15.109,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0021","text":"：","bbox":[717.099,300.987,15.109,15.109],"color":"#141414","fontSize":15.109,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0022","t