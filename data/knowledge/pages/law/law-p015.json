4","text":"犯罪的，适用我国刑法","bbox":[797.295,387.866,151.095,15.109],"color":"#141414","fontSize":15.109,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0035","text":"①最高刑为","bbox":[646.2,431.306,75.547,15.109],"color":"#141414","fontSize":15.109,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0036","text":"3","bbox":[725.657,425.65,12.632,15.109],"color":"#1e88e5","fontSize":15.109,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p015-n0037","text":"年以下","bbox":[738.288,431.306,45.328,15.109],"color":"#1e88e5","fontSize":15.109,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p015-n0038","text":"有期徒刑的，可以不予追究","bbox":[783.616,431.306,181.314,15.109],"color":"#141414","fontSize":15.109,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0039","text":"②国家工作人员和军人一律追究","bbox":[646.2,474.746,211.533,15.109],"color":"#1e88e5","fontSize":15.109,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p015-n0040","text":"保护管辖","bbox":[549.877,561.625,60.438,15.109],"color":"#19a719","fontSize":15.109,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"law-p015-n0041","text":"外国人","bbox":[646.2,518.186,45.328,15.109],"color":"#19a719","fontSize":15.109,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p015-n0042","text":"在中华人民共和国","bbox":[691.528,518.186,120.876,15.109],"color":"#141414","fontSize":15.109,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0043","text":"领域外对中国公民或者国家犯罪","bbox":[812.404,518.186,211.533,15.109],"color":"#19a719","fontSize":15.109,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p015-n0044","text":"①最低刑为","bbox":[646.2,561.625,75.547,15.109],"color":"#141414","fontSize":15.109,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"law-p015-n0045","text":"3","bbox":[721.747,555.969,16.5,15.109],"color":"#19a719","fontSize":15.109,"block":21,"line":0,"emphasis":true,"role":"content