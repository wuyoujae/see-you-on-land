{"id":"law-p006","bookId":"law","number":6,"title":"第一章民法四、物权","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p006.svg","dataUrl":"data/knowledge/pages/law/law-p006.json","questionCount":23,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":6},"nodes":[{"id":"law-p006-n0001","text":"第一章","bbox":[58.771,464.801,45.016,15.005],"color":"#141414","fontSize":15.005,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0002","text":"民法","bbox":[107.633,464.801,30.011,15.005],"color":"#141414","fontSize":15.005,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0003","text":"四、物权","bbox":[187.566,465.434,53.352,13.338],"color":"#141414","fontSize":13.338,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p006-n0004","text":"担保物权","bbox":[300.383,449.595,53.352,13.338],"color":"#141414","fontSize":13.338,"block":1,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0005","text":"抵押权","bbox":[385.413,244.315,40.014,13.338],"color":"#141414","fontSize":13.338,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0006","text":"①含义","bbox":[457.105,127.19,40.014,13.338],"color":"#141414","fontSize":13.338,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0007","text":"是指债权人对于债务人或者第三人","bbox":[528.797,107.183,200.07,13.338],"color":"#141414","fontSize":13.338,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0008","text":"不转移占有","bbox":[728.867,107.183,66.69,13.338],"color":"#ff6f00","fontSize":13.338,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0009","text":"而提供担保的财产，于债务人不履行债","bbox":[795.557,107.183,226.746,13.338],"color":"#141414","fontSize":13.338,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0010","text":"务或发生当事人约定的实现抵押权的情形时，依法享有的就该财产","bbox":[528.797,127.19,386.802,13.338],"color":"#141414","fontSize":13.338,"block":4,"line":1,"emphasis":false,"role":"content"},{"id":"law-p006-n0011","text":"优先受偿的权利","bbox":[915.599,127.19,93.366,13.338],"color":"#ff6f00","fontSize":13.338,"block":4,"line":1,"emphasis":true,"role":"content"},{"id":"law-p006-n0012","text":"②不能设立","bbox":[457.105,207.218,66.69,13.338],"color":"#e53935","fontSize":13.338,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0013","text":"抵押的财产","bbox":[457.105,227.226,66.69,13.338],"color":"#e53935","fontSize":13.338,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0014","text":"土地所有权","bbox":[555.473,169.705,66.69,13.338],"color":"#e53935","fontSize":13.338,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0015","text":"；宅基地、自留地、自留山等集体所有","bbox":[622.163,169.705,226.746,14.085],"color":"#000000","fontSize":13.338,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0016","text":"土地的使用权","bbox":[848.909,169.705,80.028,13.338],"color":"#e53935","fontSize":13.338,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0017","text":"，但是法律规定可以抵押的除外","bbox":[928.937,169.705,186.732,13.338],"color":"#000000","fontSize":13.338,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0018","text":"学校、幼儿园、医疗机构等为公益目的成立的非营利法人的教育设施、医疗卫生设施和其他","bbox":[555.473,208.052,533.521,13.338],"color":"#000000","fontSize":13.338,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0019","text":"公益设施","bbox":[1088.993,208.052,53.352,13.338],"color":"#e53935","fontSize":13.338,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0020","text":"所有权、使用权不明或者有争议的财产","bbox":[555.473,246.399,226.746,13.338],"color":"#e53935","fontSize":13.338,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0021","text":"依法被","bbox":[555.473,284.746,40.014,13.338],"color":"#000000","fontSize":13.338,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0022","text":"查封、扣押、监管","bbox":[595.487,284.746,106.704,13.338],"color":"#e53935","fontSize":13.338,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0023","text":"的财产；法律、行政法规规定不得抵押的其他财产","bbox":[702.191,284.746,293.436,13.885],"color":"#000000","fontSize":13.338,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0024","text":"③设立","bbox":[457.105,361.439,40.014,13.338],"color":"#141414","fontSize":13.338,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0025","text":"设立抵押权，当事人应当以","bbox":[528.797,323.093,160.056,13.338],"color":"#141414","fontSize":13.338,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0026","text":"书面形式","bbox":[688.853,323.093,53.352,13.338],"color":"#19a719","fontSize":13.338,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0027","text":"订立抵押合同","bbox":[742.205,323.093,80.028,13.338],"color":"#141414","fontSize":13.338,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0028","text":"以","bbox":[528.797,361.439,13.338,13.338],"color":"#141414","fontSize":13.338,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0029","text":"不动产","bbox":[542.135,361.439,40.014,13.338],"color":"#19a719","fontSize":13.338,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0030","text":"抵押，应当办理抵押物登记，","bbox":[582.149,361.439,173.394,13.338],"color":"#141414","fontSize":13.338,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0031","text":"抵押权自登记时设立","bbox":[755.543,361.439,120.042,13.338],"color":"#19a719","fontSize":13.338,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0032","text":"以","bbox":[528.797,399.786,13.338,13.338],"color":"#141414","fontSize":13.338,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0033","text":"动产","bbox":[542.135,399.786,26.676,13.338],"color":"#19a719","fontSize":13.338,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0034","text":"抵押的，抵押权自","bbox":[568.811,399.786,106.704,13.338],"color":"#141414","fontSize":13.338,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0035","text":"抵押合同生效时设立","bbox":[675.515,399.786,120.042,13.338],"color":"#19a719","fontSize":13.338,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0036","text":"；未经登记，不得对抗善意第三人","bbox":[795.557,399.786,200.07,13.885],"color":"#141414","fontSize":13.338,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0037","text":"以动产抵押的，不得对抗正常经营活动中已经支付合理价款并取得抵押财产的买受人","bbox":[528.797,419.793,493.507,13.338],"color":"#141414","fontSize":13.338,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0038","text":"质押权","bbox":[385.413,516.077,40.014,13.338],"color":"#8e24aa","fontSize":13.338,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0039","text":"①含义","bbox":[457.105,477.313,40.014,13.338],"color":"#141414","fontSize":13.338,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0040","text":"是指为了担保债务的履行，债务人或者第三人将其动产或者权利","bbox":[528.797,458.14,373.464,13.338],"color":"#141414","fontSize":13.338,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0041","text":"移交","bbox":[902.261,458.14,26.676,13.338],"color":"#8e24aa","fontSize":13.338,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0042","text":"债权人占有","bbox":[928.937,458.14,66.69,13.338],"color":"#141414","fontSize":13.338,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0043","text":"当债务人不履行债务时，债权人有就其占有的财产","bbox":[528.797,496.487,293.436,13.338],"color":"#141414","fontSize":13.338,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0044","text":"优先受偿的权利","bbox":[822.233,496.487,93.366,13.338],"color":"#8e24aa","fontSize":13.338,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0045","text":"②设立","bbox":[457.105,554.841,40.014,13.338],"color":"#141414","fontSize":13.338,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0046","text":"书面","bbox":[528.797,534.834,26.676,13.338],"color":"#141414","fontSize":13.338,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0047","text":"质押合同","bbox":[555.473,534.834,53.352,13.338],"color":"#8e24aa","fontSize":13.338,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0048","text":"；动产质权自出质人","bbox":[608.825,534.834,120.042,13.885],"color":"#141414","fontSize":13.338,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0049","text":"交付","bbox":[728.867,534.834,26.676,13.338],"color":"#8e24aa","fontSize":13.338,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0050","text":"质押财产时设","bbox":[755.543,534.834,80.028,13.338],"color":"#141414","fontSize":13.338,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0051","text":"立，权利质权自权利凭证交付或办理出质","bbox":[528.797,554.841,240.084,13.338],"color":"#141414","fontSize":13.338,"block":21,"line":1,"emphasis":false,"role":"content"},{"id":"law-p006-n0052","text":"登记","bbox":[768.881,554.841,26.676,13.338],"color":"#8e24aa","fontSize":13.338,"block":21,"line":1,"emphasis":true,"role":"content"},{"id":"law-p006-n0053","text":"时设立","bbox":[795.557,554.841,40.014,13.338],"color":"#141414","fontSize":13.338,"block":21,"line":1,"emphasis":false,"role":"content"},{"id":"law-p006-n0054","text":"留置权","bbox":[385.413,654.876,40.014,13.338],"color":"#1e88e5","fontSize":13.338,"block":22,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0055","text":"债权人按合同约定占有债务人的财产，债权","bbox":[457.105,597.355,253.422,13.338],"color":"#141414","fontSize":13.338,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0056","text":"已届清偿期","bbox":[710.527,597.355,66.69,13.338],"color":"#1e88e5","fontSize":13.338,"block":23,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0057","text":"在债务人逾期不履行债务时，有留置该财产以迫使债务人履行债务","bbox":[457.105,635.702,386.802,13.338],"color":"#141414","fontSize":13.338,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0058","text":"并在债务人仍不履行债务时就该财产优先受偿的权利","bbox":[457.105,674.049,306.774,13.338],"color":"#141414","fontSize":13.338,"block":25,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0059","text":"它是","bbox":[457.105,712.396,26.676,13.338],"color":"#141414","fontSize":13.338,"block":26,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0060","text":"法定担保物权，权利人","bbox":[483.781,712.396,133.38,13.578],"color":"#1e88e5","fontSize":13.338,"block":26,"line":0,"emphasis":true,"role":"content"},{"id":"law-p006-n0061","text":"不得擅自使用、出租、处分留置物","bbox":[617.161,712.396,200.07,13.338],"color":"#141414","fontSize":13.338,"block":26,"line":0,"emphasis":false,"role":"content"},{"id":"law-p006-n0062","text":"6","bbox":[591.275,810.711,8.0,21.344],"color":"#000000","fontSize":16.0,"block":27,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"law-p006-b0001","text":"第一章民法四、物权","bbox":[58.771,464.801,182.147,15.005],"nodeIds":["law-p006-n0001","law-p006-n0002","law-p006-n0003"]},{"id":"law-p006-b0002","text":"担保物权","bbox":[300.383,449.595,53.352,13.338],"nodeIds":["law-p006-n0004"]},{"id":"law-p006-b0003","text":"抵押权","bbox":[385.413,244.315,40.014,13.338],"nodeIds":["law-p006-n0005"]},{"id":"law-p006-b0004","text":"①含义","bbox":[457.105,127.19,40.014,13.338],"nodeIds":["law-p006-n0006"]},{"id":"law-p006-b0005","text":"是指债权人对于债务人或者第三人不转移占有而提供担保的财产，于债务人不履行债务或发生当事人约定的实现抵押权的情形时，依法享有的就该财产优先受偿的权利","bbox":[528.797,107.183,493.506,33.345],"nodeIds":["law-p006-n0007","law-p006-n0008","law-p006-n0009","law-p006-n0010","law-p006-n0011"]},{"id":"law-p006-b0006","text":"②不能设立","bbox":[457.105,207.218,66.69,13.338],"nodeIds":["law-p006-n0012"]},{"id":"law-p006-b0007","text":"抵押的财产","bbox":[457.105,227.226,66.69,13.338],"nodeIds":["law-p006-n0013"]},{"id":"law-p006-b0008","text":"土地所有权；宅基地、自留地、自留山等集体所有土地的使用权，但是法律规定可以抵押的除外","bbox":[555.473,169.705,560.196,14.085],"nodeIds":["law-p006-n0014","law-p006-n0015","law-p006-n0016","law-p006-n0017"]},{"id":"law-p006-b0009","text":"学校、幼儿园、医疗机构等为公益目的成立的非营利法人的教育设施、医疗卫生设施和其他公益设施","bbox":[555.473,208.052,586.872,13.338],"nodeIds":["law-p006-n0018","law-p006-n0019"]},{"id":"law-p006-b0010","text":"所有权、使用权不明或者有争议的财产","bbox":[555.473,246.399,226.746,13.338],"nodeIds":["law-p006-n0020"]},{"id":"law-p006-b0011","text":"依法被查封、扣押、监管的财产；法律、行政法规规定不得抵押的其他财产","bbox":[555.473,284.746,440.154,13.885],"nodeIds":["law-p006-n0021","law-p006-n0022","law-p006-n0023"]},{"id":"law-p006-b0012","text":"③设立","bbox":[457.105,361.439,40.014,13.338],"nodeIds":["law-p006-n0024"]},{"id":"law-p006-b0013","text":"设立抵押权，当事人应当以书面形式订立抵押合同","bbox":[528.797,323.093,293.436,13.338],"nodeIds":["law-p006-n0025","law-p006-n0026","law-p006-n0027"]},{"id":"law-p006-b0014","text":"以不动产抵押，应当办理抵押物登记，抵押权自登记时设立","bbox":[528.797,361.439,346.788,13.338],"nodeIds":["law-p006-n0028","law-p006-n0029","law-p006-n0030","law-p006-n0031"]},{"id":"law-p006-b0015","text":"以动产抵押的，抵押权自抵押合同生效时设立；未经登记，不得对抗善意第三人","bbox":[528.797,399.786,466.83,13.885],"nodeIds":["law-p006-n0032","law-p006-n0033","law-p006-n0034","law-p006-n0035","law-p006-n0036"]},{"id":"law-p006-b0016","text":"以动产抵押的，不得对抗正常经营活动中已经支付合理价款并取得抵押财产的买受人","bbox":[528.797,419.793,493.507,13.338],"nodeIds":["law-p006-n0037"]},{"id":"law-p006-b0017","text":"质押权","bbox":[385.413,516.077,40.014,13.338],"nodeIds":["law-p006-n0038"]},{"id":"law-p006-b0018","text":"①含义","bbox":[457.105,477.313,40.014,13.338],"nodeIds":["law-p006-n0039"]},{"id":"law-p006-b0019","text":"是指为了担保债务的履行，债务人或者第三人将其动产或者权利移交债权人占有","bbox":[528.797,458.14,466.83,13.338],"nodeIds":["law-p006-n0040","law-p006-n0041","law-p006-n0042"]},{"id":"law-p006-b0020","text":"当债务人不履行债务时，债权人有就其占有的财产优先受偿的权利","bbox":[528.797,496.487,386.802,13.338],"nodeIds":["law-p006-n0043","law-p006-n0044"]},{"id":"law-p006-b0021","text":"②设立","bbox":[457.105,554.841,40.014,13.338],"nodeIds":["law-p006-n0045"]},{"id":"law-p006-b0022","text":"书面质押合同；动产质权自出质人交付质押财产时设立，权利质权自权利凭证交付或办理出质登记时设立","bbox":[528.797,534.834,306.774,33.345],"nodeIds":["law-p006-n0046","law-p006-n0047","law-p006-n0048","law-p006-n0049","law-p006-n0050","law-p006-n0051","law-p006-n0052","law-p006-n0053"]},{"id":"law-p006-b0023","text":"留置权","bbox":[385.413,654.876,40.014,13.338],"nodeIds":["law-p006-n0054"]},{"id":"law-p006-b0024","text":"债权人按合同约定占有债务人的财产，债权已届清偿期","bbox":[457.105,597.355,320.112,13.338],"nodeIds":["law-p006-n0055","law-p006-n0056"]},{"id":"law-p006-b0025","text":"在债务人逾期不履行债务时，有留置该财产以迫使债务人履行债务","bbox":[457.105,635.702,386.802,13.338],"nodeIds":["law-p006-n0057"]},{"id":"law-p006-b0026","text":"并在债务人仍不履行债务时就该财产优先受偿的权利","bbox":[457.105,674.049,306.774,13.338],"nodeIds":["law-p006-n0058"]},{"id":"law-p006-b0027","text":"它是法定担保物权，权利人不得擅自使用、出租、处分留置物","bbox":[457.105,712.396,360.126,13.578],"nodeIds":["law-p006-n0059","law-p006-n0060","law-p006-n0061"]},{"id":"law-p006-b0028","text":"6","bbox":[591.275,810.711,8.0,21.344],"nodeIds":["law-p006-n0062"]}],"questions":[{"id":"law-p006-q001","number":1,"type":"fill-in","answer":"不转移占有","bbox":[728.867,107.183,66.69,13.338],"fontSize":13.338,"color":"#ff6f00","segments":[{"text":"不转移占有","bbox":[728.867,107.183,66.69,13.338],"color":"#ff6f00"}],"nodeIds":["law-p006-n0008"],"aliases":[],"context":"是指债权人对于债务人或者第三人____而提供担保的财产，于债务人不履行债"},{"id":"law-p006-q002","number":2,"type":"fill-in","answer":"优先受偿的权利","bbox":[915.599,127.19,93.366,13.338],"fontSize":13.338,"color":"#ff6f00","segments":[{"text":"优先受偿的权利","bbox":[915.599,127.19,93.366,13.338],"color":"#ff6f00"}],"nodeIds":["law-p006-n0011"],"aliases":[],"context":"①含义务或发生当事人约定的实现抵押权的情形时，依法享有的就该财产____"},{"id":"law-p006-q003","number":3,"type":"fill-in","answer":"土地所有权","bbox":[555.473,169.705,66.69,13.338],"fontSize":13.338,"color":"#e53935","segments":[{"text":"土地所有权","bbox":[555.473,169.705,66.69,13.338],"color":"#e53935"}],"nodeIds":["law-p006-n0014"],"aliase