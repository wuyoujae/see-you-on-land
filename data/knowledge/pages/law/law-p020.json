{"id":"law-p020","bookId":"law","number":20,"title":"第二章刑法五、故意犯罪的形态","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p020.svg","dataUrl":"data/knowledge/pages/law/law-p020.json","questionCount":30,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":20},"nodes":[{"id":"law-p020-n0001","text":"第二章","bbox":[64.577,437.911,49.464,16.488],"color":"#141414","fontSize":16.488,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0002","text":"刑法","bbox":[118.268,437.911,32.976,16.488],"color":"#141414","fontSize":16.488,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0003","text":"五、故意犯罪的形态","bbox":[206.098,438.608,131.903,14.656],"color":"#141414","fontSize":14.656,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p020-n0004","text":"犯罪","bbox":[403.342,242.356,29.312,14.656],"color":"#19a719","fontSize":14.656,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0005","text":"预备","bbox":[403.342,264.34,29.312,14.656],"color":"#19a719","fontSize":14.656,"block":2,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0006","text":"含义","bbox":[467.461,116.866,29.312,14.656],"color":"#141414","fontSize":14.656,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0007","text":"犯罪预备是指","bbox":[531.58,95.798,87.935,14.656],"color":"#141414","fontSize":14.656,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0008","text":"为了犯罪，准备工具，制造条件","bbox":[619.516,95.798,205.182,14.92],"color":"#19a719","fontSize":14.656,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0009","text":"但由于行为人","bbox":[531.58,137.934,87.935,14.656],"color":"#141414","fontSize":14.656,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0010","text":"意志以外","bbox":[619.516,137.934,58.623,14.656],"color":"#19a719","fontSize":14.656,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0011","text":"的原因而","bbox":[678.139,137.934,58.623,14.656],"color":"#141414","fontSize":14.656,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0012","text":"未能着手","bbox":[736.762,137.934,58.623,14.656],"color":"#19a719","fontSize":14.656,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0013","text":"实行犯罪的情形","bbox":[795.386,137.934,102.591,14.656],"color":"#141414","fontSize":14.656,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0014","text":"特征","bbox":[467.461,264.34,29.312,14.656],"color":"#141414","fontSize":14.656,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0015","text":"①","bbox":[531.58,180.069,14.656,14.656],"color":"#141414","fontSize":14.656,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0016","text":"主观上","bbox":[546.236,180.069,43.968,14.656],"color":"#8e24aa","fontSize":14.656,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0017","text":"为了犯罪，即","bbox":[590.204,180.069,87.935,14.656],"color":"#141414","fontSize":14.656,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0018","text":"为了自己","bbox":[678.139,180.069,58.623,14.656],"color":"#8e24aa","fontSize":14.656,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0019","text":"实行犯罪和","bbox":[736.762,180.069,73.279,14.656],"color":"#141414","fontSize":14.656,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0020","text":"为了他人","bbox":[810.042,180.069,58.623,14.656],"color":"#8e24aa","fontSize":14.656,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0021","text":"实行犯罪","bbox":[868.665,180.069,58.623,14.656],"color":"#141414","fontSize":14.656,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0022","text":"②","bbox":[531.58,222.205,14.656,14.656],"color":"#141414","fontSize":14.656,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0023","text":"客观上","bbox":[546.236,222.205,43.968,14.656],"color":"#8e24aa","fontSize":14.656,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0024","text":"实施了","bbox":[590.204,222.205,43.968,14.656],"color":"#141414","fontSize":14.656,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0025","text":"犯罪预备行为","bbox":[634.171,222.205,87.935,14.656],"color":"#8e24aa","fontSize":14.656,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0026","text":"，包括","bbox":[722.106,222.205,43.968,14.656],"color":"#141414","fontSize":14.656,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0027","text":"准备实行犯罪工具","bbox":[766.074,222.205,117.247,14.656],"color":"#8e24aa","fontSize":14.656,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0028","text":"与制造一切为实行犯罪的条件","bbox":[883.321,222.205,190.526,14.656],"color":"#141414","fontSize":14.656,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0029","text":"③","bbox":[531.58,285.408,14.656,14.656],"color":"#141414","fontSize":14.656,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0030","text":"事实上未能着手","bbox":[546.236,285.408,102.591,14.656],"color":"#8e24aa","fontSize":14.656,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0031","text":"实行犯罪，包括","bbox":[648.827,285.408,102.591,14.656],"color":"#141414","fontSize":14.656,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0032","text":"“","bbox":[786.226,258.925,5.071,14.656],"color":"#141414","fontSize":14.656,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0033","text":"预备行为没有完成而不可能着手实行犯罪","bbox":[791.3,264.34,263.806,14.656],"color":"#141414","fontSize":14.656,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0034","text":"”","bbox":[1055.105,258.925,5.071,14.656],"color":"#141414","fontSize":14.656,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0035","text":"“","bbox":[786.226,301.061,5.071,14.656],"color":"#141414","fontSize":14.656,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0036","text":"预备行为虽已完成但由于某种原因未能着手实行犯罪","bbox":[791.3,306.476,337.085,14.656],"color":"#141414","fontSize":14.656,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0037","text":"”","bbox":[1128.384,301.061,5.071,14.656],"color":"#141414","fontSize":14.656,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0038","text":"④未能着手实行犯罪是由于行为人","bbox":[531.58,348.612,219.838,14.656],"color":"#141414","fontSize":14.656,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0039","text":"意志以外的原因","bbox":[751.418,348.612,102.591,14.656],"color":"#8e24aa","fontSize":14.656,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0040","text":"对于","bbox":[467.461,390.747,29.312,14.656],"color":"#141414","fontSize":14.656,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0041","text":"预备犯","bbox":[496.773,390.747,43.968,14.656],"color":"#ff6f00","fontSize":14.656,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0042","text":"可","bbox":[575.548,390.747,14.656,14.656],"color":"#141414","fontSize":14.656,"block":13,"line":1,"emphasis":false,"role":"content"},{"id":"law-p020-n0043","text":"以比照既遂犯从轻、减轻处罚或者免除","bbox":[590.204,390.747,249.15,14.656],"color":"#ff6f00","fontSize":14.656,"block":13,"line":1,"emphasis":true,"role":"content"},{"id":"law-p020-n0044","text":"处罚","bbox":[839.353,390.747,29.312,14.656],"color":"#141414","fontSize":14.656,"block":13,"line":1,"emphasis":false,"role":"content"},{"id":"law-p020-n0045","text":"犯罪","bbox":[403.342,556.084,29.312,14.656],"color":"#3949ab","fontSize":14.656,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0046","text":"中止","bbox":[403.342,578.067,29.312,14.656],"color":"#3949ab","fontSize":14.656,"block":14,"line":1,"emphasis":true,"role":"content"},{"id":"law-p020-n0047","text":"含义","bbox":[467.461,437.463,29.312,14.656],"color":"#141414","fontSize":14.656,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0048","text":"在犯罪过程中，","bbox":[531.58,437.463,102.591,14.656],"color":"#141414","fontSize":14.656,"block":15,"line":1,"emphasis":false,"role":"content"},{"id":"law-p020-n0049","text":"自动放弃","bbox":[634.171,437.463,58.624,14.656],"color":"#ce4289","fontSize":14.656,"block":15,"line":1,"emphasis":true,"role":"content"},{"id":"law-p020-n0050","text":"犯罪或者","bbox":[692.795,437.463,58.623,14.656],"color":"#141414","fontSize":14.656,"block":15,"line":1,"emphasis":false,"role":"content"},{"id":"law-p020-n0051","text":"自动有效地防止","bbox":[751.418,437.463,102.591,14.656],"color":"#ce4289","fontSize":14.656,"block":15,"line":1,"emphasis":true,"role":"content"},{"id":"law-p020-n0052","text":"犯罪","bbox":[854.009,437.463,29.312,14.656],"color":"#141414","fontSize":14.656,"block":15,"line":1,"emphasis":false,"role":"content"},{"id":"law-p020-n0053","text":"结果发生","bbox":[883.321,437.463,58.623,14.656],"color":"#ce4289","fontSize":14.656,"block":15,"line":1,"emphasis":true,"role":"content"},{"id":"law-p020-n0054","text":"的情形","bbox":[941.945,437.463,43.968,14.656],"color":"#141414","fontSize":14.656,"block":15,"line":1,"emphasis":false,"role":"content"},{"id":"law-p020-n0055","text":"特征","bbox":[467.461,592.265,29.312,14.656],"color":"#141414","fontSize":14.656,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0056","text":"①","bbox":[531.58,484.178,14.656,14.656],"color":"#141414","fontSize":14.656,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0057","text":"中止的时间性","bbox":[546.236,484.178,87.935,14.656],"color":"#00897b","fontSize":14.656,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0058","text":"：犯罪中止必须发生在","bbox":[634.171,484.178,146.559,15.257],"color":"#141414","fontSize":14.656,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0059","text":"“","bbox":[780.73,478.763,5.071,14.656],"color":"#00897b","fontSize":14.656,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0060","text":"犯罪过程中","bbox":[785.811,484.178,73.279,14.656],"color":"#00897b","fontSize":14.656,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0061","text":"”","bbox":[859.09,478.763,5.071,14.656],"color":"#00897b","fontSize":14.656,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0062","text":"，即犯罪中止既可","bbox":[864.171,484.178,117.247,14.656],"color":"#141414","fontSize":14.656,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0063","text":"以发生在犯罪","bbox":[531.58,506.162,87.935,14.656],"color":"#141414","fontSize":14.656,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0064","text":"预备阶段","bbox":[619.516,506.162,58.623,14.656],"color":"#00897b","fontSize":14.656,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0065","text":"，也可以发生在犯罪","bbox":[678.139,506.162,131.903,14.656],"color":"#141414","fontSize":14.656,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0066","text":"实行阶段","bbox":[810.042,506.162,58.623,14.656],"color":"#00897b","fontSize":14.656,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0067","text":"；犯罪既遂后自动","bbox":[868.665,506.162,117.247,15.257],"color":"#141414","fontSize":14.656,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0068","text":"恢复原状的，不成立犯罪中止，犯罪未遂后也不可能出现犯罪中止","bbox":[531.58,528.146,425.02,14.656],"color":"#141414","fontSize":14.656,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0069","text":"②","bbox":[531.58,570.281,14.656,14.656],"color":"#141414","fontSize":14.656,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0070","text":"中止的自动性","bbox":[546.236,570.281,87.935,14.656],"color":"#00897b","fontSize":14.656,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0071","text":"；即行为人认识到客观上可能继续实施","bbox":[634.171,570.281,249.15,15.257],"color":"#141414","fontSize":14.656,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0072","text":"犯罪或者可能既遂，但自愿放弃原来的犯罪犯罪意图","bbox":[531.58,592.265,337.085,14.656],"color":"#141414","fontSize":14.656,"block":20,"line":1,"emphasis":false,"role":"content"},{"id":"law-p020-n0073","text":"③中止的客观性","bbox":[531.58,634.401,102.591,14.656],"color":"#141414","fontSize":14.656,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0074","text":"④","bbox":[531.58,676.536,14.656,14.656],"color":"#141414","fontSize":14.656,"block":22,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0075","text":"中止的有效性","bbox":[546.236,676.536,87.935,14.656],"color":"#00897b","fontSize":14.656,"block":22,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0076","text":"对于","bbox":[467.461,718.672,29.312,14.656],"color":"#141414","fontSize":14.656,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"law-p020-n0077","text":"中止犯","bbox":[496.773,718.672,43.968,14.656],"color":"#3949ab","fontSize":14.656,"block":23,"line":0,"emphasis":true,"role":"content"},{"id":"law-p020-n0078","text":"没有造成损害","bbox":[575.548,718.672,87.935,14.656],"color":"#3949ab","fontSize":14.656,"block":23,"line":1,"emphasis":true,"role":"content"},{"id":"law-p020-n0079","text":"的，应","bbox":[663.483,718.672,43.968,14.656],"color":"#141414","fontSize":14.656,"block":23,"line":1,"emphasis":false,"role":"content"},{"id":"law-p020-n0080","text":"免除","bbox":[707.451,718.672,29.312,14.656],"color":"#3949ab","fontSize":14.656,"block":23,"line":1,"emphasis":true,"role":"content"},{"id":"law-p020-n0081","text":"处罚；","bbox":[736.762,718.672,43.968,15.257],"color":"#141414","fontSize":14.656,"block":23,"line":1,"emphasis":false,"role":"content"},{"id":"law-p020-n0082","text":"造成损害，应当减轻","bbox":[780.73,718.672,131.903,14.92],"color":"#3949ab","fontSize":14.656,"block":23,"line":1,"emphasis":true,"role":"content"},{"id":"law-p020-n0083","text":"处罚","bbox":[912.633,718.672,29.312,14.656],"color":"#141414","fontSize":14.656,"block":23,"line":1,"emphasis":false,"role":"content"},{"id":"law-p020-n0084","text":"20","bbox":[587.275,810.711,16.0,21.344],"color":"#000000","fontSize":16.0,"block":24,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"law-p020-b0001","text":"第二章刑法五、故意犯罪的形态","bbox":[64.577,437.911,273.424,16.488],"nodeIds":["law-p020-n0001","law-p020-n0002","law-p020-n0003"]},{"id":"law-p020-b0002","text":"犯罪","bbox":[403.342,242.356,29.312,14.656],"nodeIds":["law-p020-n0004"]},{"id":"law-p020-b0003","text":"预备","bbox":[403.342,264.34,29.312,14.656],"nodeIds":["law-p020-n0005"]},{"id":"law-p020-b0004","text":"含义","bbox":[467.461,116.866,29.312,14.656],"nodeIds":["law-p020-n0006"]},{"id":"law-p020-b0005","text":"犯罪预备是指为了犯罪，准备工具，制造条件","bbox":[531.58,95.798,293.118,14.92],"nodeIds":["law-p020-n0007","law-p020-n0008"]},{"id":"law-p020-b0006","text":"但由于行为人意志以外的原因而未能着手实行犯罪的情形","bbox":[531.58,137.934,366.397,14.656],"nodeIds":["law-p020-n0009","law-p020-n0010","law-p020-n0011","law-p020-n0012","law-p020-n0013"]},{"id":"law-p020-b0007","text":"特征","bbox":[467.461,264.34,29.312,14.656],"nodeIds":["law-p020-n0014"]},{"id":"law-p020-b0008","text":"①主观上为了犯罪，即为了自己实行犯罪和为了他人实行犯罪","bbox":[531.58,180.069,395.708,14.656],"nodeIds":["law-p020-n0015","law-p020-n0016","law-p020-n0017","law-p020-n0018","law-p020-n0019","law-p020-n0020","law-p020-n0021"]},{"id":"law-p020-b0009","text":"②客观上实施了犯罪预备行为，包括准备实行犯罪工具与制造一切为实行犯罪的条件","bbox":[531.58,222.205,542.267,14.656],"nodeIds":["law-p020-n0022","law-p020-n0023","law-p020-n0024","law-p020-n0025","law-p020-n0026","law-p020-n0027","law-p020-n0028"]},{"id":"law-p020-b0010","text":"③事实上未能着手实行犯罪，包括","bbox":[531.58,285.408,219.838,14.656],"nodeIds":["law-p020-n0029","law-p020-n0030","law-p020-n0031"]},{"id":"law-p020-b0011","text":"“预备行为没有完成而不可能着手实行犯罪”","bbox":[786.226,258.925,273.95,20.071],"nodeIds":["law-p020-n0032","law-p020-n0033","law-p020-n0034"]},{"id":"law-p020-b0012","text":"“预备行为虽已完成但由于某种原因未能着手实行犯罪”","bbox":[786.226,301.061,347.229,20.071],"nodeIds":["law-p020-n0035","law-p020-n0036","law-p020-n0037"]},{"id":"law-p020-b0013","text":"④未能着手实行犯罪是由于行为人意志以外的原因","bbox":[531.58,348.612,322.429,14.656],"nodeIds":["law-p020-n0038","law-p020-n0039"]},{"id":"law-p020-b0014","text":"对于预备犯可以比照既遂犯从轻、减轻处罚或者免除处罚","bbox":[467.461,390.747,401.204,14.656],"nodeIds":["law-p020-n0040","law-p020-n0041","law-p020-n0042","law-p020-n0043","law-p020-n0044"]},{"id":"law-p020-b0015","text":"犯罪中止","bbox":[403.342,556.084,29.312,36.639],"nodeIds":["law-p020-n0045","law-p020-n0046"]},{"id":"law-p020-b0016","text":"含义在犯罪过程中，自动放弃犯罪或者自动有效地防止犯罪结果发生的情形","bbox":[467.461,437.463,518.452,14.656],"nodeIds":["law-p020-n0047","law-p020-n0048","law-p020-n0049","law-p020-n0050","law-p020-n0051","law-p020-n0052","law-p020-n0053","law-p020-n0054"]},{"id":"law-p020-b0017","text":"特征","bbox":[467.461,592.265,29.312,14.656],"nodeIds":["law-p020-n0055"]},{"id":"law-p020-b0018","text":"①中止的时间性：犯罪中止必须发生在“犯罪过程中”，即犯罪中止既可","bbox":[531.58,478.763,449.838,20.672],"nodeIds":["law-p020-n0056","law-p020-n0057","law-p020-n0058","law-p020-n0059","law-p020-n0060","law-p020-n0061","law-p020-n0062"]},{"id":"law-p020-b0019","text":"以发生在犯罪预备阶段，也可以发生在犯罪实行阶段；犯罪既遂后自动","bbox":[531.58,506.162,454.332,15.257],"nodeIds":["law-p020-n0063","law-p020-n0064","law-p020-n0065","law-p020-n0066","law-p020-n0067"]},{"id":"law-p020-b0020","text":"恢复原状的，不成立犯罪中止，犯罪未遂后也不可能出现犯罪中止","bbox":[531.58,528.146,425.02,14.656],"nodeIds":["law-p020-n0068"]},{"id":"law-p020-b0021","text":"②中止的自动性；即行为人认识到客观上可能继续实施犯罪或者可能既遂，但自愿放弃原来的犯罪犯罪意图","bbox":[531.58,570.281,351.741,36.64],"nodeIds":["law-p020-n0069","law-p020-n0070","law-p020-n0071","law-p020-n0072"]},{"id":"law-p020-b0022","text":"③中止的客观性","bbox":[531.58,634.401,102.591,14.656],"nodeIds":["law-p020-n0073"]},{"id":"law-p020-b0023","text":"④中止的有效性","bbox":[531.58,676.536,102.591,14.656],"nodeIds":["law-p020-n0074","law-p020-n0075"]},{"id":"law-p020-b0024","text":"对于中止犯没有造成损害的，应免除处罚；造成损害，应当减轻处罚","bbox":[467.461,718.672,474.484,15.257],"nodeIds":["law-p020-n0076","law-p020-n0077","law-p020-n0078","law-p020-n0079","law-p020-n0080","law-p020-n0081","law-p020-n0082","law-p020-n0083"]},{"id":"law-p020-b0025","text":"20","bbox":[587.275,810.711,16.0,21.344],"nodeIds":["law-p020-n0084"]}],"questions":[{"id":"law-p020-q001","number":1,"type":"fill-in","answer":"为了犯罪，准备工具，制造条件","bbox":[619.516,95.798,205.182,14.92],"fontSize":14.656,"color":"#19a719","segments":[{"text":"为了犯罪，准备工具，制造条件","bbox":[619.516,95.798,205.182,14.92],"color":"#19a719"}],"nodeIds":["law-p020-n0008"],"aliases":[],"context":"犯罪预备是指____"},{"id":"law-p020-q002","number":2,"type":"fill-in","answer":"意志以外","bbox":[619.516,137.934,58.623,14.656],"fontSize":14.656,"color":"#19a719","segments":[{"text":"意志以外","bbox":[619.516,137.934,58.623,14.656],"color":"#19a719"}],"nodeIds":["law-p020-n0010"],"aliases":[],"context":"但由于行为人____的原因而____实行犯罪的情形"},{"id":"law-p020-q003","number":3,"type":"fill-in","answer":"未能着手","bbox":[736.762,137.934,58.623,14.656],"fontSize":14.656,"color":"#19a719","segments":[{"text":"未能着手","bbox":[736.762,137.934,58.623,14.656],"color":"#19a719"}],"nodeIds":["law-p020-n0012"],"aliases":[],"context":"但由于行为人____的原因而____实行犯罪的情形"},{"id":"law-p020-q004","number":4,"type":"fill-in","answer":"主观上","bbox":[546.236,180.069,43.968,14.656],"fontSize":14.656,"color":"#8e24aa","segments":[{"text":"主观上","bbox":[546.236,180.069,43.968,14.656],"color":"#8e24aa"}],"nodeIds":["law-p020-n0016"],"aliases":[],"context":"①____为了犯罪，即____实行犯罪和____实行犯罪"},{"id":"law-p020-q005","number":5,"type":"fill-in","answer":"为了自己","bbox":[678.139,180.069,58.623,14.656],"fontSize":14.656,"color":"#8e24aa","segments":[{"text":"为了自己","bbox":[678.139,180.069,58.623,14.656],"color":"#8e24aa"}],"nodeIds":["law-p020-n0018"],"al