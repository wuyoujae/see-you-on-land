{"id":"law-p014","bookId":"law","number":14,"title":"第一章民法八、侵权责任","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p014.svg","dataUrl":"data/knowledge/pages/law/law-p014.json","questionCount":30,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":14},"nodes":[{"id":"law-p014-n0001","text":"第一章","bbox":[68.736,514.384,52.883,17.628],"color":"#141414","fontSize":17.628,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0002","text":"民法","bbox":[126.139,514.384,35.256,17.628],"color":"#141414","fontSize":17.628,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0003","text":"八、侵权责任","bbox":[220.042,515.129,94.015,15.669],"color":"#141414","fontSize":15.669,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p014-n0004","text":"物件损害责任","bbox":[353.23,347.175,94.015,15.669],"color":"#e53935","fontSize":15.669,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0005","text":"建筑物、构筑物或者其他设施及其搁置物、悬挂物发生","bbox":[484.459,116.055,376.06,15.669],"color":"#000000","fontSize":15.669,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0006","text":"脱落、坠落","bbox":[860.519,116.055,78.346,15.669],"color":"#19a719","fontSize":15.669,"block":2,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0007","text":"造成他人损害，","bbox":[938.865,116.055,109.684,15.669],"color":"#000000","fontSize":15.669,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0008","text":"所有人、管理人或者使用人","bbox":[484.459,139.558,188.03,15.669],"color":"#000000","fontSize":15.669,"block":2,"line":1,"emphasis":false,"role":"content"},{"id":"law-p014-n0009","text":"不能证明自己没有过错","bbox":[672.489,139.558,156.692,15.669],"color":"#19a719","fontSize":15.669,"block":2,"line":1,"emphasis":true,"role":"content"},{"id":"law-p014-n0010","text":"的，应当","bbox":[829.181,139.558,62.677,15.669],"color":"#000000","fontSize":15.669,"block":2,"line":1,"emphasis":false,"role":"content"},{"id":"law-p014-n0011","text":"承担","bbox":[891.857,139.558,31.338,15.669],"color":"#19a719","fontSize":15.669,"block":2,"line":1,"emphasis":true,"role":"content"},{"id":"law-p014-n0012","text":"侵权责任。","bbox":[923.196,139.558,78.346,15.669],"color":"#000000","fontSize":15.669,"block":2,"line":1,"emphasis":false,"role":"content"},{"id":"law-p014-n0013","text":"所有人、管理人或者使用人赔偿后，有其他责任人的，有权","bbox":[484.459,163.062,407.399,15.669],"color":"#000000","fontSize":15.669,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0014","text":"向其他责任人追偿","bbox":[891.857,163.062,125.353,15.669],"color":"#19a719","fontSize":15.669,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0015","text":"建筑物、构筑物或者其他设施","bbox":[484.459,208.111,203.699,15.669],"color":"#000000","fontSize":15.669,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0016","text":"倒塌","bbox":[688.158,208.111,31.339,15.669],"color":"#1e88e5","fontSize":15.669,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0017","text":"造成他人损害的，由","bbox":[719.497,208.111,141.022,15.669],"color":"#000000","fontSize":15.669,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0018","text":"建设单位与施工单位","bbox":[860.519,208.111,141.023,15.669],"color":"#1e88e5","fontSize":15.669,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0019","text":"承担","bbox":[484.459,231.615,31.338,15.669],"color":"#000000","fontSize":15.669,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0020","text":"连带责任","bbox":[515.797,231.615,62.677,15.669],"color":"#1e88e5","fontSize":15.669,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0021","text":"，但是建设单位与施工单位能够证明不存在质量缺陷的除外","bbox":[578.474,231.615,407.398,15.669],"color":"#000000","fontSize":15.669,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0022","text":"从建筑物中","bbox":[484.459,276.663,78.346,15.669],"color":"#000000","fontSize":15.669,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0023","text":"抛掷物品或者从建筑物上坠落的物品","bbox":[562.805,276.663,250.707,15.669],"color":"#00897b","fontSize":15.669,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0024","text":"造成他人损害，由","bbox":[813.512,276.663,125.353,15.669],"color":"#000000","fontSize":15.669,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0025","text":"侵权人","bbox":[938.865,276.663,47.008,15.669],"color":"#00897b","fontSize":15.669,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0026","text":"依法承担侵权责任；","bbox":[985.873,276.663,141.022,16.312],"color":"#000000","fontSize":15.669,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0027","text":"经调查","bbox":[484.459,300.167,47.008,15.669],"color":"#000000","fontSize":15.669,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0028","text":"难以确定具体侵权人","bbox":[531.467,300.167,141.023,15.669],"color":"#00897b","fontSize":15.669,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0029","text":"的，除能够证明自己不是侵权人的外，由","bbox":[672.489,300.167,282.045,15.669],"color":"#000000","fontSize":15.669,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0030","text":"可能加害的建筑物使用人","bbox":[954.534,300.167,172.361,15.669],"color":"#00897b","fontSize":15.669,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0031","text":"给予","bbox":[484.459,323.671,31.338,15.669],"color":"#000000","fontSize":15.669,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0032","text":"补偿","bbox":[515.797,323.671,31.338,15.669],"color":"#00897b","fontSize":15.669,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0033","text":"。可能加害的建筑物使用人","bbox":[547.136,323.671,188.03,15.669],"color":"#000000","fontSize":15.669,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0034","text":"补偿后","bbox":[735.166,323.671,47.008,15.669],"color":"#00897b","fontSize":15.669,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0035","text":"，有权向","bbox":[782.173,323.671,62.677,15.669],"color":"#000000","fontSize":15.669,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0036","text":"侵权人追偿","bbox":[844.85,323.671,78.346,15.669],"color":"#00897b","fontSize":15.669,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0037","text":"。","bbox":[923.196,323.671,15.669,15.669],"color":"#000000","fontSize":15.669,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0038","text":"物业","bbox":[938.865,323.671,31.338,15.669],"color":"#00897b","fontSize":15.669,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0039","text":"服务企业等建筑物管理","bbox":[970.203,323.671,156.692,15.669],"color":"#000000","fontSize":15.669,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0040","text":"人","bbox":[484.459,347.175,15.669,15.669],"color":"#000000","fontSize":15.669,"block":8,"line":1,"emphasis":false,"role":"content"},{"id":"law-p014-n0041","text":"未采取必要的安全保障措施","bbox":[500.128,347.175,188.03,15.669],"color":"#00897b","fontSize":15.669,"block":8,"line":1,"emphasis":true,"role":"content"},{"id":"law-p014-n0042","text":"的，应当依法承担未履行安全保障义务的","bbox":[688.158,347.175,282.045,15.669],"color":"#000000","fontSize":15.669,"block":8,"line":1,"emphasis":false,"role":"content"},{"id":"law-p014-n0043","text":"侵权责任","bbox":[970.203,347.175,62.677,15.669],"color":"#00897b","fontSize":15.669,"block":8,"line":1,"emphasis":true,"role":"content"},{"id":"law-p014-n0044","text":"在","bbox":[484.459,392.224,15.669,15.669],"color":"#141414","fontSize":15.669,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0045","text":"公共道路上堆放、倾倒、遗撒妨碍通行","bbox":[500.128,392.224,266.376,15.669],"color":"#ce4289","fontSize":15.669,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0046","text":"的物品造成他人损害的，行为人应当承担侵权责","bbox":[766.504,392.224,329.053,15.669],"color":"#141414","fontSize":15.669,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0047","text":"任，公共道路管理人","bbox":[484.459,415.727,141.023,15.669],"color":"#141414","fontSize":15.669,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0048","text":"不能证明已经尽到清理、防护、警示","bbox":[625.482,415.727,250.707,15.669],"color":"#ce4289","fontSize":15.669,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0049","text":"等义务的，应当承担相应的责任","bbox":[876.188,415.727,219.368,15.669],"color":"#141414","fontSize":15.669,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0050","text":"在","bbox":[484.459,460.776,15.669,15.669],"color":"#141414","fontSize":15.669,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0051","text":"公共场所或者道路上挖掘、修缮安装地下设施","bbox":[500.128,460.776,313.383,15.669],"color":"#3949ab","fontSize":15.669,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0052","text":"等造成他人损害","bbox":[813.512,460.776,109.684,15.669],"color":"#141414","fontSize":15.669,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0053","text":"施工人","bbox":[484.459,484.28,47.008,15.669],"color":"#141414","fontSize":15.669,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0054","text":"不能证明已经设置明显标志","bbox":[531.467,484.28,188.03,15.669],"color":"#3949ab","fontSize":15.669,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0055","text":"和采取安全措施的，应当","bbox":[719.497,484.28,172.361,15.669],"color":"#141414","fontSize":15.669,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0056","text":"承担侵权责任","bbox":[891.857,484.28,94.015,15.669],"color":"#3949ab","fontSize":15.669,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0057","text":"窨井等地下设施造成他人损害，管理人不能证明尽到管理职责的，应当承担侵权责任","bbox":[484.459,507.784,579.759,15.669],"color":"#141414","fontSize":15.669,"block":12,"line":1,"emphasis":false,"role":"content"},{"id":"law-p014-n0058","text":"违反安全保障义务的责任","bbox":[353.23,645.868,172.361,15.669],"color":"#141414","fontSize":15.669,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0059","text":"宾馆、商场、银行、车站、机场、体育场馆、娱乐场所等","bbox":[562.805,552.833,391.729,15.669],"color":"#141414","fontSize":15.669,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0060","text":"经营","bbox":[954.534,552.833,31.338,15.669],"color":"#8e24aa","fontSize":15.669,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0061","text":"场所、公共场所的经营者、管理者或者群众性活动的组织者","bbox":[562.805,576.336,407.399,15.669],"color":"#8e24aa","fontSize":15.669,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0062","text":"，","bbox":[970.203,576.336,15.669,15.669],"color":"#141414","fontSize":15.669,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0063","text":"未尽到","bbox":[562.805,599.84,47.008,15.669],"color":"#8e24aa","fontSize":15.669,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0064","text":"安全保障义务，造成他人损害的，应当承担","bbox":[609.812,599.84,297.714,15.669],"color":"#141414","fontSize":15.669,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0065","text":"侵权责任","bbox":[907.527,599.84,62.677,15.669],"color":"#8e24aa","fontSize":15.669,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0066","text":"因","bbox":[562.805,644.889,15.669,15.669],"color":"#141414","fontSize":15.669,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0067","text":"第三人的行为造成","bbox":[578.474,644.889,125.353,15.669],"color":"#ff6f00","fontSize":15.669,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0068","text":"他人损害的，由","bbox":[703.828,644.889,109.684,15.669],"color":"#141414","fontSize":15.669,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0069","text":"第三人承担","bbox":[813.512,644.889,78.346,15.669],"color":"#ff6f00","fontSize":15.669,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0070","text":"侵权责任","bbox":[891.857,644.889,62.677,15.669],"color":"#141414","fontSize":15.669,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0071","text":"经营者、管理者或者组织者未尽到安全保障义务的，承担相应的","bbox":[562.805,668.393,438.737,15.669],"color":"#141414","fontSize":15.669,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0072","text":"补充责任","bbox":[1001.542,668.393,62.677,15.669],"color":"#ff6f00","fontSize":15.669,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p014-n0073","text":"经营者、管理者或者组织者承担补充责任后，可以向第三人追偿","bbox":[562.805,691.897,438.737,15.669],"color":"#141414","fontSize":15.669,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p014-n0074","text":"14","bbox":[587.275,810.711,16.0,21.344],"color":"#000000","fontSize":16.0,"block":20,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"law-p014-b0001","text":"第一章民法八、侵权责任","bbox":[68.736,514.384,245.321,17.628],"nodeIds":["law-p014-n0001","law-p014-n0002","law-p014-n0003"]},{"id":"law-p014-b0002","text":"物件损害责任","bbox":[353.23,347.175,94.015,15.669],"nodeIds":["law-p014-n0004"]},{"id":"law-p014-b0003","text":"建筑物、构筑物或者其他设施及其搁置物、悬挂物发生脱落、坠落造成他人损害，所有人、管理人或者使用人不能证明自己没有过错的，应当承担侵权责任。","bbox":[484.459,116.055,564.09,39.172],"nodeIds":["law-p014-n0005","law-p014-n0006","law-p014-n0007","law-p014-n0008","law-p014-n0009","law-p014-n0010","law-p014-n0011","law-p014-n0012"]},{"id":"law-p014-b0004","text":"所有人、管理人或者使用人赔偿后，有其他责任人的，有权向其他责任人追偿","bbox":[484.459,163.062,532.751,15.669],"nodeIds":["law-p014-n0013","law-p014-n0014"]},{"id":"law-p014-b0005","text":"建筑物、构筑物或者其他设施倒塌造成他人损害的，由建设单位与施工单位","bbox":[484.459,208.111,517.083,15.669],"nodeIds":["law-p014-n0015","law-p014-n0016","law-p014-n0017","law-p014-n0018"]},{"id":"law-p014-b0006","text":"承担连带责任，但是建设单位与施工单位能够证明不存在质量缺陷的除外","bbox":[484.459,231.615,501.413,15.669],"nodeIds":["law-p014-n0019","law-p014-n0020","law-p014-n0021"]},{"id":"law-p014-b0007","text":"从建筑物中抛掷物品或者从建筑物上坠落的物品造成他人损害，由侵权人依法承担侵权责任；","bbox":[484.459,276.663,642.436,16.312],"nodeIds":["law-p014-n0022","law-p014-n0023","law-p014-n0024","law-p014-n0025","law-p014-n0026"]},{"id":"law-p014-b0008","text":"经调查难以确定具体侵权人的，除能够证明自己不是侵权人的外，由可能加害的建筑物使用人","bbox":[484.459,300.167,642.436,15.669],"nodeIds":["law-p014-n0027","law-p014-n0028","law-p014-n0029","law-p014-n0030"]},{"id":"law-p014-b0009","text":"给予补偿。可能加害的建筑物使用人补偿后，有权向侵权人追偿。物业服务企业等建筑物管理人未采取必要的安全保障措施的，应当依法承担未履行安全保障义务的侵权责任","bbox":[484.459,323.671,642.436,39.173],"nodeIds":["law-p014-n0031","law-p014-n0032","law-p014-n0033","law-p014-n0034","law-p014-n0035","law-p014-n0036","law-p014-n0037","law-p014-n0038","law-p014-n0039","law-p014-n0040","law-p014-n0041","law-p014-n0042","law-p014-n0043"]},{"id":"law-p014-b0010","text":"在公共道路上堆放、倾倒、遗撒妨碍通行的物品造成他人损害的，行为人应当承担侵权责","bbox":[484.459,392.224,611.098,15.669],"nodeIds":["law-p014-n0044","law-p014-n0045","law-p014-n0046"]},{"id":"law-p014-b0011","text":"任，公共道路管理人不能证明已经尽到清理、防护、警示等义务的，应当承担相应的责任","bbox":[484.459,415.727,611.097,15.669],"nodeIds":["law-p014-n0047","law-p014-n0048","law-p014-n0049"]},{"id":"law-p014-b0012","text":"在公共场所或者道路上挖掘、修缮安装地下设施等造成他人损害","bbox":[484.459,460.776,438.737,15.669],"nodeIds":["law-p014-n0050","law-p014-n0051","law-p014-n0052"]},{"id":"law-p014-b0013","text":"施工人不能证明已经设置明显标志和采取安全措施的，应当承担侵权责任窨井等地下设施造成他人损害，管理人不能证明尽到管理职责的，应当承担侵权责任","bbox":[484.459,484.28,579.759,39.173],"nodeIds":["law-p014-n0053","law-p014-n0054","law-p014-n0055","law-p014-n0056","law-p014-n0057"]},{"id":"law-p014-b0014","text":"违反安全保障义务的责任","bbox":[353.23,645.868,172.361,15.669],"nodeIds":["law-p014-n0058"]},{"id":"law-p014-b0015","text":"宾馆、商场、银行、车站、机场、体育场馆、娱乐场所等经营","bbox":[562.805,552.833,423.067,15.669],"nodeIds":["law-p014-n0059","law-p014-n0060"]},{"id":"law-p014-b0016","text":"场所、公共场所的经营者、管理者或者群众性活动的组织者，","bbox":[562.805,576.336,423.067,15.669],"nodeIds":["law-p014-n0061","law-p014-n0062"]},{"id":"law-p014-b0017","text":"未尽到安全保障义务，造成他人损害的，应当承担侵权责任","bbox":[562.805,599.84,407.399,15.669],"nodeIds":["law-p014-n0063","law-p014-n0064","law-p014-n0065"]},{"id":"law-p014-b0018","text":"因第三人的行为造成他人损害的，由第三人承担侵权责任","bbox":[562.805,644.889,391.729,15.669],"nodeIds":["law-p014-n0066","law-p014-n0067","law-p014-n0068","law-p014-n0069","law-p014-n0070"]},{"id":"law-p014-b0019","text":"经营者、管理者或者组织者未尽到安全保障义务的，承担相应的补充责任","bbox":[562.805,668.393,501.414,15.669],"nodeIds":["law-p014-n0071","law-p014-n0072"]},{"id":"law-p014-b0020","text":"经营者、管理者或者组织者承担补充责任后，可以向第三人追偿","bbox":[562.805,691.897,438.737,15.669],"nodeIds":["law-p014-n0073"]},{"id":"law-p014-b0021","text":"14","bbox":[587.275,810.711,16.0,21.344],"nodeIds":["law-p014-n0074"]}],"questions":[{"id":"law-p014-q001","number":1,"type":"fill-in","answer":"脱落、坠落","bbox":[860.519,116.055,78.346,15.669],"fontSize":15.669,"color":"#19a719","segments":[{"text":"脱落、坠落","bbox":[860.519,116.055,78.346,15.669],"color":"#19a719"}],"nodeIds":["law-p014-n0006"],"aliases":[],"context":"建筑物、构筑物或者其他设施及其搁置物、悬挂物发生____造成他人损害，"},{"id":"law-p014-q002","number":2,"type":"fill-in","answer":"不能证明自己没有过错","bbox":[672.489,139.558,156.692,15.669],"fontSize":15.669,"color":"#19a719","segments":[{"text":"不能证明自己没有过错","bbox":[672.489,139.558,156.692,15.669],"color":"#19a719"}],"nodeIds":["law-p014-n0009"],"aliases":[],"context":"所有人、管理人或者使用人____的，应当____侵权责任。"},{"id":"law-p014-q003","number":3,"type":"fill-in","answer":"承担","bbox":[891.857,139.558,31.338,15.669],"fontSize":15.669,"color":"#19a719","segments":[{"text":"承担","bbox":[891.857,139.558,31.338,15.669],"color":"#19a719"}],"nodeIds":["law-p014-n0011"],"aliases":[],"context":"所有人、管理人或者使用人____的，应当____侵权责任。"},{"id":"law-p014-q004","number":4,"type":"fill-in","answer":"向其他责任人追偿","bbox":[891.857,163.062,125.353,15.669],"fontSize":15.669,"color":"#19a719","segments":[{"text":"向其他责任人追偿","