{"id":"law-p008","bookId":"law","number":8,"title":"第一章民法五、债权","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p008.svg","dataUrl":"data/knowledge/pages/law/law-p008.json","questionCount":24,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":8},"nodes":[{"id":"law-p008-n0001","text":"第一章","bbox":[65.296,406.129,50.014,16.671],"color":"#141414","fontSize":16.671,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0002","text":"民法","bbox":[119.583,406.129,33.343,16.671],"color":"#141414","fontSize":16.671,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0003","text":"五、债权","bbox":[208.391,406.833,59.276,14.819],"color":"#141414","fontSize":14.819,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0004","text":"1.","bbox":[304.714,169.277,9.603,14.819],"color":"#141414","fontSize":14.819,"block":1,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0005","text":"债","bbox":[314.316,174.824,14.819,14.819],"color":"#141414","fontSize":14.819,"block":1,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0006","text":"特定当事人之间得请求为特定行为的民事法律关系","bbox":[364.916,92.857,326.016,14.819],"color":"#141414","fontSize":14.819,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0007","text":"享有权利的人是债权人，负有义务的人是债务人","bbox":[726.126,92.857,311.197,14.819],"color":"#141414","fontSize":14.819,"block":2,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0008","text":"债权和物权区别","bbox":[364.916,174.824,103.732,14.819],"color":"#141414","fontSize":14.819,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0009","text":"①","bbox":[503.843,140.092,14.819,14.819],"color":"#141414","fontSize":14.819,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0010","text":"义务主体","bbox":[518.662,140.092,59.276,14.819],"color":"#ff6f00","fontSize":14.819,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0011","text":"不同","bbox":[577.938,140.092,29.638,14.819],"color":"#141414","fontSize":14.819,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0012","text":"物权是绝对权；债权是相对权，义务主体是特定的债务人","bbox":[642.77,140.092,370.473,15.426],"color":"#141414","fontSize":14.819,"block":4,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0013","text":"②","bbox":[503.843,209.556,14.819,14.819],"color":"#141414","fontSize":14.819,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0014","text":"权利客体","bbox":[518.662,209.556,59.276,14.819],"color":"#ff6f00","fontSize":14.819,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0015","text":"不同","bbox":[577.938,209.556,29.638,14.819],"color":"#141414","fontSize":14.819,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0016","text":"物权以物为客体，这里所说的物，是指人身之外，为人力所能支配，并","bbox":[642.77,187.328,459.386,14.819],"color":"#141414","fontSize":14.819,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0017","text":"且有一定使用价值的物质资料，行为和精神产品均不能作为物权的客体","bbox":[642.77,209.556,459.386,14.819],"color":"#141414","fontSize":14.819,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0018","text":"产生","bbox":[364.916,256.791,29.638,14.819],"color":"#141414","fontSize":14.819,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0019","text":"债的发生根据是引起债的法律关系发生的事实，主要有：不当得利、无因管理、合同、侵权行为","bbox":[429.748,256.791,622.395,15.426],"color":"#141414","fontSize":14.819,"block":7,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0020","text":"2.","bbox":[304.714,383.688,11.9,14.819],"color":"#141414","fontSize":14.819,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0021","text":"不当得利","bbox":[316.624,389.235,59.276,14.819],"color":"#141414","fontSize":14.819,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0022","text":"没有合法根据，使他人受到损失而自己获得利益的事实","bbox":[411.225,304.026,355.654,14.819],"color":"#141414","fontSize":14.819,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0023","text":"构成要件：一方获得利益；他方受损失；","bbox":[411.225,346.631,266.74,15.649],"color":"#19a719","fontSize":14.819,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0024","text":"获得利益和受到损失之间有","bbox":[677.965,346.631,177.827,14.819],"color":"#141414","fontSize":14.819,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0025","text":"因果关系","bbox":[855.792,346.631,59.275,14.819],"color":"#19a719","fontSize":14.819,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0026","text":"；获得利益","bbox":[915.068,346.631,74.094,15.426],"color":"#141414","fontSize":14.819,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0027","text":"没有合法根据","bbox":[989.162,346.631,88.914,14.819],"color":"#19a719","fontSize":14.819,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0028","text":"不成立","bbox":[411.225,389.235,44.457,14.819],"color":"#8e24aa","fontSize":14.819,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0029","text":"不当得利的情形：为","bbox":[455.681,389.235,133.37,15.426],"color":"#141414","fontSize":14.819,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0030","text":"履行道德义务","bbox":[589.052,389.235,88.913,14.819],"color":"#8e24aa","fontSize":14.819,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0031","text":"进行的给付；债务","bbox":[677.965,389.235,118.551,15.426],"color":"#141414","fontSize":14.819,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0032","text":"到期之前的清偿；明知无给付义务","bbox":[796.516,389.235,222.284,15.649],"color":"#8e24aa","fontSize":14.819,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0033","text":"而进行的债务清偿","bbox":[1018.8,389.235,118.551,14.819],"color":"#141414","fontSize":14.819,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0034","text":"不当得利的","bbox":[411.225,486.484,74.095,14.819],"color":"#141414","fontSize":14.819,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0035","text":"法律效力","bbox":[485.319,486.484,59.276,14.819],"color":"#1e88e5","fontSize":14.819,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0036","text":"①","bbox":[579.79,431.84,14.819,14.819],"color":"#141414","fontSize":14.819,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0037","text":"受益人","bbox":[594.609,431.84,44.457,14.819],"color":"#1e88e5","fontSize":14.819,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0038","text":"的","bbox":[639.065,431.84,14.819,14.819],"color":"#141414","fontSize":14.819,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0039","text":"返还","bbox":[653.884,431.84,29.638,14.819],"color":"#1e88e5","fontSize":14.819,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0040","text":"义务：不当得利成立后，受害人有权请求受益人返还不当得利，","bbox":[683.522,431.84,414.93,15.426],"color":"#141414","fontSize":14.819,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0041","text":"受益人负有返还不当得利的义务","bbox":[579.79,454.068,207.465,14.819],"color":"#141414","fontSize":14.819,"block":13,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0042","text":"②","bbox":[579.79,496.672,14.819,14.819],"color":"#141414","fontSize":14.819,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0043","text":"第三人","bbox":[594.609,496.672,44.457,14.819],"color":"#1e88e5","fontSize":14.819,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0044","text":"的","bbox":[639.065,496.672,14.819,14.819],"color":"#141414","fontSize":14.819,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0045","text":"返还","bbox":[653.884,496.672,29.638,14.819],"color":"#1e88e5","fontSize":14.819,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0046","text":"义务：得利人已经将取得的利益无偿转让给第三人的，","bbox":[683.522,496.672,355.654,15.426],"color":"#141414","fontSize":14.819,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0047","text":"受损失的人可以请求第三人在","bbox":[579.79,518.901,192.646,14.819],"color":"#141414","fontSize":14.819,"block":14,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0048","text":"相应范围内","bbox":[772.436,518.901,74.094,14.819],"color":"#1e88e5","fontSize":14.819,"block":14,"line":1,"emphasis":true,"role":"content"},{"id":"law-p008-n0049","text":"承担返还义务","bbox":[846.53,518.901,88.914,14.819],"color":"#141414","fontSize":14.819,"block":14,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0050","text":"3.","bbox":[304.714,620.791,11.499,14.819],"color":"#e53935","fontSize":14.819,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0051","text":"无因管理","bbox":[316.212,626.338,59.276,14.819],"color":"#e53935","fontSize":14.819,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0052","text":"没有法定或约定的义务，为避免他人利益受损，自愿管理他人事务的","bbox":[411.225,561.505,444.567,14.819],"color":"#141414","fontSize":14.819,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0053","text":"行为。管理他人事务的人，为管理人；事务被他人管理的人，为本人","bbox":[411.225,583.733,444.567,15.427],"color":"#141414","fontSize":14.819,"block":16,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0054","text":"构成要件","bbox":[411.225,626.338,59.276,14.819],"color":"#e53935","fontSize":14.819,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0055","text":"没有","bbox":[505.695,626.338,29.638,14.819],"color":"#e53935","fontSize":14.819,"block":17,"line":1,"emphasis":true,"role":"content"},{"id":"law-p008-n0056","text":"法定或约定的","bbox":[535.333,626.338,88.914,14.819],"color":"#141414","fontSize":14.819,"block":17,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0057","text":"义务","bbox":[624.246,626.338,29.638,14.819],"color":"#e53935","fontSize":14.819,"block":17,"line":1,"emphasis":true,"role":"content"},{"id":"law-p008-n0058","text":"；有","bbox":[653.884,626.338,29.638,15.427],"color":"#141414","fontSize":14.819,"block":17,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0059","text":"为他人谋利益","bbox":[683.522,626.338,88.913,14.819],"color":"#e53935","fontSize":14.819,"block":17,"line":1,"emphasis":true,"role":"content"},{"id":"law-p008-n0060","text":"的意思；为他人","bbox":[772.436,626.338,103.732,15.427],"color":"#141414","fontSize":14.819,"block":17,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0061","text":"管理事务","bbox":[876.168,626.338,59.276,14.819],"color":"#e53935","fontSize":14.819,"block":17,"line":1,"emphasis":true,"role":"content"},{"id":"law-p008-n0062","text":"；符合受益人","bbox":[935.444,626.338,88.914,15.427],"color":"#141414","fontSize":14.819,"block":17,"line":1,"emphasis":false,"role":"content"},{"id":"law-p008-n0063","text":"真实意思","bbox":[1024.357,626.338,59.276,14.819],"color":"#e53935","fontSize":14.819,"block":17,"line":1,"emphasis":true,"role":"content"},{"id":"law-p008-n0064","text":"无因管理之债","bbox":[411.225,694.875,88.913,14.819],"color":"#e53935","fontSize":14.819,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0065","text":"管理人有权要求本人偿还因管理事务所支出的","bbox":[535.333,673.573,296.378,14.819],"color":"#141414","fontSize":14.819,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0066","text":"必要费用","bbox":[831.711,673.573,59.276,14.819],"color":"#e53935","fontSize":14.819,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0067","text":"管理人可以请求受益人对其因管理受到的损失","bbox":[535.333,716.177,296.378,14.819],"color":"#141414","fontSize":14.819,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p008-n0068","text":"给予适当补偿","bbox":[831.711,716.177,88.914,14.819],"color":"#e53935","fontSize":14.819,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p008-n0069","text":"8","bbox":[591.275,810.711,8.0,21.344],"color":"#000000","fontSize":16.0,"block":21,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"law-p008-b0001","text":"第一章民法五、债权","bbox":[65.296,406.129,202.371,16.671],"nodeIds":["law-p008-n0001","law-p008-n0002","law-p008-n0003"]},{"id":"law-p008-b0002","text":"1.债","bbox":[304.714,169.277,24.421,20.366],"nodeIds":["law-p008-n0004","law-p008-n0005"]},{"id":"law-p008-b0003","text":"特定当事人之间得请求为特定行为的民事法律关系享有权利的人是债权人，负有义务的人是债务人","bbox":[364.916,92.857,672.407,14.819],"nodeIds":["law-p008-n0006","law-p008-n0007"]},{"id":"law-p008-b0004","text":"债权和物权区别","bbox":[364.916,174.824,103.732,14.819],"nodeIds":["law-p008-n0008"]},{"id":"law-p008-b0005","text":"①义务主体不同物权是绝对权；债权是相对权，义务主体是特定的债务人","bbox":[503.843,140.092,509.4,15.426],"nodeIds":["law-p008-n0009","law-p008-n0010","law-p008-n0011","law-p008-n0012"]},{"id":"law-p008-b0006","text":"②权利客体不同","bbox":[503.843,209.556,103.733,14.819],"nodeIds":["law-p008-n0013","law-p008-n0014","law-p008-n0015"]},{"id":"law-p008-b0007","text":"物权以物为客体，这里所说的物，是指人身之外，为人力所能支配，并且有一定使用价值的物质资料，行为和精神产品均不能作为物权的客体","bbox":[642.77,187.328,459.386,37.047],"nodeIds":["law-p008-n0016","law-p008-n0017"]},{"id":"law-p008-b0008","text":"产生债的发生根据是引起债的法律关系发生的事实，主要有：不当得利、无因管理、合同、侵权行为","bbox":[364.916,256.791,687.227,15.426],"nodeIds":["law-p008-n0018","law-p008-n0019"]},{"id":"law-p008-b0009","text":"2.不当得利","bbox":[304.714,383.688,71.186,20.366],"nodeIds":["law-p008-n0020","law-p008-n0021"]},{"id":"law-p008-b0010","text":"没有合法根据，使他人受到损失而自己获得利益的事实","bbox":[411.225,304.026,355.654,14.819],"nodeIds":["law-p008-n0022"]},{"id":"law-p008-b0011","text":"构成要件：一方获得利益；他方受损失；获得利益和受到损失之间有因果关系；获得利益没有合法根据","bbox":[411.225,346.631,666.851,15.649],"nodeIds":["law-p008-n0023","law-p008-n0024","law-p008-n0025","law-p008-n0026","law-p008-n0027"]},{"id":"law-p008-b0012","text":"不成立不当得利的情形：为履行道德义务进行的给付；债务到期之前的清偿；明知无给付义务而进行的债务清偿","bbox":[411.225,389.235,726.126,15.649],"nodeIds":["law-p008-n0028","law-p008-n0029","law-p008-n0030","law-p008-n0031","law-p008-n0032","law-p008-n0033"]},{"id":"law-p008-b0013","text":"不当得利的法律效力","bbox":[411.225,486.484,133.37,14.819],"nodeIds":["law-p008-n0034","law-p008-n0035"]},{"id":"law-p008-b0014","text":"①受益人的返还义务：不当得利成立后，受害人有权请求受益人返还不当得利，受益人负有返还不当得利的义务","bbox":[579.79,431.84,518.662,37.047],"nodeIds":["law-p008-n0036","law-p008-n0037","law-p008-n0038","law-p008-n0039","law-p008-n0040","law-p008-n0041"]},{"id":"law-p008-b0015","text":"②第三人的返还义务：得利人已经将取得的利益无偿转让给第三人的，受损失的人可以请求第三人在相应范围内承担返还义务","bbox":[579.79,496.672,459.386,37.048],"nodeIds":["law-p008-n0042","law-p008-n0043","law-p008-n0044","law-p008-n0045","law-p008-n0046","law-p008-n0047","law-p008-n0048","law-p008-n0049"]},{"id":"law-p008-b0016","text":"3.无因管理","bbox":[304.714,620.791,70.774,20.366],"nodeIds":["law-p008-n0050","law-p008-n0051"]},{"id":"law-p008-b0017","text":"没有法定或约定的义务，为避免他人利益受损，自愿管理他人事务的行为。管理他人事务的人，为管理人；事务被他人管理的人，为本人","bbox":[411.225,561.505,444.567,37.655],"nodeIds":["law-p008-n0052","law-p008-n0053"]},{"id":"law-p008-b0018","text":"构成要件没有法定或约定的义务；有为他人谋利益的意思；为他人管理事务；符合受益人真实意思","bbox":[411.225,626.338,672.408,15.427],"nodeIds":["law-p008-n0054","law-p008-n0055","law-p008-n0056","law-p008-n0057","law-p008-n0058","law-p008-n0059","law-p008-n0060","law-p008-n0061","law-p008-n0062","law-p008-n0063"]},{"id":"law-p008-b0019","text":"无因管理之债","bbox":[411.225,694.875,88.913,14.819],"nodeIds":["law-p008-n0064"]},{"id":"law-p008-b0020","text":"管理人有权要求本人偿还因管理事务所支出的必要费用","bbox":[535.333,673.573,355.654,14.819],"nodeIds":["law-p008-n0065","law-p008-n0066"]},{"id":"law-p008-b0021","text":"管理人可以请求受益人对其因管理受到的损失给予适当补偿","bbox":[535.333,716.177,385.292,14.819],"nodeIds":["law-p008-n0067","law-p008-n0068"]},{"id":"law-p008-b0022","text":"8","bbox":[591.275,810.711,8.0,21.344],"nodeIds":["law-p008-n0069"]}],"questions":[{"id":"law-p008-q001","number":1,"type":"fill-in","answer":"义务主体","bbox":[518.662,140.092,59.276,14.819],"fontSize":14.819,"color":"#ff6f00","segments":[{"text":"义务主体","bbox":[518.662,140.092,59.276,14.819],"color":"#ff6f00"}],"nodeIds":["law-p008-n0010"],"aliases":[],"context":"①____不同物权是绝对权；债权是相对权，义务主体是特定的债务人"},{"id":"law-p008-q002","number":2,"type":"fill-in","answer":"权利客体","bbox":[518.662,209.556,59.276,14.819],"fontSize":14.819,"color":"#ff6f00","segments":[{"text":"权利客体","bbox":[518.662,209.556,59.276,14.819],"color":"#ff6f00"}],"nodeIds":["law-p008-n0014"],"aliases":[],"context":"②____不同且有一定使用价值的物质资料，行为和精神产品均不能作为物权的客体"},{"id":"law-p008-q003","number":3,"type":"fill-in","answer":"构成要件：一方获得利益；他方受损失；","bbox":[411.225,346.631,266.74,15.649],"fontSize":14.819,"color":"#19a719","segments":[{"text":"构成要件：一方获得利益；他方受损失；","bbox":[411.225,346.631,266.74,15.649],"color":"#19a719"}],"nodeIds":["law-p008-n0023"],"aliases":[],"context":"____获得利益和受到损失之间有____；获得利益____"},{"id":"law-p008-q004","number":4,"type":"fill-in","answer":"因果关系","bbox":[855.792,346.631,59.275,14.819],"fontSize":14.819,"color":"#19a719","segments":[{"text":"因果关系","bbox":[855.792,346.631,59.275,14.819],"color":"#19a719"}],"nodeIds":["law-p008-n0025"],"aliases":[],"context":"____获得利益和受到损失之间有____；获得利益____"},{"id":"law-p008-q005","number":5,"type":"fill-in","answer":"没有合法根据","bbox":[989.162,346.631,88.914,14.819],"fontSize":14.819,"color":"#19a719","segments":[{"text":"没有合法根据","bbox":[989.162,346.631,88.914,14.819],"color":"#19a719"}],"nodeIds":["law-p008-n0027"],"aliases":[],"context":"____获得利益和受到损失之间有____；获得利益____"},{"id":"law-p008-q006","number":6,"type":"fill-in","answer":"不成立","bbox":[411.225,389.235,44.457,14.819],"fontSize":14.819,"color":"#8e24aa","segments":[{"text":"不成立","bbox":[411.225,389.235,44.457,14.819],"color":"#8e24aa"}],"nodeIds":["law-p008-n0028"],"aliases":[],"context":"2.不当得利____不当得利的情形：为____进行的给付；债务____而进行的债务清偿"},{"id":"law-p008-q007","number":7,"type":"fill-in","answer":"履行道德义务","bbox":[589.052,389.235,88.913,14.819],"fontSize":14.819,"color":"#8e24aa","segments":[{"text":"履行道德义务","bbox":[589.052,389.235