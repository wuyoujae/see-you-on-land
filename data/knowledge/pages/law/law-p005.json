{"id":"law-p005","bookId":"law","number":5,"title":"第一章民法四、物权","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p005.svg","dataUrl":"data/knowledge/pages/law/law-p005.json","questionCount":37,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":5},"nodes":[{"id":"law-p005-n0001","text":"第一章","bbox":[63.648,452.267,48.752,16.251],"color":"#141414","fontSize":16.251,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0002","text":"民法","bbox":[116.565,452.267,32.501,16.251],"color":"#141414","fontSize":16.251,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0003","text":"四、物权","bbox":[203.132,452.953,57.78,14.445],"color":"#141414","fontSize":14.445,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0004","text":"所有权","bbox":[325.312,435.8,43.335,14.445],"color":"#141414","fontSize":14.445,"block":1,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0005","text":"所有权","bbox":[402.953,248.467,43.335,14.445],"color":"#141414","fontSize":14.445,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0006","text":"的取得","bbox":[402.953,270.134,43.335,14.445],"color":"#141414","fontSize":14.445,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0007","text":"①先占","bbox":[480.595,118.462,43.335,14.445],"color":"#ff6f00","fontSize":14.445,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0008","text":"以所有人的意思占有","bbox":[558.236,118.462,130.004,14.445],"color":"#141414","fontSize":14.445,"block":4,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0009","text":"无主动产","bbox":[688.241,118.462,57.78,14.445],"color":"#ff6f00","fontSize":14.445,"block":4,"line":1,"emphasis":true,"role":"content"},{"id":"law-p005-n0010","text":"而取得其所有权","bbox":[746.021,118.462,101.115,14.445],"color":"#141414","fontSize":14.445,"block":4,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0011","text":"②善意取得","bbox":[480.595,270.134,72.225,14.445],"color":"#1e88e5","fontSize":14.445,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0012","text":"无权处分","bbox":[587.126,164.506,57.78,14.445],"color":"#1e88e5","fontSize":14.445,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0013","text":"他人财产的占有人，在不法将其占有的他人财产","bbox":[644.906,164.506,303.344,14.445],"color":"#141414","fontSize":14.445,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0014","text":"让与第三人","bbox":[948.249,164.506,72.225,14.445],"color":"#1e88e5","fontSize":14.445,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0015","text":"后，如果","bbox":[1020.474,164.506,57.78,14.445],"color":"#141414","fontSize":14.445,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0016","text":"受让人","bbox":[1078.254,164.506,43.335,14.445],"color":"#1e88e5","fontSize":14.445,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0017","text":"在","bbox":[1121.589,164.506,14.445,14.445],"color":"#141414","fontSize":14.445,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0018","text":"取得该财产时系","bbox":[587.126,186.173,101.115,14.445],"color":"#141414","fontSize":14.445,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0019","text":"出于善意","bbox":[688.241,186.173,57.78,14.445],"color":"#1e88e5","fontSize":14.445,"block":6,"line":1,"emphasis":true,"role":"content"},{"id":"law-p005-n0020","text":"，即取","bbox":[746.02,186.173,43.335,14.445],"color":"#141414","fontSize":14.445,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0021","text":"得该财产的所有权，原财产所有人不得要求","bbox":[789.355,186.173,274.454,14.705],"color":"#1e88e5","fontSize":14.445,"block":6,"line":1,"emphasis":true,"role":"content"},{"id":"law-p005-n0022","text":"受让人","bbox":[1063.809,186.173,43.335,14.445],"color":"#141414","fontSize":14.445,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0023","text":"返还","bbox":[1107.144,186.173,28.89,14.445],"color":"#1e88e5","fontSize":14.445,"block":6,"line":1,"emphasis":true,"role":"content"},{"id":"law-p005-n0024","text":"构成要件：","bbox":[587.126,227.702,72.225,14.445],"color":"#1e88e5","fontSize":14.445,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0025","text":"出让人","bbox":[659.351,227.702,43.335,14.445],"color":"#141414","fontSize":14.445,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0026","text":"无处分权","bbox":[702.686,227.702,57.78,14.445],"color":"#1e88e5","fontSize":14.445,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0027","text":"；受让人受让该不动产或者动产时是","bbox":[760.465,227.702,231.119,15.037],"color":"#141414","fontSize":14.445,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0028","text":"善意","bbox":[991.584,227.702,28.89,14.445],"color":"#1e88e5","fontSize":14.445,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0029","text":"的；","bbox":[1020.474,227.702,28.89,15.037],"color":"#141414","fontSize":14.445,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0030","text":"以","bbox":[587.126,249.37,14.445,14.445],"color":"#141414","fontSize":14.445,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0031","text":"合理的价格转让","bbox":[601.571,249.37,101.115,14.445],"color":"#1e88e5","fontSize":14.445,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0032","text":"；应当登记的","bbox":[702.686,249.37,86.67,15.037],"color":"#141414","fontSize":14.445,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0033","text":"已登记","bbox":[789.355,249.37,43.335,14.445],"color":"#1e88e5","fontSize":14.445,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0034","text":"，不需要登记的","bbox":[832.69,249.37,101.115,14.445],"color":"#141414","fontSize":14.445,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0035","text":"已交付","bbox":[933.805,249.37,43.335,14.445],"color":"#1e88e5","fontSize":14.445,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0036","text":"法律后果","bbox":[587.126,290.899,57.78,14.445],"color":"#1e88e5","fontSize":14.445,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0037","text":"：原所有人","bbox":[644.906,290.899,72.225,15.037],"color":"#141414","fontSize":14.445,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0038","text":"无权请求","bbox":[717.13,290.899,57.78,14.445],"color":"#1e88e5","fontSize":14.445,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0039","text":"善意第三人","bbox":[774.91,290.899,72.225,14.445],"color":"#141414","fontSize":14.445,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0040","text":"返还原物","bbox":[847.135,290.899,57.78,14.445],"color":"#1e88e5","fontSize":14.445,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0041","text":"，善意受让人取得不动产","bbox":[904.915,290.899,158.894,14.445],"color":"#141414","fontSize":14.445,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0042","text":"或者动产的所有权，原所有权人","bbox":[587.126,312.566,202.229,14.445],"color":"#141414","fontSize":14.445,"block":9,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0043","text":"有权向无处分权人请求赔偿损失","bbox":[789.355,312.566,202.229,14.445],"color":"#1e88e5","fontSize":14.445,"block":9,"line":1,"emphasis":true,"role":"content"},{"id":"law-p005-n0044","text":"遗失物、盗赃物、埋藏物","bbox":[587.126,354.095,158.894,14.445],"color":"#1e88e5","fontSize":14.445,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0045","text":"不适用善意取得","bbox":[746.02,354.095,101.115,14.445],"color":"#141414","fontSize":14.445,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0046","text":"③拾得遗失物","bbox":[480.595,438.959,86.67,14.445],"color":"#19a719","fontSize":14.445,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0047","text":"拾得遗失物应当","bbox":[601.571,395.625,101.115,14.445],"color":"#141414","fontSize":14.445,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0048","text":"返还权利人","bbox":[702.686,395.625,72.225,14.445],"color":"#19a719","fontSize":14.445,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0049","text":"。拾得人应当","bbox":[774.91,395.625,86.67,14.445],"color":"#141414","fontSize":14.445,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0050","text":"及时通知","bbox":[861.58,395.625,57.78,14.445],"color":"#19a719","fontSize":14.445,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0051","text":"权利人领取，或者","bbox":[919.359,395.625,115.56,14.445],"color":"#141414","fontSize":14.445,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0052","text":"送交公安","bbox":[1034.919,395.625,57.78,14.445],"color":"#19a719","fontSize":14.445,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0053","text":"等有关","bbox":[1092.699,395.625,43.335,14.445],"color":"#141414","fontSize":14.445,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0054","text":"部门。有关部门收到遗失物，知道权利人的，应当及时通知其领取；不知道的，应当","bbox":[601.571,417.292,534.462,15.037],"color":"#141414","fontSize":14.445,"block":12,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0055","text":"及时发布招领公告。遗失物自","bbox":[601.571,438.959,187.784,14.445],"color":"#141414","fontSize":14.445,"block":12,"line":2,"emphasis":false,"role":"content"},{"id":"law-p005-n0056","text":"发布招领公告之日","bbox":[789.355,438.959,115.559,14.445],"color":"#19a719","fontSize":14.445,"block":12,"line":2,"emphasis":true,"role":"content"},{"id":"law-p005-n0057","text":"起","bbox":[904.915,438.959,14.445,14.445],"color":"#141414","fontSize":14.445,"block":12,"line":2,"emphasis":false,"role":"content"},{"id":"law-p005-n0058","text":"一年内","bbox":[919.359,438.959,43.335,14.445],"color":"#19a719","fontSize":14.445,"block":12,"line":2,"emphasis":true,"role":"content"},{"id":"law-p005-n0059","text":"无人认领的，归","bbox":[962.694,438.959,101.115,14.445],"color":"#141414","fontSize":14.445,"block":12,"line":2,"emphasis":false,"role":"content"},{"id":"law-p005-n0060","text":"国家所有","bbox":[1063.809,438.959,57.78,14.445],"color":"#19a719","fontSize":14.445,"block":12,"line":2,"emphasis":true,"role":"content"},{"id":"law-p005-n0061","text":"共有","bbox":[402.953,601.465,28.89,14.445],"color":"#141414","fontSize":14.445,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0062","text":"某项财产由两个或两个以上的权利主体共有享有所有权，包括","bbox":[466.15,485.003,390.013,14.445],"color":"#141414","fontSize":14.445,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0063","text":"公民之间的共有、法人之间的共有以及公民和法人之间的共有","bbox":[466.15,506.67,390.013,14.445],"color":"#141414","fontSize":14.445,"block":14,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0064","text":"①分类","bbox":[466.15,601.465,43.335,14.445],"color":"#141414","fontSize":14.445,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0065","text":"按份共有","bbox":[543.791,548.199,57.78,14.445],"color":"#8e24aa","fontSize":14.445,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0066","text":"：又称分别共有，是共有人按","bbox":[601.571,548.199,187.784,15.037],"color":"#141414","fontSize":14.445,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0067","text":"各自的份额","bbox":[789.355,548.199,72.225,14.445],"color":"#8e24aa","fontSize":14.445,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0068","text":"对同一财产享有所有权。共有人对份","bbox":[861.58,548.199,231.119,14.445],"color":"#141414","fontSize":14.445,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0069","text":"额，没有","bbox":[543.791,569.866,57.78,14.445],"color":"#141414","fontSize":14.445,"block":16,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0070","text":"约定","bbox":[601.571,569.866,28.89,14.445],"color":"#8e24aa","fontSize":14.445,"block":16,"line":1,"emphasis":true,"role":"content"},{"id":"law-p005-n0071","text":"或者约定不明确的，按照","bbox":[630.461,569.866,158.894,14.445],"color":"#141414","fontSize":14.445,"block":16,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0072","text":"出资额","bbox":[789.355,569.866,43.335,14.445],"color":"#8e24aa","fontSize":14.445,"block":16,"line":1,"emphasis":true,"role":"content"},{"id":"law-p005-n0073","text":"确定；不能确定出资额的，视为","bbox":[832.69,569.866,202.229,15.037],"color":"#141414","fontSize":14.445,"block":16,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0074","text":"等额享有","bbox":[1034.919,569.866,57.78,14.445],"color":"#8e24aa","fontSize":14.445,"block":16,"line":1,"emphasis":true,"role":"content"},{"id":"law-p005-n0075","text":"共同共有：又称公同共有，是基于共同关系发生的、各共有人对共有财产","bbox":[543.791,611.396,462.238,15.037],"color":"#141414","fontSize":14.445,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0076","text":"享有平等的所有权。在","bbox":[543.791,633.063,144.449,14.445],"color":"#141414","fontSize":14.445,"block":17,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0077","text":"对外","bbox":[688.241,633.063,28.89,14.445],"color":"#8e24aa","fontSize":14.445,"block":17,"line":1,"emphasis":true,"role":"content"},{"id":"law-p005-n0078","text":"关系上，共有人享有","bbox":[717.131,633.063,130.004,14.445],"color":"#141414","fontSize":14.445,"block":17,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0079","text":"连带债权","bbox":[847.135,633.063,57.78,14.445],"color":"#8e24aa","fontSize":14.445,"block":17,"line":1,"emphasis":true,"role":"content"},{"id":"law-p005-n0080","text":"、承担","bbox":[904.915,633.063,43.335,14.445],"color":"#141414","fontSize":14.445,"block":17,"line":1,"emphasis":false,"role":"content"},{"id":"law-p005-n0081","text":"连带债务","bbox":[948.249,633.063,57.78,14.445],"color":"#8e24aa","fontSize":14.445,"block":17,"line":1,"emphasis":true,"role":"content"},{"id":"law-p005-n0082","text":"②其他要点","bbox":[466.15,696.26,72.225,14.445],"color":"#141414","fontSize":14.445,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0083","text":"如无","bbox":[572.681,674.592,28.89,14.445],"color":"#141414","fontSize":14.445,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0084","text":"约定","bbox":[601.571,674.592,28.89,14.445],"color":"#8e24aa","fontSize":14.445,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0085","text":"，除共有人具有","bbox":[630.461,674.592,101.115,15.037],"color":"#141414","fontSize":14.445,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0086","text":"家庭关系、继承关系、夫妻关系","bbox":[731.576,674.592,202.229,14.445],"color":"#8e24aa","fontSize":14.445,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"law-p005-n0087","text":"外，","bbox":[933.805,674.592,28.89,14.445],"color":"#141414","fontSize":14.445,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0088","text":"视为按份共有。一方转让份额，共有人享有优先购买权","bbox":[572.681,696.26,346.678,14.445],"color":"#141414","fontSize":14.445,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p005-n0089","text":"5","bbox":[591.275,810.711,8.0,21.344],"color":"#000000","fontSize":16.0,"block":21,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"law-p005-b0001","text":"第一章民法四、物权","bbox":[63.648,452.267,197.264,16.251],"nodeIds":["law-p005-n0001","law-p005-n0002","law-p005-n0003"]},{"id":"law-p005-b0002","text":"所有权","bbox":[325.312,435.8,43.335,14.445],"nodeIds":["law-p005-n0004"]},{"id":"law-p005-b0003","text":"所有权","bbox":[402.953,248.467,43.335,14.445],"nodeIds":["law-p005-n0005"]},{"id":"law-p005-b0004","text":"的取得","bbox":[402.953,270.134,43.335,14.445],"nodeIds":["law-p005-n0006"]},{"id":"law-p005-b0005","text":"①先占以所有人的意思占有无主动产而取得其所有权","bbox":[480.595,118.462,366.541,14.445],"nodeIds":["law-p005-n0007","law-p005-n0008","law-p005-n0009","law-p005-n0010"]},{"id":"law-p005-b0006","text":"②善意取得","bbox":[480.595,270.134,72.225,14.445],"nodeIds":["law-p005-n0011"]},{"id":"law-p005-b0007","text":"无权处分他人财产的占有人，在不法将其占有的他人财产让与第三人后，如果受让人在取得该财产时系出于善意，即取得该财产的所有权，原财产所有人不得要求受让人返还","bbox":[587.126,164.506,548.908,36.372],"nodeIds":["law-p005-n0012","law-p005-n0013","law-p005-n0014","law-p005-n0015","law-p005-n0016","law-p005-n0017","law-p005-n0018","law-p005-n0019","law-p005-n0020","law-p005-n0021","law-p005-n0022","law-p005-n0023"]},{"id":"law-p005-b0008","text":"构成要件：出让人无处分权；受让人受让该不动产或者动产时是善意的；","bbox":[587.126,227.702,462.238,15.037],"nodeIds":["law-p005-n0024","law-p005-n0025","law-p005-n0026","law-p005-n0027","law-p005-n0028","law-p005-n0029"]},{"id":"law-p005-b0009","text":"以合理的价格转让；应当登记的已登记，不需要登记的已交付","bbox":[587.126,249.37,390.014,15.037],"nodeIds":["law-p005-n0030","law-p005-n0031","law-p005-n0032","law-p005-n0033","law-p005-n0034","law-p005-n0035"]},{"id":"law-p005-b0010","text":"法律后果：原所有人无权请求善意第三人返还原物，善意受让人取得不动产或者动产的所有权，原所有权人有权向无处分权人请求赔偿损失","bbox":[587.126,290.899,476.683,36.112],"nodeIds":["law-p005-n0036","law-p005-n0037","law-p005-n0038","law-p005-n0039","law-p005-n0040","law-p005-n0041","law-p005-n0042","law-p005-n0043"]},{"id":"law-p005-b0011","text":"遗失物、盗赃物、埋藏物不适用善意取得","bbox":[587.126,354.095,260.009,14.445],"nodeIds":["law-p005-n0044","law-p005-n0045"]},{"id":"law-p005-b0012","text":"③拾得遗失物","bbox":[480.595,438.959,86.67,14.445],"nodeIds":["law-p005-n0046"]},{"id":"law-p005-b0013","text":"拾得遗失物应当返还权利人。拾得人应当及时通知权利人领取，或者送交公安等有关部门。有关部门收到遗失物，知道权利人的，应当及时通知其领取；不知道的，应当及时发布招领公告。遗失物自发布招领公告之日起一年内无人认领的，归国家所有","bbox":[601.571,395.625,534.463,57.779],"nodeIds":["law-p005-n0047","law-p005-n0048","law-p005-n0049","law-p005-n0050","law-p005-n0051","law-p005-n0052","law-p005-n0053","law-p005-n0054","law-p005-n0055","law-p005-n0056","law-p005-n0057","law-p005-n0058","law-p005-n0059","law-p005-n0060"]},{"id":"law-p005-b0014","text":"共有","bbox":[402.953,601.465,28.89,14.445],"nodeIds":["law-p005-n0061"]},{"id":"law-p005-b0015","text":"某项财产由两个或两个以上的权利主体共有享有所有权，包括公民之间的共有、法人之间的共有以及公民和法人之间的共有","bbox":[466.15,485.003,390.013,36.112],"nodeIds":["law-p005-n0062","law-p005-n0063"]},{"id":"law-p005-b0016","text":"①分类","bbox":[466.15,601.465,43.335,14.445],"nodeIds":["law-p005-n0064"]},{"id":"law-p005-b0017","text":"按份共有：又称分别共有，是共有人按各自的份额对同一财产享有所有权。共有人对份额，没有约定或者约定不明确的，按照出资额确定；不能确定出资额的，视为等额享有","bbox":[543.791,548.199,548.908,36.704],"nodeIds":["law-p005-n0065","law-p005-n0066","law-p005-n0067","law-p005-n0068","law-p005-n0069","law-p005-n0070","law-p005-n0071","law-p005-n0072","law-p005-n0073","law-p005-n0074"]},{"id":"law-p005-b0018","text":"共同共有：又称公同共有，是基于共同关系发生的、各共有人对共有财产享有平等的所有权。在对外关系上，共有人享有连带债权、承担连带债务","bbox":[543.791,611.396,462.238,36.112],"nodeIds":["law-p005-n0075","law-p005-n0076","law-p005-n0077","law-p005-n0078","law-p005-n0079","law-p005-n0080","law-p005-n0081"]},{"id":"law-p005-b0019","text":"②其他要点","bbox":[466.15,696.26,72.225,14.445],"nodeIds":["law-p005-n0082"]},{"id":"law-p005-b0020","text":"如无约定，除共有人具有家庭关系、继承关系、夫妻关系外，","bbox":[572.681,674.592,390.014,15.037],"nodeIds":["law-p005-n0083","law-p005-n0084","law-p005-n0085","law-p005-n0086","law-p005-n0087"]},{"id":"law-p005-b0021","text":"视为按份共有。一方转让份额，共有人享有优先购买权","bbox":[572.681,696.26,346.678,14.445],"nodeIds":["law-p005-n0088"]},{"id":"law-p005-b0022","text":"5","bbox":[591.275,810.711,8.0,21.344],"nodeIds":["law-p005-n0089"]}],"questions":[{"id":"law-p005-q001","number":1,"type":"fill-in","answer":"①先占","bbox":[480.595,118.462,43.335,14.445],"fontSize":14.445,"color":"#ff6f00","segments":[{"text":"①先占","bbox":[480.595,118.462,43.335,14.445],"color":"#ff6f00"}],"nodeIds":["law-p005-n0007"],"aliases":[],"context":"____以所有人的意思占有____而取得其所有权"},{"id":"law-p005-q002","number":2,"type":"fill-in","answer":"无主动产","bbox":[688.241,118.462,57.78,14.445],"fontSize":14.445,"color":"#ff6f00","segments":[{"text":"无主动产","bbox":[688.241,118.462,57.78,14.445],"color":"#ff6f00"}],"no