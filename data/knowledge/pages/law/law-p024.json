{"id":"law-p024","bookId":"law","number":24,"title":"第二章刑法七、刑罚","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p024.svg","dataUrl":"data/knowledge/pages/law/law-p024.json","questionCount":21,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":24},"nodes":[{"id":"law-p024-n0001","text":"第二章","bbox":[69.085,382.222,53.262,17.754],"color":"#141414","fontSize":17.754,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0002","text":"刑法","bbox":[126.898,382.222,35.508,17.754],"color":"#141414","fontSize":17.754,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0003","text":"七、刑罚","bbox":[221.474,382.972,63.125,15.781],"color":"#141414","fontSize":15.781,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p024-n0004","text":"主刑","bbox":[354.958,364.232,31.563,15.781],"color":"#8e24aa","fontSize":15.781,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0005","text":"无期","bbox":[424.001,186.691,31.563,15.781],"color":"#00897b","fontSize":15.781,"block":2,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0006","text":"徒刑","bbox":[424.001,210.363,31.563,15.781],"color":"#00897b","fontSize":15.781,"block":2,"line":1,"emphasis":true,"role":"content"},{"id":"law-p024-n0007","text":"剥夺犯罪分子终身自由，","bbox":[493.045,119.62,173.595,15.781],"color":"#141414","fontSize":15.781,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0008","text":"强迫其劳动","bbox":[666.639,119.62,78.907,15.781],"color":"#00897b","fontSize":15.781,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0009","text":"并接受教育和改造","bbox":[745.546,119.62,126.251,15.781],"color":"#141414","fontSize":15.781,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0010","text":"①剥夺自由是","bbox":[493.045,164.992,94.688,15.781],"color":"#141414","fontSize":15.781,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0011","text":"没有期限","bbox":[587.733,164.992,63.125,15.781],"color":"#00897b","fontSize":15.781,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0012","text":"的，即剥夺犯罪分子的","bbox":[650.858,164.992,157.814,15.781],"color":"#141414","fontSize":15.781,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0013","text":"终身自由","bbox":[808.672,164.992,63.126,15.781],"color":"#00897b","fontSize":15.781,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0014","text":"②","bbox":[493.045,210.363,15.781,15.781],"color":"#141414","fontSize":15.781,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0015","text":"强迫参加劳动","bbox":[508.826,210.363,94.688,15.781],"color":"#00897b","fontSize":15.781,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0016","text":"，接受教育和改造","bbox":[603.514,210.363,126.251,15.781],"color":"#141414","fontSize":15.781,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0017","text":"③羁押时间","bbox":[493.045,255.735,78.907,15.781],"color":"#141414","fontSize":15.781,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0018","text":"不能折抵刑期","bbox":[571.951,255.735,94.688,15.781],"color":"#00897b","fontSize":15.781,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0019","text":"④","bbox":[493.045,301.106,15.781,15.781],"color":"#141414","fontSize":15.781,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0020","text":"必须附加剥夺政治权利","bbox":[508.826,301.106,157.814,15.781],"color":"#00897b","fontSize":15.781,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0021","text":"终身","bbox":[666.639,301.106,31.563,15.781],"color":"#141414","fontSize":15.781,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0022","text":"死刑","bbox":[424.001,518.1,31.563,15.781],"color":"#e53935","fontSize":15.781,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0023","text":"剥夺犯罪分子生命的刑罚方法。死刑是刑罚体系中最严厉的手段","bbox":[493.045,346.478,441.878,15.781],"color":"#141414","fontSize":15.781,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0024","text":"①适用","bbox":[493.045,437.22,47.344,15.781],"color":"#141414","fontSize":15.781,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0025","text":"死刑只适用于","bbox":[577.869,391.849,94.688,15.781],"color":"#141414","fontSize":15.781,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0026","text":"罪行极其严重","bbox":[672.557,391.849,94.688,15.781],"color":"#e53935","fontSize":15.781,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0027","text":"的犯罪分子","bbox":[767.246,391.849,78.907,15.781],"color":"#141414","fontSize":15.781,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0028","text":"不得对","bbox":[577.869,437.22,47.344,15.781],"color":"#141414","fontSize":15.781,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0029","text":"犯罪的时候不满","bbox":[625.214,437.22,110.47,15.781],"color":"#e53935","fontSize":15.781,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0030","text":"18","bbox":[735.683,431.313,24.43,15.781],"color":"#e53935","fontSize":15.781,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0031","text":"周岁","bbox":[760.118,437.22,31.563,15.781],"color":"#e53935","fontSize":15.781,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0032","text":"的人和","bbox":[791.688,437.22,47.344,15.781],"color":"#141414","fontSize":15.781,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0033","text":"审判的时候怀孕的妇女","bbox":[839.033,437.22,157.814,15.781],"color":"#e53935","fontSize":15.781,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0034","text":"适用死刑","bbox":[996.846,437.22,63.125,15.781],"color":"#141414","fontSize":15.781,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0035","text":"审判时已满","bbox":[577.869,482.592,78.907,15.781],"color":"#e53935","fontSize":15.781,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0036","text":"75","bbox":[656.776,476.684,25.613,15.781],"color":"#e53935","fontSize":15.781,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0037","text":"周岁","bbox":[682.39,482.592,31.563,15.781],"color":"#e53935","fontSize":15.781,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0038","text":"的人，不适用死刑，但以","bbox":[713.953,482.592,173.595,15.781],"color":"#141414","fontSize":15.781,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0039","text":"特别残忍手段致人死亡的除外","bbox":[887.548,482.592,205.158,15.781],"color":"#e53935","fontSize":15.781,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0040","text":"②死刑立即执行","bbox":[493.045,586.157,110.47,15.781],"color":"#141414","fontSize":15.781,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0041","text":"判处死刑立即执行的案件，除依法由最高人民法院判决的以外，都应当","bbox":[640.995,527.963,489.222,15.781],"color":"#141414","fontSize":15.781,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0042","text":"报请","bbox":[640.995,551.635,31.563,15.781],"color":"#141414","fontSize":15.781,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0043","text":"最高人民法院核准","bbox":[672.557,551.635,126.251,15.781],"color":"#ce4289","fontSize":15.781,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0044","text":"；最高人民法院将","bbox":[798.808,551.635,126.251,16.428],"color":"#141414","fontSize":15.781,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0045","text":"复核结果通报最高人民检察院","bbox":[925.059,551.635,205.158,15.781],"color":"#ce4289","fontSize":15.781,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0046","text":"最高人民法院判处和核准的死刑立即执行的判决，应当由","bbox":[640.995,597.007,394.534,15.781],"color":"#141414","fontSize":15.781,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0047","text":"最高人民","bbox":[1035.529,597.007,63.125,15.781],"color":"#ce4289","fontSize":15.781,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0048","text":"法院院长签发","bbox":[640.995,620.679,94.688,15.781],"color":"#ce4289","fontSize":15.781,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0049","text":"执行死刑的命令。死刑采用","bbox":[735.683,620.679,189.376,15.781],"color":"#141414","fontSize":15.781,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0050","text":"枪决或者注射","bbox":[925.059,620.679,94.688,15.781],"color":"#ce4289","fontSize":15.781,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0051","text":"等方法执行","bbox":[1019.747,620.679,78.907,15.781],"color":"#141414","fontSize":15.781,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0052","text":"③死刑缓期执行制度","bbox":[493.045,689.722,142.032,15.781],"color":"#141414","fontSize":15.781,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0053","text":"对于应当判处死刑的犯罪分子，如果不是必须立即执行的，","bbox":[672.557,666.05,410.316,15.781],"color":"#141414","fontSize":15.781,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0054","text":"可以判处死刑同时宣告","bbox":[672.557,689.722,157.814,15.781],"color":"#141414","fontSize":15.781,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"law-p024-n0055","text":"缓期","bbox":[830.371,689.722,31.563,15.781],"color":"#3949ab","fontSize":15.781,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0056","text":"2","bbox":[861.934,683.815,17.659,15.781],"color":"#3949ab","fontSize":15.781,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0057","text":"年执行","bbox":[879.611,689.722,47.344,15.781],"color":"#3949ab","fontSize":15.781,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"law-p024-n0058","text":"24","bbox":[587.275,810.711,16.0,21.344],"color":"#000000","fontSize":16.0,"block":22,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"law-p024-b0001","text":"第二章刑法七、刑罚","bbox":[69.085,382.222,215.514,17.754],"nodeIds":["law-p024-n0001","law-p024-n0002","law-p024-n0003"]},{"id":"law-p024-b0002","text":"主刑","bbox":[354.958,364.232,31.563,15.781],"nodeIds":["law-p024-n0004"]},{"id":"law-p024-b0003","text":"无期徒刑","bbox":[424.001,186.691,31.563,39.453],"nodeIds":["law-p024-n0005","law-p024-n0006"]},{"id":"law-p024-b0004","text":"剥夺犯罪分子终身自由，强迫其劳动并接受教育和改造","bbox":[493.045,119.62,378.752,15.781],"nodeIds":["law-p024-n0007","law-p024-n0008","law-p024-n0009"]},{"id":"law-p024-b0005","text":"①剥夺自由是没有期限的，即剥夺犯罪分子的终身自由","bbox":[493.045,164.992,378.753,15.781],"nodeIds":["law-p024-n0010","law-p024-n0011","law-p024-n0012","law-p024-n0013"]},{"id":"law-p024-b0006","text":"②强迫参加劳动，接受教育和改造","bbox":[493.045,210.363,236.72,15.781],"nodeIds":["law-p024-n0014","law-p024-n0015","law-p024-n0016"]},{"id":"law-p024-b0007","text":"③羁押时间不能折抵刑期","bbox":[493.045,255.735,173.594,15.781],"nodeIds":["law-p024-n0017","law-p024-n0018"]},{"id":"law-p024-b0008","text":"④必须附加剥夺政治权利终身","bbox":[493.045,301.106,205.157,15.781],"nodeIds":["law-p024-n0019","law-p024-n0020","law-p024-n0021"]},{"id":"law-p024-b0009","text":"死刑","bbox":[424.001,518.1,31.563,15.781],"nodeIds":["law-p024-n0022"]},{"id":"law-p024-b0010","text":"剥夺犯罪分子生命的刑罚方法。死刑是刑罚体系中最严厉的手段","bbox":[493.045,346.478,441.878,15.781],"nodeIds":["law-p024-n0023"]},{"id":"law-p024-b0011","text":"①适用","bbox":[493.045,437.22,47.344,15.781],"nodeIds":["law-p024-n0024"]},{"id":"law-p024-b0012","text":"死刑只适用于罪行极其严重的犯罪分子","bbox":[577.869,391.849,268.284,15.781],"nodeIds":["law-p024-n0025","law-p024-n0026","law-p024-n0027"]},{"id":"law-p024-b0013","text":"不得对犯罪的时候不满18周岁的人和审判的时候怀孕的妇女适用死刑","bbox":[577.869,431.313,482.102,21.688],"nodeIds":["law-p024-n0028","law-p024-n0029","law-p024-n0030","law-p024-n0031","law-p024-n0032","law-p024-n0033","law-p024-n0034"]},{"id":"law-p024-b0014","text":"审判时已满75周岁的人，不适用死刑，但以特别残忍手段致人死亡的除外","bbox":[577.869,476.684,514.837,21.689],"nodeIds":["law-p024-n0035","law-p024-n0036","law-p024-n0037","law-p024-n0038","law-p024-n0039"]},{"id":"law-p024-b0015","text":"②死刑立即执行","bbox":[493.045,586.157,110.47,15.781],"nodeIds":["law-p024-n0040"]},{"id":"law-p024-b0016","text":"判处死刑立即执行的案件，除依法由最高人民法院判决的以外，都应当","bbox":[640.995,527.963,489.222,15.781],"nodeIds":["law-p024-n0041"]},{"id":"law-p024-b0017","text":"报请最高人民法院核准；最高人民法院将复核结果通报最高人民检察院","bbox":[640.995,551.635,489.222,16.428],"nodeIds":["law-p024-n0042","law-p024-n0043","law-p024-n0044","law-p024-n0045"]},{"id":"law-p024-b0018","text":"最高人民法院判处和核准的死刑立即执行的判决，应当由最高人民","bbox":[640.995,597.007,457.659,15.781],"nodeIds":["law-p024-n0046","law-p024-n0047"]},{"id":"law-p024-b0019","text":"法院院长签发执行死刑的命令。死刑采用枪决或者注射等方法执行","bbox":[640.995,620.679,457.659,15.781],"nodeIds":["law-p024-n0048","law-p024-n0049","law-p024-n0050","law-p024-n0051"]},{"id":"law-p024-b0020","text":"③死刑缓期执行制度","bbox":[493.045,689.722,142.032,15.781],"nodeIds":["law-p024-n0052"]},{"id":"law-p024-b0021","text":"对于应当判处死刑的犯罪分子，如果不是必须立即执行的，","bbox":[672.557,666.05,410.316,15.781],"nodeIds":["law-p024-n0053"]},{"id":"law-p024-b0022","text":"可以判处死刑同时宣告缓期2年执行","bbox":[672.557,683.815,254.398,21.688],"nodeIds":["law-p024-n0054","law-p024-n0055","law-p024-n0056","law-p024-n0057"]},{"id":"law-p024-b0023","text":"24","bbox":[587.275,810.711,16.0,21.344],"nodeIds":["law-p024-n0058"]}],"questions":[{"id":"law-p024-q001","number":1,"type":"fill-in","answer":"强迫其劳动","bbox":[666.639,119.62,78.907,15.781],"fontSize":15.781,"color":"#00897b","segments":[{"text":"强迫其劳动","bbox":[666.639,119.62,78.907,15.781],"color":"#00897b"}],"nodeIds":["law-p024-n0008"],"aliases":[],"context":"剥夺犯罪分子终身自由，____并接受教育和改造"},{"id":"law-p024-q002","number":2,"type":"fill-in","answer":"没有期限","bbox":[587.733,164.992,63.125,15.781],"fontSize":15.781,"color":"#0