{"id":"law-p002","bookId":"law","number":2,"title":"第一章民法二、民事法律行为的效力","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p002.svg","dataUrl":"data/knowledge/pages/law/law-p002.json","questionCount":22,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":2},"nodes":[{"id":"law-p002-n0001","text":"第一章","bbox":[72.682,409.914,49.476,16.492],"color":"#141414","fontSize":16.492,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0002","text":"民法","bbox":[126.386,409.914,32.984,16.492],"color":"#141414","fontSize":16.492,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0003","text":"二、民事法律行为的效力","bbox":[214.239,410.611,161.256,14.66],"color":"#141414","fontSize":14.66,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p002-n0004","text":"有效的民事法律行为","bbox":[440.853,53.383,131.937,14.66],"color":"#8e24aa","fontSize":14.66,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0005","text":"（同时满足）","bbox":[462.843,75.372,87.958,14.66],"color":"#8e24aa","fontSize":14.66,"block":2,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0006","text":"行为人","bbox":[607.607,33.226,43.979,14.66],"color":"#000000","fontSize":14.66,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0007","text":"具有相应的民事行为能力","bbox":[651.586,33.226,161.256,14.66],"color":"#8e24aa","fontSize":14.66,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0008","text":"意思表示","bbox":[607.607,75.373,58.639,14.66],"color":"#000000","fontSize":14.66,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0009","text":"真实","bbox":[666.245,75.373,29.319,14.66],"color":"#8e24aa","fontSize":14.66,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0010","text":"不违反法律、行政法规","bbox":[607.607,117.519,146.597,14.66],"color":"#8e24aa","fontSize":14.66,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0011","text":"的强制性规定，","bbox":[754.203,117.519,102.618,14.66],"color":"#000000","fontSize":14.66,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0012","text":"不违背公序良俗","bbox":[856.821,117.519,102.618,14.66],"color":"#8e24aa","fontSize":14.66,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0013","text":"无效的民事法律行为","bbox":[440.853,243.958,131.937,14.66],"color":"#ff6f00","fontSize":14.66,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0014","text":"（满足一条即可）","bbox":[448.183,265.948,117.277,14.66],"color":"#ff6f00","fontSize":14.66,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0015","text":"无民事行为能力人","bbox":[607.607,159.666,117.277,14.66],"color":"#ff6f00","fontSize":14.66,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0016","text":"实施的民事法律行为","bbox":[724.884,159.666,131.937,14.66],"color":"#000000","fontSize":14.66,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0017","text":"行为人与相对人以","bbox":[607.607,201.812,117.277,14.66],"color":"#000000","fontSize":14.66,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0018","text":"虚假的意思表示","bbox":[724.884,201.812,102.618,14.66],"color":"#ff6f00","fontSize":14.66,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0019","text":"实施的民事法律行为无效","bbox":[827.502,201.812,161.256,14.66],"color":"#000000","fontSize":14.66,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0020","text":"违反法律、行政法规","bbox":[607.607,243.958,131.937,14.66],"color":"#ff6f00","fontSize":14.66,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0021","text":"的强制性规定的民事法律行为无效","bbox":[739.544,243.958,219.895,14.66],"color":"#000000","fontSize":14.66,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0022","text":"但是该强制性规定不导致该民事法律行为无效的除外","bbox":[607.607,265.948,337.172,14.66],"color":"#000000","fontSize":14.66,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0023","text":"违背公序良俗","bbox":[607.607,308.094,87.958,14.66],"color":"#ff6f00","fontSize":14.66,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0024","text":"的民事法律行为无效","bbox":[695.565,308.094,131.937,14.66],"color":"#000000","fontSize":14.66,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0025","text":"行为人与相对人","bbox":[607.607,350.241,102.618,14.66],"color":"#000000","fontSize":14.66,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0026","text":"恶意串通","bbox":[710.224,350.241,58.639,14.66],"color":"#ff6f00","fontSize":14.66,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0027","text":"，损害他人合法权益的民事法律行为无效","bbox":[768.863,350.241,263.874,14.66],"color":"#000000","fontSize":14.66,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0028","text":"效力待定的民事法律行为","bbox":[440.853,521.576,161.256,14.66],"color":"#19a719","fontSize":14.66,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0029","text":"类型","bbox":[636.926,446.445,29.319,14.66],"color":"#141414","fontSize":14.66,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0030","text":"限制民事行为能力人","bbox":[701.062,392.388,131.937,14.66],"color":"#19a719","fontSize":14.66,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0031","text":"实施的","bbox":[832.999,392.388,43.979,14.66],"color":"#000000","fontSize":14.66,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0032","text":"超越能力范围","bbox":[876.978,392.388,87.958,14.66],"color":"#19a719","fontSize":14.66,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0033","text":"的民事法律行为，经","bbox":[964.936,392.388,131.937,14.66],"color":"#000000","fontSize":14.66,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0034","text":"法定代理人同意或者追认后有效。拒绝追认，民事法律行为无效","bbox":[701.062,414.377,410.47,14.66],"color":"#000000","fontSize":14.66,"block":16,"line":1,"emphasis":false,"role":"content"},{"id":"law-p002-n0035","text":"行为人","bbox":[701.062,456.524,43.979,14.66],"color":"#000000","fontSize":14.66,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0036","text":"没有代理权、超越代理权或者代理权终止","bbox":[745.041,456.524,263.874,14.66],"color":"#19a719","fontSize":14.66,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0037","text":"后仍然实施","bbox":[1008.915,456.524,73.298,14.66],"color":"#000000","fontSize":14.66,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0038","text":"代理行为，未经被代理人追认的，对被代理人不发生效力","bbox":[701.062,478.513,366.492,14.66],"color":"#000000","fontSize":14.66,"block":17,"line":1,"emphasis":false,"role":"content"},{"id":"law-p002-n0039","text":"法律","bbox":[636.926,574.717,29.319,14.66],"color":"#141414","fontSize":14.66,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0040","text":"后果","bbox":[636.926,596.707,29.319,14.66],"color":"#141414","fontSize":14.66,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0041","text":"相对人的催告权及法定代理人（被代理人）的","bbox":[701.062,520.66,293.193,14.66],"color":"#141414","fontSize":14.66,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0042","text":"追认权","bbox":[994.255,520.66,43.979,14.66],"color":"#19a719","fontSize":14.66,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0043","text":"：相对人可","bbox":[1038.234,520.66,73.298,14.66],"color":"#141414","fontSize":14.66,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0044","text":"以催告法定代理人（被代理人）自收到通知之日起","bbox":[701.062,542.649,322.513,14.66],"color":"#141414","fontSize":14.66,"block":20,"line":1,"emphasis":false,"role":"content"},{"id":"law-p002-n0045","text":"30","bbox":[1027.369,537.161,21.081,14.66],"color":"#19a719","fontSize":14.66,"block":20,"line":1,"emphasis":true,"role":"content"},{"id":"law-p002-n0046","text":"日","bbox":[1048.442,542.649,14.66,14.66],"color":"#19a719","fontSize":14.66,"block":20,"line":1,"emphasis":true,"role":"content"},{"id":"law-p002-n0047","text":"内予以","bbox":[1063.101,542.649,43.979,14.66],"color":"#141414","fontSize":14.66,"block":20,"line":1,"emphasis":false,"role":"content"},{"id":"law-p002-n0048","text":"追认。法定代理人（被代理人）未作表示的，视为拒绝追认","bbox":[701.062,564.639,381.151,14.66],"color":"#141414","fontSize":14.66,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0049","text":"善意相对人的撤销权","bbox":[701.062,606.785,131.937,14.66],"color":"#19a719","fontSize":14.66,"block":22,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0050","text":"：民事法律行为被追认前，善意","bbox":[832.999,606.785,205.235,14.66],"color":"#141414","fontSize":14.66,"block":22,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0051","text":"相对人有撤销的权利。撤销应当以","bbox":[701.062,628.775,219.895,14.66],"color":"#141414","fontSize":14.66,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0052","text":"通知","bbox":[920.957,628.775,29.319,14.66],"color":"#19a719","fontSize":14.66,"block":23,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0053","text":"的方式作出","bbox":[950.276,628.775,73.298,14.66],"color":"#141414","fontSize":14.66,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"law-p002-n0054","text":"可撤销的民事法律行为","bbox":[440.853,711.032,146.597,14.66],"color":"#1e88e5","fontSize":14.66,"block":24,"line":0,"emphasis":true,"role":"content"},{"id":"law-p002-n0055","text":"2","bbox":[591.275,810.711,8.0,21.344],"color":"#000000","fontSize":16.0,"block":25,"line":0,"emphasis":false,"role":"page-number"},{"id":"law-p002-r01-n001","text":"类型","bbox":[663.148,673.872,28.129,15.554],"color":"#141414","fontSize":15.554,"block":10016,"line":0,"emphasis":false,"role":"content","sourceKind":"ocr","sourceImageId":"law-p002-r01","confidence":0.999987},{"id":"law-p002-r01-n002","text":"撤销