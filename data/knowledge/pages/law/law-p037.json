{"id":"law-p037","bookId":"law","number":37,"title":"第三章行政法五、行政强制","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p037.svg","dataUrl":"data/knowledge/pages/law/law-p037.json","questionCount":27,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":37},"nodes":[{"id":"law-p037-n0001","text":"第三章","bbox":[64.042,397.535,49.054,16.351],"color":"#141414","fontSize":16.351,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0002","text":"行政法","bbox":[117.287,397.535,49.054,16.351],"color":"#141414","fontSize":16.351,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0003","text":"五、行政强制","bbox":[220.741,398.226,87.206,14.534],"color":"#141414","fontSize":14.534,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p037-n0004","text":"措施","bbox":[372.746,231.534,29.069,14.534],"color":"#19a719","fontSize":14.534,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0005","text":"是指行政机关在","bbox":[436.334,126.16,101.741,14.534],"color":"#000000","fontSize":14.534,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0006","text":"行政管理过程中","bbox":[436.334,147.962,101.741,14.534],"color":"#000000","fontSize":14.534,"block":2,"line":1,"emphasis":false,"role":"content"},{"id":"law-p037-n0007","text":"为","bbox":[572.594,106.175,14.534,14.534],"color":"#000000","fontSize":14.534,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0008","text":"制止违法行为、防止证据损毁、避免危害发生、控制危险扩大","bbox":[587.128,106.175,392.428,14.534],"color":"#19a719","fontSize":14.534,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0009","text":"等情形","bbox":[979.557,106.175,43.603,14.534],"color":"#000000","fontSize":14.534,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0010","text":"依法对公民的人身自由实施","bbox":[572.594,147.962,174.413,14.534],"color":"#000000","fontSize":14.534,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0011","text":"暂时性限制","bbox":[747.007,147.962,72.672,14.534],"color":"#19a719","fontSize":14.534,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0012","text":"或者对公民、法人或者其他组织的财物实施","bbox":[572.594,189.748,276.153,14.534],"color":"#000000","fontSize":14.534,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0013","text":"暂时性控制","bbox":[848.747,189.748,72.672,14.534],"color":"#19a719","fontSize":14.534,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0014","text":"的行为","bbox":[921.419,189.748,43.603,14.534],"color":"#000000","fontSize":14.534,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0015","text":"种类","bbox":[436.334,231.534,29.069,14.534],"color":"#141414","fontSize":14.534,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0016","text":"限制公民人身自由；查封场所、设施或者财物；扣押财物；冻结存款、汇款；其他行政强制措施","bbox":[499.922,231.534,610.444,15.13],"color":"#000000","fontSize":14.534,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"law-p037-n0017","text":"实施","bbox":[436.334,319.649,29.069,14.534],"color":"#141414","fontSize":14.534,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0018","text":"①实施主体：由","bbox":[499.922,277.863,101.741,15.13],"color":"#000000","fontSize":14.534,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0019","text":"法律、法规","bbox":[601.663,277.863,72.672,14.534],"color":"#8e24aa","fontSize":14.534,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0020","text":"规定的","bbox":[674.335,277.863,43.603,14.534],"color":"#000000","fontSize":14.534,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0021","text":"行政机关（不得委托）","bbox":[717.938,277.863,145.344,14.534],"color":"#8e24aa","fontSize":14.534,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0022","text":"②","bbox":[499.922,319.649,14.534,14.534],"color":"#000000","fontSize":14.534,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0023","text":"不得查封、扣押","bbox":[514.457,319.649,101.741,14.534],"color":"#8e24aa","fontSize":14.534,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0024","text":"公民","bbox":[616.197,319.649,29.069,14.534],"color":"#000000","fontSize":14.534,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0025","text":"个人及其所扶养家属","bbox":[645.266,319.649,130.809,14.534],"color":"#8e24aa","fontSize":14.534,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0026","text":"的","bbox":[776.076,319.649,14.534,14.534],"color":"#000000","fontSize":14.534,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0027","text":"生活必需品","bbox":[790.61,319.649,72.672,14.534],"color":"#8e24aa","fontSize":14.534,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0028","text":"③冻结存款、汇款的数额应当与违法行为涉及的金额相当；","bbox":[499.922,361.435,377.894,15.13],"color":"#000000","fontSize":14.534,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0029","text":"已被其他国家机关依法冻结的，","bbox":[514.968,383.237,203.481,14.534],"color":"#000000","fontSize":14.534,"block":10,"line":1,"emphasis":false,"role":"content"},{"id":"law-p037-n0030","text":"不得重复冻结","bbox":[718.449,383.237,87.206,14.534],"color":"#8e24aa","fontSize":14.534,"block":10,"line":1,"emphasis":true,"role":"content"},{"id":"law-p037-n0031","text":"执行","bbox":[372.746,530.398,29.069,14.534],"color":"#1e88e5","fontSize":14.534,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0032","text":"是指行政机关或者行政机关申请人民法院","bbox":[436.334,445.916,261.619,14.534],"color":"#000000","fontSize":14.534,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0033","text":"对","bbox":[732.472,425.023,14.534,14.534],"color":"#000000","fontSize":14.534,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0034","text":"不履行","bbox":[747.007,425.023,43.603,14.534],"color":"#1e88e5","fontSize":14.534,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0035","text":"政决定","bbox":[805.144,425.023,43.603,14.534],"color":"#1e88e5","fontSize":14.534,"block":13,"line":1,"emphasis":true,"role":"content"},{"id":"law-p037-n0036","text":"的公民、法人或者其他组织","bbox":[848.747,425.023,174.413,14.534],"color":"#000000","fontSize":14.534,"block":13,"line":1,"emphasis":false,"role":"content"},{"id":"law-p037-n0037","text":"依法","bbox":[732.472,466.81,29.069,14.534],"color":"#000000","fontSize":14.534,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0038","text":"强制履行义务","bbox":[761.541,466.81,87.206,14.534],"color":"#1e88e5","fontSize":14.534,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0039","text":"的行为","bbox":[848.747,466.81,43.603,14.534],"color":"#000000","fontSize":14.534,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0040","text":"种类","bbox":[436.334,530.398,29.069,14.534],"color":"#141414","fontSize":14.534,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0041","text":"加处罚款","bbox":[499.922,508.596,58.138,14.534],"color":"#ff6f00","fontSize":14.534,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0042","text":"或者","bbox":[558.06,508.596,29.069,14.534],"color":"#000000","fontSize":14.534,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0043","text":"滞纳金；划拨","bbox":[587.128,508.596,87.206,15.13],"color":"#ff6f00","fontSize":14.534,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0044","text":"存款、汇款；","bbox":[674.335,508.596,87.206,15.13],"color":"#000000","fontSize":14.534,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0045","text":"拍卖","bbox":[761.541,508.596,29.069,14.534],"color":"#ff6f00","fontSize":14.534,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0046","text":"或者依法处理","bbox":[790.61,508.596,87.206,14.534],"color":"#000000","fontSize":14.534,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0047","text":"查封、扣押","bbox":[877.816,508.596,72.672,14.534],"color":"#ff6f00","fontSize":14.534,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0048","text":"的","bbox":[950.488,508.596,14.534,14.534],"color":"#000000","fontSize":14.534,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0049","text":"场所、设施或者财物；排除妨碍、恢复原状；","bbox":[499.922,530.398,290.688,15.13],"color":"#000000","fontSize":14.534,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0050","text":"代履行","bbox":[790.61,530.398,43.603,14.534],"color":"#ff6f00","fontSize":14.534,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0051","text":"；其他强制执行方式","bbox":[834.213,530.398,130.809,15.13],"color":"#000000","fontSize":14.534,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0052","text":"实施","bbox":[436.334,640.314,29.069,14.534],"color":"#141414","fontSize":14.534,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0053","text":"①行政机关","bbox":[499.922,576.726,72.672,14.534],"color":"#000000","fontSize":14.534,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0054","text":"不得在夜间或者法定节假日实施","bbox":[572.594,576.726,203.481,14.534],"color":"#e53935","fontSize":14.534,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0055","text":"行政强制执行。但是，","bbox":[776.076,576.726,145.344,14.534],"color":"#000000","fontSize":14.534,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0056","text":"情况紧急的除外","bbox":[921.419,576.726,101.741,14.534],"color":"#e53935","fontSize":14.534,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0057","text":"②行政机关","bbox":[499.922,618.512,72.672,14.534],"color":"#000000","fontSize":14.534,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0058","text":"不得对居民","bbox":[572.594,618.512,72.672,14.534],"color":"#e53935","fontSize":14.534,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0059","text":"生活采取","bbox":[645.266,618.512,58.137,14.534],"color":"#000000","fontSize":14.534,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0060","text":"停止供水、供电、供热、供燃气等","bbox":[703.404,618.512,218.016,14.534],"color":"#e53935","fontSize":14.534,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0061","text":"方式迫使当事人履行相关行政决定","bbox":[921.419,618.512,218.016,14.534],"color":"#000000","fontSize":14.534,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0062","text":"③需要立即","bbox":[499.922,660.299,72.672,14.534],"color":"#000000","fontSize":14.534,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0063","text":"清除道路、河道、航道","bbox":[572.594,660.299,145.344,14.534],"color":"#e53935","fontSize":14.534,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0064","text":"或者","bbox":[717.938,660.299,29.069,14.534],"color":"#000000","fontSize":14.534,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0065","text":"公共场所的遗洒物、障碍物","bbox":[747.007,660.299,174.413,14.534],"color":"#e53935","fontSize":14.534,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"law-p037-n0066","text":"或者污染物，","bbox":[921.419,660.299,87.206,14.534],"color":"#000000","fontSize":14.534,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"law-p037-n0067","text":"当事人","bbox":[499.922,682.1,43.603,14.534],"color":"#000000","fontSize":14.534,"block":21,"line":1,"emphasis":false,"role":"content"},{"id":"law-p037-n0068","text":"不能清除","bbox":[543.525,682.1,58.138,14.534],"color":"#e53935","fontSize":14.534,"block":21,"line":1,"emphasis":true,"role":"content"},{"id":"law-p037-n0069","text":"的，行政机关可以决定","bbox":[601.663,682.1,145.344,14.534],"color":"#000000","fontSize":14.534,"block":21,"line":1,"emphasis":false,"role":"content"},{"id":"law-p037-n0070","text":"立即实施代履行","bbox":[747.007,682.1,101.741,14.534],"color":"#e53935","fontSize":14.534,"block":21,"line":1,"emphasis":true,"role":"content"},{"id":"law-p037-n0071","text":"；当事人不在场的，行政","bbox":[848.747,682.1,159.878,15.13],"color":"#000000","fontSize":14.534,"block":21,"line":1,"emphasis":false,"role":"content"},{"id":"law-p037-n0072","text":"机关应当在事后立即通知当事人，并依法作出处理","bbox":[499.922,703.902,319.756,14.534],"color":"#000000","fontSize":14.534,"block":21,"line":2,"emphasis":false,"role":"content"},{"id":"law-p037-n0073","text":"37","bbox":[587.275,810.711,16.0,21.344],"color":"#000000","fontSize":16.0,"block":22,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"law-p037-b0001","text":"第三章行政法五、行政强制","bbox":[64.042,397.535,243.905,16.351],"nodeIds":["law-p037-n0001","law-p037-n0002","law-p037-n0003"]},{"id":"law-p037-b0002","text":"措施","bbox":[372.746,231.534,29.069,14.534],"nodeIds":["law-p037-n0004"]},{"id":"law-p037-b0003","text":"是指行政机关在行政管理过程中","bbox":[436.334,126.16,101.741,36.336],"nodeIds":["law-p037-n0005","law-p037-n0006"]},{"id":"law-p037-b0004","text":"为制止违法行为、防止证据损毁、避免危害发生、控制危险扩大等情形","bbox":[572.594,106.175,450.566,14.534],"nodeIds":["law-p037-n0007","law-p037-n0008","law-p037-n0009"]},{"id":"law-p037-b0005","text":"依法对公民的人身自由实施暂时性限制","bbox":[572.594,147.962,247.085,14.534],"nodeIds":["law-p037-n0010","law-p037-n0011"]},{"id":"law-p037-b0006","text":"或者对公民、法人或者其他组织的财物实施暂时性控制的行为","bbox":[572.594,189.748,392.428,14.534],"nodeIds":["law-p037-n0012","law-p037-n0013","law-p037-n0014"]},{"id":"law-p037-b0007","text":"种类限制公民人身自由；查封场所、设施或者财物；扣押财物；冻结存款、汇款；其他行政强制措施","bbox":[436.334,231.534,674.032,15.13],"nodeIds":["law-p037-n0015","law-p037-n0016"]},{"id":"law-p037-b0008","text":"实施","bbox":[436.334,319.649,29.069,14.534],"nodeIds":["law-p037-n0017"]},{"id":"law-p037-b0009","text":"①实施主体：由法律、法规规定的行政机关（不得委托）","bbox":[499.922,277.863,363.36,15.13],"nodeIds":["law-p037-n0018","law-p037-n0019","law-p037-n0020","law-p037-n0021"]},{"id":"law-p037-b0010","text":"②不得查封、扣押公民个人及其所扶养家属的生活必需品","bbox":[499.922,319.649,363.36,14.534],"nodeIds":["law-p037-n0022","law-p037-n0023","law-p037-n0024","law-p037-n0025","law-p037-n0026","law-p037-n0027"]},{"id":"law-p037-b0011","text":"③冻结存款、汇款的数额应当与违法行为涉及的金额相当；已被其他国家机关依法冻结的，不得重复冻结","bbox":[499.922,361.435,377.894,36.336],"nodeIds":["law-p037-n0028","law-p037-n0029","law-p037-n0030"]},{"id":"law-p037-b0012","text":"执行","bbox":[372.746,530.398,29.069,14.534],"nodeIds":["law-p037-n0031"]},{"id":"law-p037-b0013","text":"是指行政机关或者行政机关申请人民法院","bbox":[436.334,445.916,261.619,14.534],"nodeIds":["law-p037-n0032"]},{"id":"law-p037-b0014","text":"对不履行政决定的公民、法人或者其他组织","bbox":[732.472,425.023,290.688,14.534],"nodeIds":["law-p037-n0033","law-p037-n0034","law-p037-n0035","law-p037-n0036"]},{"id":"law-p037-b0015","text":"依法强制履行义务的行为","bbox":[732.472,466.81,159.878,14.534],"nodeIds":["law-p037-n0037","law-p037-n0038","law-p037-n0039"]},{"id":"law-p037-b0016","text":"种类","bbox":[436.334,530.398,29.069,14.534],"nodeIds":["law-p037-n0040"]},{"id":"law-p037-b0017","text":"加处罚款或者滞纳金；划拨存款、汇款；拍卖或者依法处理查封、扣押的","bbox":[499.922,508.596,465.1,15.13],"nodeIds":["law-p037-n0041","law-p037-n0042","law-p037-n0043","law-p037-n0044","law-p037-n0045","law-p037-n0046","law-p037-n0047","law-p037-n0048"]},{"id":"law-p037-b0018","text":"场所、设施或者财物；排除妨碍、恢复原状；代履行；其他强制执行方式","bbox":[499.922,530.398,465.1,15.13],"nodeIds":["law-p037-n0049","law-p037-n0050","law-p037-n0051"]},{"id":"law-p037-b0019","text":"实施","bbox":[436.334,640.314,29.069,14.534],"nodeIds":["law-p037-n0052"]},{"id":"law-p037-b0020","text":"①行政机关不得在夜间或者法定节假日实施行政强制执行。但是，情况紧急的除外","bbox":[499.922,576.726,523.238,14.534],"nodeIds":["law-p037-n0053","law-p037-n0054","law-p037-n0055","law-p037-n0056"]},{"id":"law-p037-b0021","text":"②行政机关不得对居民生活采取停止供水、供电、供热、供燃气等方式迫使当事人履行相关行政决定","bbox":[499.922,618.512,639.513,14.534],"nodeIds":["law-p037-n0057","law-p037-n0058","la