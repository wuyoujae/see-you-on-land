04.137,14.483],"color":"#141414","fontSize":14.483,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p007-n0011","text":"与违约金不得同时","bbox":[805.709,242.958,115.862,14.483],"color":"#e53935","fontSize":14.483,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"law-p007-n0012","text":"适用","bbox":[921.571,242.958,28.965,14.483],"color":"#141414","fontSize":14.483,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p007-n0013","text":"①定金的","bbox":[501.571,294.553,57.931,14.483],"color":"#141414","fontSize":14.483,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p007-n0014","text":"数额","bbox":[559.502,294.553,28.966,14.483],"color":"#1e88e5","fontSize":14.483,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p007-n0015","text":"由当事人约定，但不得超过主合同标的额的","bbox":[622.864,294.553,275.172,14.483],"color":"#141414","fontSize":14.483,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"law-p007-n0016","text":"20","bbox":[898.036,289.202,20.16,14.483],"color":"#141414","fontSize":14.483,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"law-p007-n0017","text":"％，超过部分不产生定金的效力","bbox":[918.198,294.553,202.758,14.483],"color":"#141414","fontSize":14.483,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"law-p007-n0018","text":"②定金","bbox":[501.571,404.079,43.448,14.483],"color":"#141414","fontSize":14.483,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p007-n0019","text":"罚则","bbox":[545.02,404.079,28.966,14.483],"color":"#1e88e5","fontSize":14.483,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p007-n0020","text":"债务人履行债务的，定金应当抵作价款或者收回","bbox":[608.381,340.717,304.137,14.483],"color":"#141414","fontSize":14.483,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p007-n0021","text":"给付定金的一方不履行债务或者履行债务不符合约","bbox":[608.381,382.355,318.62,14.483],"color":"#141414","fontSize":14.483,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p007