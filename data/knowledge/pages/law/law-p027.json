{"id":"law-p027","bookId":"law","number":27,"title":"第二章刑法九、危害公共安全罪","width":1190.55,"height":841.89,"image":"data/knowledge/pages/law/law-p027.svg","dataUrl":"data/knowledge/pages/law/law-p027.json","questionCount":27,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·法律常识思维导图.pdf","sha256":"13f2556a80241b0d6de1e51bc187b6ead06e073e131fa1e8b6d073fc888c8c70","page":27},"nodes":[{"id":"law-p027-n0001","text":"第二章","bbox":[65.573,474.365,50.226,16.742],"color":"#141414","fontSize":16.742,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0002","text":"刑法","bbox":[120.092,474.365,33.484,16.742],"color":"#141414","fontSize":16.742,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0003","text":"九、危害公共安全罪","bbox":[209.277,475.072,133.937,14.882],"color":"#141414","fontSize":14.882,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"law-p027-n0004","text":"交通肇事罪","bbox":[409.562,217.894,74.409,14.882],"color":"#ce4289","fontSize":14.882,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0005","text":"含义","bbox":[519.316,131.393,29.764,14.882],"color":"#141414","fontSize":14.882,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0006","text":"指违反交通运输管理法规，因而发生重大事故","bbox":[584.424,110.0,297.638,14.882],"color":"#000000","fontSize":14.882,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0007","text":"致人重伤、死亡或者使公私财产遭受重大损失的行为","bbox":[584.424,152.786,342.283,14.882],"color":"#000000","fontSize":14.882,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0008","text":"常见","bbox":[519.316,282.072,29.764,14.882],"color":"#141414","fontSize":14.882,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0009","text":"情形","bbox":[519.316,304.395,29.764,14.882],"color":"#141414","fontSize":14.882,"block":5,"line":1,"emphasis":false,"role":"content"},{"id":"law-p027-n0010","text":"①","bbox":[584.424,195.571,14.882,14.882],"color":"#141414","fontSize":14.882,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0011","text":"“","bbox":[599.306,190.0,6.34,14.882],"color":"#1e88e5","fontSize":14.882,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0012","text":"因逃逸致人死亡","bbox":[605.65,195.571,104.173,14.882],"color":"#1e88e5","fontSize":14.882,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0013","text":"”","bbox":[709.823,190.0,6.34,14.882],"color":"#1e88e5","fontSize":14.882,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0014","text":"即因为行为人逃逸使得被害人得不到及时救助而死亡","bbox":[716.167,195.571,342.284,14.882],"color":"#141414","fontSize":14.882,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0015","text":"②","bbox":[584.424,238.356,14.882,14.882],"color":"#141414","fontSize":14.882,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0016","text":"单位主管人员、机动车辆所有人","bbox":[599.306,238.356,208.347,14.882],"color":"#19a719","fontSize":14.882,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0017","text":"或者机动车辆承包人","bbox":[807.653,238.356,133.937,14.882],"color":"#141414","fontSize":14.882,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0018","text":"指使、强令","bbox":[941.59,238.356,74.409,14.882],"color":"#19a719","fontSize":14.882,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0019","text":"他人违章","bbox":[584.424,260.679,59.527,14.882],"color":"#19a719","fontSize":14.882,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0020","text":"驾驶造成重大交通事故的，以","bbox":[643.952,260.679,193.465,14.882],"color":"#141414","fontSize":14.882,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0021","text":"交通肇事罪定罪处罚","bbox":[837.416,260.679,133.937,14.882],"color":"#19a719","fontSize":14.882,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0022","text":"③交通肇事后，单位主管人员、机动车辆所有人、承包人或者乘车人","bbox":[584.424,303.465,446.457,14.882],"color":"#141414","fontSize":14.882,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0023","text":"指使肇","bbox":[1030.881,303.465,44.646,14.882],"color":"#ff6f00","fontSize":14.882,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0024","text":"事人逃逸","bbox":[584.424,325.788,59.528,14.882],"color":"#ff6f00","fontSize":14.882,"block":9,"line":1,"emphasis":true,"role":"content"},{"id":"law-p027-n0025","text":"，致使","bbox":[643.952,325.788,44.646,14.882],"color":"#141414","fontSize":14.882,"block":9,"line":1,"emphasis":false,"role":"content"},{"id":"law-p027-n0026","text":"被害人因得不到救助而死亡","bbox":[688.598,325.788,178.583,14.882],"color":"#ff6f00","fontSize":14.882,"block":9,"line":1,"emphasis":true,"role":"content"},{"id":"law-p027-n0027","text":"的，以","bbox":[867.18,325.788,44.646,14.882],"color":"#141414","fontSize":14.882,"block":9,"line":1,"emphasis":false,"role":"content"},{"id":"law-p027-n0028","text":"交通肇事罪的共犯","bbox":[911.826,325.788,119.055,14.882],"color":"#ff6f00","fontSize":14.882,"block":9,"line":1,"emphasis":true,"role":"content"},{"id":"law-p027-n0029","text":"论处","bbox":[1030.881,325.788,29.764,14.882],"color":"#141414","fontSize":14.882,"block":9,"line":1,"emphasis":false,"role":"content"},{"id":"law-p027-n0030","text":"④行为人在交通肇事后","bbox":[584.424,368.573,148.819,14.882],"color":"#141414","fontSize":14.882,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0031","text":"为逃避法律追究","bbox":[733.243,368.573,104.173,14.882],"color":"#8e24aa","fontSize":14.882,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0032","text":"，将","bbox":[837.416,368.573,29.764,14.882],"color":"#141414","fontSize":14.882,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0033","text":"被害人带离事故现场后隐藏或者","bbox":[867.18,368.573,208.346,14.882],"color":"#8e24aa","fontSize":14.882,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0034","text":"遗弃","bbox":[584.424,390.896,29.764,14.882],"color":"#8e24aa","fontSize":14.882,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0035","text":"，致使被害人无法得到救助而死亡或者严重残疾的，应当以","bbox":[614.188,390.896,386.929,14.882],"color":"#141414","fontSize":14.882,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0036","text":"故意杀人罪","bbox":[1001.117,390.896,74.409,14.882],"color":"#8e24aa","fontSize":14.882,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0037","text":"或者","bbox":[584.424,413.219,29.764,14.882],"color":"#141414","fontSize":14.882,"block":11,"line":1,"emphasis":false,"role":"content"},{"id":"law-p027-n0038","text":"故意伤害罪","bbox":[614.188,413.219,74.409,14.882],"color":"#8e24aa","fontSize":14.882,"block":11,"line":1,"emphasis":true,"role":"content"},{"id":"law-p027-n0039","text":"定罪处罚","bbox":[688.598,413.219,59.527,14.882],"color":"#141414","fontSize":14.882,"block":11,"line":1,"emphasis":false,"role":"content"},{"id":"law-p027-n0040","text":"危险驾驶罪","bbox":[409.562,511.811,74.409,14.882],"color":"#00897b","fontSize":14.882,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0041","text":"含义","bbox":[519.316,456.004,29.764,14.882],"color":"#141414","fontSize":14.882,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0042","text":"危险驾驶罪是指在道路上驾驶机动车，实施刑法所禁止的危险驾驶行为","bbox":[584.424,456.004,461.338,14.882],"color":"#000000","fontSize":14.882,"block":13,"line":1,"emphasis":false,"role":"content"},{"id":"law-p027-n0043","text":"具体","bbox":[519.316,545.295,29.764,14.882],"color":"#141414","fontSize":14.882,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0044","text":"情形","bbox":[519.316,567.618,29.764,14.882],"color":"#141414","fontSize":14.882,"block":14,"line":1,"emphasis":false,"role":"content"},{"id":"law-p027-n0045","text":"①","bbox":[584.424,503.44,14.882,14.882],"color":"#000000","fontSize":14.882,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0046","text":"追逐竞驶","bbox":[599.306,503.44,59.528,14.882],"color":"#e53935","fontSize":14.882,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0047","text":"，情节恶劣","bbox":[658.834,503.44,74.409,14.882],"color":"#000000","fontSize":14.882,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0048","text":"②","bbox":[584.424,546.226,14.882,14.882],"color":"#000000","fontSize":14.882,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0049","text":"醉酒驾驶","bbox":[599.306,546.226,59.528,14.882],"color":"#e53935","fontSize":14.882,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0050","text":"机动车","bbox":[658.834,546.226,44.646,14.882],"color":"#000000","fontSize":14.882,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0051","text":"(","bbox":[703.479,540.727,4.747,14.882],"color":"#000000","fontSize":14.882,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0052","text":"血液酒精含量达到","bbox":[708.232,546.226,119.055,14.882],"color":"#000000","fontSize":14.882,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0053","text":"80","bbox":[831.138,540.655,21.46,14.882],"color":"#e53935","fontSize":14.882,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0054","text":"毫克","bbox":[852.596,546.226,29.764,14.882],"color":"#e53935","fontSize":14.882,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0055","text":"/100","bbox":[882.36,540.655,34.377,14.882],"color":"#e53935","fontSize":14.882,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0056","text":"毫升","bbox":[916.731,546.226,29.764,14.882],"color":"#e53935","fontSize":14.882,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0057","text":"以上","bbox":[946.502,546.226,29.764,14.882],"color":"#000000","fontSize":14.882,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0058","text":")","bbox":[976.266,540.727,4.747,14.882],"color":"#000000","fontSize":14.882,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0059","text":"③从事","bbox":[584.424,589.011,44.646,14.882],"color":"#000000","fontSize":14.882,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0060","text":"校车业务或者旅客运输","bbox":[629.07,589.011,148.819,14.882],"color":"#e53935","fontSize":14.882,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0061","text":"，严重超过额定乘员载客或者严重超过规定时速行驶的","bbox":[777.889,589.011,357.165,14.882],"color":"#000000","fontSize":14.882,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0062","text":"④","bbox":[584.424,631.796,14.882,14.882],"color":"#000000","fontSize":14.882,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0063","text":"违反危险化学品安全管理规定运输","bbox":[599.306,631.796,223.228,14.882],"color":"#e53935","fontSize":14.882,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0064","text":"危险化学品，危及公共安全的","bbox":[822.534,631.796,193.465,14.882],"color":"#000000","fontSize":14.882,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0065","text":"妨害安全驾驶罪","bbox":[409.562,696.905,104.173,14.882],"color":"#3949ab","fontSize":14.882,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0066","text":"指对","bbox":[549.08,674.582,29.764,14.882],"color":"#000000","fontSize":14.882,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0067","text":"行驶中的","bbox":[578.843,674.582,59.528,14.882],"color":"#3949ab","fontSize":14.882,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"law-p027-n0068","text":"公共交通工具的","bbox":[638.371,674.582,104.173,14.882],"color":"#000000","fontSize":14.882,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"law-p027-n0069","text":"驾驶人员","bbox":[742.544,674.582,59.528,14.882],"color":"#3949ab","fontSize":14.882,"