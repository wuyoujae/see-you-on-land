23,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0056","text":"反向变动","bbox":[839.64,661.076,65.307,16.327],"color":"#3949ab","fontSize":16.327,"block":23,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0057","text":"的关系","bbox":[904.947,661.076,48.98,16.327],"color":"#141414","fontSize":16.327,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0058","text":"通货膨胀率高，失业率低；通货膨胀率低，则失业率高","bbox":[611.065,708.016,391.843,16.996],"color":"#141414","fontSize":16.327,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0059","text":"菲利普斯曲线","bbox":[611.065,754.955,97.961,16.327],"color":"#141414","fontSize":16.327,"block":25,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0060","text":"只在短期有效","bbox":[709.026,754.955,97.961,16.327],"color":"#3949ab","fontSize":16.327,"block":25,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0061","text":"，长期无效","bbox":[806.986,754.955,81.634,16.327],"color":"#141414","fontSize":16.327,"block":25,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0062","text":"4","bbox":[591.275,810.711,8.0,21.344],"color":"#000000","fontSize":16.0,"block":26,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"economics-p004-b0001","text":"四、通货膨胀","bbox":[71.43,424.582,110.206,18.368],"nodeIds":["economics-p004-n0001"]},{"id":"economics-p004-b0002","text":"含义是指在货币流通条件下","bbox":[272.283,103.924,234.698,16.327],"nodeIds":["economics-p004-n0002","economics-p004-n0003"]},{"id":"economics-p004-b0003","text":"因货币供给大于货币实际需求，导致货币贬值","bbox":[545.758,56.984,326.536,16.327],"nodeIds":["economics-p004-n0004","economics-p004-n0005","economics-p004-n0006","economics-p004-n0007","economics-p004-n0008"]},{"id":"economics-p004-b0004","text":"而引起的一段时间内商品和劳务的价格持续而普遍地上涨现象","bbox":[545.758,103.924,440.824,16.327],"nodeIds":["economics-p004-n0009","economics-p004-n0010","economics-p004-n0011"]},{"id":"economics-p004-b0005","t