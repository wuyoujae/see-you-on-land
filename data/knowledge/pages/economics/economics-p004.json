010","text":"价格持续而普遍地上涨","bbox":[790.659,103.924,163.268,16.327],"color":"#8e24aa","fontSize":16.327,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0011","text":"现象","bbox":[953.928,103.924,32.654,16.327],"color":"#141414","fontSize":16.327,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0012","text":"其实质是","bbox":[545.758,150.864,65.307,16.327],"color":"#141414","fontSize":16.327,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0013","text":"社会总需求大于社会总供给","bbox":[611.065,150.864,195.922,16.327],"color":"#8e24aa","fontSize":16.327,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0014","text":"衡量","bbox":[272.283,313.111,32.654,16.327],"color":"#ff6f00","fontSize":16.327,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0015","text":"物价指数是衡量通货膨胀程度的基本指标，常见的有消费价格指数、生产者价格指数等","bbox":[343.713,195.762,620.419,16.327],"color":"#141414","fontSize":16.327,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0016","text":"消费价格指数","bbox":[343.713,253.416,97.961,16.327],"color":"#1e88e5","fontSize":16.327,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0017","text":"（","bbox":[363.245,277.907,16.327,16.327],"color":"#1e88e5","fontSize":16.327,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0018","text":"CPI","bbox":[379.572,271.795,26.237,16.327],"color":"#1e88e5","fontSize":16.327,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0019","text":"）","bbox":[405.792,277.907,16.327,16.327],"color":"#1e88e5","fontSize":16.327,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0020","text":"也称居民消费价格指数，是反映","bbox":[480.45,242.702,228.575,16.327],"color":"#141414","fontSize":16.327,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0021","text":"与居民生活有关","bbox":[709.026,242.702,114.288,16.327],"