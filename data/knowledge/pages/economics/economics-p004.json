omics-p004-n0033","text":"CPI","bbox":[617.187,330.549,24.36,16.327],"color":"#141414","fontSize":16.327,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0034","text":"增幅低于","bbox":[641.534,336.581,65.307,16.327],"color":"#141414","fontSize":16.327,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0035","text":"1%","bbox":[706.841,330.549,25.274,16.327],"color":"#141414","fontSize":16.327,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0036","text":"且持续一段时间，预示着通货紧缩的风险","bbox":[732.105,336.581,293.882,16.327],"color":"#141414","fontSize":16.327,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0037","text":"生产者价格指数","bbox":[343.713,405.97,114.288,16.327],"color":"#19a719","fontSize":16.327,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0038","text":"（","bbox":[372.492,430.46,16.327,16.327],"color":"#19a719","fontSize":16.327,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0039","text":"PPI","bbox":[388.819,424.348,24.066,16.327],"color":"#19a719","fontSize":16.327,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0040","text":"）","bbox":[412.871,430.46,16.327,16.327],"color":"#19a719","fontSize":16.327,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0041","text":"也称工业生产者出厂价格指数","bbox":[496.777,383.521,212.248,16.327],"color":"#141414","fontSize":16.327,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0042","text":"是衡量工业企业产品","bbox":[496.777,430.46,146.941,16.327],"color":"#141414","fontSize":16.327,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"economics-p004-n0043","text":"出厂价格变动","bbox":[643.718,430.46,97.961,16.327],"color":"#19a719","fontSize":16.327,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"economics-p004-n0044","text":"趋势和变动程度的指数","bbox":[741.679,430.46,163.268,16.327],"col