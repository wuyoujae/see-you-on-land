{"id":"marxism-p003","bookId":"marxism","number":3,"title":"知识点3物质与意识","width":1190.55,"height":841.89,"image":"data/knowledge/pages/marxism/marxism-p003.svg","dataUrl":"data/knowledge/pages/marxism/marxism-p003.json","questionCount":14,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·马原理论思维导图.pdf","sha256":"ea74dfb02d0d04582b14c3652a4c6a144be801f9cdcb91ab7eb4398a1284da05","page":3},"nodes":[{"id":"marxism-p003-n0001","text":"知识点","bbox":[88.338,426.935,59.66,19.887],"color":"#141414","fontSize":19.887,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0002","text":"3","bbox":[147.998,418.173,19.887,19.887],"color":"#141414","fontSize":19.887,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0003","text":"物质与意识","bbox":[167.885,426.935,99.434,19.887],"color":"#141414","fontSize":19.887,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0004","text":"一、物质","bbox":[330.846,142.73,70.709,17.677],"color":"#141414","fontSize":17.677,"block":1,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0005","text":"物质是标志客观实在的哲学范畴，","bbox":[443.538,66.497,265.158,17.677],"color":"#141414","fontSize":17.677,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0006","text":"客观实在性","bbox":[708.696,66.497,88.386,17.677],"color":"#8e24aa","fontSize":17.677,"block":2,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0007","text":"是物质的","bbox":[797.082,66.497,70.709,17.677],"color":"#141414","fontSize":17.677,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0008","text":"唯一特性","bbox":[867.791,66.497,70.709,17.677],"color":"#8e24aa","fontSize":17.677,"block":2,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0009","text":"物质的","bbox":[443.538,117.319,53.032,17.677],"color":"#141414","fontSize":17.677,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0010","text":"根本属性","bbox":[496.57,117.319,70.709,17.677],"color":"#8e24aa","fontSize":17.677,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0011","text":"和","bbox":[567.279,117.319,17.677,17.677],"color":"#141414","fontSize":17.677,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0012","text":"存在方式","bbox":[584.956,117.319,70.709,17.677],"color":"#8e24aa","fontSize":17.677,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0013","text":"是","bbox":[655.665,117.319,17.677,17.677],"color":"#141414","fontSize":17.677,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0014","text":"运动","bbox":[673.342,117.319,35.354,17.677],"color":"#8e24aa","fontSize":17.677,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0015","text":"。","bbox":[708.696,117.319,17.677,17.677],"color":"#141414","fontSize":17.677,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0016","text":"静止","bbox":[726.373,117.319,35.354,17.677],"color":"#8e24aa","fontSize":17.677,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0017","text":"是运动的一种","bbox":[761.728,117.319,106.063,17.677],"color":"#141414","fontSize":17.677,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0018","text":"特殊的状态","bbox":[867.791,117.319,88.386,17.677],"color":"#8e24aa","fontSize":17.677,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0019","text":"运动是无条件的、永恒的、绝对的。静止是有条件的、暂时的、相对的","bbox":[443.538,168.141,547.992,17.677],"color":"#141414","fontSize":17.677,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0020","text":"世界上的事物都是","bbox":[443.538,218.963,141.417,17.677],"color":"#141414","fontSize":17.677,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0021","text":"绝对运动","bbox":[584.956,218.963,70.709,17.677],"color":"#8e24aa","fontSize":17.677,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0022","text":"和","bbox":[655.665,218.963,17.677,17.677],"color":"#141414","fontSize":17.677,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0023","text":"相对静止","bbox":[673.342,218.963,70.709,17.677],"color":"#8e24aa","fontSize":17.677,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0024","text":"的统一","bbox":[744.05,218.963,53.032,17.677],"color":"#141414","fontSize":17.677,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0025","text":"二、意识","bbox":[330.846,292.986,70.709,17.677],"color":"#141414","fontSize":17.677,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0026","text":"意识的本质是","bbox":[443.538,267.575,106.063,17.677],"color":"#141414","fontSize":17.677,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0027","text":"人脑","bbox":[549.602,267.575,35.354,17.677],"color":"#19a719","fontSize":17.677,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0028","text":"对","bbox":[584.956,267.575,17.677,17.677],"color":"#141414","fontSize":17.677,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0029","text":"客观存在","bbox":[602.633,267.575,70.709,17.677],"color":"#19a719","fontSize":17.677,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0030","text":"的","bbox":[673.342,267.575,17.677,17.677],"color":"#141414","fontSize":17.677,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0031","text":"主观映象","bbox":[691.019,267.575,70.709,17.677],"color":"#19a719","fontSize":17.677,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0032","text":"人脑是意识的器官","bbox":[443.538,318.397,141.417,17.677],"color":"#141414","fontSize":17.677,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0033","text":"三、物质和意识的辩证关系","bbox":[330.846,456.5,212.126,17.677],"color":"#141414","fontSize":17.677,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0034","text":"物质决定意识，要求一切从实际出发","bbox":[584.956,367.009,282.835,17.677],"color":"#141414","fontSize":17.677,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0035","text":"意识具有","bbox":[584.956,417.831,70.709,17.677],"color":"#141414","fontSize":17.677,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0036","text":"主观能动性，对物质起能动的反作用","bbox":[655.665,417.831,282.835,17.995],"color":"#ff6f00","fontSize":17.677,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0037","text":"正确的意识对事物的发展具有促进作用","bbox":[584.956,468.653,300.512,17.677],"color":"#141414","fontSize":17.677,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0038","text":"错误的意识对事物的发展具有阻碍作用","bbox":[584.956,495.168,300.512,17.677],"color":"#141414","fontSize":17.677,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0039","text":"尊重客观规律","bbox":[584.956,545.99,106.063,17.677],"color":"#ff6f00","fontSize":17.677,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p003-n0040","text":"是正确发挥主观能动性的前提","bbox":[691.019,545.99,229.803,17.677],"color":"#141414","fontSize":17.677,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0041","text":"【知识延伸】人工智能","bbox":[365.464,670.835,176.772,17.677],"color":"#141414","fontSize":17.677,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0042","text":"人工智能是人意识的延伸和补充，是意识具有主观能动性的体现","bbox":[618.837,594.603,494.961,17.677],"color":"#141414","fontSize":17.677,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0043","text":"人的意识是精神活动过程，人工智能是机械物理过程","bbox":[618.837,645.424,406.575,17.677],"color":"#141414","fontSize":17.677,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0044","text":"人工智能无法完全取代人的意识","bbox":[618.837,696.246,247.481,17.677],"color":"#141414","fontSize":17.677,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0045","text":"人工智能不具备意识独有的特点如具有自觉能动性、揭示规律等","bbox":[618.837,747.068,494.961,17.677],"color":"#141414","fontSize":17.677,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p003-n0046","text":"3","bbox":[592.275,810.923,6.0,16.008],"color":"#000000","fontSize":12.0,"block":20,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"marxism-p003-b0001","text":"知识点3物质与意识","bbox":[88.338,418.173,178.981,28.649],"nodeIds":["marxism-p003-n0001","marxism-p003-n0002","marxism-p003-n0003"]},{"id":"marxism-p003-b0002","text":"一、物质","bbox":[330.846,142.73,70.709,17.677],"nodeIds":["marxism-p003-n0004"]},{"id":"marxism-p003-b0003","text":"物质是标志客观实在的哲学范畴，客观实在性是物质的唯一特性","bbox":[443.538,66.497,494.962,17.677],"nodeIds":["marxism-p003-n0005","marxism-p003-n0006","marxism-p003-n0007","marxism-p003-n0008"]},{"id":"marxism-p003-b0004","text":"物质的根本属性和存在方式是运动。静止是运动的一种特殊的状态","bbox":[443.538,117.319,512.639,17.677],"nodeIds":["marxism-p003-n0009","marxism-p003-n0010","marxism-p003-n0011","marxism-p003-n0012","marxism-p003-n0013","marxism-p003-n0014","marxism-p003-n0015","marxism-p003-n0016","marxism-p003-n0017","marxism-p003-n0018"]},{"id":"marxism-p003-b0005","text":"运动是无条件的、永恒的、绝对的。静止是有条件的、暂时的、相对的","bbox":[443.538,168.141,547.992,17.677],"nodeIds":["marxism-p003-n0019"]},{"id":"marxism-p003-b0006","text":"世界上的事物都是绝对运动和相对静止的统一","bbox":[443.538,218.963,353.544,17.677],"nodeIds":["marxism-p003-n0020","marxism-p003-n0021","marxism-p003-n0022","marxism-p003-n0023","marxism-p003-n0024"]},{"id":"marxism-p003-b0007","text":"二、意识","bbox":[330.846,292.986,70.709,17.677],"nodeIds":["marxism-p003-n0025"]},{"id":"marxism-p003-b0008","text":"意识的本质是人脑对客观存在的主观映象","bbox":[443.538,267.575,318.19,17.677],"nodeIds":["marxism-p003-n0026","marxism-p003-n0027","marxism-p003-n0028","marxism-p003-n0029","marxism-p003-n0030","marxism-p003-n0031"]},{"id":"marxism-p003-b0009","text":"人脑是意识的器官","bbox":[443.538,318.397,141.417,17.677],"nodeIds":["marxism-p003-n0032"]},{"id":"marxism-p003-b0010","text":"三、物质和意识的辩证关系","bbox":[330.846,456.5,212.126,17.677],"nodeIds":["marxism-p003-n0033"]},{"id":"marxism-p003-b0011","text":"物质决定意识，要求一切从实际出发","bbox":[584.956,367.009,282.835,17.677],"nodeIds":["marxism-p003-n0034"]},{"id":"marxism-p003-b0012","text":"意识具有主观能动性，对物质起能动的反作用","bbox":[584.956,417.831,353.544,17.995],"nodeIds":["marxism-p003-n0035","marxism-p003-n0036"]},{"id":"marxism-p003-b0013","text":"正确的意识对事物的发展具有促进作用","bbox":[584.956,468.653,300.512,17.677],"nodeIds":["marxism-p003-n0037"]},{"id":"marxism-p003-b0014","text":"错误的意识对事物的发展具有阻碍作用","bbox":[584.956,495.168,300.512,17.677],"nodeIds":["marxism-p003-n0038"]},{"id":"marxism-p003-b0015","text":"尊重客观规律是正确发挥主观能动性的前提","bbox":[584.956,545.99,335.866,17.677],"nodeIds":["marxism-p003-n0039","marxism-p003-n0040"]},{"id":"marxism-p003-b0016","text":"【知识延伸】人工智能","bbox":[365.464,670.835,176.772,17.677],"nodeIds":["marxism-p003-n0041"]},{"id":"marxism-p003-b0017","text":"人工智能是人意识的延伸和补充，是意识具有主观能动性的体现","bbox":[618.837,594.603,494.961,17.677],"nodeIds":["marxism-p003-n0042"]},{"id":"marxism-p003-b0018","text":"人的意识是精神活动过程，人工智能是机械物理过程","bbox":[618.837,645.424,406.575,17.677],"nodeIds":["marxism-p003-n0043"]},{"id":"marxism-p003-b0019","text":"人工智能无法完全取代人的意识","bbox":[618.837,696.246,247.481,17.677],"nodeIds":["marxism-p003-n0044"]},{"id":"marxism-p003-b0020","text":"人工智能不具备意识独有的特点如具有自觉能动性、揭示规律等","bbox":[618.837,747.068,494.961,17.677],"nodeIds":["marxism-p003-n0045"]},{"id":"marxism-p003-b0021","text":"3","bbox":[592.275,810.923,6.0,16.008],"nodeIds":["marxism-p003-n0046"]}],"questions":[{"id":"marxism-p003-q001","number":1,"type":"fill-in","answer":"客观实在性","bbox":[708.696,66.497,88.386,17.677],"fontSize":17.677,"color":"#8e24aa","segments":[{"text":"客观实在性","bbox":[708.696,66.497,88.386,17.677],"color":"#8e24aa"}],"nodeIds":["marxism-p003-n0006"],"aliases":[],"context":"物质是标志客观实在的哲学范畴，____是物质的____"},{"id":"marxism-p003-q002","number":2,"type":"fill-in","