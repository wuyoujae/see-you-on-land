{"id":"marxism-p020","bookId":"marxism","number":20,"title":"知识点18剩余价值理论","width":1190.55,"height":841.89,"image":"data/knowledge/pages/marxism/marxism-p020.svg","dataUrl":"data/knowledge/pages/marxism/marxism-p020.json","questionCount":27,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·马原理论思维导图.pdf","sha256":"ea74dfb02d0d04582b14c3652a4c6a144be801f9cdcb91ab7eb4398a1284da05","page":20},"nodes":[{"id":"marxism-p020-n0001","text":"知识点","bbox":[78.247,385.118,46.226,15.409],"color":"#141414","fontSize":15.409,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0002","text":"18","bbox":[124.472,378.33,23.113,15.409],"color":"#141414","fontSize":15.409,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0003","text":"剩余价值理论","bbox":[147.585,385.118,92.451,15.409],"color":"#141414","fontSize":15.409,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0004","text":"剩余价值学说","bbox":[298.675,60.477,82.179,13.697],"color":"#8e24aa","fontSize":13.697,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0005","text":"阐明了资本主义经济制度的","bbox":[380.854,60.477,164.358,13.697],"color":"#141414","fontSize":13.697,"block":1,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0006","text":"本质","bbox":[545.212,60.477,27.393,13.697],"color":"#8e24aa","fontSize":13.697,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0007","text":"；","bbox":[572.605,60.477,13.697,14.258],"color":"#141414","fontSize":13.697,"block":1,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0008","text":"剩余价值规律","bbox":[586.302,60.477,82.179,13.697],"color":"#8e24aa","fontSize":13.697,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0009","text":"是资本主义的","bbox":[668.481,60.477,82.179,13.697],"color":"#141414","fontSize":13.697,"block":1,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0010","text":"基本规律","bbox":[750.66,60.477,54.786,13.697],"color":"#8e24aa","fontSize":13.697,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0011","text":"剩余价值","bbox":[298.675,117.831,54.786,13.697],"color":"#19a719","fontSize":13.697,"block":2,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0012","text":"是雇佣工人所创造的并被资本家无偿占有的超过劳动力价值的那部分价值","bbox":[385.99,98.142,438.288,13.697],"color":"#19a719","fontSize":13.697,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0013","text":"体现了资本家与雇佣工人之间剥削与被剥削的关系","bbox":[385.99,137.52,301.323,13.697],"color":"#141414","fontSize":13.697,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0014","text":"一、剩余价值的生产方法","bbox":[298.675,216.703,150.662,13.697],"color":"#141414","fontSize":13.697,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0015","text":"绝对剩余价值生产","bbox":[508.688,184.602,109.572,13.697],"color":"#ff6f00","fontSize":13.697,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0016","text":"在","bbox":[650.789,184.602,13.697,13.697],"color":"#141414","fontSize":13.697,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0017","text":"必要劳动时间不变","bbox":[664.486,184.602,109.572,13.697],"color":"#ff6f00","fontSize":13.697,"block":6,"line":1,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0018","text":"的条件下，由于","bbox":[774.058,184.602,95.876,13.697],"color":"#141414","fontSize":13.697,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0019","text":"延长劳动日的长度","bbox":[869.933,184.602,109.572,13.697],"color":"#ff6f00","fontSize":13.697,"block":6,"line":1,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0020","text":"而生产的剩余价值","bbox":[979.505,184.602,109.572,13.697],"color":"#141414","fontSize":13.697,"block":6,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0021","text":"相对剩余价值生产","bbox":[508.688,248.804,109.572,13.697],"color":"#1e88e5","fontSize":13.697,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0022","text":"在","bbox":[650.789,228.259,13.697,13.697],"color":"#141414","fontSize":13.697,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0023","text":"工作日长度不变","bbox":[664.486,228.259,95.876,13.697],"color":"#1e88e5","fontSize":13.697,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0024","text":"的条件下，由于","bbox":[760.361,228.259,95.876,13.697],"color":"#141414","fontSize":13.697,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0025","text":"缩短必要劳动时间","bbox":[856.237,228.259,109.572,13.697],"color":"#1e88e5","fontSize":13.697,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0026","text":"，相应延长剩余劳动时间","bbox":[965.809,228.259,150.661,13.697],"color":"#141414","fontSize":13.697,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0027","text":"而生产的剩余价值。","bbox":[650.789,248.804,123.269,13.697],"color":"#141414","fontSize":13.697,"block":8,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0028","text":"缩短必要劳动时间是通过全社会劳动生产率的提高实现的","bbox":[774.058,248.804,342.413,13.697],"color":"#1e88e5","fontSize":13.697,"block":8,"line":1,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0029","text":"二、不变资本与可变资本","bbox":[298.675,427.287,150.662,13.697],"color":"#141414","fontSize":13.697,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0030","text":"资本在资本主义生产过程中以","bbox":[491.282,300.166,178.055,13.697],"color":"#141414","fontSize":13.697,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0031","text":"生产资料","bbox":[669.337,300.166,54.786,13.697],"color":"#8e24aa","fontSize":13.697,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0032","text":"和","bbox":[724.123,300.166,13.697,13.697],"color":"#141414","fontSize":13.697,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0033","text":"劳动力","bbox":[737.819,300.166,41.09,13.697],"color":"#8e24aa","fontSize":13.697,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0034","text":"两种形态存在，根据这两部分","bbox":[778.909,300.166,178.055,13.697],"color":"#141414","fontSize":13.697,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0035","text":"资本","bbox":[491.282,320.711,27.393,13.697],"color":"#141414","fontSize":13.697,"block":10,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0036","text":"在剩余价值生产中所起的不同作用","bbox":[518.675,320.711,205.448,13.697],"color":"#8e24aa","fontSize":13.697,"block":10,"line":1,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0037","text":"，可将资本分为","bbox":[724.123,320.711,95.876,13.697],"color":"#141414","fontSize":13.697,"block":10,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0038","text":"不变资本","bbox":[819.998,320.711,54.786,13.697],"color":"#8e24aa","fontSize":13.697,"block":10,"line":1,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0039","text":"和","bbox":[874.784,320.711,13.697,13.697],"color":"#141414","fontSize":13.697,"block":10,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0040","text":"可变资本","bbox":[888.481,320.711,54.786,13.697],"color":"#8e24aa","fontSize":13.697,"block":10,"line":1,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0041","text":"之所以划分不变资本与可变资本，主要是揭示了剩余价值的来源，","bbox":[491.282,360.088,397.199,13.697],"color":"#141414","fontSize":13.697,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0042","text":"以及为确定资本家对雇佣劳动者的剥削程度提供了科学依据","bbox":[491.282,380.633,356.109,13.697],"color":"#141414","fontSize":13.697,"block":11,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0043","text":"不变资本（","bbox":[518.104,449.971,68.483,13.697],"color":"#19a719","fontSize":13.697,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0044","text":"C","bbox":[586.587,444.844,10.259,13.697],"color":"#19a719","fontSize":13.697,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0045","text":"）","bbox":[596.839,449.971,13.697,13.697],"color":"#19a719","fontSize":13.697,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0046","text":"以","bbox":[643.085,429.427,13.697,13.697],"color":"#141414","fontSize":13.697,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0047","text":"生产资料形态","bbox":[656.781,429.427,82.179,13.697],"color":"#19a719","fontSize":13.697,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0048","text":"存在的那部分资本，其在生产过程中只转变","bbox":[738.961,429.427,260.234,13.697],"color":"#141414","fontSize":13.697,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0049","text":"自己的物质形态而不改变自己的价值量，","bbox":[643.085,449.971,246.537,13.697],"color":"#141414","fontSize":13.697,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0050","text":"不发生增殖","bbox":[889.622,449.971,68.483,13.697],"color":"#19a719","fontSize":13.697,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0051","text":"可变资本（","bbox":[518.104,533.863,68.483,13.943],"color":"#ff6f00","fontSize":13.697,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0052","text":"V","bbox":[586.587,528.736,10.094,13.696],"color":"#ff6f00","fontSize":13.697,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0053","text":"）","bbox":[596.679,533.863,13.697,13.943],"color":"#ff6f00","fontSize":13.697,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0054","text":"以","bbox":[643.085,493.629,13.697,13.697],"color":"#141414","fontSize":13.697,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0055","text":"劳动力价值形态","bbox":[656.781,493.629,95.876,13.697],"color":"#ff6f00","fontSize":13.697,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0056","text":"存在的那部分资本，其在生产过程中","bbox":[752.657,493.629,219.144,13.697],"color":"#141414","fontSize":13.697,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0057","text":"不是被转移到新产品中去，而是由工人的劳动再生产出来","bbox":[643.085,514.174,342.413,13.696],"color":"#141414","fontSize":13.697,"block":16,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0058","text":"这一部分资本的价值不是不变的，而","bbox":[643.085,553.551,219.144,13.696],"color":"#141414","fontSize":13.697,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0059","text":"是一个可变的量","bbox":[862.229,553.551,95.876,13.696],"color":"#ff6f00","fontSize":13.697,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0060","text":"三、资本有机构成","bbox":[298.675,678.532,109.572,13.696],"color":"#141414","fontSize":13.697,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0061","text":"资本有机构成这一范畴涉及","bbox":[450.193,600.633,164.358,13.696],"color":"#141414","fontSize":13.697,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0062","text":"资本的技术构成、资本的价值构成和资本的有机构成之间的关系","bbox":[614.551,600.633,383.502,13.696],"color":"#8e24aa","fontSize":13.697,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0063","text":"资本的技术构成","bbox":[477.015,649.427,95.876,13.696],"color":"#141414","fontSize":13.697,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0064","text":"生产的技术水平所决定的生产资料和劳动力之间的比例","bbox":[605.42,649.427,328.716,13.696],"color":"#141414","fontSize":13.697,"block":20,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0065","text":"资本的价值构成","bbox":[477.015,693.084,95.876,13.696],"color":"#141414","fontSize":13.697,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0066","text":"不变资本和可变资本价值之间的比例","bbox":[605.42,693.084,219.144,13.696],"color":"#141414","fontSize":13.697,"block":21,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0067","text":"资本的有机构成","bbox":[477.015,756.431,95.876,13.696],"color":"#ff6f00","fontSize":13.697,"block":22,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0068","text":"指由资本技术构成决定并反映技术构成变化的资本价值构成，即","bbox":[605.42,736.742,383.502,13.943],"color":"#ff6f00","fontSize":13.697,"block":23,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0069","text":"C : V","bbox":[988.922,731.615,30.584,13.696],"color":"#ff6f00","fontSize":13.697,"block":23,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p020-n0070","text":"资本的不断积累和生产规模的不断扩大，会导致劳动生产率和资本有机构成的提高","bbox":[605.42,776.12,493.074,13.696],"color":"#141414","fontSize":13.697,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p020-n0071","text":"20","bbox":[589.275,810.923,12.0,16.008],"color":"#000000","fontSize":12.0,"block":25,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"marxism-p020-b0001","text":"知识点18剩余价值理论","bbox":[78.247,378.33,161.789,22.197],"nodeIds":["marxism-p020-n0001","marxism-p020-n0002","marxism-p020-n0003"]},{"id":"marxism-p020-b0002","text":"剩余价值学说阐明了资本主义经济制度的本质；剩余价值规律是资本主义的基本规律","bbox":[298.675,60.477,506.771,14.258],"nodeIds":["marxism-p020-n0004","marxism-p020-n0005","marxism-p020-n0006","marxism-p020-n0007","marxism-p020-n0008","marxism-p020-n0009","marxism-p020-n0010"]},{"id":"marxism-p020-b0003","text":"剩余价值","bbox":[298.675,117.831,54.786,13.697],"nodeIds":["marxism-p020-n0011"]},{"id":"marxism-p020-b0004","text":"是雇佣工人所创造的并被资本家无偿占有的超过劳动力价值的那部分价值","bbox":[385.99,98.142,438.288,13.697],"nodeIds":["marxism-p020-n0012"]},{"id":"marxism-p020-b0005","text":"体现了资本家与雇佣工人之间剥削与被剥削的关系","bbox":[385.99,137.52,301.323,13.697],"nodeIds":["marxism-p020-n0013"]},{"id":"marxism-p020-b0006","text":"一、剩余价值的生产方法","bbox":[298.675,216.703,150.662,13.697],"nodeIds":["marxism-p020-n0014"]},{"id":"marxism-p020-b0007","text":"绝对剩余价值生产在必要劳动时间不变的条件下，由于延长劳动日的长度而生产的剩余价值","bbox":[508.688,184.602,580.389,13.697],"nodeIds":["marxism-p020-n0015","marxism-p020-n0016","marxism-p020-n0017","marxism-p020-n0018","marxism-p020-n0019","marxism-p020-n0020"]},{"id":"marxism-p020-b0008","text":"相对剩余价值生产","bbox":[508.688,248.804,109.572,13.697],"nodeIds":["marxism-p020-n0021"]},{"id":"marxism-p020-b0009","text":"在工作日长度不变的条件下，由于缩短必要劳动时间，相应延长剩余劳动时间而生产的剩余价值。缩短必要劳动时间是通过全社会劳动生产率的提高实现的","bbox":[650.789,228.259,465.682,34.242],"nodeIds":["marxism-p020-n0022","marxism-p020-n0023","marxism-p020-n0024","marxism-p020-n0025","marxism-p020-n0026","marxism-p020-n0027","marxism-p020-n0028"]},{"id":"marxism-p020-b0010","text":"二、不变资本与可变资本","bbox":[298.675,427.287,150.662,13.697],"nodeIds":["marxism-p020-n0029"]},{"id":"marxism-p020-b0011","text":"资本在资本主义生产过程中以生产资料和劳动力两种形态存在，根据这两部分资本在剩余价值生产中所起的不同作用，可将资本分为不变资本和可变资本","bbox":[491.282,300.166,465.682,34.242],"nodeIds":["marxism-p020-n0030","marxism-p020-n0031","marxism-p020-n0032","marxism-p020-n0033","marxism-p020-n0034","marxism-p020-n0035","marxism-p020-n0036","marxism-p020-n0037","marxism-p020-n0038","marxism-p020-n0039","marxism-p020-n0040"]},{"id":"marxism-p020-b0012","text":"之所以划分不变资本与可变资本，主要是揭示了剩余价值的来源，以及为确定资本家对雇佣劳动者的剥削程度提供了科学依据","bbox":[491.282,360.088,397.199,34.242],"nodeIds":["marxism-p020-n0041","marxism-p020-n0042"]},{"id":"marxism-p020-b0013","text":"不变资本（C）","bbox":[518.104,444.844,92.432,18.824],"nodeIds":["marxism-p020-n0043","marxism-p020-n0044","marxism-p020-n0045"]},{"id":"marxism-p020-b0014","text":"以生产资料形态存在的那部分资本，其在生产过程中只转变","bbox":[643.085,429.427,356.11,13.697],"nodeIds":["marxism-p020-n0046","marxism-p020-n0047","marxism-p020-n0048"]},{"id":"marxism-p020-b0015","text":"自己的物质形态而不改变自己的价值量，不发生增殖","bbox":[643.085,449.971,315.02,13.697],"nodeIds":["marxism-p020-n0049","marxism-p020-n0050"]},{"id":"marxism-p020-b0016","text":"可变资本（V）","bbox":[518.104,528.736,92.272,19.07],"nodeIds":["marxism-p020-n0051","marxism-p020-n0052","marxism-p020-n0053"]},{"id":"marxism-p020-b0017","text":"以劳动力价值形态存在的那部分资本，其在生产过程中不是被转移到新产品中去，而是由工人的劳动再生产出来","bbox":[643.085,493.629,342.413,34.241],"nodeIds":["marxism-p020-n0054","marxism-p020-n0055","marxism-p020-n0056","marxism-p020-n0057"]},{"id":"marxism-p020-b0018","text":"这一部分资本的价值不是不变的，而是一个可变的量","bbox":[643.085,553.551,315.02,13.696],"nodeIds":["marxism-p020-n0058","marxism-p020-n0059"]},{"id":"marxism-p020-b0019","text":"三、资本有机构成","bbox":[298.675,678.532,109.572,13.696],"nodeIds":["marxism-p020-n0060"]},{"id":"marxism-p020-b0020","text":"资本有机构成这一范畴涉及资本的技术构成、资本的价值构成和资本的有机构成之间的关系","bbox":[450.193,600.633,547.86,13.696],"nodeIds":["marxism-p020-n0061","marxism-p020-n0062"]},{"id":"marxism-p020-b0021","text":"资本的技术构成生产的技术水平所决定的生产资料和劳动力之间的比例","bbox":[477.015,649.427,457.121,13.696],"nodeIds":["marxism-p020-n0063","marxism-p020-n0064"]},{"id":"marxism-p020-b0022","text":"资本的价值构成不变资本和可变资本价值之间的比例","bbox":[477.015,693.084,347.549,13.696],"nodeIds":["marxism-p020-n0065","marxism-p020-n0066"]},{"id":"marxism-p020-b0023","text":"资本的有机构成","bbox":[477.015,756.431,95.876,13.696],"nodeIds":["marxism-p020-n0067"]},{"id":"marxism-p020-b0024","text":"指由资本技术构成决定并反映技术构成变化的资本价值构成，即C : V","bbox":[605.42,731.615,414.086,19.07],"nodeIds":["marxism-p020-n0068","marxism-p020-n0069"]},{"id":"marxism-p020-b0025","text":"资本的不断积累和生产规模的不断扩大，会导致劳动生产率和资本有机构成的提高","bbox":[605.42,776.12,493.074,13.696],"nodeIds":["marxism-p020-n0070"]},{"id":"marxism-p020-b0026","text":"20","bbox":[589.275,810.923,12.0,16.008],"nodeIds":["marxism-p020-n0071"]}],"questions":[{"id":"marxism-p020-q001","number":1,"type":"fill-in","answer":"剩余价值学说","bbox":[298.675,60.477,82.179,13.697],"fontSize":13.697,"color":"#8e24aa","segments":[{"text":"剩余价值学说","bbox":[298.675,60.477,82.179,13.697],"color":"#8e24aa"}],"nodeIds":["marxism-p020-n0004"],"aliases":[],"context":"____阐明了资本主义经济制度的____；____是资本主义的____"},{"id":"marxism-p020-q002","number":2,"type":"fill-in","answer":"本质","bbox":[545.212,60.477,27.393,13.697],"fontSize":13.697,"color":"#8e24aa","segments":[{"text":"本质","bbox":[545.212,60.477,27.393,13.697],"color":"#8e24aa"}],"nodeIds":["marxism-p020-n0006"],