,119.614,65.397,16.349],"color":"#8e24aa","fontSize":16.349,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0011","text":"和","bbox":[907.791,119.614,16.349,16.349],"color":"#141414","fontSize":16.349,"block":1,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0012","text":"价值","bbox":[924.14,119.614,32.698,16.349],"color":"#8e24aa","fontSize":16.349,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0013","text":"一、使用价值","bbox":[351.917,222.818,98.095,16.349],"color":"#141414","fontSize":16.349,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0014","text":"指商品","bbox":[488.842,175.814,49.048,16.349],"color":"#141414","fontSize":16.349,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0015","text":"能够满足人们某种需要的属性","bbox":[537.89,175.814,212.54,16.349],"color":"#19a719","fontSize":16.349,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0016","text":"，即","bbox":[750.43,175.814,32.698,16.349],"color":"#141414","fontSize":16.349,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0017","text":"商品的有用性","bbox":[783.128,175.814,98.096,16.349],"color":"#19a719","fontSize":16.349,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0018","text":"同一商品可以有不同的使用价值，不同的商品也可以有同一种使用价值","bbox":[488.842,222.818,506.826,16.349],"color":"#141414","fontSize":16.349,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0019","text":"使用价值是","bbox":[488.842,269.822,81.746,16.349],"color":"#19a719","fontSize":16.349,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0020","text":"是商品的","bbox":[570.588,269.822,65.397,16.349],"color":"#141414","fontSize":16.349,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0021","text":"自然属性","bbox":[635.985,269.822,65.397,16.349],"color":"#19a719","fontSize":16.349,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0022","text":"二、价值","bbox":[351.917,385.289,65.397,16.349],"color":"#141414","fontSize":16.349,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0023","text":"指","bbox":[456.144,314.783,16.349,16.349],"color":"#141414","fontSize":16.349,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0024","text":"凝结在商品中无差别的一般人类劳动","bbox":[472.493,314.783,261.588,16.349],"color":"#ff6f00","fontSize":16.349,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0025","text":"使用价值不同的商品之所以能够交换","bbox":[456.144,385.289,261.588,16.349],"color":"#ff6f00","fontSize":16.349,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0026","text":"是因为它们都具有价值","bbox":[756.561,361.787,163.492,16.349],"color":"#ff6f00","fontSize":16.349,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0027","text":"都耗费了人类一定的体力和脑力","bbox":[756.561,408.791,228.889,16.349],"color":"#141414","fontSize":16.349,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0028","text":"价值是商品的根本属性","bbox":[456.144,455.795,163.492,16.349],"color":"#ff6f00","fontSize":16.349,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0029","text":"是商品的","bbox":[658.465,455.795,65.397,16.349],"color":"#141414","fontSize":16.349,"block":11,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0030","text":"社会属性","bbox":[723.862,455.795,65.397,16.349],"color":"#ff6f00","fontSize":16.349,"block":11,"line":1,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0031","text":"，是商品","bbox":[789.259,455.795,65.397,16.349],"color":"#141414","fontSize":16.349,"block":11,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0032","text":"最本质的因素","bbox":[854.656,455.795,98.096,16.349],"color":"#ff6f00","fontSize":16.349,"block":11,"line":1,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0033","text":"三、二者辩证关系","bbox":[351.917,623.885,130.794,16.349],"color":"#141414","fontSize":16.349,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0034","text":"商品必须同时具有使用价值和价值","bbox":[553.558,552.868,245.239,16.349],"color":"#141414","fontSize":16.349,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0035","text":"使用价值是价值的物质承担者","bbox":[837.626,505.864,212.54,16.349],"color":"#1e88e5","fontSize":16.349,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0036","text":"价值通过使用价值表现出来","bbox":[837.626,552.868,196.191,16.349],"color":"#141414","fontSize":16.349,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0037","text":"没有合格的使用价值，价值不能得到实现","bbox":[837.626,599.872,294.286,16.643],"color":"#1e88e5","fontSize":16.349,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0038","text":"对于同一商品所有者来说","bbox":[553.558,694.902,179.842,16.349],"color":"#141414","fontSize":16.349,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0039","text":"在商品交换过程中，不论是买者还是","bbox":[772.229,646.876,261.588,16.349],"color":"#141414","fontSize":16.349,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0040","text":"卖者，","bbox":[772.229,671.4,49.048,16.349],"color":"#141414","fontSize":16.349,"block":19,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0041","text":"使用价值和价值二者不可兼得","bbox":[821.276,671.4,212.54,16.349],"color":"#1e88e5","fontSize":16.349,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0042","text":"其对立的外在表现是","bbox":[772.229,718.404,147.143,16.349],"color":"#141414","fontSize":16.349,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p016-n0043","text":"商品和货币的对立","bbox":[919.372,718.404,130.794,16.349],"color":"#1e88e5","fontSize":16.349,"block":20,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p016-n0044","text":"16","bbox":[589.275,810.923,12.0,16.008],"color":"#000000","fontSize":12.0,"block":21,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"marxism-p016-b0001","text":"知识点14商品及其二因素","bbox":[70.404,395.824,211.518,26.496],"nodeIds":["marxism-p016-n0001","marxism-p016-n0002","marxism-p016-n0003"]},{"id":"marxism-p016-b0002","text":"商品是用来交换、能满足人的某种需要的劳动产品；商品的二因素是使用价值和价值","bbox":[351.917,119.614,604.921,17.02],"nodeIds":["marxism-p016-n0004","marxism-p016-n0005","marxism-p016-n0006","marxism-p016-n0007","marxism-p016-n0008","marxism-p016-n0009","marxism-p016-n0010","marxism-p016-n0011","marxism-p016-n0012"]},{"id":"marxism-p016-b0003","text":"一、使用价值","bbox":[351.917,222.818,98.095,16.349],"nodeIds":["marxism-p016-n0013"]},{"id":"marxism-p016-b0004","text":"指商品能够满足人们某种需要的属性，即商品的有用性","bbox":[488.842,175.814,392.382,16.349],"nodeIds":["marxism-p016-n0014","marxism-p016-n0015","marxism-p016-n0016","marxism-p016-n0017"]},{"id":"marxism-p016-b0005","text":"同一商品可以有不同的使用价值，不同的商品也可以有同一种使用价值","bbox":[488.842,222.818,506.826,16.349],"nodeIds":["marxism-p016-n0018"]},{"id":"marxism-p016-b0006","text":"使用价值是是商品的自然属性","bbox":[488.842,269.822,212.54,16.349],"nodeIds":["marxism-p016-n0019","marxism-p016-n0020","marxism-p016-n0021"]},{"id":"marxism-p016-b0007","text":"二、价值","bbox":[351.917,385.289,65.397,16.349],"nodeIds":["marxism-p016-n0022"]},{"id":"marxism-p016-b0008","text":"指凝结在商品中无差别的一般人类劳动","bbox":[456.144,314.783,277.937,16.349],"nodeIds":["marxism-p016-n0023","marxism-p016-n0024"]},{"id":"marxism-p016-b0009","text":"使用价值不同的商品之所以能够交换","bbox":[456.144,385.289,261.588,16.349],"nodeIds":["marxism-p016-n0025"]},{"id":"marxism-p016-b0010","text":"是因为它们都具有价值","bbox":[756.561,361.787,163.492,16.349],"nodeIds":["marxism-p016-n0026"]},{"id":"marxism-p016-b0011","text":"都耗费了人类一定的体力和脑力","bbox":[756.561,408.791,228.889,16.349],"nodeIds":["marxism-p016-n0027"]},{"id":"marxism-p016-b0012","text":"价值是商品的根本属性是商品的社会属性，是商品最本质的因素","bbox":[456.144,455.795,496.608,16.349],"nodeIds":["marxism-p016-n0028","marxism-p016-n0029","marxism-p016-n0030","marxism-p016