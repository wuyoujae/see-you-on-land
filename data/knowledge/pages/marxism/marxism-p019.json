{"id":"marxism-p019","bookId":"marxism","number":19,"title":"知识点17货币本质和职能","width":1190.55,"height":841.89,"image":"data/knowledge/pages/marxism/marxism-p019.svg","dataUrl":"data/knowledge/pages/marxism/marxism-p019.json","questionCount":9,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·马原理论思维导图.pdf","sha256":"ea74dfb02d0d04582b14c3652a4c6a144be801f9cdcb91ab7eb4398a1284da05","page":19},"nodes":[{"id":"marxism-p019-n0001","text":"知识点","bbox":[78.885,418.794,60.423,20.141],"color":"#141414","fontSize":20.141,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0002","text":"17","bbox":[139.308,409.921,30.211,20.141],"color":"#141414","fontSize":20.141,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0003","text":"货币本质和职能","bbox":[169.519,418.794,140.986,20.141],"color":"#141414","fontSize":20.141,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0004","text":"一、货币的本质","bbox":[387.153,151.099,125.321,17.903],"color":"#141414","fontSize":17.903,"block":1,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0005","text":"货币是固定地充当一般等价物的商品。货币的本质是","bbox":[554.994,151.099,411.769,17.903],"color":"#141414","fontSize":17.903,"block":1,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0006","text":"一般等价物","bbox":[966.763,151.099,89.515,17.903],"color":"#8e24aa","fontSize":17.903,"block":1,"line":1,"emphasis":true,"role":"content"},{"id":"marxism-p019-n0007","text":"二、货币的职能","bbox":[387.153,231.662,125.321,17.903],"color":"#141414","fontSize":17.903,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0008","text":"货币具有","bbox":[554.994,205.927,71.612,17.903],"color":"#141414","fontSize":17.903,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0009","text":"价值尺度、流通手段、贮藏手段、支付手段","bbox":[626.606,205.927,340.157,17.903],"color":"#19a719","fontSize":17.903,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p019-n0010","text":"以及","bbox":[966.763,205.927,35.806,17.903],"color":"#141414","fontSize":17.903,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0011","text":"世界货币","bbox":[1002.569,205.927,71.612,17.903],"color":"#19a719","fontSize":17.903,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p019-n0012","text":"等职能","bbox":[1074.181,205.927,53.709,17.903],"color":"#141414","fontSize":17.903,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0013","text":"价值尺度和流通手段是货币的两个最基本职能","bbox":[554.994,257.398,358.06,17.903],"color":"#ff6f00","fontSize":17.903,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p019-n0014","text":"价值尺度","bbox":[422.213,345.794,71.612,17.903],"color":"#1e88e5","fontSize":17.903,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p019-n0015","text":"货币表现其他一切商品是否具有价值和衡量其价值量大小的职能","bbox":[536.345,318.94,501.285,17.903],"color":"#141414","fontSize":17.903,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0016","text":"只需要在观念上是货币即可，不需要是现实中的货币","bbox":[536.345,345.794,411.77,18.225],"color":"#141414","fontSize":17.903,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0017","text":"流通手段","bbox":[422.213,427.477,71.612,17.903],"color":"#ce4289","fontSize":17.903,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p019-n0018","text":"货币在商品流通中充当交换媒介借以实现商品价值的职能","bbox":[536.345,400.622,447.576,17.903],"color":"#141414","fontSize":17.903,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0019","text":"必须是现实的货币，不再是观念的货币","bbox":[536.345,427.477,304.352,18.225],"color":"#141414","fontSize":17.903,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0020","text":"贮藏手段","bbox":[422.213,509.159,71.612,17.903],"color":"#e32c2d","fontSize":17.903,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p019-n0021","text":"货币退出流通领域作为社会财富的一般代表被保存起来的职能","bbox":[536.345,482.305,483.382,17.903],"color":"#141414","fontSize":17.903,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0022","text":"必须是足值的金属货币或金属条块","bbox":[536.345,509.159,268.545,17.903],"color":"#141414","fontSize":17.903,"block":12,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0023","text":"支付手段","bbox":[422.213,590.842,71.612,17.903],"color":"#8e24aa","fontSize":17.903,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p019-n0024","text":"在发生赊购赊销的情况下，货币用于清偿债务所执行的职能","bbox":[536.345,563.987,465.479,17.903],"color":"#141414","fontSize":17.903,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0025","text":"被广泛运用于缴纳租金、税金和发放工资等方面","bbox":[536.345,590.842,375.964,17.903],"color":"#141414","fontSize":17.903,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0026","text":"世界货币","bbox":[422.213,645.67,71.612,17.903],"color":"#ff6f00","fontSize":17.903,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p019-n0027","text":"在国际商品流通中发挥一般等价物作用的职能","bbox":[536.345,645.67,358.06,17.903],"color":"#141414","fontSize":17.903,"block":16,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p019-n0028","text":"19","bbox":[589.275,810.923,12.0,16.008],"color":"#000000","fontSize":12.0,"block":17,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"marxism-p019-b0001","text":"知识点17货币本质和职能","bbox":[78.885,409.921,231.62,29.014],"nodeIds":["marxism-p019-n0001","marxism-p019-n0002","marxism-p019-n0003"]},{"id":"marxism-p019-b0002","text":"一、货币的本质货币是固定地充当一般等价物的商品。货币的本质是一般等价物","bbox":[387.153,151.099,669.125,17.903],"nodeIds":["marxism-p019-n0004","marxism-p019-n0005","marxism-p019-n0006"]},{"id":"marxism-p019-b0003","text":"二、货币的职能","bbox":[387.153,231.662,125.321,17.903],"nodeIds":["marxism-p019-n0007"]},{"id":"marxism-p019-b0004","text":"货币具有价值尺度、流通手段、贮藏手段、支付手段以及世界货币等职能","bbox":[554.994,205.927,572.896,17.903],"nodeIds":