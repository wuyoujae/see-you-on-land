33","text":"区别于其他事物的本质","bbox":[949.38,464.042,153.151,15.315],"color":"#1e88e5","fontSize":15.315,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p005-n0034","text":"②方法论","bbox":[683.279,541.575,61.261,15.315],"color":"#141414","fontSize":15.315,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p005-n0035","text":"做到","bbox":[780.913,508.073,30.63,15.315],"color":"#141414","fontSize":15.315,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p005-n0036","text":"具体问题具体分析","bbox":[811.544,508.073,122.521,15.315],"color":"#1e88e5","fontSize":15.315,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p005-n0037","text":"具体问题具体分析（矛盾的特殊性）","bbox":[780.913,552.104,245.042,16.173],"color":"#141414","fontSize":15.315,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p005-n0038","text":"是正确认识事物的基础和正确解决矛盾的关键","bbox":[780.913,575.077,306.303,15.315],"color":"#141414","fontSize":15.315,"block":16,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p005-n0039","text":"二者关系","bbox":[555.015,675.582,61.261,15.315],"color":"#ce4289","fontSize":15.315,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p005-n0040","text":"矛盾的普遍性即矛盾的","bbox":[652.649,619.108,153.152,15.315],"color":"#141414","fontSize":15.315,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p005-n0041","text":"共性","bbox":[805.8,619.108,30.63,15.315],"color":"#ce4289","fontSize":15.315,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p005-n0042","text":"；矛盾的特殊性即矛盾的","bbox":[836.431,619.108,168.467,15.943],"color":"#141414","fontSize":15.315,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p005-n0043","text":"个性","bbox":[1004.897,619.108,30.63,15.315],"color":"#ce4289","fontSize":15.315,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"marxism-p005-n0044","text":"；","bbox":[1035.528,619.108,15.315,16.173],"color":"#141414","font