marxism-p009-n0068","text":"——","bbox":[605.381,681.441,24.922,14.852],"color":"#141414","fontSize":14.852,"block":25,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p009-n0069","text":"精通的目的全在于应用","bbox":[630.299,686.929,148.522,14.852],"color":"#141414","fontSize":14.852,"block":25,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p009-n0070","text":"实践是检验认识真理性的唯一标准","bbox":[451.29,734.27,222.783,14.852],"color":"#141414","fontSize":14.852,"block":26,"line":0,"emphasis":false,"role":"content"},{"id":"marxism-p009-n0071","text":"——","bbox":[709.346,728.783,24.922,14.852],"color":"#141414","fontSize":14.852,"block":26,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p009-n0072","text":"路遥知马力，日久见人心","bbox":[734.265,734.27,163.374,14.852],"color":"#141414","fontSize":14.852,"block":26,"line":1,"emphasis":false,"role":"content"},{"id":"marxism-p009-n0073","text":"9","bbox":[592.275,810.923,6.0,16.008],"color":"#000000","fontSize":12.0,"block":27,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"marxism-p009-b0001","text":"知识点8实践与认识","bbox":[64.978,421.966,150.379,24.07],"nodeIds":["marxism-p009-n0001","marxism-p009-n0002","marxism-p009-n0003"]},{"id":"marxism-p009-b0002","text":"一、实践","bbox":[268.732,161.533,59.409,14.852],"nodeIds":["marxism-p009-n0004"]},{"id":"marxism-p009-b0003","text":"1.含义","bbox":[363.414,91.995,37.993,20.34],"nodeIds":["marxism-p009-n0005","marxism-p009-n0006"]},{"id":"marxism-p009-b0004","text":"人类能动地改造世界的社会性的客观物质活动","bbox":[436.747,76.133,297.044,14.852],"nodeIds":["marxism-p009-n0007"]},{"id":"marxism-p009-b0005","text":"实践是主观见之于客观的活动，是沟通主观和客观的桥梁","bbox":[436.747,118.833,371.305,14.852],"nodeIds":["marxism-p009-n0008","marxism-p009-n0009","marxism-p009-n0010","marxism-p009-n0011"]},{"id":"marxism-p009-b0006","text":"2.基本特征直接现实性（客观物质性）、自觉能动性、社会历史性","bbox":[363.414,156.045,454.849,20.34],"nodeIds":["marxism-p009-n0012","marxism-p009-n0013","marxism-p009-n0014","marxism-p009-n0015","marxism-p009-n0016"]},{"id":"marxism-p009-b0007","text":"3.基本形式","bbox":[363.414,224.736,69.823,20.34],"nodeIds":["marxism-p009-n0017","marxism-p009-n0018"]},{"id":"marxism-p009-b0008","text":"物质生产实践、社会政治实践、科学文化实践","bbox":[469.236,208.874,297.044,14.852],"nodeIds":["marxism-p009-n0019"]},{"id":"marxism-p009-b0009","text":"物质生产实践是最基本的、首要的实践活动","bbox":[469.236,251.574,282.192,14.852],"nodeIds":["marxism-p009-n0020","marxism-p009-n0021","marxism-p009-n0022","marxism-p009-n0023"]},{"id":"marxism-p009-b0010","text":"二、认识","bbox":[268.732,326.763,59.409,14.852],"nodeIds":["marxism-p009-n0024"]},{"id":"marxism-p009-b0011","text":"1.本质主体在实践基础上对客体的能动的反映","bbox":[363.414,286.93,325.821,20.34],"nodeIds":["marxism-p009-n0025","marxism-p009-n0026","marxism-p009-n0027","marxism-p009-n0028"]},{"id":"marxism-p009-b0012","text":"2.特征认识具有主体差异性","bbox":[363.414,355.621,209.788,20.34],"nodeIds":["marxism-p009-n0029","marxism-p009-n0030","marxism-p009-n0031","marxism-p009-n0032"]},{"id":"marxism-p009-b0013","text":"主体在认识活动中自觉地将其自身因素即主体因素投入认识过程","bbox":[608.476,339.759,415.861,14.852],"nodeIds":["marxism-p009-n0033"]},{"id":"marxism-p009-b0014","text":"融合或凝结于认识结果而使认识不可避免地带有主体属性","bbox":[608.476,382.459,371.305,14.852],"nodeIds":["marxism-p009-n0034"]},{"id":"marxism-p009-b0015","text":"三、实践和认识的辩证关系","bbox":[268.732,487.353,178.226,14.852],"nodeIds":["marxism-p009-n0035"]},{"id":"marxism-p009-b0016","text":"1.实践决定认识","bbox":[482.232,439.165,97.409,20.34],"nodeIds":["marxism-p009-n0036","marxism-p009-n0037"]},{"id":"marxism-p009-b0017","text":"①实践是认识的来源②实践是认识发展的动力","bbox":[614.973,423.303,297.044,14.852],"nodeIds":["marxism-p009-n0038","marxism-p009-n0039","marxism-p009-n0040","marxism-p009-n0041"]},{"id":"marxism-p009-b0018","text":"③实践是认识的目的④实践是检验认识真理的唯一标准","bbox":[614.973,466.003,356.452,14.852],"nodeIds":["marxism-p009-n0042","marxism-p009-n0043","marxism-p009-n0044","marxism-p009-n0045","marxism-p009-n0046","marxism-p009-n0047"]},{"id":"marxism-p009-b0019","text":"2.认识反作用于实践","bbox":[482.232,524.565,129.731,20.34],"nodeIds":["marxism-p009-n0048","marxism-p009-n0049"]},{"id":"marxism-p009-b0020","text":"①正确的认识对实践起着积极的促进作用","bbox":[647.463,508.703,267.339,14.852],"nodeIds":["marxism-p009-n0050","marxism-p009-n0051","marxism-p009-n0052","marxism-p009-n0053"]},{"id":"marxism-p009-b0021","text":"②错误的认识则对实践起消极的阻碍作用，甚至导致实践的失败","bbox":[647.463,551.403,415.861,14.852],"nodeIds":["marxism-p009-n0054","marxism-p009-n0055","marxism-p009-n0056","marxism-p009-n0057","marxism-p009-n0058"]},{"id":"marxism-p009-b0022","text":"【知识延伸】","bbox":[297.817,640.98,89.113,14.852],"nodeIds":["marxism-p009-n0059"]},{"id":"marxism-p009-b0023","text":"典型例句","bbox":[312.669,663.258,59.409,14.852],"nodeIds":["marxism-p009-n0060"]},{"id":"marxism-p009-b0024","text":"实践是认识的来源——近水知鱼性，近山识鸟音","bbox":[451.29,586.759,342.383,20.339],"nodeIds":["marxism-p009-n0061","marxism-p009-n0062","marxism-p009-n0063"]},{"id":"marxism-p009-b0025","text":"实践是认识发展的动力——社会一旦有技术上的需要，这种需要就会比十所大学更能把科学推向前进","bbox":[451.29,634.1,683.984,20.339],"nodeIds":["marxism-p009-n0064","marxism-p009-n0065","marxism-p009-n0066"]},{"id":"marxism-p009-b0026","text":"实践是认识的目的——精通的目的全在于应用","bbox":[451.29,681.441,327.531,20.34],"nodeIds":["marxism-p009-n0067","marxism-p009-n0068","marxism-p009-n0069"]},{"id":"marxism-p009-b0027","text":"实践是检验认识真理性的唯一标准——路遥知马力，日久见人心","bbox":[451.29,728.783,446.349,20.339],"nodeIds":["marxism-p009-n0070","marxism-p009-n0071","marxism-p009-n0072"]},{"id":"marxism-p009-b0028","text":"9","bbox":[592.275,810.923,6.0,16.008],"nodeIds":["marxism-p009-n0073"]}],"questions":[{"id":"marxism-p009-q001","number":1,"type":"fill-in","answer":"主观见之于客观的活动","bbox":[481.304,118.833,148.522,14.852],"fontSize":14.852,"color":"#8e24aa","segments":[{"text":"主观见之于客观的活动","bbox":[481.304,118.833,148.522,14.852],"color":"#8e24aa"}],"nodeIds":["marxism-p009-n0009"],"aliases":[],"context":"实践是____，是____"},{"id":"marxism-p009-q002","number":2,"type":"fill-in","answer":"沟通主观和客观的桥梁","bbox":[659.53,118.833,148.522,14.852],"fontSize":14