,358.945,13.294],"color":"#141414","fontSize":13.294,"block":26,"line":0,"emphasis":false,"role":"content"},{"id":"science-p002-n0068","text":"举重运动员手上涂防滑粉可通过增大接触面的粗糙程度来增大摩擦力","bbox":[596.106,704.809,398.828,13.294],"color":"#141414","fontSize":13.294,"block":27,"line":0,"emphasis":false,"role":"content"},{"id":"science-p002-n0069","text":"超重和失重","bbox":[498.061,762.141,66.471,13.294],"color":"#141414","fontSize":13.294,"block":28,"line":0,"emphasis":false,"role":"content"},{"id":"science-p002-n0070","text":"乘坐电梯上楼时，电梯先向上做加速运动，此时人处于超重状态","bbox":[596.106,743.03,372.24,13.294],"color":"#141414","fontSize":13.294,"block":29,"line":0,"emphasis":false,"role":"content"},{"id":"science-p002-n0071","text":"再向上做匀速运动，此时人受力平衡；最后向上做减速运动，此时人处于失重状态","bbox":[596.106,781.251,478.594,13.839],"color":"#141414","fontSize":13.294,"block":30,"line":0,"emphasis":false,"role":"content"},{"id":"science-p002-n0072","text":"2","bbox":[591.275,810.711,8.0,21.344],"color":"#000000","fontSize":16.0,"block":31,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"science-p002-b0001","text":"第一章基础科学","bbox":[115.643,423.336,108.431,14.956],"nodeIds":["science-p002-n0001","science-p002-n0002"]},{"id":"science-p002-b0002","text":"第一节物理知识","bbox":[121.615,444.74,96.468,13.294],"nodeIds":["science-p002-n0003","science-p002-n0004"]},{"id":"science-p002-b0003","text":"二、常见的力","bbox":[273.72,433.938,79.766,13.294],"nodeIds":["science-p002-n0005"]},{"id":"science-p002-b0004","text":"压力","bbox":[412.756,92.441,26.589,13.294],"nodeIds":["science-p002-n0006"]},{"id":"science-p002-b0005","text":"物体间由于相互挤压而垂直作用在物体表面上的力，叫作压力。物体所受的压力与受力面积之比叫做压强","bbox":[470.919,35.11,611.537,13.294],"nodeIds":["science-p002-n0007"]},{"id":"science-p002-b0006","text":"要增大压强，可以增大压力、减小受力面积；要减小压强，可以减小压力、增大受力面积","bbox":[470.919,73.331,518.476,13.839],"nodeIds":["science-p002-n0008","science-p002-n0009","science-p002-n0010","science-p002-n0011"]},{"id":"science-p002-b0007","text":"流体中流速越大的位置，压强越小；流速越小的位置，压强越大","bbox":[470.919,111.552,372.239,14.039],"nodeIds":["science-p002-n0012","science-p002-n0013"]},{"id":"science-p002-b0008","text":"大气压是大气产生的压强，随高度的升高而降低","bbox":[470.919,149.773,279.18,13.294],"nodeIds":["science-p002-n0014","science-p002-n0015"]},{"id":"science-p002-b0009","text":"摩擦力","bbox":[412.756,226.215,39.883,13.294],"nodeIds":["science-p002-n0016"]},{"id":"science-p002-b0010","text":"阻碍物体相对运动（或相对运动趋势）的力叫做摩擦力","bbox":[484.213,187.994,319.063,13.294],"nodeIds":["science-p002-n0017"]},{"id":"science-p002-b0011","text":"摩擦力的方向与物体相对运动（或相对运动趋势）的方向相反","bbox":[484.213,226.215,358.946,13.294],"nodeIds":["science-p002-n0018","science-p002-n0019"]},{"id":"science-p002-b0012","text":"滑动摩擦力的大小与物体间的压力和接触面的粗糙程度有关","bbox":[484.213,264.436,345.651,13.294],"nodeIds":["science-p002-n0020","science-p002-n0021","science-p002-n0022","science-p002-n0023","science-p002-n0024"]},{"id":"science-p002-b0013","text":"为减小摩擦力可以将滑动摩擦改为滚动摩擦、减小接触面的粗糙程度、减小压力","bbox":[484.213,284.378,465.299,13.294],"nodeIds":["science-p002-n0025","science-p002-n0026"]},{"id":"science-p002-b0014","text":"重力","bbox":[412.756,418.151,26.589,13.294],"nodeIds":["science-p002-n0027"]},{"id":"science-p002-b0015","text":"由于地球的吸引而使物体受到的力叫做重力；重力的方向竖直向下","bbox":[470.919,322.598,385.534,13.839],"nodeIds":["science-p002-n0028","science-p002-n0029"]},{"id":"science-p002-b0016","text":"当物体做向上加速运动或向下减速运动时，物体均处于超重状态","bbox":[505.816,360.82,372.24,13.294],"nodeIds":["science-p002-n0030","science-p002-n0031","science-p002-n0032","science-p002-n0033","science-p002-n0034"]},{"id":"science-p002-b0017","text":"即不管物体如何运动，只要具有向上的加速度，物体就处于超重状态","bbox":[505.816,399.041,398.829,13.839],"nodeIds":["science-p002-n0035","science-p002-n0036","science-p002-n0037"]},{"id":"science-p002-b0018","text":"当物体做向下加速运动或向上减速运动时，物体均处于失重状态","bbox":[505.816,437.262,372.24,13.294],"nodeIds":["science-p002-n0038"]},{"id":"science-p002-b0019","text":"即不管物体如何运动，只要具有向下的加速度，物体就处于失重状态","bbox":[505.816,475.483,398.829,13.839],"nodeIds":["science-p002-n0039","science-p002-n0040","science-p002-n0041"]},{"id":"science-p002-b0020","text":"在太空中，所有物体处于失重状态","bbox":[470.919,513.704,199.414,13.294],"nodeIds":["science-p002-n0042","science-p002-n0043","science-p002-n0044","science-p002-n0045","science-p002-n0046"]},{"id":"science-p002-b0021","text":"浮力","bbox":[412.756,580.591,26.589,13.294],"nodeIds":["science-p002-n0047"]},{"id":"science-p002-b0022","text":"浸在液体中的物体受到向上的浮力，浮力的大小等于它排开的液体所受的重力","bbox":[470.919,551.925,452.005,13.294],"nodeIds":["science-p002-n0048","science-p002-n0049"]},{"id":"science-p002-b0023","text":"当浮力大于重力时，物体上浮；当浮力小于重力时，物体下沉","bbox":[518.003,590.146,358.945,13.839],"nodeIds":["science-p002-n0050","science-p002-n0051","science-p002-n0052","science-p002-n0053","science-p002-n0054","science-p002-n0055","science-p002-n0056","science-p002-n0057"]},{"id":"science-p002-b0024","text":"当浮力等于重力时，物体悬浮在液体中或者漂浮在液体表面","bbox":[518.003,628.367,345.65,13.294],"nodeIds":["science-p002-n0058","science-p002-n0059","science-p002-n0060","science-p002-n0061","science-p002-n0062","science-p002-n0063","science-p002-n0064"]},{"id":"science-p002-b0025","text":"【知识延伸】","bbox":[386.722,723.919,79.766,13.294],"nodeIds":["science-p002-n0065"]},{"id":"science-p002-b0026","text":"摩擦力现象","bbox":[498.061,685.698,66.471,13.294],"nodeIds":["science-p002-n0066"]},{"id":"science-p002-b0027","text":"机械轴承定期上油可通过减小接触面的粗糙程度来减小摩擦力","bbox":[596.106,666.588,358.945,13.294],"nodeIds":["science-p002-n0067"]},{"id":"science-p002-b0028","text":"举重运动员手上涂防滑粉可通过增大接触面的粗糙程度来增大摩擦力","bbox":[596.106,704.809,398.828,13.294],"nodeIds":["science-p002-n0068"]},{"id":"science-p002-b0029","text":"超重和失重","bbox":[498.061,762.141,66.471,13.294],"nodeIds":["science-p002-n0069"]},{"id":"science-p002-b0030","text":"乘坐电梯上楼时，电梯先向上做加速运动，此时人处于超重状态","bbox":[596.106,743.03,372.24,13.294],"nodeIds":["science-p002-n0070"]},{"id":"science-p002-b0031","text":"再向上做匀速运动，此时人受力平衡；最后向上做减速运动，此时人处于失重状态","bbox":[596.106,781.251,478.594,13.839],"nodeIds":["science-p002-n0071"]},{"id":"science-p002-b0032","