{"id":"science-p028","bookId":"science","number":28,"title":"第二章生活常识二、交通常识","width":1190.55,"height":841.89,"image":"data/knowledge/pages/science/science-p028.svg","dataUrl":"data/knowledge/pages/science/science-p028.json","questionCount":27,"version":1,"imagePixels":[2084,1474],"source":{"file":"27上岸村·科技常识思维导图.pdf","sha256":"58396d10bab33da54e68ea993cbfbfe7f67afde003f88d5013e92dcfe8fa27d8","page":28},"nodes":[{"id":"science-p028-n0001","text":"第二章","bbox":[61.052,432.642,47.209,15.736],"color":"#141414","fontSize":15.736,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0002","text":"生活常识","bbox":[112.195,432.642,62.945,15.736],"color":"#141414","fontSize":15.736,"block":0,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0003","text":"二、交通常识","bbox":[227.594,433.306,83.926,13.988],"color":"#141414","fontSize":13.988,"block":0,"line":1,"emphasis":false,"role":"content"},{"id":"science-p028-n0004","text":"汽车","bbox":[373.882,195.078,27.975,13.988],"color":"#8e24aa","fontSize":13.988,"block":1,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0005","text":"多数汽车的","bbox":[435.078,74.434,69.939,13.988],"color":"#141414","fontSize":13.988,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0006","text":"前窗","bbox":[505.017,74.434,27.975,13.988],"color":"#8e24aa","fontSize":13.988,"block":2,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0007","text":"都是","bbox":[532.992,74.434,27.975,13.988],"color":"#141414","fontSize":13.988,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0008","text":"倾斜","bbox":[560.968,74.434,27.976,13.988],"color":"#8e24aa","fontSize":13.988,"block":2,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0009","text":"的，最主要是为了避免因","bbox":[588.943,74.434,153.865,13.988],"color":"#141414","fontSize":13.988,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0010","text":"反光","bbox":[742.808,74.434,27.975,13.988],"color":"#8e24aa","fontSize":13.988,"block":2,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0011","text":"而影响驾驶员视线","bbox":[770.784,74.434,111.902,13.988],"color":"#141414","fontSize":13.988,"block":2,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0012","text":"双闪灯","bbox":[435.078,114.649,41.963,13.988],"color":"#8e24aa","fontSize":13.988,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0013","text":"的作用是在","bbox":[477.041,114.649,69.939,13.988],"color":"#141414","fontSize":13.988,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0014","text":"紧急情况","bbox":[546.98,114.649,55.951,13.988],"color":"#8e24aa","fontSize":13.988,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0015","text":"或","bbox":[602.931,114.649,13.988,13.988],"color":"#141414","fontSize":13.988,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0016","text":"临时停车","bbox":[616.919,114.649,55.951,13.988],"color":"#8e24aa","fontSize":13.988,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0017","text":"，用来提醒其他人的","bbox":[672.869,114.649,125.89,13.988],"color":"#141414","fontSize":13.988,"block":3,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0018","text":"远光灯","bbox":[435.078,174.971,41.963,13.988],"color":"#8e24aa","fontSize":13.988,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0019","text":"适用于照明条件特别差，又不会影响其他交通参与者的情况","bbox":[510.262,154.863,363.681,14.24],"color":"#8e24aa","fontSize":13.988,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0020","text":"晚上开车在有路灯的街道上行驶，尽量少用汽车远光灯，以免影响他人","bbox":[510.262,195.078,433.619,13.988],"color":"#141414","fontSize":13.988,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0021","text":"汽车轮胎上的花纹是为了增大汽车与地面的摩擦力","bbox":[435.078,235.293,307.73,13.988],"color":"#8e24aa","fontSize":13.988,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0022","text":"在","bbox":[435.078,275.507,13.988,13.988],"color":"#141414","fontSize":13.988,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0023","text":"加油站","bbox":[449.066,275.507,41.963,13.988],"color":"#8e24aa","fontSize":13.988,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0024","text":"，所有机动车辆均须","bbox":[491.029,275.507,125.89,13.988],"color":"#141414","fontSize":13.988,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0025","text":"熄火加油，不能拨打手机","bbox":[616.919,275.507,153.865,14.24],"color":"#8e24aa","fontSize":13.988,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0026","text":"，不要下车拍打","bbox":[770.784,275.507,97.914,13.988],"color":"#141414","fontSize":13.988,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0027","text":"化纤类衣物","bbox":[868.698,275.507,69.939,13.988],"color":"#8e24aa","fontSize":13.988,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0028","text":"雷电天气","bbox":[435.078,315.722,55.951,13.988],"color":"#8e24aa","fontSize":13.988,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0029","text":"，如正在驾驶汽车，","bbox":[491.029,315.722,125.89,13.988],"color":"#141414","fontSize":13.988,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0030","text":"应留在车内","bbox":[616.919,315.722,69.938,13.988],"color":"#8e24aa","fontSize":13.988,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0031","text":"飞机","bbox":[373.882,396.152,27.975,13.988],"color":"#19a719","fontSize":13.988,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0032","text":"飞机","bbox":[435.078,355.937,27.975,13.988],"color":"#141414","fontSize":13.988,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0033","text":"窗户必须做成圆形","bbox":[463.054,355.937,111.902,13.988],"color":"#19a719","fontSize":13.988,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0034","text":"。圆角可以避免使四角受到的力不均匀，易导致机体受损","bbox":[574.956,355.937,349.693,13.988],"color":"#141414","fontSize":13.988,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0035","text":"飞机的","bbox":[435.078,396.152,41.963,13.988],"color":"#141414","fontSize":13.988,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0036","text":"机翼横截面","bbox":[477.041,396.152,69.939,13.988],"color":"#19a719","fontSize":13.988,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0037","text":"一般","bbox":[546.98,396.152,27.975,13.988],"color":"#141414","fontSize":13.988,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0038","text":"前端圆钝、后端尖锐，上表面拱起、下表面较平","bbox":[574.956,396.152,293.742,14.24],"color":"#19a719","fontSize":13.988,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0039","text":"空气通过机翼上表面时流速大，压强较小；通过下表面时流速较小，压强大，因而此时飞机会有一个向上的升力","bbox":[435.078,436.366,685.398,14.561],"color":"#141414","fontSize":13.988,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0040","text":"火车","bbox":[373.882,507.179,27.975,13.988],"color":"#1e88e5","fontSize":13.988,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0041","text":"火车轨道由两条钢轨组成，一般来说，转弯处的火车轨道，","bbox":[435.078,476.581,363.681,13.988],"color":"#141414","fontSize":13.988,"block":15,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0042","text":"外侧钢轨比内侧高","bbox":[798.759,476.581,111.902,13.988],"color":"#1e88e5","fontSize":13.988,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0043","text":"“C”","bbox":[435.078,511.56,22.394,13.988],"color":"#1e88e5","fontSize":13.988,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0044","text":"代表城际，","bbox":[457.474,516.796,69.939,14.24],"color":"#1e88e5","fontSize":13.988,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0045","text":"“D”","bbox":[527.412,511.56,21.779,13.988],"color":"#1e88e5","fontSize":13.988,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0046","text":"代表动车，","bbox":[549.2,516.796,69.939,14.24],"color":"#1e88e5","fontSize":13.988,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0047","text":"“G”","bbox":[619.138,511.56,22.674,13.988],"color":"#1e88e5","fontSize":13.988,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0048","text":"代表高铁，","bbox":[641.814,516.796,69.939,14.24],"color":"#1e88e5","fontSize":13.988,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0049","text":"“Z”","bbox":[711.752,511.56,20.744,13.988],"color":"#1e88e5","fontSize":13.988,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0050","text":"代表直达","bbox":[732.509,516.796,55.951,13.988],"color":"#1e88e5","fontSize":13.988,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0051","text":"“T”","bbox":[435.078,532.541,20.898,13.988],"color":"#1e88e5","fontSize":13.988,"block":16,"line":1,"emphasis":true,"role":"content"},{"id":"science-p028-n0052","text":"代表特快，","bbox":[455.985,537.777,69.939,14.24],"color":"#1e88e5","fontSize":13.988,"block":16,"line":1,"emphasis":true,"role":"content"},{"id":"science-p028-n0053","text":"“K”","bbox":[525.923,532.541,20.772,13.988],"color":"#1e88e5","fontSize":13.988,"block":16,"line":1,"emphasis":true,"role":"content"},{"id":"science-p028-n0054","text":"代表快速，","bbox":[546.707,537.777,69.939,14.24],"color":"#1e88e5","fontSize":13.988,"block":16,"line":1,"emphasis":true,"role":"content"},{"id":"science-p028-n0055","text":"“L”","bbox":[616.645,532.541,19.485,13.988],"color":"#1e88e5","fontSize":13.988,"block":16,"line":1,"emphasis":true,"role":"content"},{"id":"science-p028-n0056","text":"代表临客，","bbox":[636.131,537.777,69.939,14.24],"color":"#1e88e5","fontSize":13.988,"block":16,"line":1,"emphasis":true,"role":"content"},{"id":"science-p028-n0057","text":"“Y”","bbox":[706.07,532.541,21.569,13.988],"color":"#1e88e5","fontSize":13.988,"block":16,"line":1,"emphasis":true,"role":"content"},{"id":"science-p028-n0058","text":"代表旅游列车","bbox":[727.646,537.777,83.926,13.988],"color":"#1e88e5","fontSize":13.988,"block":16,"line":1,"emphasis":true,"role":"content"},{"id":"science-p028-n0059","text":"交通信号灯","bbox":[373.882,638.314,69.939,13.988],"color":"#ce4289","fontSize":13.988,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0060","text":"红绿灯是国际统一的交通信号灯。红灯禁止通行，绿灯允许通行，黄灯为警示","bbox":[477.041,577.992,475.583,13.988],"color":"#141414","fontSize":13.988,"block":18,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0061","text":"红灯亮","bbox":[477.041,638.314,41.963,13.988],"color":"#e32c2d","fontSize":13.988,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0062","text":"车辆禁止直行或左转弯，在不碍行人和车辆情况下，允许车辆右转弯","bbox":[552.225,618.207,419.632,13.988],"color":"#141414","fontSize":13.988,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0063","text":"禁止行人进入人行横道，但是已经进入人行横道的，可以继续通过或者在道路中心线处停留等候","bbox":[552.225,658.421,587.484,13.988],"color":"#141414","fontSize":13.988,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0064","text":"黄灯亮","bbox":[477.041,718.743,41.963,13.988],"color":"#ff6f00","fontSize":13.988,"block":22,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0065","text":"停在路口停止线或人行横道线以内，","bbox":[552.225,698.636,223.803,13.988],"color":"#141414","fontSize":13.988,"block":23,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0066","text":"已越过停止线的车辆可以继续通过","bbox":[776.029,698.636,209.816,13.988],"color":"#ff6f00","fontSize":13.988,"block":23,"line":0,"emphasis":true,"role":"content"},{"id":"science-p028-n0067","text":"持续闪烁时为闪光警告信号灯，警告车辆行人注意安全，瞭望确认安全后通过","bbox":[552.225,738.851,475.583,13.988],"color":"#141414","fontSize":13.988,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"science-p028-n0068","text":"28","bbox":[587.275,810.711,16.0,21.344],"color":"#000000","fontSize":16.0,"block":25,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"science-p028-b0001","text":"第二章生活常识二、交通常识","bbox":[61.052,432.642,250.468,15.736],"nodeIds":["science-p028-n0001","science-p028-n0002","science-p028-n0003"]},{"id":"science-p028-b0002","text":"汽车","bbox":[373.882,195.078,27.975,13.988],"nodeIds":["science-p028-n0004"]},{"id":"science-p028-b0003","text":"多数汽车的前窗都是倾斜的，最主要是为了避免因反光而影响驾驶员视线","bbox":[435.078,74.434,447.608,13.988],"nodeIds":["science-p028-n0005","science-p028-n0006","science-p028-n0007","science-p028-n0008","science-p028-n0009","science-p028-n0010","science-p028-n0011"]},{"id":"science-p028-b0004","text":"双闪灯的作用是在紧急情况或临时停车，用来提醒其他人的","bbox":[435.078,114.649,363.681,13.988],"nodeIds":["science-p028-n0012","science-p028-n0013","science-p028-n0014","science-p028-n0015","science-p028-n0016","science-p028-n0017"]},{"id":"science-p028-b0005","text":"远光灯","bbox":[435.078,174.971,41.963,13.988],"nodeIds":["science-p028-n0018"]},{"id":"science-p028-b0006","text":"适用于照明条件特别差，又不会影响其他交通参与者的情况","bbox":[510.262,154.863,363.681,14.24],"nodeIds":["science-p028-n0019"]},{"id":"science-p028-b0007","text":"晚上开车在有路灯的街道上行驶，尽量少用汽车远光灯，以免影响他人","bbox":[510.262,195.078,433.619,13.988],"nodeIds":["science-p028-n0020"]},{"id":"science-p028-b0008","text":"汽车轮胎上的花纹是为了增大汽车与地面的摩擦力","bbox":[435.078,235.293,307.73,13.988],"nodeIds":["science-p028-n0021"]},{"id":"science-p028-b0009","text":"在加油站，所有机动车辆均须熄火加油，不能拨打手机，不要下车拍打化纤类衣物","bbox":[435.078,275.507,503.559,14.24],"nodeIds":["science-p028-n0022","science-p028-n0023","science-p028-n0024","science-p028-n0025","science-p028-n0026","science-p028-n0027"]},{"id":"science-p028-b0010","text":"雷电天气，如正在驾驶汽车，应留在车内","bbox":[435.078,315.722,251.779,13.988],"nodeIds":["science-p028-n0028","science-p028-n0029","science-p028-n0030"]},{"id":"science-p028-b0011","text":"飞机","bbox":[373.882,396.152,27.975,13.988],"nodeIds":["science-p028-n0031"]},{"id":"science-p028-b0012","text":"飞机窗户必须做成圆形。圆角可以避免使四角受到的力不均匀，易导致机体受损","bbox":[435.078,355.937,489.571,13.988],"nodeIds":["science-p028-n0032","science-p028-n0033","science-p028-n0034"]},{"id":"science-p028-b0013","text":"飞机的机翼横截面一般前端圆钝、后端尖锐，上表面拱起、下表面较平","bbox":[435.078,396.152,433.62,14.24],"nodeIds":["science-p028-n0035","science-p028-n0036","science-p028-n0037","science-p028-n0038"]},{"id":"science-p028-b0014","text":"空气通过机翼上表面时流速大，压强较小；通过下表面时流速较小，压强大，因而此时飞机会有一个向上的升力","bbox":[435.078,436.366,685.398,14.561],"nodeIds":["science-p028-n0039"]},{"id":"science-p028-b0015","text":"火车","bbox":[373.882,507.179,27.975,13.988],"nodeIds":["science-p028-n0040"]},{"id":"science-p028-b0016","text":"火车轨道由两条钢轨组成，一般来说，转弯处的火车轨道，外侧钢轨比内侧高","bbox":[435.078,476.581,475.583,13.988],"nodeIds":["science-p028-n0041","science-p028-n0042"]},{"id":"science-p028-b0017","text":"“C”代表城际，“D”代表动车，“G”代表高铁，“Z”代表直达“T”代表特快，“K”代表快速，“L”代表临客，“Y”代表旅游列车","bbox":[435.078,511.56,376.494,40.457],"nodeIds":["science-p028-n0043","science-p028-n0044","science-p028-n0045","science-p028-n0046","science-p028-n0047","science-p028-n0048","science-p028-n0049","science-p028-n0050","science-p028-n0051","science-p028-n0052","science-p028-n0053","science-p028-n0054","science-p028-n0055","science-p028-n0056","science-p028-n0057","science-p028-n0058"]},{"id":"science-p028-b0018","text":"交通信号灯","bbox":[373.882,638.314,69.939,13.988],"nodeIds":["science-p028-n0059"]},{"id":"science-p028-b0019","text":"红绿灯是国际统一的交通信号灯。红灯禁止通行，绿灯允许通行，黄灯为警示","bbox":[477.041,577.992,475.583,13.988],"nodeIds":["science-p028-n0060"]},{"id":"science-p028-b0020","text":"红灯亮","bbox":[477.041,638.314,41.963,13.988],"nodeIds":["science-p028-n0061"]},{"id":"science-p028-b0021","text":"车辆禁止直行或左转弯，在不碍行人和车辆情况下，允许车辆右转弯","bbox":[552.225,618.207,419.632,13.988],"nodeIds":["science-p028-n0062"]},{"id":"science-p028-b0022","text":"禁止行人进入人行横道，但是已经进入人行横道的，可以继续通过或者在道路中心线处停留等候","bbox":[552.225,658.421,587.484,13.988],"nodeIds":["science-p028-n0063"]},{"id":"science-p028-b0023","text":"黄灯亮","bbox":[477.041,718.743,41.963,13.988],"nodeIds":["science-p028-n0064"]},{"id":"science-p028-b0024","text":"停在路口停止线或人行横道线以内，已越过停止线的车辆可以继续通过","bbox":[552.225,698.636,433.62,13.988],"nodeIds":["science-p028-n0065","science-p028-n0066"]},{"id":"science-p028-b0025","text":"持续闪烁时为闪光警告信号灯，警告车辆行人注意安全，瞭望确认安全后通过","bbox":[552.225,738.851,475.583,13.988],"nodeIds":["science-p028-n0067"]},{"id":"science-p028-b0026","text":"28","bbox":[587.275,810.711,16.0,21.344],"nodeIds":["science-p028-n0068"]}],"questions":[{"id":"science-p028-q001","number":1,"type":"fill-in","answer":"前窗","bbox":[505.017,74.434,27.975,13.988],"fontSize":13.988,"color":"#8e24aa","segments":[{"text":"前窗","bbox":[505.017,74.434,27.975,13.988],"color":"#8e24aa"}],"nodeIds":["science-p028-n0006"],"aliases":[],"context":"多数汽车的____都是____的，最主要是为了避免因____而影响驾驶员视线"},{"id":"science-p028-q002","number":2,"type":"fill-in","answer":"倾斜","bbox":[560.968,74.434,27.976,13.988],"fontSize":13.988,"color":"#8e24aa","segments":[{"text":"倾斜","bbox":[560.968,74.434,27.976,13.988],"color":"#8e24aa"}],"nodeIds":["science-p028-n0008"],"aliases":[],"context":"多数汽车的____都是____的，最主要是为了避免因____而影响驾驶员视线"},{"id":"science-p028-q003","number":3,"type":"fill-in","answer":"反光","bbox":[742.808,74.434,27.975,13.988],"fontSize":13.988,"color":"#8e24aa","segments":[{"text":"反光","bbox":[742.808,74.434,27.975,13.988],"color":"#8e24aa"}],"nodeIds":["science-p028-n0010"],"aliases":[],"context":"多数汽车的____都是____的，最主要是为了避免因____而影响驾驶员视线"},{"id":"science-p028-q004","number":4,"type":"fill-in","answer":"双闪灯","bbox":[435.078,114.649,41.963,13.988],"fontSize":13.988,"color":"#8e24aa","segments":[{"text":"双闪灯","bbox":[435.078,114.649,41.963,13.988],"color":"#8e24aa"}],"nodeIds":["science-p028-n0012"],"aliases":[],"context":"____的作用是在____或____，用来提醒其他人的"},{"id":"science-p028-q005","numb