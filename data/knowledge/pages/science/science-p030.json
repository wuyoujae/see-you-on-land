,14.655],"color":"#e32c2d","fontSize":14.655,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0011","text":"着火层的下层","bbox":[898.137,42.526,87.928,14.655],"color":"#e32c2d","fontSize":14.655,"block":3,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0012","text":"高层建筑火灾逃生要有序疏散，","bbox":[593.822,84.658,205.166,14.655],"color":"#141414","fontSize":14.655,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0013","text":"勿乘电梯；不能跳楼","bbox":[798.989,84.658,131.893,15.256],"color":"#e32c2d","fontSize":14.655,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0014","text":"可利用疏散楼梯、阳台、落水管等，用绳索顺绳滑下逃生自救","bbox":[593.822,106.641,395.678,14.655],"color":"#141414","fontSize":14.655,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0015","text":"穿过充满烟气的楼道逃生时，要尽量降","bbox":[593.822,148.773,249.131,14.655],"color":"#141414","fontSize":14.655,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0016","text":"低头部的高度","bbox":[842.953,148.773,87.928,14.655],"color":"#e32c2d","fontSize":14.655,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0017","text":"用","bbox":[593.822,170.755,14.655,14.655],"color":"#141414","fontSize":14.655,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0018","text":"湿毛巾","bbox":[608.477,170.755,43.964,14.655],"color":"#e32c2d","fontSize":14.655,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0019","text":"或","bbox":[652.441,170.755,14.655,14.655],"color":"#141414","fontSize":14.655,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0020","text":"口罩","bbox":[667.096,170.755,29.309,14.655],"color":"#e32c2d","fontSize":14.655,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0021","text":"捂住口鼻，","bbox":[696.406,170.755,73.274,15.256],"color":"#141414","fontSize":14.655,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0022","text":"匍匐着撤离","bbox":[769.679,170.755,73.274,14.655],"color":"#e32c2d","fontSize":14.655,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0023","text":"。沿","bbox":[842.953,170.755,29.309,14.655],"color":"#141414","fontSize":14.655,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0024","text":"墙壁方向逃生","bbox":[872.262,170.755,87.928,14.655],"color":"#e32c2d","fontSize":14.655,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0025","text":"可以明确逃生方向","bbox":[960.191,170.755,117.238,14.655],"color":"#141414","fontSize":14.655,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0026","text":"身上着火后应","bbox":[593.822,212.887,87.928,14.655],"color":"#141414","fontSize":14.655,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0027","text":"就地打滚","bbox":[681.751,212.887,58.619,14.655],"color":"#e32c2d","fontSize":14.655,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0028","text":"或利用厚重的衣物、被子等物体覆压火苗","bbox":[740.37,212.887,263.785,14.655],"color":"#141414","fontSize":14.655,"block":8,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0029","text":"②灭火器","bbox":[456.434,300.438,58.619,14.655],"color":"#e32c2d","fontSize":14.655,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0030","text":"火苗的内焰温度低，外焰温度高。使用灭火器时应该对准火苗","bbox":[549.858,255.02,395.678,14.655],"color":"#141414","fontSize":14.655,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0031","text":"根部的内焰","bbox":[945.536,255.02,73.274,14.655],"color":"#e53935","fontSize":14.655,"block":10,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0032","text":"雷电","bbox":[392.32,512.716,29.309,14.655],"color":"#8e24aa","fontSize":14.655,"block":11,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0033","text":"若处室外，应寻找低洼处","bbox":[456.434,469.668,161.202,14.655],"color":"#141414","fontSize":14.655,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0034","text":"(","bbox":[617.636,464.253,4.675,14.655],"color":"#141414","fontSize":14.655,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0035","text":"如土坑","bbox":[622.316,469.668,43.964,14.655],"color":"#141414","fontSize":14.655,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0036","text":")","bbox":[666.28,464.253,4.675,14.655],"color":"#141414","fontSize":14.655,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0037","text":"藏身，","bbox":[670.96,469.668,43.964,14.655],"color":"#141414","fontSize":14.655,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0038","text":"低头曲身下蹲","bbox":[714.924,469.668,87.928,14.655],"color":"#8e24aa","fontSize":14.655,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0039","text":"，同时","bbox":[802.853,469.668,43.964,14.655],"color":"#141414","fontSize":14.655,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0040","text":"双手抱膝，两脚并拢","bbox":[846.817,469.668,131.893,14.655],"color":"#8e24aa","fontSize":14.655,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0041","text":"。远离","bbox":[978.71,469.668,43.964,14.655],"color":"#141414","fontSize":14.655,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0042","text":"导电物品","bbox":[1022.674,469.668,58.619,14.655],"color":"#8e24aa","fontSize":14.655,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0043","text":"(","bbox":[1081.293,464.253,4.675,14.655],"color":"#141414","fontSize":14.655,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0044","text":"如金属","bbox":[1085.972,469.668,43.964,14.655],"color":"#141414","fontSize":14.655,"block":12,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0045","text":"广告牌或湿润树干","bbox":[456.434,491.65,117.238,14.655],"color":"#141414","fontSize":14.655,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0046","text":")","bbox":[573.672,486.235,4.675,14.655],"color":"#141414","fontSize":14.655,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0047","text":"和","bbox":[578.352,491.65,14.655,14.655],"color":"#141414","fontSize":14.655,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0048","text":"电力设施","bbox":[593.006,491.65,58.619,14.655],"color":"#8e24aa","fontSize":14.655,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0049","text":"(","bbox":[651.625,486.235,4.675,14.655],"color":"#141414","fontSize":14.655,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0050","text":"如灯杆、电线杆","bbox":[656.305,491.65,102.583,14.655],"color":"#141414","fontSize":14.655,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0051","text":")","bbox":[758.888,486.235,4.675,14.655],"color":"#141414","fontSize":14.655,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0052","text":"，不要拿着","bbox":[763.568,491.65,73.274,14.655],"color":"#141414","fontSize":14.655,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0053","text":"金属物品","bbox":[836.842,491.65,58.619,14.655],"color":"#8e24aa","fontSize":14.655,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0054","text":"(","bbox":[895.461,486.235,4.675,14.655],"color":"#141414","fontSize":14.655,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0055","text":"如带有金属杆的雨伞）在雷雨中停留","bbox":[900.141,491.65,234.476,14.655],"color":"#141414","fontSize":14.655,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0056","text":"若处室内，","bbox":[456.434,533.782,73.274,14.655],"color":"#141414","fontSize":14.655,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0057","text":"不拨打接听电话","bbox":[529.708,533.782,102.583,14.655],"color":"#8e24aa","fontSize":14.655,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0058","text":"，拔掉电器用具插头；不开门开窗以防雷电直击室内","bbox":[632.291,533.782,337.059,15.256],"color":"#141414","fontSize":14.655,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0059","text":"洪水","bbox":[392.32,596.981,29.309,14.655],"color":"#ff6f00","fontSize":14.655,"block":15,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0060","text":"若时间充裕，应按照预定路线，有组织地向","bbox":[456.434,575.914,278.44,14.655],"color":"#141414","fontSize":14.655,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0061","text":"山坡、高地","bbox":[734.874,575.914,73.274,14.655],"color":"#ff6f00","fontSize":14.655,"block":16,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0062","text":"等处转移","bbox":[808.148,575.914,58.619,14.655],"color":"#141414","fontSize":14.655,"block":16,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0063","text":"来不及转移时，应立即爬上屋顶、大树、高墙等","bbox":[456.434,618.047,307.75,14.655],"color":"#141414","fontSize":14.655,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0064","text":"高的地方","bbox":[764.184,618.047,58.619,14.655],"color":"#ff6f00","fontSize":14.655,"block":17,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0065","text":"，做暂时避险，等待援救","bbox":[822.803,618.047,161.202,14.655],"color":"#141414","fontSize":14.655,"block":17,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0066","text":"泥石流","bbox":[392.32,660.179,43.964,14.655],"color":"#19a719","fontSize":14.655,"block":18,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0067","text":"发生泥石流时，要立即向坚固的","bbox":[471.089,660.179,205.166,14.655],"color":"#141414","fontSize":14.655,"block":18,"line":1,"emphasis":false,"role":"content"},{"id":"science-p030-n0068","text":"高地","bbox":[676.255,660.179,29.31,14.655],"color":"#19a719","fontSize":14.655,"block":18,"line":1,"emphasis":true,"role":"content"},{"id":"science-p030-n0069","text":"或与泥石流成","bbox":[705.565,660.179,87.928,14.655],"color":"#141414","fontSize":14.655,"block":18,"line":1,"emphasis":false,"role":"content"},{"id":"science-p030-n0070","text":"垂直方向","bbox":[793.493,660.179,58.619,14.655],"color":"#19a719","fontSize":14.655,"block":18,"line":1,"emphasis":true,"role":"content"},{"id":"science-p030-n0071","text":"的两侧","bbox":[852.112,660.179,43.964,14.655],"color":"#141414","fontSize":14.655,"block":18,"line":1,"emphasis":false,"role":"content"},{"id":"science-p030-n0072","text":"山坡","bbox":[896.076,660.179,29.31,14.655],"color":"#19a719","fontSize":14.655,"block":18,"line":1,"emphasis":true,"role":"content"},{"id":"science-p030-n0073","text":"跑，离开沟道、河谷地带","bbox":[925.386,660.179,161.202,14.655],"color":"#141414","fontSize":14.655,"block":18,"line":1,"emphasis":false,"role":"content"},{"id":"science-p030-n0074","text":"地震","bbox":[392.32,738.948,29.309,14.655],"color":"#1e88e5","fontSize":14.655,"block":19,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0075","text":"若身处低矮楼层，应尽快疏散到屋外开阔空地，远离人多的地方、高层建筑和桥梁","bbox":[456.434,706.891,527.571,14.655],"color":"#141414","fontSize":14.655,"block":20,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0076","text":"若身处高层，应躲在","bbox":[456.434,749.023,131.893,14.655],"color":"#141414","fontSize":14.655,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0077","text":"低矮牢固的家具","bbox":[588.327,749.023,102.583,14.655],"color":"#1e88e5","fontSize":14.655,"block":21,"line":0,"emphasis":true,"role":"content"},{"id":"science-p030-n0078","text":"(","bbox":[690.91,743.609,4.675,14.655],"color":"#141414","fontSize":14.655,"block":21,"line":0,"emphasis":false,"role":"content"},{"id":"science-p030-n0079","text":"如床、桌","bbox":[695.59,749.023,58.619,14.655],"color":"#141414","fontSize":14.655,"block":