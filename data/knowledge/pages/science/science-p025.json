723],"color":"#e53935","fontSize":15.723,"block":4,"line":0,"emphasis":true,"role":"content"},{"id":"science-p025-n0011","text":"以止痛、减少渗出和肿胀，避免或减少水泡形成","bbox":[749.972,50.609,330.193,16.368],"color":"#000000","fontSize":15.723,"block":4,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0012","text":"等冷却后才可小心地将贴身衣服脱去；","bbox":[489.721,95.814,267.299,16.368],"color":"#000000","fontSize":15.723,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0013","text":"不可用冰块凉敷","bbox":[757.02,95.814,110.064,15.723],"color":"#e53935","fontSize":15.723,"block":5,"line":0,"emphasis":true,"role":"content"},{"id":"science-p025-n0014","text":"，以免产生冻伤","bbox":[867.085,95.814,110.064,15.723],"color":"#000000","fontSize":15.723,"block":5,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0015","text":"不可擅自在伤口处涂药或涂其他物质","bbox":[489.721,141.019,251.576,15.723],"color":"#e53935","fontSize":15.723,"block":6,"line":0,"emphasis":true,"role":"content"},{"id":"science-p025-n0016","text":"，以免影响创面情况的观察与处理","bbox":[741.297,141.019,235.852,15.723],"color":"#000000","fontSize":15.723,"block":6,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0017","text":"若烫伤处有水泡，","bbox":[489.721,186.224,125.788,16.368],"color":"#000000","fontSize":15.723,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0018","text":"不可挑破","bbox":[615.509,186.224,62.894,15.723],"color":"#e53935","fontSize":15.723,"block":7,"line":0,"emphasis":true,"role":"content"},{"id":"science-p025-n0019","text":"，应用干净纱布覆盖，去医院处理","bbox":[678.403,186.224,235.852,15.723],"color":"#000000","fontSize":15.723,"block":7,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0020","text":"触电","bbox":[420.931,276.634,31.447,15.723],"color":"#8e24aa","fontSize":15.723,"block":8,"line":0,"emphasis":true,"role":"content"},{"id":"science-p025-n0021","text":"有人触电时，首先应","bbox":[489.721,231.429,141.511,15.723],"color":"#141414","fontSize":15.723,"block":9,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0022","text":"迅速切断电源","bbox":[631.232,231.429,94.341,15.723],"color":"#8e24aa","fontSize":15.723,"block":9,"line":0,"emphasis":true,"role":"content"},{"id":"science-p025-n0023","text":"如果一时不能切断电源，救助者应做好防护措施","bbox":[489.721,276.634,330.193,15.723],"color":"#141414","fontSize":15.723,"block":10,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0024","text":"用不导电的物体，挑开触电者身上的电线，尽快将触电者与电源隔离","bbox":[489.721,321.839,471.705,15.723],"color":"#141414","fontSize":15.723,"block":11,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0025","text":"中暑","bbox":[420.931,435.834,31.447,15.723],"color":"#ff6f00","fontSize":15.723,"block":12,"line":0,"emphasis":true,"role":"content"},{"id":"science-p025-n0026","text":"应停止活动并在","bbox":[489.721,367.044,110.064,15.723],"color":"#141414","fontSize":15.723,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0027","text":"凉爽、通风","bbox":[599.785,367.044,78.617,15.723],"color":"#ff6f00","fontSize":15.723,"block":13,"line":0,"emphasis":true,"role":"content"},{"id":"science-p025-n0028","text":"的环境中休息，脱去多余的或者紧身的衣服","bbox":[678.403,367.044,298.746,15.723],"color":"#141414","fontSize":15.723,"block":13,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0029","text":"如果患者有反应并且没有恶心呕吐，可给患者","bbox":[489.721,412.249,314.47,15.723],"color":"#141414","fontSize":15.723,"block":14,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0030","text":"喝水或者","bbox":[804.191,412.249,62.894,15.723],"color":"#ff6f00","fontSize":15.723,"block":14,"line":0,"emphasis":true,"role":"content"},{"id":"science-p025-n0031","text":"运动饮料","bbox":[489.721,435.834,62.894,15.723],"color":"#ff6f00","fontSize":15.723,"block":14,"line":1,"emphasis":true,"role":"content"},{"id":"science-p025-n0032","text":"，也可服用","bbox":[552.615,435.834,78.617,15.723],"color":"#141414","fontSize":15.723,"block":14,"line":1,"emphasis":false,"role":"content"},{