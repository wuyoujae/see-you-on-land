.724],"color":"#141414","fontSize":15.723,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0056","text":"禁止一切能够引起火花的行为","bbox":[599.785,759.148,204.405,15.724],"color":"#0096bf","fontSize":15.723,"block":24,"line":0,"emphasis":true,"role":"content"},{"id":"science-p025-n0057","text":"（如开灯、打开排风扇、点燃打火机等）","bbox":[804.191,759.148,283.023,15.724],"color":"#141414","fontSize":15.723,"block":24,"line":0,"emphasis":false,"role":"content"},{"id":"science-p025-n0058","text":"25","bbox":[587.275,810.711,16.0,21.344],"color":"#000000","fontSize":16.0,"block":25,"line":0,"emphasis":false,"role":"page-number"}],"blocks":[{"id":"science-p025-b0001","text":"第一章基础科学","bbox":[69.527,441.966,128.245,17.689],"nodeIds":["science-p025-n0001","science-p025-n0002"]},{"id":"science-p025-b0002","text":"第四节医学知识","bbox":[76.591,467.281,114.095,15.723],"nodeIds":["science-p025-n0003","science-p025-n0004"]},{"id":"science-p025-b0003","text":"二、急救知识","bbox":[256.489,454.506,94.341,15.723],"nodeIds":["science-p025-n0005"]},{"id":"science-p025-b0004","text":"烫伤","bbox":[420.931,118.416,31.447,15.723],"nodeIds":["science-p025-n0006"]},{"id":"science-p025-b0005","text":"烫伤后应立即用20℃左右的凉水冲洗以止痛、减少渗出和肿胀，避免或减少水泡形成","bbox":[489.721,44.723,590.444,22.254],"nodeIds":["science-p025-n0007","science-p025-n0008","science-p025-n0009","science-p025-n0010","science-p025-n0011"]},{"id":"science-p025-b0006","text":"等冷却后才可小心地将贴身衣服脱去；不可用冰块凉敷，以免产生冻伤","bbox":[489.721,95.814,487.428,16.368],"nodeIds":["science-p025-n0012","science-p025-n0013","science-p025-n0014"]},{"id":"science-p025-b0007","text":"不可擅自在伤口处涂药或涂其他物质，以免影响创面情况的观察与处理","bbox":[489.721,141.019,487.428,15.723],"nodeIds":["science-p025-n0015","science-p025-n0016"]},{"id":"science-p025-b0008","text":"若烫伤处有水泡，不可挑破，应用干净纱布覆盖，去医院处理","bbox":[489.721,186.224,424.534,16.368],"nodeIds":["science-p025-n0017","science-p025-n0018","science-p025-n0019"]},{"id":"science-p025-b0009","text":"触电","bbox":[420.931,276.634,31.447,15.723],"nodeIds":["science-p025-n0020"]},{"id":"science-p025-b0010","text":"有人触电时，首先应迅速切断电源","bbox":[489.721,231.429,235.852,15.723],"nodeIds":["science-p025-n0021","science-p025-n0022"]},{"id":"science-p025-b0011","text":"如果一时不能切断电源，救助者应做好防护措施","bbox":[489.721,276.634,330.193,15.723],"nodeIds":["science-p025-n0023"]},{"id":"science-p025-b0012","text":"用不导电的物体，挑开触电者身上的电线，尽快将触电者与电源隔离","bbox":[489.721,321.839,471.705,15.723],"nodeIds":["science-p025-n0024"]},{"id":"science-p025-b0013","text":"中暑","bbox":[420.931,435.834,31.447,15.723],"nodeIds":["science-p025-n0025"]},{"id":"science-p025-b0014","text":"应停止活动并在凉爽、通风的环境中休息，脱去多余的或者紧身的衣服","bbox":[489.721,367.044,487.428,15.723],"nodeIds":["science-p025-n0026","science-p025-n0027","science-p025-n0028"]},{"id":"science-p025-b0015","text":"如果患者有反应并且没有恶心呕吐，可给患者喝水或者运动饮料，也可服用人丹、十滴水、藿香正气水等中药","bbox":[489.721,412.249,377.364,39.308],"nodeIds":["science-p025-n0029","science-p025-n0030","science-p025-n0031","science-p025-n0032","science-p025-n0033","science-p025-n0034"]},{"id":"science-p025-b0016","text":"用湿的凉毛巾放置于患者的头部和躯干部以降温，或将冰袋置于患者的腋下、颈侧和腹股沟处","bbox":[489.721,481.039,644.663,15.723],"nodeIds":["science-p025-n0035","science-p025-n0036","science-p025-n0037","science-p025-n0038","science-p025-n0039","science-p025-n0040","science-p025-n0041"]},{"id":"science-p025-b0017","text":"骨折要对伤肢进行固定再送医院，否则骨折断端异常活动，会加重损伤","bbox":[420.931,526.244,524.771,15.724],"nodeIds":["science-p025-n0042","science-p025-n0043","science-p025-n0044","science-p025-n0045"]},{"id":"science-p025-b0018","text":"溺水","bbox":[420.931,610.758,31.447,15.724],"nodeIds":["science-p025-n0046"]},{"id":"science-p025-b0019","text":"溺水者被救上岸后急救方法步骤如下：①清除口、鼻中杂物；②人工呼吸；③胸外心脏按摩","bbox":[489.721,576.363,628.939,16.604],"nodeIds":["science-p025-n0047","science-p025-n0048"]},{"id":"science-p025-b0020","text":"将溺水者救上岸后，如发现溺水者心跳已停或极其微弱，则应立即施行","bbox":[489.721,621.568,487.428,15.724],"nodeIds":["science-p025-n0049"]},{"id":"science-p025-b0021","text":"胸外心脏按摩，通过间接按压心脏使其收缩与舒张，恢复供血功能","bbox":[489.721,645.153,455.