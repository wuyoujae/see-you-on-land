ce-p026-n0017"]},{"id":"science-p026-b0009","text":"主要包括铜、镍、钴、铅、锌、锡、锑、铋、镉、汞等","bbox":[443.934,247.714,322.862,13.453],"nodeIds":["science-p026-n0018","science-p026-n0019","science-p026-n0020"]},{"id":"science-p026-b0010","text":"误食重金属后，需要进行催吐，并通过补充蛋白质（如牛奶、豆浆等）来缓解中毒症状","bbox":[443.934,286.39,511.198,13.453],"nodeIds":["science-p026-n0021","science-p026-n0022","science-p026-n0023"]},{"id":"science-p026-b0011","text":"9.急性呼吸道异物堵塞","bbox":[333.792,438.16,130.61,18.489],"nodeIds":["science-p026-n0024","science-p026-n0025"]},{"id":"science-p026-b0012","text":"使用“海姆里克腹部冲击法”，被称为“生命的拥抱”","bbox":[496.904,320.03,291.985,18.489],"nodeIds":["science-p026-n0026","science-p026-n0027","science-p026-n0028","science-p026-n0029","science-p026-n0030","science-p026-n0031","science-p026-n0032","science-p026-n0033"]},{"id":"science-p026-b0013","text":"对于1岁以上儿童及成人","bbox":[496.904,416.72,147.505,18.489],"nodeIds":["science-p026-n0034","science-p026-n0035","science-p026-n0036"]},{"id":"science-p026-b0014","text":"发生重度气道梗阻且意识清醒时，先进行5次背部拍击","bbox":[676.832,358.772,323.571,18.423],"nodeIds":["science-p026-n0037","science-p026-n0038","science-p026-n0039","science-p026-n0040","science-p026-n0041"]},{"id":"science-p026-b0015","text":"即用掌根在患者两侧肩胛骨连线的中点处，快速、有力地连续拍击5次","bbox":[676.832,397.448,417.739,18.423],"nodeIds":["science-p026-n0042","science-p026-n0043","science-p026-n0044"]},{"id":"science-p026-b0016","text":"如果拍背后异物未排出，立即转为腹部冲击","bbox":[676.832,441.094,255.599,13.453],"nodeIds":["science-p026-n0045"]},{"id":"science-p026-b0017","text":"交替进行“5次背部拍击”和“5次腹部冲击”，直到异物排出或患者失去意识","bbox":[676.832,474.735,427.749,18.488],"nodeIds":["science-p026-n0046","science-p026-n0047","science-p026-n0048","science-p026-n0049","science-p026-n0050","science-p026-n0051","science-p026-n0052","science-p026-n0053","science-p026-n0054","science-p026-n0055","science-p026-n0056","science-p026-n0057"]},{"id":"science-p026-b0018","text":"对于1岁以下婴儿严禁使用腹部冲击法，应采用“拍背+按胸”法，以免损伤其未发育成熟的肝、脾等内脏","bbox":[496.904,513.411,643.148,18.488],"nodeIds":["science-p026-n0058","science-p026-n0059","science-p026-n0060","science-p026-n0061","science-p026-n0062","science-p026-n0063","science-p026-n0064","science-p026-n0065","science-p026-n0066","science-p026-n0067","science-p026-n0068"]},{"id":"science-p026-b0019","text":"对于孕妇和肥胖者先进行5次背部拍击，若异物未排出，则采取胸部冲击","bbox":[496.904,556.356,463.141,18.423],"nodeIds":["science-p026-n0069","science-p026-n0070","science-p026-n0071","science-p026-n0072","science-p026-n0073","science-p026-n0074"]},{"id":"science-p026-b0020","text":"【知识延伸】","bbox":[360.136,622.704,80.715,13.453],"nodeIds":["science-p026-n0075"]},{"id":"science-p026-b0021","text":"冷敷和热敷","bbox":[366.862,642.882,67.263,13.453],"nodeIds":["science-p026-n0076"]},{"id":"science-p026-b0022","text":"血遇热而活，遇寒则凝，所以在受伤早期宜冷敷，以减少局部血肿","bbox":[472.801,604.206,390.124,13.453],"nodeIds":["science-p026-n0077"]},{"id":"science-p026-b0023","text":"在出血停止以后再热敷，可加速消散伤处周围的瘀血","bbox":[472.801,642.882,309.409,13.453],"nodeIds":["science-p026-n0078"]},{"id":"science-p026-b0024","text":"一般而言，受伤24到48小时后视情况使用热敷","bbox":[472.801,676.588,286.886,18.424],"nodeIds":["science-p026-n0079","science-p026-n0080","science-p026-n0081","science-p026-n0082","science-p026-n0083"]},{"id":"science-p026-b0025","text":"26","bbox":[587.275,810.711,16.0,21.344],"nodeIds":["science-p026-n0084"]}],"questions":[{"id":"science-p026-q001","number":1,"type":"fill-in","answer":"关节扭伤","bbox":[360.136,151.023,53.81,13.453],"fontSize":13.453,"color":"#3949ab","segments":[{"text":"关节扭伤","bbox":[360.136,151.023,53.81,13.453],"color":"#3949ab"}],"nodeIds":["science-p026-n0006"],"aliases":[],"context":"____"},{"id":"science-p026-q002","number":2,"type":"fill-in","answer":"不可热敷","bbox":[513.159,170.361,53.81,13.453],"fontSize":13.453,"color":"#3949ab","segments":[{"text":"不可热敷","bbox":[513.159,170.361,53.81,13.453],"color":"#3949ab"}],"nodeIds":["science-p026-n0011"],"aliases":[],"context":"刚扭伤时，____、按揉、擦涂红花油等活血化瘀的药剂"},{"id":"science-p026-q003","number":3,"type":"fill-i