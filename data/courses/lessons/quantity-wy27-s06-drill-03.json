        "printedPages": [
          64
        ],
        "originalImages": [
          {
            "src": "assets/images/courses/quantity-wy27/quantity-wy27-s06-t03-drill-09-p070.webp",
            "alt": "行程问题（一） · 实战精刷9 · 讲义第64页",
            "pdfPage": 70
          }
        ]
      }
    },
    {
      "id": "quantity-wy27-s06-t03-drill-09-explanation-02",
      "type": "text",
      "role": "explanation",
      "title": "我们这样分析 · 2",
      "questionId": "quantity-wy27-s06-t03-drill-09",
      "blocks": [
        {
          "type": "paragraph",
          "text": "转90度后用直角三角形求直线距离，不能把两段路简单相加。"
        }
      ],
