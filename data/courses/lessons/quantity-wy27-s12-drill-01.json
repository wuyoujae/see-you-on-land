    {
      "id": "quantity-wy27-s12-t02-drill-02-explanation-02",
      "type": "text",
      "role": "explanation",
      "title": "我们这样分析 · 2",
      "questionId": "quantity-wy27-s12-t02-drill-02",
      "blocks": [
