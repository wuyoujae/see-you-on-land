        ],
        "originalImages": [
          {
            "src": "assets/images/courses/quantity-wy27/quantity-wy27-s15-t03-drill-01-p159.webp",
            "alt": "几何问题（二） · 实战精刷1 · 讲义第153页",
            "pdfPage": 159
