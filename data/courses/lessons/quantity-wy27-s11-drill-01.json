      "question": {
        "id": "quantity-wy27-s11-t02-drill-03",
        "type": "single",
        "stem": "（26全国事考）甲高校2名教授，乙高校4名教授分成2个3人组，分别对A，B两篇学术论文进行评审。如要求每个组的3人不能来自同一所高校，则有多少种不同的分组方式？",
        "options": [
          {
            "value": "A",
            "label": "8"
          },
          {
            "value": "B",
            "label": "12"
          },
          {
            "value": "C",
            "label": "16"
          },
          {
            "value": "D",
            "label": "24"
          }
        ],
        "answer": "B",
        "sourceAnswer": "B"
      },
      "source": {
        "type": "pdf",
        "documentId": "quantity-wy27",
        "title": "王炎·27数量关系大满贯·讲义",
