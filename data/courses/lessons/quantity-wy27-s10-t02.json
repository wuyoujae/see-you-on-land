    {
      "id": "quantity-wy27-s10-t02-practice-02-explanation-01",
      "type": "text",
      "role": "explanation",
      "title": "我们这样分析",
      "questionId": "quantity-wy27-s10-t02-practice-02",
      "blocks": [
