        "printedPages": [
          98
        ],
        "originalImages": [
          {
            "src": "assets/images/courses/quantity-wy27/quantity-wy27-s10-t02-mother-01-p104.webp",
            "alt": "排列组合问题（一） · 母题精讲1 · 讲义第98页",
            "pdfPage": 104
