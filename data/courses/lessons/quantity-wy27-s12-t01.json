      "question": {
        "id": "quantity-wy27-s12-t01-practice-05",
        "type": "single",
        "stem": "（26浙江）小张计划在假期剩余的13天完成A、B、C三本书的阅读。已知阅读A书需要连续2天，阅读B书需要连续3天，阅读C书需要连续4天。问在所有可能的阅读方案中随机选择一种，没有阅读的4天都不相连的概率是多少？",
        "options": [
          {
            "value": "A",
            "label": "1/10"
          },
          {
            "value": "B",
            "label": "1/15"
          },
          {
            "value": "C",
            "label": "1/20"
          },
          {
            "value": "D",
            "label": "1/35"
          }
        ],
        "answer": "D",
        "sourceAnswer": "D"
      },
      "source": {
        "type": "pdf",
        "documentId": "quantity-wy27",
