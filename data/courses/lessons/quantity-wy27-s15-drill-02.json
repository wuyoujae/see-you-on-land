        ]
      }
    },
    {
      "id": "quantity-wy27-s15-t03-drill-06-explanation-02",
      "type": "text",
      "role": "explanation",
      "title": "我们这样分析 · 2",
      "questionId": "quantity-wy27-s15-t03-drill-06",
      "blocks": [
        {
          "type": "paragraph",
          "text": "倒锥水体线性比例要立方，问“再”时扣除已经注入的量。"
        }
      ],
