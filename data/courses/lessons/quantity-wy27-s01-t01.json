          {
            "src": "assets/images/courses/quantity-wy27/quantity-wy27-s01-t01-mother-02-p009.webp",
            "alt": "和差倍比问题（一） · 母题精讲2 · 讲义第3页",
            "pdfPage": 9
          }
        ]
      }
