    {
      "id": "quantity-wy27-s01-t01-practice-03-question",
      "type": "question",
      "title": "思维精练 · 第3题",
      "question": {
        "id": "quantity-wy27-s01-t01-practice-03",
        "type": "single",
        "stem": "（25联考）某绿色有机农场把61600平方米耕地划分为玉米、大豆、稻谷三个作物区，玉米和大豆的面积比是7：2，大豆和稻谷的面积比是6：1，则玉米的面积是多少平方米？",
        "options": [
          {
            "value": "A",
            "label": "46200"
          },
          {
            "value": "B",
            "label": "47200"
          },
          {
            "value": "C",
            "label": "48200"
          },
          {
            "value": "D",
            "label": "49200"
          }
        ],
        "answer": "A",
        "sourceAnswer": "A"
      },
      "source": {
        "type": "pdf",
        "documentId": "quantity-wy27",
        "title": "王炎·27数量关系大满贯·讲义",
        "pages": [
          10
        ],
        "printedPages": [
          4
        ],
        "originalImages": [
