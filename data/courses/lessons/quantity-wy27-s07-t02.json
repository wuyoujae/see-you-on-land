    {
      "id": "quantity-wy27-s07-t02-practice-02-question",
      "type": "question",
      "title": "思维精练 · 第2题",
      "question": {
        "id": "quantity-wy27-s07-t02-practice-02",
        "type": "single",
        "stem": "（26天津）小赵开车从A地前往B地，前25%的路程匀速行驶用了1小时10分，此后均匀加速并用50分钟到达A、B两地中点。后半段均匀减速，又用了1小时40分到达B地。问到达B地的速度是从A地出发时的多少倍？",
        "options": [
          {
            "value": "A",
            "label": "不到1.25倍"
          },
          {
            "value": "B",
            "label": "1.25~1.35倍之间"
          },
          {
            "value": "C",
            "label": "1.35~1.45倍之间"
          },
          {
            "value": "D",
            "label": "超过1.45倍"
          }
        ],
        "answer": "A",
        "sourceAnswer": "A"
      },
      "source": {
        "type": "pdf",
        "documentId": "quantity-wy27",
        "title": "王炎·27数量关系大满贯·讲义",
        "pages": [
          76
        ],
        "printedPages": [
          70
        ],
        "originalImages": [
          {
            "src": "assets/images/courses/quantity-wy27/quantity-wy27-s07-t02-practice-02-p076.webp",
            "alt": "行程问题（二） · 思维精练2 · 讲义第70页",
            "pdfPage": 76
