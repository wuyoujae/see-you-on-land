      "question": {
        "id": "quantity-wy27-s10-t03-drill-07",
        "type": "single",
        "stem": "（26河南事考）学校冬季运动会上，进入长跑决赛的7名选手全部来自于A、B两个班，其中A班5名同学、B班2名同学。已知最后获得金、银、铜牌的3名选手中有A班2名同学。那么获奖者的结果有（ ）种可能性。",
        "options": [
          {
            "value": "A",
            "label": "140"
          },
          {
            "value": "B",
            "label": "120"
          },
          {
            "value": "C",
            "label": "100"
          },
          {
            "value": "D",
            "label": "60"
          }
        ],
        "answer": "B",
        "sourceAnswer": "B"
