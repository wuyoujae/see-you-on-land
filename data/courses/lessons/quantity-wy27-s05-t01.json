    {
      "id": "quantity-wy27-s05-t01-mother-02-question",
      "type": "question",
      "title": "母题精讲 · 第2题",
      "question": {
        "id": "quantity-wy27-s05-t01-mother-02",
        "type": "single",
        "stem": "（26联考）某AI训练任务需完成X亿次浮点运算。若使用云服务器单独计算，A型需12小时，B型需15小时。实际先由A型工作3小时后，加入B型共同工作。但因任务负载变化，共同工作时效率均下降20%。问完成全部任务需多少小时？",
        "options": [
          {
            "value": "A",
            "label": "6.25"
          },
          {
            "value": "B",
            "label": "7.5"
          },
          {
            "value": "C",
            "label": "9.25"
          },
          {
            "value": "D",
            "label": "10.5"
          }
        ],
        "answer": "C",
        "sourceAnswer": "C"
      },
      "source": {
        "type": "pdf",
