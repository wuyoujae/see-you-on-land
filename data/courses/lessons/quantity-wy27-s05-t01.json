    {
      "id": "quantity-wy27-s05-t01-mother-03-question",
      "type": "question",
      "title": "母题精讲 · 第3题",
      "question": {
        "id": "quantity-wy27-s05-t01-mother-03",
        "type": "single",
        "stem": "（26江苏）某团队共有5名成员，他们共同完成一项工作需要4天时间。从该团队选3人完成此项工作，最快的组合需要5天时间，最慢的组合需要10天时间。若从该团队选2人完成此项工作，则最慢的组合需要的时间是：",
        "options": [
          {
            "value": "A",
            "label": "12天"
          },
          {
            "value": "B",
            "label": "15天"
          },
          {
            "value": "C",
            "label": "18天"
          },
          {
            "value": "D",
            "label": "20天"
          }
        ],
        "answer": "D",
        "sourceAnswer": "D"
      },
      "source": {
        "type": "pdf",
