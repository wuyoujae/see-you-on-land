    {
      "id": "quantity-wy27-s12-t02-drill-08-question",
      "type": "question",
      "title": "实战精刷 · 第8题",
      "question": {
        "id": "quantity-wy27-s12-t02-drill-08",
        "type": "single",
        "stem": "（21江苏）某市举办足球邀请赛，共有9个球队报名参加，其中包含上届比赛的前3名球队。现将这9个球队通过抽签的方式平均分成3组进行单循环比赛，则上届比赛的前3名球队被分在同一组的概率是：",
        "options": [
          {
            "value": "A",
            "label": "1/21"
          },
          {
            "value": "B",
            "label": "1/28"
          },
          {
            "value": "C",
            "label": "1/63"
          },
          {
            "value": "D",
            "label": "1/84"
          }
        ],
        "answer": "B",
        "sourceAnswer": "B"
      },
      "source": {
        "type": "pdf",
        "documentId": "quantity-wy27",
        "title": "王炎·27数量关系大满贯·讲义",
        "pages": [
          130,
          131
        ],
        "printedPages": [
          124,
          125
        ],
        "originalImages": [
          {
            "src": "assets/images/courses/quantity-wy27/quantity-wy27-s12-t02-drill-08-p130.webp",
            "alt": "概率问题（一） · 实战精刷8 · 讲义第124页",
            "pdfPage": 130
          },
          {
            "src": "assets/images/courses/quantity-wy27/quantity-wy27-s12-t02-drill-08-p131.webp",
            "alt": "概率问题（一） · 实战精刷8 · 讲义第125页",
