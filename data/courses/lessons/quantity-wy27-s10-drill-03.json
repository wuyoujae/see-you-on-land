      "question": {
        "id": "quantity-wy27-s10-t03-drill-12",
        "type": "single",
        "stem": "（26联考）小明假期计划每周学习滑雪的天数不少于2天，学习乒乓球1天，周六、周日休息，且不能连续两天学习同一项运动，每天至多学习一项。问其每周的学习计划有多少种不同安排？",
        "options": [
          {
            "value": "A",
            "label": "10"
          },
          {
            "value": "B",
            "label": "14"
          },
          {
            "value": "C",
            "label": "20"
          },
          {
            "value": "D",
            "label": "26"
          }
        ],
        "answer": "C",
        "sourceAnswer": "C"
      },
      "source": {
        "type": "pdf",
        "documentId": "quantity-wy27",
        "title": "王炎·27数量关系大满贯·讲义",
        "pages": [
          110
        ],
        "printedPages": [
          104
        ],
        "originalImages": [
          {
            "src": "assets/images/courses/quantity-wy27/quantity-wy27-s10-t03-drill-12-p110.webp",
            "alt": "排列组合问题（一） · 实战精刷12 · 讲义第104页",
