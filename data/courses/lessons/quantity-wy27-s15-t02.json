    {
      "id": "quantity-wy27-s15-t02-practice-01-question",
      "type": "question",
      "title": "思维精练 · 第1题",
      "question": {
        "id": "quantity-wy27-s15-t02-practice-01",
        "type": "single",
        "stem": "（26北京）小刘的手表分针长度是时针的2倍，分针每小时扫过的面积为20n，他今天长跑期间，时针扫过的面积为n。则他的跑步时长在以下哪个范围内？",
        "options": [
          {
            "value": "A",
            "label": "不到2小时"
          },
          {
            "value": "B",
            "label": "2小时—2小时30分之间"
          },
          {
            "value": "C",
            "label": "2小时30分—3小时之间"
          },
          {
            "value": "D",
            "label": "超过3小时"
          }
        ],
        "answer": "B",
        "sourceAnswer": "B"
      },
      "source": {
        "type": "pdf",
        "documentId": "quantity-wy27",
        "title": "王炎·27数量关系大满贯·讲义",
        "pages": [
          157,
          158
        ],
        "printedPages": [
          151,
          152
        ],
        "originalImages": [
          {
            "src": "assets/images/courses/quantity-wy27/quantity-wy27-s15-t02-practice-01-p157.webp",
            "alt": "几何问题（二） · 思维精练1 · 讲义第151页",
            "pdfPage": 157
          },
          {
            "src": "assets/images/courses/quantity-wy27/quantity-wy27-s15-t02-practice-01-p158.webp",
