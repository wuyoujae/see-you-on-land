    {
      "id": "quantity-wy27-s11-t01-mother-02-question",
      "type": "question",
      "title": "母题精讲 · 第2题",
      "question": {
        "id": "quantity-wy27-s11-t01-mother-02",
        "type": "single",
        "stem": "（24全国事考）某单位将11本《党员学习手册》分发给甲、乙、丙共3个党支部。已知甲支部至少分得3本，乙支部至少分得2本，丙支部至少分得4本，问一共有多少种不同的分配方式？",
        "options": [
          {
            "value": "A",
            "label": "3"
          },
          {
            "value": "B",
            "label": "4"
          },
          {
            "value": "C",
            "label": "5"
          },
          {
            "value": "D",
            "label": "6"
          }
        ],
        "answer": "D",
        "sourceAnswer": "D"
      },
      "source": {
        "type": "pdf",
        "documentId": "quantity-wy27",
        "title": "王炎·27数量关系大满贯·讲义",
        "pages": [
