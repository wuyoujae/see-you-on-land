          },
          {
            "value": "B",
            "label": "45"
          },
          {
            "value": "C",
            "label": "40"
          },
          {
            "value": "D",
            "label": "30"
          }
        ],
        "answer": "C",
        "sourceAnswer": "C"
      },
      "source": {
