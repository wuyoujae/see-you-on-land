    {
      "id": "quantity-wy27-s09-t02-practice-01-question",
      "type": "question",
      "title": "思维精练 · 第1题",
      "question": {
        "id": "quantity-wy27-s09-t02-practice-01",
        "type": "single",
        "stem": "（25江苏）某单位组织45名员工参观第十五届中国国际航空航天博览会。其中，21人参观了新一代隐身战斗机歼-35A，22人参观了嫦娥六号取回的月背月壤样品，19人参观了大型无人机战舰“虎鲸”。所有员工中，这三种展览都未参观的有5人，至少参观两种的有12人，则这三种展览都参观的有（）。",
        "options": [
          {
            "value": "A",
            "label": "7人"
          },
          {
            "value": "B",
            "label": "8人"
          },
          {
            "value": "C",
            "label": "9人"
          },
          {
            "value": "D",
            "label": "10人"
          }
        ],
        "answer": "D",
        "sourceAnswer": "D"
      },
      "source": {
        "type": "pdf",
        "documentId": "quantity-wy27",
        "title": "王炎·27数量关系大满贯·讲义",
        "pages": [
          94
        ],
        "printedPages": [
          88
        ],
        "originalImages": [
          {
            "src": "assets/images/courses/quantity-wy27/quantity-wy27-s09-t02-practice-01-p094.webp",
            "alt": "容斥问题 · 思维精练1 · 讲义第88页",
