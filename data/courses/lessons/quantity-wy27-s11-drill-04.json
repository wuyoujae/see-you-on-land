        ],
        "originalImages": [
          {
            "src": "assets/images/courses/quantity-wy27/quantity-wy27-s11-t02-drill-13-p121.webp",
            "alt": "排列组合问题（二） · 实战精刷13 · 讲义第115页",
            "pdfPage": 121
